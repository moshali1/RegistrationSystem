@page "/admin/scheduling-bookings"
@attribute [Authorize(Roles = "Admin")]

@inject SettingsService SettingsService
@inject SchedulingService SchedulingService
@inject NavigationManager NavigationManager

<PageTitle>Scheduling Bookings</PageTitle>

<div class="space-y-6">
    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                @Icons.Spinner("h-8 w-8 text-cyan-700 animate-spin")
                <span class="text-sm text-slate-500">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="flex items-start justify-between">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Scheduling Bookings</h1>
                <p class="mt-1 text-sm text-slate-500">View and manage participant slot bookings across all sessions.</p>
            </div>
            <button type="button" @onclick="ReloadAsync"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 cursor-pointer">
                @Icons.Refresh("h-4 w-4")
                <span>Refresh</span>
            </button>
        </div>

        @if (allSessions.Count == 0)
        {
            <div class="rounded-xl border border-slate-200 bg-slate-50 px-6 py-12 text-center">
                <p class="text-sm text-slate-500">No scheduling sessions have been configured yet. Add sessions in <a href="/admin/competition-settings" class="text-cyan-700 hover:underline">Competition Settings</a>.</p>
            </div>
        }
        else
        {
            <!-- Group by GroupId for display -->
            @{
                var sessionGroups = allSessions
                    .GroupBy(s => s.GroupId ?? s.Id)
                    .OrderBy(g => allSessions.FindIndex(s => s.Id == g.First().Id))
                    .ToList();
            }

            <!-- Session selector tabs — grouped -->
            <div class="border-b border-slate-200">
                <div class="flex gap-1 overflow-x-auto">
                    @foreach (var group in sessionGroups)
                    {
                        var groupSessions = group.OrderBy(s => s.SectionLabel).ToList();
                        var isGroup = groupSessions.Count > 1;

                        @if (isGroup)
                        {
                            <!-- Group label -->
                            <div class="flex items-center">
                                <span class="px-3 py-3 text-xs font-semibold text-slate-400 uppercase tracking-wide whitespace-nowrap border-r border-slate-200 mr-1">
                                    @(groupSessions.First().LinkedRoundName ?? groupSessions.First().Name)
                                </span>
                                @foreach (var session in groupSessions)
                                {
                                    var sBookings = bookingsBySession.GetValueOrDefault(session.Id) ?? new List<SchedulingBooking>();
                                    var aCount = sBookings.Count(b => b.Status == BookingStatus.Active);
                                    var tLabel = !string.IsNullOrEmpty(session.SectionLabel) ? session.SectionLabel : session.Name;
                                    <button type="button"
                                            class="@(selectedSessionId == session.Id ? "border-b-2 border-cyan-600 text-cyan-700 font-medium" : "text-slate-500 hover:text-slate-700 border-b-2 border-transparent") whitespace-nowrap px-4 py-3 text-sm cursor-pointer flex items-center gap-2"
                                            @onclick="() => SelectSession(session.Id)">
                                        <span>@tLabel</span>
                                        <span class="rounded-full @(aCount > 0 ? "bg-cyan-100 text-cyan-700" : "bg-slate-100 text-slate-400") px-1.5 py-0.5 text-xs font-medium">@aCount</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            var session = groupSessions[0];
                            var sBookings = bookingsBySession.GetValueOrDefault(session.Id) ?? new List<SchedulingBooking>();
                            var aCount = sBookings.Count(b => b.Status == BookingStatus.Active);
                            var tLabel = !string.IsNullOrEmpty(session.SectionLabel) ? session.SectionLabel : session.Name;
                            <button type="button"
                                    class="@(selectedSessionId == session.Id ? "border-b-2 border-cyan-600 text-cyan-700 font-medium" : "text-slate-500 hover:text-slate-700 border-b-2 border-transparent") whitespace-nowrap px-4 py-3 text-sm cursor-pointer flex items-center gap-2"
                                    @onclick="() => SelectSession(session.Id)">
                                <span>@tLabel</span>
                                <span class="rounded-full @(aCount > 0 ? "bg-cyan-100 text-cyan-700" : "bg-slate-100 text-slate-400") px-1.5 py-0.5 text-xs font-medium">@aCount</span>
                            </button>
                        }
                    }
                </div>
            </div>

            @if (selectedSession != null)
            {
                var sessionBookings = bookingsBySession.GetValueOrDefault(selectedSession.Id) ?? new List<SchedulingBooking>();
                var bookingsBySlot = sessionBookings.ToLookup(b => b.SlotId);
                var slotsByDate = selectedSession.Slots
                    .GroupBy(s => s.Date)
                    .OrderBy(g => g.Key);

                <!-- Cross-section group summary (only when session belongs to a parallel group) -->
                @if (!string.IsNullOrEmpty(selectedSession.GroupId))
                {
                    var parallelSessions = allSessions.Where(s => s.GroupId == selectedSession.GroupId).OrderBy(s => s.SectionLabel).ToList();
                    var groupTotalCapacity = parallelSessions.Sum(s => s.Slots.Where(sl => sl.IsActive).Sum(sl => sl.Capacity));
                    var groupTotalBooked = parallelSessions.Sum(s => (bookingsBySession.GetValueOrDefault(s.Id) ?? new()).Count(b => b.Status == BookingStatus.Active));
                    var groupFillPct = groupTotalCapacity > 0 ? Math.Min(100, groupTotalBooked * 100 / groupTotalCapacity) : 0;

                    <div class="rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mb-1">All Sections Combined</p>
                                <p class="text-sm text-cyan-700">
                                    <span class="text-2xl font-bold text-cyan-900">@groupTotalBooked</span>
                                    <span class="text-cyan-600"> / @groupTotalCapacity booked</span>
                                </p>
                            </div>
                            <div class="flex items-center gap-4">
                                @foreach (var ps in parallelSessions)
                                {
                                    var psBooked = (bookingsBySession.GetValueOrDefault(ps.Id) ?? new()).Count(b => b.Status == BookingStatus.Active);
                                    var psCap = ps.Slots.Where(sl => sl.IsActive).Sum(sl => sl.Capacity);
                                    <button type="button" @onclick="() => SelectSession(ps.Id)"
                                            class="text-center cursor-pointer hover:opacity-80 transition-opacity @(selectedSessionId == ps.Id ? "opacity-100" : "opacity-60")">
                                        <p class="text-lg font-bold text-cyan-900">@psBooked<span class="text-xs font-normal text-cyan-600">/@psCap</span></p>
                                        <p class="text-xs text-cyan-700">@(ps.SectionLabel ?? ps.Name)</p>
                                    </button>
                                }
                            </div>
                        </div>
                        <!-- Combined fill bar -->
                        <div class="mt-2 h-1.5 w-full rounded-full bg-cyan-200 overflow-hidden">
                            <div class="h-full rounded-full bg-cyan-500" style="width: @groupFillPct%"></div>
                        </div>
                    </div>
                }

                <!-- Session header -->
                <div>
                    <h2 class="text-lg font-semibold text-slate-800">@selectedSession.Name</h2>
                    @if (!string.IsNullOrEmpty(selectedSession.LinkedRoundName))
                    {
                        <p class="text-sm text-slate-500">@selectedSession.LinkedRoundName</p>
                    }
                </div>

                <!-- Session meta -->
                <div class="flex flex-wrap items-center gap-3 text-sm text-slate-600">
                    @if (selectedSession.IsOpen)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700">
                            @Icons.Key("h-3 w-3") Open
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-500">
                            @Icons.Lock("h-3 w-3") Closed
                        </span>
                    }
                    <span class="text-slate-400">
                        Total slots: <span class="font-medium text-slate-700">@selectedSession.Slots.Count(s => s.IsActive)</span> active
                    </span>
                    <span class="text-slate-400">
                        Booked: <span class="font-medium text-slate-700">@sessionBookings.Count(b => b.Status == BookingStatus.Active)</span>
                    </span>
                </div>

                @if (!selectedSession.Slots.Any())
                {
                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-6 py-10 text-center">
                        <p class="text-sm text-slate-500">No slots configured for this session.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var dateGroup in slotsByDate)
                        {
                            var dateSlots = dateGroup.OrderBy(s => s.TimeUtc).ToList();
                            var dateBookings = dateSlots.SelectMany(s => bookingsBySlot[s.Id]).ToList();
                            var dateActive = dateBookings.Count(b => b.Status == BookingStatus.Active);

                            <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
                                <!-- Date header -->
                                <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-4 py-3">
                                    <span class="font-semibold text-slate-800">@dateGroup.Key.ToString("dddd, MMMM d, yyyy")</span>
                                    <span class="text-sm text-slate-500">@dateActive booked / @dateSlots.Count(s => s.IsActive) active slots</span>
                                </div>

                                <div class="divide-y divide-slate-100">
                                    @foreach (var slot in dateSlots)
                                    {
                                        var slotBookings = bookingsBySlot[slot.Id].OrderBy(b => b.BookedAt).ToList();
                                        var activeBookings = slotBookings.Where(b => b.Status == BookingStatus.Active).ToList();
                                        var cancelledBookings = slotBookings.Where(b => b.Status == BookingStatus.Cancelled).ToList();
                                        var isFull = activeBookings.Count >= slot.Capacity;
                                        var timeLabel = SchedulingService.FormatSlotTime(slot.Date, slot.TimeUtc);

                                        <div class="px-4 py-3 @(slot.IsActive ? "" : "opacity-50")">
                                            <div class="flex items-start gap-4">
                                                <!-- Time + capacity -->
                                                <div class="w-40 flex-shrink-0">
                                                    <div class="font-medium text-slate-800 text-sm">@timeLabel</div>
                                                    <div class="mt-0.5 text-xs text-slate-500">
                                                        @activeBookings.Count / @slot.Capacity booked
                                                        @if (!slot.IsActive)
                                                        {
                                                            <span class="ml-1 text-slate-400">(inactive)</span>
                                                        }
                                                        else if (isFull)
                                                        {
                                                            <span class="ml-1 font-medium text-amber-600">Full</span>
                                                        }
                                                    </div>
                                                    <!-- Capacity bar -->
                                                    <div class="mt-1.5 h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                                                        @{
                                                            var fillPct = slot.Capacity > 0 ? Math.Min(100, activeBookings.Count * 100 / slot.Capacity) : 0;
                                                        }
                                                        <div class="h-full rounded-full @(isFull ? "bg-amber-400" : "bg-cyan-400")"
                                                             style="width: @fillPct%"></div>
                                                    </div>
                                                </div>

                                                <!-- Bookings list -->
                                                <div class="flex-1 min-w-0">
                                                    @if (!activeBookings.Any() && !cancelledBookings.Any())
                                                    {
                                                        <p class="text-xs text-slate-400 italic">No bookings</p>
                                                    }
                                                    else
                                                    {
                                                        <div class="space-y-1">
                                                            @foreach (var booking in activeBookings)
                                                            {
                                                                <div class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 px-3 py-1.5">
                                                                    <div class="flex items-center gap-2 min-w-0">
                                                                        <span class="text-xs font-mono text-slate-500 flex-shrink-0">@(booking.Cid ?? "—")</span>
                                                                        <span class="text-sm font-medium text-slate-800 truncate">@booking.CompetitorName</span>
                                                                        <span class="text-xs text-slate-400 flex-shrink-0">@SchedulingService.ToCentralTime(booking.BookedAt).ToString("M/d h:mm tt") CT</span>
                                                                    </div>
                                                                    <div class="flex items-center gap-2 flex-shrink-0">
                                                                        <a href="/registrations/@booking.RegistrationId"
                                                                           class="text-xs text-cyan-700 hover:underline">View</a>
                                                                        <button type="button"
                                                                                @onclick="() => RequestCancel(booking)"
                                                                                class="text-xs text-red-600 hover:text-red-800 cursor-pointer">Cancel</button>
                                                                    </div>
                                                                </div>
                                                            }
                                                            @if (cancelledBookings.Any())
                                                            {
                                                                <details class="group">
                                                                    <summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-600 mt-1 select-none list-none flex items-center gap-1">
                                                                        @Icons.Chevron("h-3 w-3 group-open:rotate-90 transition-transform")
                                                                        @cancelledBookings.Count cancelled
                                                                    </summary>
                                                                    <div class="mt-1 space-y-1">
                                                                        @foreach (var booking in cancelledBookings)
                                                                        {
                                                                            <div class="flex items-center gap-2 rounded-lg border border-slate-100 px-3 py-1.5 opacity-60">
                                                                                <span class="text-xs font-mono text-slate-400 flex-shrink-0">@(booking.Cid ?? "—")</span>
                                                                                <span class="text-sm text-slate-500 line-through truncate">@booking.CompetitorName</span>
                                                                                @if (!string.IsNullOrEmpty(booking.CancellationReason))
                                                                                {
                                                                                    <span class="text-xs text-slate-400 italic">— @booking.CancellationReason</span>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </details>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
    }
</div>

<!-- Cancel confirmation modal -->
@if (showCancelModal && cancellingBooking != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4" @onclick="CloseCancelModal">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl" @onclick:stopPropagation="true">
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Cancel Booking</h3>
            <p class="text-sm text-slate-600 mb-1">
                Cancel <strong>@cancellingBooking.CompetitorName</strong>'s booking for
                <strong>@SchedulingService.FormatSlotTime(cancellingBooking.Date, cancellingBooking.TimeUtc)</strong>
                on <strong>@cancellingBooking.Date.ToString("MMMM d, yyyy")</strong>?
            </p>
            <p class="text-xs text-slate-500 mb-4">Their round status will revert to Active so they can rebook.</p>

            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Reason (optional)</label>
                <input type="text" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 outline-none"
                       placeholder="e.g. Admin adjustment"
                       @bind="cancelReason" />
            </div>

            @if (!string.IsNullOrEmpty(cancelError))
            {
                <p class="mb-3 text-sm text-red-600">@cancelError</p>
            }

            <div class="flex justify-end gap-3">
                <button type="button" @onclick="CloseCancelModal"
                        class="rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 cursor-pointer">
                    Keep Booking
                </button>
                <button type="button" @onclick="ConfirmCancel"
                        disabled="@isCancelling"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700 disabled:opacity-50 cursor-pointer">
                    @if (isCancelling) { <text>Cancelling...</text> } else { <text>Cancel Booking</text> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<SchedulingSession> allSessions = new();
    private string? selectedSessionId;
    private Dictionary<string, List<SchedulingBooking>> bookingsBySession = new();

    private SchedulingSession? selectedSession =>
        allSessions.FirstOrDefault(s => s.Id == selectedSessionId);

    // Cancel modal
    private bool showCancelModal;
    private SchedulingBooking? cancellingBooking;
    private string cancelReason = string.Empty;
    private bool isCancelling;
    private string? cancelError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        isLoading = true;
        StateHasChanged();

        var settings = await SettingsService.GetSettingsAsync();
        allSessions = settings.SchedulingSessions;

        // Load ALL session bookings upfront so tab badges are accurate immediately
        var tasks = allSessions.Select(async s =>
        {
            var bookings = await SchedulingService.GetBookingsBySessionAsync(s.Id);
            return (s.Id, bookings.ToList());
        });
        var results = await Task.WhenAll(tasks);
        bookingsBySession = results.ToDictionary(r => r.Id, r => r.Item2);

        // Auto-select first session
        if (selectedSessionId == null && allSessions.Count > 0)
            selectedSessionId = allSessions[0].Id;

        isLoading = false;
    }

    private void SelectSession(string sessionId)
    {
        selectedSessionId = sessionId;
    }

    private async Task LoadSessionBookingsAsync(string sessionId)
    {
        var bookings = await SchedulingService.GetBookingsBySessionAsync(sessionId);
        bookingsBySession[sessionId] = bookings.ToList();
    }

    private void RequestCancel(SchedulingBooking booking)
    {
        cancellingBooking = booking;
        cancelReason = string.Empty;
        cancelError = null;
        showCancelModal = true;
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        cancellingBooking = null;
        isCancelling = false;
    }

    private async Task ConfirmCancel()
    {
        if (cancellingBooking == null) return;
        isCancelling = true;
        cancelError = null;

        var reason = string.IsNullOrWhiteSpace(cancelReason) ? "Admin cancellation" : cancelReason.Trim();
        var ok = await SchedulingService.AdminCancelBookingAsync(cancellingBooking.Id, reason, allSessions);

        if (ok)
        {
            // Refresh all sessions so group summary stays accurate
            var tasks = allSessions.Select(async s =>
            {
                var bookings = await SchedulingService.GetBookingsBySessionAsync(s.Id);
                return (s.Id, bookings.ToList());
            });
            var results = await Task.WhenAll(tasks);
            bookingsBySession = results.ToDictionary(r => r.Id, r => r.Item2);
            CloseCancelModal();
        }
        else
        {
            cancelError = "Could not cancel this booking. It may have already been cancelled.";
            isCancelling = false;
        }
    }
}
