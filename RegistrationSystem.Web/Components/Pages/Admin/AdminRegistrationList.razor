    private string GetDivisionName(Registration reg)
    {
        return divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId)?.Name ?? "Unknown";
    }

    private string GetCategoryName(Registration reg)
    {
        var division = divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId);
        return division?.Categories.FirstOrDefault(c => c.Id == reg.CompetitionSelection.CategoryId)?.Name ?? "Unknown";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // TEMPLATE SCOPE FILTERING
    // ═══════════════════════════════════════════════════════════════════════════

    private List<EmailTemplate> GetFilteredEmailTemplates()
    {
        var selectedRegs = GetSelectedRegistrations();
        if (selectedRegs.Count == 0)
            return emailTemplates.Where(t => t.IsActive).ToList();

        var scopes = selectedRegs
            .Select(r => (r.CompetitionSelection.DivisionId, r.CompetitionSelection.CategoryId))
            .Distinct()
            .ToList();

        return EmailTemplateService.FilterTemplatesForRegistrations(emailTemplates, scopes);
    }

    private int GetSelectedAccountCount() =>
        GetSelectedRegistrations().Select(r => r.CreatorUserId).Distinct().Count();

    private string GetTemplateScopeLabel(EmailTemplate template)
    {
        if (string.IsNullOrEmpty(template.DivisionId)) return "Global";
        var divName = divisions.FirstOrDefault(d => d.Id == template.DivisionId)?.Name ?? "?";
        if (string.IsNullOrEmpty(template.CategoryId)) return divName;
        var division = divisions.FirstOrDefault(d => d.Id == template.DivisionId);
        var catName = division?.Categories.FirstOrDefault(c => c.Id == template.CategoryId)?.Name ?? "?";
        return $"{divName} / {catName}";
    }

