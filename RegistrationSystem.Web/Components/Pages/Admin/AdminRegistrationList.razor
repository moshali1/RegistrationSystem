    private async Task OpenDeleteModal(Registration reg)
    {
        deleteTarget = reg;
        deleteAuditTrail = false;
        deleteConfirmation = string.Empty;
        isLoadingAuditCount = true;
        auditEntryCount = 0;
        StateHasChanged();

        try
        {
            var entries = await AuditService.GetEntityHistoryAsync("Registration", reg.Id);
            auditEntryCount = entries.Count;
        }
        catch
        {
            auditEntryCount = 0;
        }
        finally
        {
            isLoadingAuditCount = false;
            StateHasChanged();
        }
    }

    private void CloseDeleteModal()
    {
        deleteTarget = null;
        deleteConfirmation = string.Empty;
        deleteAuditTrail = false;
    }

    private async Task ExecuteDelete()
    {
        if (deleteTarget == null || deleteConfirmation != "DELETE") return;

        isDeleting = true;
        StateHasChanged();

        try
        {
            var name = deleteTarget.PersonalInfo.FullName;
            var cid = deleteTarget.Cid ?? "N/A";
            var regId = deleteTarget.Id;

            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogAsync(
                AuditAction.Deleted,
                "Registration",
                regId,
                summary: $"Deleted registration for {name} ({cid})",
                entityDescription: $"{name} ({cid})",
                metadata: new Dictionary<string, string>
                {
                    ["CompetitorName"] = name,
                    ["CID"] = cid,
                    ["Division"] = GetDivisionName(deleteTarget),
                    ["Category"] = GetCategoryName(deleteTarget),
                    ["Status"] = deleteTarget.Status.ToString(),
                    ["AuditTrailDeleted"] = deleteAuditTrail.ToString()
                });

            await RegistrationRepository.DeleteAsync(regId);

            if (deleteAuditTrail)
            {
                await AuditService.DeleteEntityAuditTrailAsync("Registration", regId);
            }

            registrations.Remove(deleteTarget);
            selectedIds.Remove(regId);
            RebuildFilteredData();

            successMessage = $"Registration for {name} ({cid}) deleted successfully.";
            CloseDeleteModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete registration: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // REVERT STATUS
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task OpenRevertModal(Registration reg)
    {
        revertTarget = reg;
        revertTargetStatus = default;
        revertPreviousStatusFound = false;
        isLoadingPreviousStatus = true;
        revertReason = string.Empty;
        StateHasChanged();

        try
        {
            // Look up the previous status from the audit trail (ordered newest-first)
            var auditEntries = await AuditService.GetEntityHistoryAsync("Registration", reg.Id);
            RegistrationStatus? previousStatus = null;

            // Strategy 1: Find the most recent StatusChanged entry that transitioned TO the current status
            // This covers admin-initiated status changes (review page, bulk verify)
            var statusChangedEntry = auditEntries
                .Where(e => e.Action == AuditAction.StatusChanged)
                .FirstOrDefault(e =>
                {
                    // Check metadata (bulk verify, revert)
                    if (e.Metadata?.TryGetValue("NewStatus", out var ns) == true
                        && ns == reg.Status.ToString())
                        return true;
                    // Check summary text (review page: "Status changed from X to Y")
                    var currentDisplayName = StatusBadge.GetDisplayName(reg.Status);
                    return e.Summary?.Contains($"to {currentDisplayName}") == true;
                });

            if (statusChangedEntry != null)
            {
                // Try metadata OldStatus
                if (statusChangedEntry.Metadata?.TryGetValue("OldStatus", out var oldStr) == true
                    && Enum.TryParse<RegistrationStatus>(oldStr, out var parsed))
                    previousStatus = parsed;
                // Try Changes list
                else if (statusChangedEntry.Changes?.FirstOrDefault(c => c.FieldName == "Status") is { } fc
                    && Enum.TryParse<RegistrationStatus>(fc.OldValue, out var parsedFromChanges))
                    previousStatus = parsedFromChanges;
                // Try parsing summary
                else if (statusChangedEntry.Summary != null)
                    previousStatus = ParseOldStatusFromSummary(statusChangedEntry.Summary);
            }

            // Strategy 2: Find a Withdrawn/Disqualified audit entry with Changes list
            // This covers user-initiated withdrawals (logged via LogFieldChangesAsync with AuditAction.Withdrawn)
            if (previousStatus == null)
            {
                var targetAction = reg.Status == RegistrationStatus.Withdrawn
                    ? AuditAction.Withdrawn
                    : AuditAction.Disqualified;

                var actionEntry = auditEntries
                    .FirstOrDefault(e => e.Action == targetAction
                        && e.Changes?.Any(c => c.FieldName == "Status") == true);

                if (actionEntry != null)
                {
                    var statusChange = actionEntry.Changes!.First(c => c.FieldName == "Status");
                    if (Enum.TryParse<RegistrationStatus>(statusChange.OldValue, out var parsedOld))
                        previousStatus = parsedOld;
                }
            }

            // Strategy 3: If no audit trail found at all, default to AwaitingReview
            // This handles edge cases like data imports or missing audit history
            previousStatus ??= RegistrationStatus.AwaitingReview;

            revertTargetStatus = previousStatus.Value;
            revertPreviousStatusFound = true;
        }
        catch
        {
            // Best-effort — if audit lookup fails completely, admin can't revert
        }
        finally
        {
            isLoadingPreviousStatus = false;
            StateHasChanged();
        }
    }

    private static RegistrationStatus? ParseOldStatusFromSummary(string summary)
    {
        foreach (RegistrationStatus s in Enum.GetValues<RegistrationStatus>())
        {
            if (summary.Contains($"from {StatusBadge.GetDisplayName(s)} to"))
                return s;
        }
        return null;
    }

    private void CloseRevertModal()
    {
        revertTarget = null;
        revertReason = string.Empty;
    }

    private async Task ExecuteRevert()
    {
        if (revertTarget == null || string.IsNullOrWhiteSpace(revertReason)) return;

        isReverting = true;
        StateHasChanged();

        try
        {
            var oldStatus = revertTarget.Status;
            var name = revertTarget.PersonalInfo.FullName;
            var cid = revertTarget.Cid ?? "N/A";

            revertTarget.Status = revertTargetStatus;
            revertTarget.StatusComment = revertReason;
            revertTarget.WithdrawComment = null;

            await RegistrationService.AdminUpdateStatusAsync(revertTarget);

            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogAsync(
                AuditAction.StatusChanged,
                "Registration",
                revertTarget.Id,
                summary: $"Status reverted from {StatusBadge.GetDisplayName(oldStatus)} to {StatusBadge.GetDisplayName(revertTargetStatus)} ({revertReason})",
                entityDescription: $"{name} ({cid})",
                metadata: new Dictionary<string, string>
                {
                    ["OldStatus"] = oldStatus.ToString(),
                    ["NewStatus"] = revertTargetStatus.ToString(),
                    ["RevertReason"] = revertReason
                });

            RebuildFilteredData();
            successMessage = $"Registration for {name} ({cid}) reverted to {StatusBadge.GetDisplayName(revertTargetStatus)}.";
            CloseRevertModal();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to revert registration: {ex.Message}";
        }
        finally
        {
            isReverting = false;
            StateHasChanged();
        }
    }

