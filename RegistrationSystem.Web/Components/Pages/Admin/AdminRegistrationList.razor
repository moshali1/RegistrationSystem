@code {
    // ═══════════════════════════════════════════════════════════════════════════
    // STATE
    // ═══════════════════════════════════════════════════════════════════════════
    private bool isLoading = false;
    private bool isInitialLoading = true;
    private string loadingMessage = "Loading...";
    private CompetitionSettings? settings;
    private int competitionYear;

    // Filter state — split into two groups so the UI can render them as separate
    // button clusters: active pipeline statuses vs "not continuing" statuses.
    private static readonly RegistrationStatus[] activeStatuses = new[]
    {
        RegistrationStatus.AwaitingReview,
        RegistrationStatus.Pending,
        RegistrationStatus.Reviewed,
        RegistrationStatus.Verified
    };
    private static readonly RegistrationStatus[] inactiveStatuses = new[]
    {
        RegistrationStatus.Withdrawn,
        RegistrationStatus.Disqualified
    };
    private static readonly RegistrationStatus[] allStatuses =
        activeStatuses.Concat(inactiveStatuses).ToArray();

    private HashSet<RegistrationStatus> selectedStatuses = new(allStatuses);
    private string selectedDivisionId = string.Empty;
    private string selectedCategoryId = string.Empty;
    private string selectedRegion = string.Empty;
    private string selectedGender = string.Empty;
    private string selectedNiqabFilter = string.Empty;
    private string searchQuery = string.Empty;

    // Data
    private List<Division> divisions = new();
    private List<Category> availableCategories = new();
    private List<Registration> registrations = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;

    // Single delete modal
    private Registration? deleteTarget;
    private bool deleteAuditTrail = false;
    private string deleteConfirmation = string.Empty;
    private bool isDeleting = false;
    private bool isLoadingAuditCount = false;
    private int auditEntryCount = 0;

    // Revert status modal
    private static readonly string[] revertPresets = new[]
    {
        "Withdrawn by mistake",
        "Reverting after admin review",
        "Disqualification reversed after appeal",
        "Re-entered into competition"
    };
    private Registration? revertTarget;
    private RegistrationStatus revertTargetStatus;
    private bool revertPreviousStatusFound;
    private bool isLoadingPreviousStatus;
    private string revertReason = string.Empty;
    private bool isReverting;

    // Selection state
    private HashSet<string> selectedIds = new();
    private bool allFilteredSelected;

    // Mobile responsive state
    private bool showMobileFilters;

    // Bulk modals
    private bool showBulkVerifyModal;
    private bool showBulkEmailModal;
    private bool showBulkDeleteModal;
    private bool showBulkResultsModal;
    private bool isBulkProcessing;
    private int bulkProgress;
    private int bulkTotal;
    private string bulkResultMessage = string.Empty;
    private string bulkPhaseMessage = string.Empty;

    // Bulk verify
    private string bulkVerifyTemplateId = string.Empty;

    // Bulk email
    private string bulkEmailTemplateId = string.Empty;

    // Bulk delete
    private bool bulkDeleteAuditTrail;
    private string bulkDeleteConfirmation = string.Empty;

    // Email templates
    private List<EmailTemplate> emailTemplates = new();

    // Messages
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    // Materialized filter/page results — rebuilt once via RebuildFilteredData() instead of
    // recalculating on every property access. With 642+ registrations and ~14 template
    // references per render, computed getters were re-running the full LINQ chain each time.
    private List<Registration> filteredRegistrations = new();
    private List<Registration> pagedRegistrations = new();
    private int totalPages;

    private bool IsAllPageSelected => pagedRegistrations.Count > 0 && pagedRegistrations.All(r => selectedIds.Contains(r.Id));

    private bool AllSelectedAreReviewed => selectedIds.Count > 0 &&
        GetSelectedRegistrations().All(r => r.Status == RegistrationStatus.Reviewed);

    private void RebuildFilteredData()
    {
        filteredRegistrations = registrations
            .Where(r => selectedStatuses.Contains(r.Status))
            .Where(r => string.IsNullOrEmpty(selectedDivisionId) || r.CompetitionSelection.DivisionId == selectedDivisionId)
            .Where(r => string.IsNullOrEmpty(selectedCategoryId) || r.CompetitionSelection.CategoryId == selectedCategoryId)
            .Where(r => MatchesRegion(r))
            .Where(r => string.IsNullOrEmpty(selectedGender) || r.PersonalInfo.Gender.ToString() == selectedGender)
            .Where(r => MatchesNiqabFilter(r))
            .Where(r => MatchesSearch(r))
            .OrderByDescending(r => r.Id)
            .ToList();

        totalPages = (int)Math.Ceiling((double)filteredRegistrations.Count / pageSize);

        if (currentPage > totalPages && totalPages > 0)
            currentPage = totalPages;

        pagedRegistrations = filteredRegistrations
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // LIFECYCLE
    // ═══════════════════════════════════════════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        isInitialLoading = true;

        loadingMessage = "Loading competition settings...";
        StateHasChanged();

        settings = await SettingsService.GetSettingsAsync();
        competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

        if (settings != null)
        {
            divisions = settings.Divisions.Where(d => d.IsEnabled).ToList();
        }

        loadingMessage = "Fetching registrations...";
        StateHasChanged();

        await FetchRegistrations();

        // Load email templates for bulk operations
        try { emailTemplates = await EmailTemplateService.GetAllAsync(); } catch { }

        isInitialLoading = false;
        StateHasChanged();
    }

    private async Task FetchRegistrations()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var allRegistrations = await RegistrationService.GetAllByYearAsync(competitionYear);
            registrations = allRegistrations.ToList();
            currentPage = 1;
            selectedIds.Clear();
            allFilteredSelected = false;
            RebuildFilteredData();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SELECTION
    // ═══════════════════════════════════════════════════════════════════════════

    private void ToggleSelection(string id)
    {
        if (!selectedIds.Remove(id))
            selectedIds.Add(id);
        else
            allFilteredSelected = false; // Unchecking any item exits "select all filtered" mode
    }

    private void ToggleSelectAllPage()
    {
        if (IsAllPageSelected)
        {
            // If "select all filtered" is active, uncheck clears everything (Gmail behavior)
            if (allFilteredSelected)
            {
                selectedIds.Clear();
                allFilteredSelected = false;
            }
            else
            {
                foreach (var reg in pagedRegistrations)
                    selectedIds.Remove(reg.Id);
            }
        }
        else
        {
            foreach (var reg in pagedRegistrations)
                selectedIds.Add(reg.Id);
        }
    }

    private void SelectAllFiltered()
    {
        foreach (var reg in filteredRegistrations)
            selectedIds.Add(reg.Id);
        allFilteredSelected = true;
    }

    private void ClearSelection()
    {
        selectedIds.Clear();
        allFilteredSelected = false;
    }

    private List<Registration> GetSelectedRegistrations() =>
        allFilteredSelected
            ? filteredRegistrations
            : registrations.Where(r => selectedIds.Contains(r.Id)).ToList();

    // ═══════════════════════════════════════════════════════════════════════════
    // FILTERS
    // ═══════════════════════════════════════════════════════════════════════════

    private void ToggleStatusFilter(RegistrationStatus status)
    {
        if (selectedStatuses.Contains(status))
        {
            if (selectedStatuses.Count > 1)
                selectedStatuses.Remove(status);
        }
        else
        {
            selectedStatuses.Add(status);
        }
        currentPage = 1;
        // Clear selections when filters change — stale selections on hidden items
        // can lead to accidental bulk actions on registrations the admin forgot about.
        selectedIds.Clear();
        allFilteredSelected = false;
        RebuildFilteredData();
    }

    private void OnDivisionChanged()
    {
        selectedCategoryId = string.Empty;
        currentPage = 1;
        selectedIds.Clear();
        allFilteredSelected = false;

        if (!string.IsNullOrEmpty(selectedDivisionId))
        {
            var division = divisions.FirstOrDefault(d => d.Id == selectedDivisionId);
            availableCategories = division?.Categories.Where(c => c.IsEnabled).ToList() ?? new();
        }
        else
        {
            availableCategories = new();
        }
        RebuildFilteredData();
    }

    private void OnFilterChanged()
    {
        currentPage = 1;
        selectedIds.Clear();
        allFilteredSelected = false;
        RebuildFilteredData();
    }

    private bool MatchesRegion(Registration reg)
    {
        if (string.IsNullOrEmpty(selectedRegion)) return true;
        var state = reg.AddressInfo.StateProvince ?? "";
        return selectedRegion switch
        {
            "MN" => state.Equals("Minnesota", StringComparison.OrdinalIgnoreCase)
                  || state.Equals("MN", StringComparison.OrdinalIgnoreCase),
            "OutOfState" => !state.Equals("Minnesota", StringComparison.OrdinalIgnoreCase)
                         && !state.Equals("MN", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    private bool MatchesNiqabFilter(Registration reg)
    {
        if (string.IsNullOrEmpty(selectedNiqabFilter)) return true;
        return selectedNiqabFilter switch
        {
            "Yes" => reg.FileUploadInfo.NiqabBypassApproved,
            "No" => !reg.FileUploadInfo.NiqabBypassApproved,
            _ => true
        };
    }

    private bool MatchesSearch(Registration r)
    {
        if (string.IsNullOrEmpty(searchQuery)) return true;

        var query = searchQuery.Trim();

        if (r.Cid?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;

        var fullName = r.PersonalInfo.FullName;
        var firstName = r.PersonalInfo.FirstName;
        var lastName = r.PersonalInfo.LastName;

        if (fullName.Contains(query, StringComparison.OrdinalIgnoreCase))
            return true;

        var queryParts = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (queryParts.Length > 1)
        {
            var middleName = r.PersonalInfo.MiddleName ?? "";
            return queryParts.All(part =>
                firstName.Contains(part, StringComparison.OrdinalIgnoreCase) ||
                middleName.Contains(part, StringComparison.OrdinalIgnoreCase) ||
                lastName.Contains(part, StringComparison.OrdinalIgnoreCase));
        }

        return false;
    }

