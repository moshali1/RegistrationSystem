    private async Task ExportSelected()
    {
        var selected = GetSelectedRegistrations();
        await ExportToCsv(selected, $"registrations_selected_{DateTime.Now:yyyyMMdd_HHmm}.csv");
    }

    private async Task ExportAllFiltered()
    {
        await ExportToCsv(filteredRegistrations, $"registrations_export_{DateTime.Now:yyyyMMdd_HHmm}.csv");
    }

    private async Task ExportToCsv(List<Registration> regs, string filename)
    {
        var sb = new System.Text.StringBuilder();

        // Header
        sb.AppendLine("CID,Full Name,Gender,DOB,Age,Division,Category,Portion,City,State,Country,Parent Name,Parent Phone,Teacher Name,Status,Niqab Bypass,Has Video,Has Photo,Has ID");

        foreach (var r in regs)
        {
            var age = settings != null ? r.CalculateAgeAsOf(settings.AgeCutoffDate).ToString() : "";
            var portion = r.CompetitionSelection.PortionChoice?.ToString() ?? "";
            var hasVideo = r.FileUploadInfo.Video != null ? "Yes" : "No";
            var hasPhoto = r.FileUploadInfo.Photo != null ? "Yes" : "No";
            var hasId = r.FileUploadInfo.IdDocument != null ? "Yes" : "No";
            var niqab = r.FileUploadInfo.NiqabBypassApproved ? "Yes" : "No";
            var teacherName = r.TeacherInfo?.FullName ?? "";

            sb.AppendLine(string.Join(",",
                Csv(r.Cid ?? ""),
                Csv(r.PersonalInfo.FullName),
                Csv(r.PersonalInfo.Gender.ToString()),
                Csv(r.PersonalInfo.DateOfBirth.ToString("yyyy-MM-dd")),
                Csv(age),
                Csv(GetDivisionName(r)),
                Csv(GetCategoryName(r)),
                Csv(portion),
                Csv(r.AddressInfo.City ?? ""),
                Csv(r.AddressInfo.StateProvince ?? ""),
                Csv(r.AddressInfo.Country ?? ""),
                Csv(r.ParentInfo?.FullName ?? ""),
                Csv(r.ParentInfo?.PhoneNumber ?? ""),
                Csv(teacherName),
                Csv(r.Status.ToString()),
                Csv(niqab),
                Csv(hasVideo),
                Csv(hasPhoto),
                Csv(hasId)
            ));
        }

        await JS.InvokeVoidAsync("downloadFile", filename, "text/csv", sb.ToString());
    }

    private static string Csv(string value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return $"\"{value.Replace("\"", "\"\"")}\"";
    }

