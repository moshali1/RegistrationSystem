    // BULK VERIFY
    // ═══════════════════════════════════════════════════════════════════════════

    private void OpenBulkVerifyModal()
    {
        var filtered = GetFilteredEmailTemplates();
        bulkVerifyTemplateId = filtered.FirstOrDefault(t => t.Name.Contains("Verified", StringComparison.OrdinalIgnoreCase))?.Id ?? "";
        showBulkVerifyModal = true;
    }

    private async Task ExecuteBulkVerify()
    {
        isBulkProcessing = true;
        var selected = GetSelectedRegistrations().Where(r => r.Status == RegistrationStatus.Reviewed).ToList();
        bulkTotal = selected.Count;
        bulkProgress = 0;
        bulkPhaseMessage = $"Verifying 0 of {bulkTotal}...";
        StateHasChanged();

        EmailTemplate? template = null;
        if (!string.IsNullOrEmpty(bulkVerifyTemplateId))
        {
            template = await EmailTemplateService.GetByIdAsync(bulkVerifyTemplateId);
        }

        int verified = 0, emailsSent = 0, failures = 0, accountCount = 0;
        var verifiedRegs = new List<Registration>();

        await AuditContextProvider.SetCurrentUserContextAsync();

        // Phase 1: Update status for each registration
        foreach (var reg in selected)
        {
            try
            {
                bulkProgress++;
                bulkPhaseMessage = $"Verifying {bulkProgress} of {bulkTotal}...";
                StateHasChanged();

                var oldStatus = reg.Status.ToString();
                reg.Status = RegistrationStatus.Verified;
                await RegistrationService.AdminUpdateStatusAsync(reg);

                await AuditService.LogAsync(
                    AuditAction.StatusChanged,
                    "Registration",
                    reg.Id,
                    summary: $"Bulk status change: {oldStatus} → Verified",
                    entityDescription: $"{reg.PersonalInfo.FullName} ({reg.Cid})",
                    metadata: new Dictionary<string, string>
                    {
                        ["OldStatus"] = oldStatus,
                        ["NewStatus"] = "Verified"
                    });

                verified++;
                verifiedRegs.Add(reg);
            }
            catch
            {
                failures++;
            }
        }

        // Phase 2: Send grouped emails (one per account)
        if (template != null && verifiedRegs.Count > 0)
        {
            var accountGroups = verifiedRegs.GroupBy(r => r.CreatorUserId).ToList();
            bulkTotal = accountGroups.Count;
            bulkProgress = 0;
            bulkPhaseMessage = $"Sending email 0 of {bulkTotal} accounts...";
            StateHasChanged();

            foreach (var group in accountGroups)
            {
                bulkProgress++;
                bulkPhaseMessage = $"Sending email {bulkProgress} of {bulkTotal} accounts...";
                StateHasChanged();

                try
                {
                    var user = await UserService.GetByObjectIdentifierAsync(group.Key);
                    if (user == null || string.IsNullOrWhiteSpace(user.Email))
                        continue;

                    var participants = group.Select(r => new ParticipantRow(
                        r.Cid ?? "N/A",
                        r.PersonalInfo.FullName,
                        GetDivisionName(r),
                        GetCategoryName(r),
                        r.CompetitionSelection.PortionChoice?.ToString()
                    )).ToList();

                    var (htmlPlaceholders, plainTextPlaceholders) = EmailTemplateService.BuildAccountPlaceholders(
                        user.DisplayName,
                        EmailOptions.SiteUrl,
                        participants);

                    var (subject, plainText, html) = EmailTemplateService.RenderTemplate(template, htmlPlaceholders, plainTextPlaceholders);
                    var sent = await EmailService.SendEmailAsync(user.Email, user.DisplayName, subject, plainText, html);

                    if (sent)
                    {
                        emailsSent++;
                        accountCount++;
                        // Log audit for each registration in this account group
                        foreach (var reg in group)
                        {
                            await AuditService.LogEmailSentAsync(
                                "Registration", reg.Id, user.Email,
                                template.Name,
                                $"{reg.PersonalInfo.FullName} ({reg.Cid})");
                        }
                    }
                }
                catch { /* email is fire-and-forget */ }
            }
        }

        isBulkProcessing = false;
        showBulkVerifyModal = false;

        selectedIds.Clear();
        allFilteredSelected = false;
        RebuildFilteredData();

        bulkResultMessage = $"✓ {verified} verified";
        if (template != null) bulkResultMessage += $"\n✉ {emailsSent} emails sent to {accountCount} accounts";
        if (failures > 0) bulkResultMessage += $"\n✗ {failures} failed";

        showBulkResultsModal = true;
        StateHasChanged();
    }

