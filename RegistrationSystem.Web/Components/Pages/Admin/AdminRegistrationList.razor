@page "/admin/registrations"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Messaging
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Application.Users
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Messaging
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject IRegistrationRepository RegistrationRepository
@inject SettingsService SettingsService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject EmailTemplateService EmailTemplateService
@inject IEmailService EmailService
@inject UserService UserService
@inject EmailOptions EmailOptions
@inject IJSRuntime JS

<PageTitle>Registration List</PageTitle>

<div class="max-w-[1800px] mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Registration List</h1>
            <p class="text-sm text-slate-500 mt-1">@settings?.CompetitionInfo?.CompetitionName — @competitionYear</p>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-6 overflow-hidden">
        <div class="bg-slate-800 px-3 md:px-5 py-3 space-y-3 md:space-y-0">
            <div class="flex flex-wrap items-center gap-2 md:gap-4">
                <!-- Status Filter: two groups — active pipeline statuses and "not continuing".
                     On mobile each group stretches full-width with evenly distributed buttons. -->
                <div class="flex flex-wrap items-center gap-1.5 md:gap-2 w-full md:w-auto">
                    <span class="text-xs font-medium text-slate-300 uppercase tracking-wide hidden md:inline">Status</span>
                    <!-- Active pipeline: Awaiting → Pending → Reviewed → Verified -->
                    <div class="flex w-full md:w-auto rounded-lg overflow-hidden border border-slate-600 divide-x divide-slate-500">
                        @foreach (var status in activeStatuses)
                        {
                            <button type="button"
                                    @onclick="() => ToggleStatusFilter(status)"
                                    class="flex-1 md:flex-none px-2 md:px-3 py-1.5 text-[10px] md:text-xs font-medium whitespace-nowrap transition-colors cursor-pointer text-center @(selectedStatuses.Contains(status) ? "bg-cyan-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500")">
                                @StatusBadge.GetShortName(status)
                            </button>
                        }
                    </div>
                    <!-- Not continuing: Withdrawn, Disqualified -->
                    <div class="flex w-full md:w-auto rounded-lg overflow-hidden border border-slate-600 divide-x divide-slate-500">
                        @foreach (var status in inactiveStatuses)
                        {
                            <button type="button"
                                    @onclick="() => ToggleStatusFilter(status)"
                                    class="flex-1 md:flex-none px-2 md:px-3 py-1.5 text-[10px] md:text-xs font-medium whitespace-nowrap transition-colors cursor-pointer text-center @(selectedStatuses.Contains(status) ? "bg-amber-700 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500")">
                                @StatusBadge.GetShortName(status)
                            </button>
                        }
                    </div>
                </div>

                <!-- Desktop Dropdown Filters (hidden on mobile, display:contents on desktop) -->
                <div class="hidden md:contents">
                    <!-- Division Filter -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Division</span>
                        <select @bind="selectedDivisionId" @bind:after="OnDivisionChanged"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All Divisions</option>
                            @foreach (var division in divisions)
                            {
                                <option value="@division.Id">@division.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Category Filter -->
                    @if (!string.IsNullOrEmpty(selectedDivisionId))
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Category</span>
                            <select @bind="selectedCategoryId" @bind:after="OnFilterChanged"
                                    class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                                <option value="">All Categories</option>
                                @foreach (var category in availableCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Region Filter -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Region</span>
                        <select @bind="selectedRegion" @bind:after="OnFilterChanged"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All Regions</option>
                            <option value="MN">Minnesota</option>
                            <option value="OutOfState">Out of State</option>
                        </select>
                    </div>

                    <!-- Gender Filter -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Gender</span>
                        <select @bind="selectedGender" @bind:after="OnFilterChanged"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>

                    <!-- Niqab Bypass Filter -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Niqab</span>
                        <select @bind="selectedNiqabFilter" @bind:after="OnFilterChanged"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            <option value="Yes">Bypass Enabled</option>
                            <option value="No">No Bypass</option>
                        </select>
                    </div>
                </div>

                <!-- Mobile Filter Toggle Button -->
                <button type="button" @onclick="() => showMobileFilters = !showMobileFilters"
                        class="md:hidden px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-slate-300 text-xs font-medium transition-colors cursor-pointer flex items-center gap-1.5 hover:bg-slate-500">
                    @Icons.Filter("h-4 w-4")
                    Filters
                    @if (!string.IsNullOrEmpty(selectedDivisionId) || !string.IsNullOrEmpty(selectedRegion) || !string.IsNullOrEmpty(selectedGender) || !string.IsNullOrEmpty(selectedNiqabFilter))
                    {
                        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                    }
                </button>

                <!-- Search -->
                <div class="flex-1 min-w-[140px] md:min-w-[200px]">
                    <input type="text" @bind="searchQuery" @bind:event="oninput" @bind:after="OnFilterChanged"
                           placeholder="Search by name or CID..."
                           class="w-full px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white placeholder-slate-400 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" />
                </div>

                <!-- Fetch Button -->
                <button type="button" @onclick="FetchRegistrations" disabled="@isLoading"
                        class="px-4 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-500 text-white text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
                    @if (isLoading)
                    {
                        @Icons.Spinner("h-4 w-4")
                    }
                    else
                    {
                        @Icons.Refresh("h-4 w-4")
                    }
                    <span class="hidden md:inline">Fetch</span>
                </button>
            </div>

            <!-- Mobile Collapsible Filter Dropdowns -->
            @if (showMobileFilters)
            {
                <div class="md:hidden grid grid-cols-2 gap-2 pt-3 border-t border-slate-700">
                    <!-- Division -->
                    <div>
                        <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wide mb-1 block">Division</label>
                        <select @bind="selectedDivisionId" @bind:after="OnDivisionChanged"
                                class="w-full px-2 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            @foreach (var division in divisions)
                            {
                                <option value="@division.Id">@division.Name</option>
                            }
                        </select>
                    </div>
                    <!-- Region -->
                    <div>
                        <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wide mb-1 block">Region</label>
                        <select @bind="selectedRegion" @bind:after="OnFilterChanged"
                                class="w-full px-2 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            <option value="MN">Minnesota</option>
                            <option value="OutOfState">Out of State</option>
                        </select>
                    </div>
                    <!-- Gender -->
                    <div>
                        <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wide mb-1 block">Gender</label>
                        <select @bind="selectedGender" @bind:after="OnFilterChanged"
                                class="w-full px-2 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <!-- Niqab -->
                    <div>
                        <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wide mb-1 block">Niqab</label>
                        <select @bind="selectedNiqabFilter" @bind:after="OnFilterChanged"
                                class="w-full px-2 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All</option>
                            <option value="Yes">Bypass</option>
                            <option value="No">No Bypass</option>
                        </select>
                    </div>
                    <!-- Category (conditional, full width) -->
                    @if (!string.IsNullOrEmpty(selectedDivisionId))
                    {
                        <div class="col-span-2">
                            <label class="text-[10px] font-medium text-slate-400 uppercase tracking-wide mb-1 block">Category</label>
                            <select @bind="selectedCategoryId" @bind:after="OnFilterChanged"
                                    class="w-full px-2 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                                <option value="">All Categories</option>
                                @foreach (var category in availableCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Results Count Bar -->
        <div class="px-3 md:px-5 py-2.5 bg-slate-50 border-t border-slate-200 flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-sm">
            <span class="text-slate-600">
                Showing <span class="font-semibold text-slate-800">@filteredRegistrations.Count</span> of <span class="font-semibold text-slate-800">@registrations.Count</span> registrations
            </span>
            <div class="flex items-center gap-2 md:gap-3 flex-wrap">
                <!-- Status counts -->
                <div class="flex items-center gap-1.5 flex-wrap">
                    @foreach (var status in allStatuses)
                    {
                        var count = filteredRegistrations.Count(r => r.Status == status);
                        if (count > 0)
                        {
                            <span class="inline-flex items-center gap-1 px-1.5 md:px-2 py-0.5 rounded-md text-[10px] md:text-xs font-medium @StatusBadge.GetBgColor(status) text-white">
                                @count @StatusBadge.GetShortName(status)
                            </span>
                        }
                    }
                </div>
                <!-- Export All Filtered Button -->
                <button type="button" @onclick="ExportAllFiltered" disabled="@(filteredRegistrations.Count == 0)"
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg border border-slate-300 bg-white text-xs font-medium text-slate-600
                               hover:bg-slate-50 hover:border-slate-400 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                    @Icons.Download("h-3.5 w-3.5")
                    Export All
                </button>
            </div>
        </div>
    </div>

    @if (isInitialLoading)
    {
        <!-- Loading Screen -->
        <div class="flex flex-col items-center justify-center min-h-[60vh]">
            <div class="w-16 h-16 rounded-2xl bg-cyan-100 flex items-center justify-center mb-4">
                @Icons.Spinner("h-8 w-8 text-cyan-600")
            </div>
            <h2 class="text-lg font-semibold text-slate-800 mb-1">Loading Registrations</h2>
            <p class="text-sm text-slate-500">@loadingMessage</p>
        </div>
    }
    else if (registrations.Count == 0 && !isLoading)
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center mx-auto mb-5 shadow-lg">
                @Icons.Document("h-8 w-8 text-white")
            </div>
            <h3 class="text-xl font-semibold text-slate-800 mb-2">No Registrations Found</h3>
            <p class="text-slate-600">No registrations have been submitted for this competition year.</p>
        </div>
    }
    else if (filteredRegistrations.Count == 0)
    {
        <!-- No Results After Filtering -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm px-4 py-12 text-center">
            @Icons.Search("h-12 w-12 text-slate-300 mx-auto mb-3")
            <p class="text-slate-500">No registrations match your filters.</p>
        </div>
    }
    else
    {
        <!-- Bulk Action Bar (appears when items selected) -->
        @if (selectedIds.Count > 0)
        {
            <div class="mb-4 bg-white/95 backdrop-blur-sm border border-slate-200 rounded-xl shadow-lg px-3 md:px-5 py-3 sticky top-2 z-30">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 md:gap-0">
                    <div class="flex items-center gap-2 md:gap-3 flex-wrap">
                        <span class="text-sm font-semibold text-slate-800">
                            @if (allFilteredSelected)
                            {
                                @:All @filteredRegistrations.Count selected
                            }
                            else
                            {
                                @selectedIds.Count@: selected
                            }
                        </span>
                        @if (!allFilteredSelected && IsAllPageSelected && filteredRegistrations.Count > pagedRegistrations.Count)
                        {
                            <button type="button" @onclick="SelectAllFiltered"
                                    class="text-xs text-cyan-600 hover:text-cyan-700 font-medium cursor-pointer">
                                Select all @filteredRegistrations.Count
                            </button>
                        }
                        <button type="button" @onclick="ClearSelection"
                                class="text-xs text-slate-500 hover:text-slate-700 underline decoration-slate-300 cursor-pointer">
                            Clear
                        </button>
                    </div>
                    <div class="flex items-center gap-1.5 md:gap-2">
                        <!-- Bulk Verify -->
                        <button type="button" @onclick="OpenBulkVerifyModal"
                                disabled="@(!AllSelectedAreReviewed)"
                                title="@(AllSelectedAreReviewed ? "Verify selected" : "All selected must be Reviewed")"
                                class="inline-flex items-center gap-1.5 px-2.5 md:px-3.5 py-2 rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700
                                       text-white text-xs font-semibold shadow-sm hover:from-cyan-700 hover:to-cyan-800
                                       disabled:opacity-40 disabled:cursor-not-allowed transition-all cursor-pointer">
                            @Icons.CheckCircle("h-4 w-4")
                            <span class="hidden md:inline">Verify</span>
                        </button>

                        <!-- Bulk Send Email -->
                        <button type="button" @onclick="OpenBulkEmailModal"
                                class="inline-flex items-center gap-1.5 px-2.5 md:px-3.5 py-2 rounded-lg bg-gradient-to-r from-slate-600 to-slate-700
                                       text-white text-xs font-semibold shadow-sm hover:from-slate-700 hover:to-slate-800 transition-all cursor-pointer">
                            @Icons.Envelope("h-4 w-4")
                            <span class="hidden md:inline">Send Email</span>
                        </button>

                        <!-- Export Selected -->
                        <button type="button" @onclick="ExportSelected"
                                class="inline-flex items-center gap-1.5 px-2.5 md:px-3.5 py-2 rounded-lg border border-slate-300 bg-white
                                       text-slate-700 text-xs font-semibold hover:bg-slate-50 hover:border-slate-400 transition-colors cursor-pointer">
                            @Icons.Download("h-4 w-4")
                            <span class="hidden md:inline">Export</span>
                        </button>

                        <!-- Bulk Delete -->
                        <button type="button" @onclick="OpenBulkDeleteModal"
                                class="inline-flex items-center gap-1.5 px-2.5 md:px-3.5 py-2 rounded-lg border border-slate-300 bg-white
                                       text-red-600 text-xs font-semibold hover:bg-red-50 hover:border-red-300 transition-colors cursor-pointer">
                            @Icons.Trash("h-4 w-4")
                            <span class="hidden md:inline">Delete</span>
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- ═══════════════════════════════════════════════════════════════
             MOBILE CARD LIST (shown on mobile, hidden on md+)
             ═══════════════════════════════════════════════════════════════ -->
        <div class="md:hidden">
            <!-- Mobile Select All Bar -->
            <div class="flex items-center justify-between mb-2 px-1">
                <button type="button" @onclick="ToggleSelectAllPage"
                        class="flex items-center gap-2 text-xs font-medium text-slate-600 cursor-pointer hover:text-slate-800">
                    <span class="flex items-center justify-center w-5 h-5 rounded transition-all duration-150
                                 @(IsAllPageSelected
                                     ? "bg-cyan-500 border-cyan-500 shadow-sm shadow-cyan-500/30"
                                     : selectedIds.Count > 0
                                         ? "bg-transparent border-2 border-slate-300"
                                         : "bg-transparent border-2 border-slate-300 hover:border-slate-400")">
                        @if (IsAllPageSelected)
                        {
                            @Icons.Check("w-3.5 h-3.5 text-white")
                        }
                        else if (selectedIds.Count > 0)
                        {
                            <span class="w-2.5 h-0.5 bg-slate-400 rounded-full"></span>
                        }
                    </span>
                    Select all on page
                </button>
            </div>

            <!-- Mobile Cards -->
            <div class="space-y-2">
                @foreach (var reg in pagedRegistrations)
                {
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden @(selectedIds.Contains(reg.Id) ? "ring-2 ring-cyan-500/40" : "")">
                        <!-- Card Header: Checkbox + Name + CID + Status -->
                        <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-3 py-2.5">
                            <div class="flex items-center gap-2.5">
                                <!-- Selection checkbox -->
                                <button type="button" @onclick="() => ToggleSelection(reg.Id)"
                                        class="flex-shrink-0 flex items-center justify-center w-5 h-5 rounded transition-all duration-150 cursor-pointer
                                               @(selectedIds.Contains(reg.Id)
                                                   ? "bg-cyan-500 border-cyan-500 shadow-sm shadow-cyan-500/25"
                                                   : "bg-transparent border-2 border-slate-400 hover:border-slate-300")">
                                    @if (selectedIds.Contains(reg.Id))
                                    {
                                        @Icons.Check("w-3.5 h-3.5 text-white")
                                    }
                                </button>

                                <!-- Gender bar -->
                                <div class="w-1.5 h-8 rounded-full flex-shrink-0 @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-400" : "bg-pink-400")"></div>

                                <!-- Name + CID + Status -->
                                <div class="min-w-0 flex-1">
                                    <span class="font-semibold text-white truncate block text-sm">@reg.PersonalInfo.FullName</span>
                                    <div class="flex items-center gap-1.5 mt-0.5">
                                        @if (!string.IsNullOrEmpty(reg.Cid))
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-600 text-slate-300 text-[10px] font-mono">
                                                @reg.Cid
                                            </span>
                                        }
                                        <StatusBadge Status="reg.Status" Size="StatusBadge.StatusBadgeSize.Mini" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="px-3 py-2.5 space-y-1.5 text-sm">
                            <!-- Division / Category + Age -->
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <span class="font-medium text-slate-800">@GetDivisionName(reg)</span>
                                    <span class="text-slate-400 mx-1">/</span>
                                    <span class="text-slate-600">@GetCategoryName(reg)</span>
                                    @if (reg.CompetitionSelection.PortionChoice.HasValue)
                                    {
                                        <span class="text-xs text-slate-500 ml-1">@(reg.CompetitionSelection.PortionChoice == PortionChoice.Top ? "▲" : "▼")</span>
                                    }
                                </div>
                                <div class="text-xs text-slate-500 flex-shrink-0">
                                    @reg.PersonalInfo.Gender
                                    @if (settings != null)
                                    {
                                        <span class="text-slate-300 mx-0.5">·</span>
                                        <span class="text-cyan-600 font-medium">@(reg.CalculateAgeAsOf(settings.AgeCutoffDate))y</span>
                                    }
                                </div>
                            </div>

                            <!-- Location -->
                            @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                            {
                                <div class="text-xs text-slate-500">
                                    @reg.AddressInfo.City, @reg.AddressInfo.StateProvince
                                </div>
                            }

                            <!-- Flags -->
                            @if (reg.FileUploadInfo.NiqabBypassApproved || reg.FileUploadInfo.Video != null || !string.IsNullOrEmpty(reg.StatusComment))
                            {
                                <div class="flex items-center gap-1.5">
                                    @if (reg.FileUploadInfo.NiqabBypassApproved)
                                    {
                                        <span class="px-1.5 py-0.5 rounded bg-violet-100 text-violet-700 text-[10px] font-medium">Niqab</span>
                                    }
                                    @if (reg.FileUploadInfo.Video != null)
                                    {
                                        <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 text-[10px] font-medium">Video</span>
                                    }
                                    @if (!string.IsNullOrEmpty(reg.StatusComment))
                                    {
                                        <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 text-[10px] font-medium" title="@reg.StatusComment">Comment</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Card Footer: Actions -->
                        <div class="px-3 py-2 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <a href="/admin/registration/@reg.Id" target="_blank"
                                   class="inline-flex items-center gap-1 text-xs text-slate-600 font-medium hover:text-teal-600">
                                    @Icons.Eye("h-3.5 w-3.5")
                                    View
                                </a>
                                <a href="/admin/registration/@reg.Id/edit" target="_blank"
                                   class="inline-flex items-center gap-1 text-xs text-slate-600 font-medium hover:text-teal-600">
                                    @Icons.Edit("h-3.5 w-3.5")
                                    Edit
                                </a>
                                <a href="/admin/audit/Registration/@reg.Id" target="_blank"
                                   class="inline-flex items-center gap-1 text-xs text-slate-600 font-medium hover:text-teal-600">
                                    @Icons.Clock("h-3.5 w-3.5")
                                    Audit
                                </a>
                            </div>
                            <div class="flex items-center gap-3">
                                @if (reg.Status == RegistrationStatus.Withdrawn || reg.Status == RegistrationStatus.Disqualified)
                                {
                                    <button type="button" @onclick="() => OpenRevertModal(reg)"
                                            class="inline-flex items-center gap-1 text-xs text-amber-600 font-medium hover:text-amber-700 cursor-pointer">
                                        @Icons.ArrowUturnLeft("h-3.5 w-3.5")
                                        Revert
                                    </button>
                                }
                                <button type="button" @onclick="() => OpenDeleteModal(reg)"
                                        class="inline-flex items-center gap-1 text-xs text-red-500 font-medium hover:text-red-600 cursor-pointer">
                                    @Icons.Trash("h-3.5 w-3.5")
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Mobile Pagination -->
            @if (totalPages > 1)
            {
                <div class="mt-3 rounded-xl border border-slate-200 bg-white shadow-sm px-3 py-2.5 flex items-center justify-between">
                    <span class="text-xs text-slate-500">
                        @((currentPage - 1) * pageSize + 1)–@(Math.Min(currentPage * pageSize, filteredRegistrations.Count)) of @filteredRegistrations.Count
                    </span>
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)"
                                class="p-1.5 rounded hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            @Icons.Chevron("h-4 w-4 text-slate-600 rotate-180")
                        </button>
                        @foreach (var pg in GetPageNumbers())
                        {
                            var pageNum = pg;
                            <button type="button" @onclick="() => GoToPage(pageNum)"
                                    class="px-2.5 py-1 rounded text-xs font-medium transition-colors cursor-pointer @(pageNum == currentPage ? "bg-cyan-600 text-white" : "text-slate-600 hover:bg-slate-100")">
                                @pageNum
                            </button>
                        }
                        <button type="button" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)"
                                class="p-1.5 rounded hover:bg-slate-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            @Icons.Chevron("h-4 w-4 text-slate-600")
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             DESKTOP TABLE (hidden on mobile, shown on md+)
             ═══════════════════════════════════════════════════════════════ -->
        <!-- Table -->
        <div class="hidden md:block rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gradient-to-r from-slate-700 to-slate-800">
                            <!-- Select All Checkbox -->
                            <th class="px-3 py-3.5 w-10">
                                <button type="button" @onclick="ToggleSelectAllPage"
                                        class="flex items-center justify-center w-5 h-5 rounded transition-all duration-150 cursor-pointer
                                               @(IsAllPageSelected
                                                   ? "bg-cyan-500 border-cyan-500 shadow-sm shadow-cyan-500/30"
                                                   : selectedIds.Count > 0
                                                       ? "bg-transparent border-2 border-slate-400"
                                                       : "bg-transparent border-2 border-slate-400 hover:border-slate-300")">
                                    @if (IsAllPageSelected)
                                    {
                                        @Icons.Check("w-3.5 h-3.5 text-white")
                                    }
                                    else if (selectedIds.Count > 0)
                                    {
                                        <span class="w-2.5 h-0.5 bg-slate-400 rounded-full"></span>
                                    }
                                </button>
                            </th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Competitor</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">CID</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Division</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Category</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Location</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Status</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Flags</th>
                            <th class="text-center px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-32">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var reg in pagedRegistrations)
                        {
                            <tr class="hover:bg-slate-50 transition-colors @(selectedIds.Contains(reg.Id) ? "bg-cyan-50/40" : "")">
                                <!-- Checkbox -->
                                <td class="px-3 py-4">
                                    <button type="button" @onclick="() => ToggleSelection(reg.Id)"
                                            class="flex items-center justify-center w-5 h-5 rounded transition-all duration-150 cursor-pointer
                                                   @(selectedIds.Contains(reg.Id)
                                                       ? "bg-cyan-500 border-cyan-500 shadow-sm shadow-cyan-500/25"
                                                       : "bg-white border-2 border-slate-300 hover:border-cyan-400")">
                                        @if (selectedIds.Contains(reg.Id))
                                        {
                                            @Icons.Check("w-3.5 h-3.5 text-white")
                                        }
                                    </button>
                                </td>

                                <!-- Competitor: gender bar + name + gender/DOB/age -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-1.5 h-10 rounded-full flex-shrink-0 @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-500" : "bg-pink-500")"></div>
                                        <div class="min-w-0 flex-1">
                                            <span class="font-medium text-slate-800">
                                                @reg.PersonalInfo.FullName
                                            </span>
                                            <div class="text-xs text-slate-500 flex items-center gap-2">
                                                <span>@reg.PersonalInfo.Gender</span>
                                                <span class="text-slate-300">·</span>
                                                <span class="whitespace-nowrap">@reg.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")</span>
                                                @if (settings != null)
                                                {
                                                    <span class="text-slate-300">·</span>
                                                    <span class="text-cyan-600 font-medium whitespace-nowrap">@reg.CalculateAgeAsOf(settings.AgeCutoffDate) yrs</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- CID -->
                                <td class="px-4 py-4">
                                    @if (!string.IsNullOrEmpty(reg.Cid))
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-mono whitespace-nowrap">
                                            @reg.Cid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 text-sm">—</span>
                                    }
                                </td>

                                <!-- Division -->
                                <td class="px-4 py-4">
                                    <div class="text-sm font-medium text-slate-800">@GetDivisionName(reg)</div>
                                </td>

                                <!-- Category + Portion -->
                                <td class="px-4 py-4 whitespace-nowrap">
                                    <div class="text-sm">
                                        <div class="text-slate-700">@GetCategoryName(reg)</div>
                                        @if (reg.CompetitionSelection.PortionChoice.HasValue)
                                        {
                                            <div class="text-xs text-slate-500">@(reg.CompetitionSelection.PortionChoice == PortionChoice.Top ? "▲" : "▼") @reg.CompetitionSelection.PortionChoice</div>
                                        }
                                    </div>
                                </td>

                                <!-- Location -->
                                <td class="px-4 py-4">
                                    <div class="text-sm">
                                        @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                                        {
                                            <div class="text-slate-700">@reg.AddressInfo.City, @reg.AddressInfo.StateProvince</div>
                                            <div class="text-xs text-slate-500">@reg.AddressInfo.Country</div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">—</span>
                                        }
                                    </div>
                                </td>

                                <!-- Status -->
                                <td class="px-4 py-4">
                                    <StatusBadge Status="reg.Status" />
                                </td>

                                <!-- Flags -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-1.5">
                                        @if (reg.FileUploadInfo.NiqabBypassApproved)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-violet-100 text-violet-700 text-xs font-medium" title="Niqab Bypass Enabled">Niqab</span>
                                        }
                                        @if (reg.FileUploadInfo.Video != null)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 text-xs font-medium" title="Has Video">Video</span>
                                        }
                                        @if (!string.IsNullOrEmpty(reg.StatusComment))
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 text-xs font-medium" title="@reg.StatusComment">Comment</span>
                                        }
                                    </div>
                                </td>

                                <!-- Actions -->
                                <td class="px-4 py-4 whitespace-nowrap text-right">
                                    <div class="inline-flex items-center gap-1 justify-end">
                                        <a href="/admin/registration/@reg.Id" target="_blank"
                                           class="p-2 text-slate-400 hover:text-teal-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200"
                                           title="View Details">
                                            @Icons.Eye("h-4 w-4")
                                        </a>
                                        <a href="/admin/registration/@reg.Id/edit" target="_blank"
                                           class="p-2 text-slate-400 hover:text-teal-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200"
                                           title="Edit Registration">
                                            @Icons.Edit("h-4 w-4")
                                        </a>
                                        <a href="/admin/audit/Registration/@reg.Id" target="_blank"
                                           class="p-2 text-slate-400 hover:text-teal-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200"
                                           title="Audit Trail">
                                            @Icons.Clock("h-4 w-4")
                                        </a>
                                        @if (reg.Status == RegistrationStatus.Withdrawn || reg.Status == RegistrationStatus.Disqualified)
                                        {
                                            <button type="button" @onclick="() => OpenRevertModal(reg)"
                                                    class="p-2 text-slate-400 hover:text-amber-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200 cursor-pointer"
                                                    title="Revert Status">
                                                @Icons.ArrowUturnLeft("h-4 w-4")
                                            </button>
                                        }
                                        <button type="button" @onclick="() => OpenDeleteModal(reg)"
                                                class="p-2 text-slate-400 hover:text-red-500 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200 cursor-pointer"
                                                title="Delete Registration">
                                            @Icons.Trash("h-4 w-4")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="px-4 py-3 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="text-sm text-slate-500">
                        Showing @((currentPage - 1) * pageSize + 1)–@(Math.Min(currentPage * pageSize, filteredRegistrations.Count)) of @filteredRegistrations.Count
                    </div>
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="() => GoToPage(1)" disabled="@(currentPage == 1)"
                                class="px-2 py-1 rounded text-xs font-medium text-slate-600 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            First
                        </button>
                        <button type="button" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)"
                                class="p-1.5 rounded hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            @Icons.Chevron("h-4 w-4 text-slate-600 rotate-180")
                        </button>

                        @foreach (var pg in GetPageNumbers())
                        {
                            var pageNum = pg;
                            <button type="button" @onclick="() => GoToPage(pageNum)"
                                    class="px-3 py-1 rounded text-sm font-medium transition-colors cursor-pointer @(pageNum == currentPage ? "bg-cyan-600 text-white" : "text-slate-600 hover:bg-slate-200")">
                                @pageNum
                            </button>
                        }

                        <button type="button" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)"
                                class="p-1.5 rounded hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            @Icons.Chevron("h-4 w-4 text-slate-600")
                        </button>
                        <button type="button" @onclick="() => GoToPage(totalPages)" disabled="@(currentPage == totalPages)"
                                class="px-2 py-1 rounded text-xs font-medium text-slate-600 hover:bg-slate-200 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer">
                            Last
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     SINGLE DELETE MODAL
     ══════════════════════════════════════════════════════════════════════ -->
@if (deleteTarget != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/50 transition-opacity" @onclick="CloseDeleteModal"></div>

            <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl" @onclick:stopPropagation>
                <div class="px-6 py-5 border-b border-slate-200">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow">
                            @Icons.Trash("h-5 w-5 text-white")
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-slate-800">Delete Registration</h3>
                            <p class="text-sm text-slate-500">This action cannot be undone</p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-5 space-y-4">
                    <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 space-y-2">
                        <div class="flex justify-between">
                            <span class="text-sm text-slate-500">Competitor</span>
                            <span class="text-sm font-medium text-slate-800">@deleteTarget.PersonalInfo.FullName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(deleteTarget.Cid))
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">CID</span>
                                <span class="text-sm font-mono text-cyan-700">@deleteTarget.Cid</span>
                            </div>
                        }
                        <div class="flex justify-between">
                            <span class="text-sm text-slate-500">Division / Category</span>
                            <span class="text-sm font-medium text-slate-800">@GetDivisionName(deleteTarget) / @GetCategoryName(deleteTarget)</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-slate-500">Status</span>
                            <StatusBadge Status="deleteTarget.Status" />
                        </div>
                        @if (deleteTarget.FileUploadInfo.NiqabBypassApproved)
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">Niqab Bypass</span>
                                <span class="px-2 py-0.5 rounded bg-violet-100 text-violet-700 text-xs font-medium">Enabled</span>
                            </div>
                        }
                    </div>

                    <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                        <div class="flex items-start gap-3">
                            @Icons.Warning("h-5 w-5 text-amber-600 flex-shrink-0 mt-0.5")
                            <div class="flex-1">
                                <h4 class="text-sm font-semibold text-amber-800 mb-1">Audit Trail</h4>
                                @if (isLoadingAuditCount)
                                {
                                    <div class="flex items-center gap-2">
                                        @Icons.Spinner("h-4 w-4 text-amber-600")
                                        <span class="text-sm text-amber-700">Loading audit entries...</span>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-sm text-amber-700 mb-2">
                                        This registration has <span class="font-bold">@auditEntryCount audit entries</span>.
                                    </p>
                                    <a href="/admin/audit/Registration/@deleteTarget.Id" target="_blank"
                                       class="inline-flex items-center gap-1.5 text-sm text-amber-800 font-medium hover:text-amber-900 underline decoration-amber-400">
                                        @Icons.ExternalLink("h-3.5 w-3.5")
                                        View full audit trail
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <label class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                        <input type="checkbox" @bind="deleteAuditTrail"
                               class="mt-0.5 w-4 h-4 rounded border-slate-300 text-red-600 focus:ring-red-500 cursor-pointer" />
                        <div>
                            <span class="text-sm font-medium text-slate-800">Also delete all audit trail entries</span>
                            <p class="text-xs text-slate-500 mt-0.5">
                                Permanently removes @auditEntryCount audit log entries associated with this registration.
                                This data cannot be recovered.
                            </p>
                        </div>
                    </label>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">
                            Type <span class="font-bold text-red-600">DELETE</span> to confirm
                        </label>
                        <input type="text" @bind="deleteConfirmation" @bind:event="oninput"
                               placeholder="Type DELETE here"
                               class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm" />
                    </div>
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-2xl">
                    <button type="button" @onclick="CloseDeleteModal"
                            class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                        Cancel
                    </button>
                    <button type="button" @onclick="ExecuteDelete"
                            disabled="@(deleteConfirmation != "DELETE" || isDeleting)"
                            class="cursor-pointer rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-red-700 hover:to-red-800 disabled:opacity-50 transition-all flex items-center gap-2">
                        @if (isDeleting)
                        {
                            @Icons.Spinner("h-4 w-4")
                            <span>Deleting...</span>
                        }
                        else
                        {
                            @Icons.Trash("h-4 w-4")
                            <span>Delete Registration</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════════════
     REVERT STATUS MODAL
     ══════════════════════════════════════════════════════════════════════ -->
@if (revertTarget != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/50 transition-opacity" @onclick="CloseRevertModal"></div>

            <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl" @onclick:stopPropagation>
                <div class="px-6 py-5 border-b border-slate-200">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow">
                            @Icons.ArrowUturnLeft("h-5 w-5 text-white")
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-slate-800">Revert Status</h3>
                            <p class="text-sm text-slate-500">Restore this registration to an active status</p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-5 space-y-4">
                    <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 space-y-2">
                        <div class="flex justify-between">
                            <span class="text-sm text-slate-500">Competitor</span>
                            <span class="text-sm font-medium text-slate-800">@revertTarget.PersonalInfo.FullName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(revertTarget.Cid))
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-slate-500">CID</span>
                                <span class="text-sm font-mono text-cyan-700">@revertTarget.Cid</span>
                            </div>
                        }
                        <div class="flex justify-between">
                            <span class="text-sm text-slate-500">Division / Category</span>
                            <span class="text-sm font-medium text-slate-800">@GetDivisionName(revertTarget) / @GetCategoryName(revertTarget)</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-sm text-slate-500">Current Status</span>
                            <StatusBadge Status="revertTarget.Status" />
                        </div>
                    </div>

                    @if (isLoadingPreviousStatus)
                    {
                        <div class="flex items-center gap-2 py-2">
                            @Icons.Spinner("h-4 w-4 text-amber-600")
                            <span class="text-sm text-slate-600">Looking up previous status...</span>
                        </div>
                    }
                    else if (!revertPreviousStatusFound)
                    {
                        <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                            <div class="flex items-start gap-3">
                                @Icons.Warning("h-5 w-5 text-red-500 flex-shrink-0 mt-0.5")
                                <p class="text-sm text-red-700">
                                    Could not determine the previous status from the audit trail.
                                    This registration cannot be reverted automatically.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-medium text-amber-800">Will revert to</span>
                                <StatusBadge Status="revertTargetStatus" />
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label class="block text-xs font-medium text-slate-500 uppercase tracking-wide">Quick reasons</label>
                            @foreach (var preset in revertPresets)
                            {
                                <button type="button" @onclick="() => revertReason = preset"
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-amber-200 bg-amber-50 hover:bg-amber-100 text-left text-[11px] leading-tight text-amber-800 transition-colors cursor-pointer">
                                    @preset
                                </button>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">
                                Reason for reverting <span class="text-red-500">*</span>
                            </label>
                            <textarea @bind="revertReason" @bind:event="oninput"
                                      rows="3"
                                      placeholder="Select a quick reason above or type your own..."
                                      class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 text-sm resize-none"></textarea>
                            @if (string.IsNullOrWhiteSpace(revertReason))
                            {
                                <p class="text-xs text-slate-400 mt-1">A reason is required for the audit trail.</p>
                            }
                        </div>
                    }
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-2xl">
                    <button type="button" @onclick="CloseRevertModal"
