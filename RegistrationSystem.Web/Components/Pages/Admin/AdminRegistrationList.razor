    {
        if (bulkDeleteConfirmation != "DELETE") return;

        isBulkProcessing = true;
        var selected = GetSelectedRegistrations();
        bulkTotal = selected.Count;
        bulkProgress = 0;
        StateHasChanged();

        int deleted = 0, failures = 0;

        await AuditContextProvider.SetCurrentUserContextAsync();

        foreach (var reg in selected)
        {
            try
            {
                bulkProgress++;
                StateHasChanged();

                var name = reg.PersonalInfo.FullName;
                var cid = reg.Cid ?? "N/A";

                await AuditService.LogAsync(
                    AuditAction.Deleted,
                    "Registration",
                    reg.Id,
                    summary: $"Bulk deleted registration for {name} ({cid})",
