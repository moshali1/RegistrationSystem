    }

    private async Task ExecuteBulkEmail()
    {
        if (string.IsNullOrEmpty(bulkEmailTemplateId)) return;

        isBulkProcessing = true;
        var selected = GetSelectedRegistrations();

        var template = await EmailTemplateService.GetByIdAsync(bulkEmailTemplateId);
        if (template == null)
        {
            errorMessage = "Template not found.";
            isBulkProcessing = false;
            showBulkEmailModal = false;
            return;
        }

        // Group by account
        var accountGroups = selected.GroupBy(r => r.CreatorUserId).ToList();
        bulkTotal = accountGroups.Count;
        bulkProgress = 0;
        bulkPhaseMessage = $"Sending email 0 of {bulkTotal} accounts...";
        StateHasChanged();

        int emailsSent = 0, failures = 0;

        await AuditContextProvider.SetCurrentUserContextAsync();

        foreach (var group in accountGroups)
        {
            bulkProgress++;
            bulkPhaseMessage = $"Sending email {bulkProgress} of {bulkTotal} accounts...";
            StateHasChanged();

            try
            {
                var user = await UserService.GetByObjectIdentifierAsync(group.Key);
                if (user == null || string.IsNullOrWhiteSpace(user.Email))
                {
                    failures++;
                    continue;
                }

                var participants = group.Select(r => new ParticipantRow(
                    r.Cid ?? "N/A",
                    r.PersonalInfo.FullName,
                    GetDivisionName(r),
                    GetCategoryName(r),
                    r.CompetitionSelection.PortionChoice?.ToString()
                )).ToList();

                var (htmlPlaceholders, plainTextPlaceholders) = EmailTemplateService.BuildAccountPlaceholders(
                    user.DisplayName,
                    EmailOptions.SiteUrl,
                    participants);

                var (subject, plainText, html) = EmailTemplateService.RenderTemplate(template, htmlPlaceholders, plainTextPlaceholders);
                var sent = await EmailService.SendEmailAsync(user.Email, user.DisplayName, subject, plainText, html);

                if (sent)
                {
                    emailsSent++;
                    foreach (var reg in group)
                    {
                        await AuditService.LogEmailSentAsync(
                            "Registration", reg.Id, user.Email,
                            template.Name,
                            $"{reg.PersonalInfo.FullName} ({reg.Cid})");
                    }
                }
                else
                {
                    failures++;
                }
            }
            catch
            {
                failures++;
            }
        }

        isBulkProcessing = false;
        showBulkEmailModal = false;

        bulkResultMessage = $"✉ {emailsSent} emails sent to {emailsSent} accounts ({selected.Count} registrations)";
        if (failures > 0) bulkResultMessage += $"\n✗ {failures} failed (no email on account or send error)";

        showBulkResultsModal = true;
        selectedIds.Clear();
        allFilteredSelected = false;
        StateHasChanged();
    }

