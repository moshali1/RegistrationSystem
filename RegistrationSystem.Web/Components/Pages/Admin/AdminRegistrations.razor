@page "/admin/registrations"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject IRegistrationRepository RegistrationRepository
@inject SettingsService SettingsService
@inject NavigationManager NavigationManager

<PageTitle>All Registrations</PageTitle>

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div class="flex items-center gap-4">
            <a href="/admin" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors">
                <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-slate-800">All Registrations</h1>
                <p class="text-sm text-slate-500 mt-0.5">@settings?.CompetitionInfo?.CompetitionName — @competitionYear</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button @onclick="ExportToExcel"
                    disabled="@(!filteredRegistrations.Any())"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-2.5 text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Export
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
                <span class="text-sm text-slate-500">Loading registrations...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-6">
            <!-- Total -->
            <button @onclick="ClearFilters" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-slate-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@allRegistrations.Count</p>
                        <p class="text-xs text-slate-500">Total</p>
                    </div>
                </div>
            </button>

            <!-- Awaiting Review -->
            <button @onclick="@(() => QuickFilter(RegistrationStatus.AwaitingReview))" class="rounded-xl border @(selectedStatus == RegistrationStatus.AwaitingReview.ToString() ? "border-amber-300 bg-amber-50" : "border-slate-200 bg-white") p-4 shadow-sm hover:border-amber-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@GetStatusCount(RegistrationStatus.AwaitingReview)</p>
                        <p class="text-xs text-amber-600">Awaiting</p>
                    </div>
                </div>
            </button>

            <!-- Pending -->
            <button @onclick="@(() => QuickFilter(RegistrationStatus.Pending))" class="rounded-xl border @(selectedStatus == RegistrationStatus.Pending.ToString() ? "border-cyan-300 bg-cyan-50" : "border-slate-200 bg-white") p-4 shadow-sm hover:border-cyan-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-cyan-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@GetStatusCount(RegistrationStatus.Pending)</p>
                        <p class="text-xs text-cyan-600">Pending</p>
                    </div>
                </div>
            </button>

            <!-- Reviewed -->
            <button @onclick="@(() => QuickFilter(RegistrationStatus.Reviewed))" class="rounded-xl border @(selectedStatus == RegistrationStatus.Reviewed.ToString() ? "border-emerald-300 bg-emerald-50" : "border-slate-200 bg-white") p-4 shadow-sm hover:border-emerald-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@GetStatusCount(RegistrationStatus.Reviewed)</p>
                        <p class="text-xs text-emerald-600">Reviewed</p>
                    </div>
                </div>
            </button>

            <!-- Verified -->
            <button @onclick="@(() => QuickFilter(RegistrationStatus.Verified))" class="rounded-xl border @(selectedStatus == RegistrationStatus.Verified.ToString() ? "border-emerald-300 bg-emerald-50" : "border-slate-200 bg-white") p-4 shadow-sm hover:border-emerald-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@GetStatusCount(RegistrationStatus.Verified)</p>
                        <p class="text-xs text-emerald-600">Verified</p>
                    </div>
                </div>
            </button>

            <!-- Issues (Withdrawn + Disqualified) -->
            <button @onclick="FilterIssues" class="rounded-xl border @(showIssuesOnly ? "border-rose-300 bg-rose-50" : "border-slate-200 bg-white") p-4 shadow-sm hover:border-rose-300 transition-all text-left cursor-pointer">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@GetIssuesCount()</p>
                        <p class="text-xs text-rose-600">Issues</p>
                    </div>
                </div>
            </button>
        </div>

        <!-- Filters & Search Bar -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-4 overflow-hidden">
            <div class="p-4">
                <div class="flex flex-col lg:flex-row gap-4">
                    <!-- Search -->
                    <div class="flex-1 lg:max-w-md">
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   placeholder="Search by name, CID, or city..."
                                   class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="flex flex-wrap gap-3">
                        <!-- Status Filter -->
                        <select @bind="selectedStatus" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Statuses</option>
                            @foreach (RegistrationStatus status in Enum.GetValues<RegistrationStatus>())
                            {
                                <option value="@status">@GetStatusDisplayName(status)</option>
                            }
                        </select>

                        <!-- Division Filter -->
                        <select @bind="selectedDivision" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Divisions</option>
                            @foreach (var division in availableDivisions)
                            {
                                <option value="@division.Id">@division.Name</option>
                            }
                        </select>

                        <!-- Category Filter -->
                        <select @bind="selectedCategory"
                                disabled="@string.IsNullOrEmpty(selectedDivision)"
                                class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 disabled:opacity-50 disabled:cursor-not-allowed">
                            <option value="">All Categories</option>
                            @foreach (var category in GetCategoriesForDivision())
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>

                        <!-- Gender Filter -->
                        <select @bind="selectedGender" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Genders</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>

                        <!-- Date Range Filter -->
                        <select @bind="selectedDateRange" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="all">All Time</option>
                            <option value="today">Today</option>
                            <option value="week">This Week</option>
                            <option value="month">This Month</option>
                        </select>

                        @if (HasActiveFilters())
                        {
                            <button type="button" @onclick="ClearFilters" class="cursor-pointer text-sm text-slate-500 hover:text-slate-700 px-3 py-2.5 flex items-center gap-1">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Clear
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Results Count -->
            <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-sm">
                <span class="text-slate-600">
                    Showing <span class="font-semibold text-slate-800">@filteredRegistrations.Count</span> of <span class="font-semibold text-slate-800">@allRegistrations.Count</span> registrations
                </span>
                @if (selectedIds.Any())
                {
                    <span class="text-cyan-600 font-medium">@selectedIds.Count selected</span>
                }
            </div>
        </div>

        <!-- Bulk Actions Bar -->
        @if (selectedIds.Any())
        {
            <div class="rounded-xl border border-cyan-200 bg-cyan-50 shadow-sm mb-4 p-4">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-cyan-100 flex items-center justify-center">
                            <span class="text-cyan-700 font-bold text-sm">@selectedIds.Count</span>
                        </div>
                        <span class="text-sm text-slate-700">registrations selected</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button @onclick="BulkUpdateStatus" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white border border-slate-300 text-slate-700 text-sm font-medium hover:bg-slate-50 transition-colors">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                            Update Status
                        </button>
                        <button @onclick="ClearSelection" class="px-4 py-2 rounded-lg text-slate-500 text-sm hover:text-slate-700 transition-colors">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        }

        <!-- Registrations Table -->
        @if (!filteredRegistrations.Any())
        {
            <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-5">
                    <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h2 class="text-xl font-semibold text-slate-800 mb-2">No Registrations Found</h2>
                <p class="text-slate-600 max-w-md mx-auto">Try adjusting your filters or search query.</p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
                                <th class="text-left px-4 py-3 w-10">
                                    <input type="checkbox"
                                           checked="@IsAllSelected()"
                                           @onchange="ToggleSelectAll"
                                           class="w-4 h-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" />
                                </th>
                                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider cursor-pointer hover:text-slate-800" @onclick="@(() => SortBy("name"))">
                                    <div class="flex items-center gap-1">
                                        Competitor
                                        @if (sortColumn == "name")
                                        {
                                            <svg class="h-4 w-4 @(sortAscending ? "" : "rotate-180")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                            </svg>
                                        }
                                    </div>
                                </th>
                                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Competition</th>
                                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Location</th>
                                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider cursor-pointer hover:text-slate-800" @onclick="@(() => SortBy("status"))">
                                    <div class="flex items-center gap-1">
                                        Status
                                        @if (sortColumn == "status")
                                        {
                                            <svg class="h-4 w-4 @(sortAscending ? "" : "rotate-180")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                            </svg>
                                        }
                                    </div>
                                </th>
                                <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider cursor-pointer hover:text-slate-800" @onclick="@(() => SortBy("date"))">
                                    <div class="flex items-center gap-1">
                                        Submitted
                                        @if (sortColumn == "date")
                                        {
                                            <svg class="h-4 w-4 @(sortAscending ? "" : "rotate-180")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                                            </svg>
                                        }
                                    </div>
                                </th>
                                <th class="text-right px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var reg in GetPaginatedRegistrations())
                            {
                                var division = settings?.FindDivision(reg.CompetitionSelection.DivisionId);
                                var category = division?.FindCategory(reg.CompetitionSelection.CategoryId);
                                var isSelected = selectedIds.Contains(reg.Id);

                                <tr class="hover:bg-slate-50 transition-colors @(isSelected ? "bg-cyan-50/50" : "")">
                                    <!-- Checkbox -->
                                    <td class="px-4 py-4">
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               @onchange="@(() => ToggleSelection(reg.Id))"
                                               class="w-4 h-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" />
                                    </td>

                                    <!-- Competitor -->
                                    <td class="px-4 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-1.5 h-10 rounded-full @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-500" : "bg-pink-500")"></div>
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <span class="font-medium text-slate-800">@reg.PersonalInfo.FullName</span>
                                                    @if (!string.IsNullOrEmpty(reg.Cid))
                                                    {
                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-mono">@reg.Cid</span>
                                                    }
                                                </div>
                                                <div class="text-xs text-slate-500 flex items-center gap-2">
                                                    <span>@reg.PersonalInfo.Gender</span>
                                                    <span class="text-slate-300">•</span>
                                                    <span>@reg.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")</span>
                                                    @if (settings != null)
                                                    {
                                                        <span class="text-slate-300">•</span>
                                                        <span class="text-cyan-600 font-medium">@reg.CalculateAgeAsOf(settings.AgeCutoffDate) yrs</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Competition -->
                                    <td class="px-4 py-4">
                                        <div class="text-sm">
                                            <div class="font-medium text-slate-800">@(division?.Name ?? "—")</div>
                                            <div class="text-xs text-slate-500">@(category?.Name ?? "—")</div>
                                        </div>
                                    </td>

                                    <!-- Location -->
                                    <td class="px-4 py-4">
                                        <div class="text-sm">
                                            @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                                            {
                                                <div class="text-slate-700">@reg.AddressInfo.City, @reg.AddressInfo.StateProvince</div>
                                                <div class="text-xs text-slate-500">@reg.AddressInfo.Country</div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">—</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Status -->
                                    <td class="px-4 py-4">
                                        @RenderStatusBadge(reg.Status)
                                    </td>

                                    <!-- Submitted -->
                                    <td class="px-4 py-4">
                                        <div class="text-sm text-slate-600">
                                            @if (reg.SubmittedAt.HasValue)
                                            {
                                                <div>@reg.SubmittedAt.Value.ToString("MMM d, yyyy")</div>
                                                <div class="text-xs text-slate-400">@reg.SubmittedAt.Value.ToString("h:mm tt")</div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">—</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Actions -->
                                    <td class="px-4 py-4">
                                        <div class="flex items-center justify-end gap-1">
                                            <a href="/admin/registration/@reg.Id"
                                               class="p-2 rounded-lg text-slate-400 hover:text-cyan-600 hover:bg-cyan-50 transition-colors"
                                               title="View Details">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                            </a>
                                            <a href="/admin/registration/@reg.Id/edit"
                                               class="p-2 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                               title="Edit">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </a>
                                            <button @onclick="@(() => ConfirmDelete(reg))"
                                                    @onclick:stopPropagation="true"
                                                    class="p-2 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
                                                    title="Delete">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <p class="text-sm text-slate-600">
                            Page <span class="font-medium">@currentPage</span> of <span class="font-medium">@totalPages</span>
                        </p>
                        <div class="flex items-center gap-1">
                            <button @onclick="PreviousPage"
                                    disabled="@(currentPage <= 1)"
                                    class="p-2 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                            </button>

                            @foreach (var pageNum in GetPageNumbers())
                            {
                                if (pageNum == -1)
                                {
                                    <span class="px-2 text-slate-400">...</span>
                                }
                                else
                                {
                                    <button @onclick="@(() => GoToPage(pageNum))"
                                            class="w-9 h-9 rounded-lg text-sm font-medium transition-colors @(pageNum == currentPage ? "bg-cyan-600 text-white" : "border border-slate-300 bg-white text-slate-600 hover:bg-slate-50")">
                                        @pageNum
                                    </button>
                                }
                            }

                            <button @onclick="NextPage"
                                    disabled="@(currentPage >= totalPages)"
                                    class="p-2 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && registrationToDelete != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="fixed inset-0 bg-black/50" @onclick="CancelDelete"></div>
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-md rounded-2xl bg-white shadow-xl overflow-hidden">
                <!-- Modal Header -->
                <div class="bg-rose-50 px-6 py-5 border-b border-rose-100">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-rose-100 flex items-center justify-center">
                            <svg class="h-6 w-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-slate-800">Delete Registration</h3>
                            <p class="text-sm text-slate-500">This action cannot be undone</p>
                        </div>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="px-6 py-5">
                    <p class="text-slate-600 mb-4">
                        Are you sure you want to permanently delete this registration?
                    </p>
                    <div class="rounded-xl bg-slate-50 border border-slate-200 p-4">
                        <p class="font-medium text-slate-800">@registrationToDelete.PersonalInfo.FullName</p>
                        <p class="text-sm text-slate-500 mt-1">
                            @GetDivisionName(registrationToDelete.CompetitionSelection.DivisionId) •
                            @GetCategoryName(registrationToDelete.CompetitionSelection.DivisionId, registrationToDelete.CompetitionSelection.CategoryId)
                        </p>
                    </div>

                    <div class="mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200">
                        <p class="text-sm text-amber-800">
                            <strong>Note:</strong> All associated files (ID, photo, video) will also be deleted from storage.
                        </p>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3">
                    <button @onclick="CancelDelete"
                            class="px-5 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-slate-800 transition-colors">
                        Cancel
                    </button>
                    <button @onclick="ExecuteDelete"
                            disabled="@isDeleting"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-rose-600 text-white text-sm font-medium hover:bg-rose-700 transition-colors disabled:opacity-50">
                        @if (isDeleting)
                        {
                            <div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            <span>Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private bool showIssuesOnly = false;

    private CompetitionSettings? settings;
    private int competitionYear;
    private List<Registration> allRegistrations = new();
    private List<Division> availableDivisions = new();

    // Filters
    private string searchQuery = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedDivision = string.Empty;
    private string selectedCategory = string.Empty;
    private string selectedGender = string.Empty;
    private string selectedDateRange = "all";

    // Sorting
    private string sortColumn = "date";
    private bool sortAscending = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages => (int)Math.Ceiling(filteredRegistrations.Count / (double)pageSize);

    // Selection
    private HashSet<string> selectedIds = new();

    // Delete
    private Registration? registrationToDelete;

    private List<Registration> filteredRegistrations => GetFilteredRegistrations();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            settings = await SettingsService.GetSettingsAsync();
            competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

            if (settings?.Divisions != null)
            {
                availableDivisions = settings.Divisions.ToList();
            }

            allRegistrations = (await RegistrationService.GetAllByYearAsync(competitionYear)).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<Registration> GetFilteredRegistrations()
    {
        var query = allRegistrations.AsEnumerable();

        // Search
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var search = searchQuery.ToLowerInvariant();
            query = query.Where(r =>
                r.PersonalInfo.FullName.ToLowerInvariant().Contains(search) ||
                (r.Cid?.ToLowerInvariant().Contains(search) ?? false) ||
                (r.AddressInfo.City?.ToLowerInvariant().Contains(search) ?? false));
        }

        // Issues filter
        if (showIssuesOnly)
        {
            query = query.Where(r => r.Status == RegistrationStatus.Withdrawn || r.Status == RegistrationStatus.Disqualified);
        }
        // Status
        else if (!string.IsNullOrEmpty(selectedStatus) && Enum.TryParse<RegistrationStatus>(selectedStatus, out var status))
        {
            query = query.Where(r => r.Status == status);
        }

        // Division
        if (!string.IsNullOrEmpty(selectedDivision))
        {
            query = query.Where(r => r.CompetitionSelection.DivisionId == selectedDivision);
        }

        // Category
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            query = query.Where(r => r.CompetitionSelection.CategoryId == selectedCategory);
        }

        // Gender
        if (!string.IsNullOrEmpty(selectedGender) && Enum.TryParse<Gender>(selectedGender, out var gender))
        {
            query = query.Where(r => r.PersonalInfo.Gender == gender);
        }

        // Date Range
        var now = DateTime.UtcNow;
        query = selectedDateRange switch
        {
            "today" => query.Where(r => r.SubmittedAt?.Date == now.Date),
            "week" => query.Where(r => r.SubmittedAt >= now.AddDays(-7)),
            "month" => query.Where(r => r.SubmittedAt >= now.AddDays(-30)),
            _ => query
        };

        // Sorting
        query = sortColumn switch
        {
            "name" => sortAscending
                ? query.OrderBy(r => r.PersonalInfo.FullName)
                : query.OrderByDescending(r => r.PersonalInfo.FullName),
            "status" => sortAscending
                ? query.OrderBy(r => r.Status)
                : query.OrderByDescending(r => r.Status),
            "date" => sortAscending
                ? query.OrderBy(r => r.SubmittedAt)
                : query.OrderByDescending(r => r.SubmittedAt),
            _ => query.OrderByDescending(r => r.SubmittedAt)
        };

        return query.ToList();
    }

    private IEnumerable<Registration> GetPaginatedRegistrations()
    {
        return filteredRegistrations
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        selectedStatus = string.Empty;
        selectedDivision = string.Empty;
        selectedCategory = string.Empty;
        selectedGender = string.Empty;
        selectedDateRange = "all";
        showIssuesOnly = false;
        currentPage = 1;
    }

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(searchQuery) ||
        !string.IsNullOrEmpty(selectedStatus) ||
        !string.IsNullOrEmpty(selectedDivision) ||
        !string.IsNullOrEmpty(selectedCategory) ||
        !string.IsNullOrEmpty(selectedGender) ||
        selectedDateRange != "all" ||
        showIssuesOnly;

    private void QuickFilter(RegistrationStatus status)
    {
        showIssuesOnly = false;
        selectedStatus = status.ToString();
        currentPage = 1;
    }

    private void FilterIssues()
    {
        selectedStatus = string.Empty;
        showIssuesOnly = !showIssuesOnly;
        currentPage = 1;
    }

    private IEnumerable<Category> GetCategoriesForDivision()
    {
        if (string.IsNullOrEmpty(selectedDivision)) return Enumerable.Empty<Category>();
        var division = availableDivisions.FirstOrDefault(d => d.Id == selectedDivision);
        return division?.Categories ?? Enumerable.Empty<Category>();
    }

    // Stats
    private int GetStatusCount(RegistrationStatus status) =>
        allRegistrations.Count(r => r.Status == status);

    private int GetIssuesCount() =>
        allRegistrations.Count(r => r.Status == RegistrationStatus.Withdrawn || r.Status == RegistrationStatus.Disqualified);

    // Selection
    private void ToggleSelection(string id)
    {
        if (!selectedIds.Add(id))
            selectedIds.Remove(id);
    }

    private void ToggleSelectAll()
    {
        if (IsAllSelected())
            selectedIds.Clear();
        else
            selectedIds = filteredRegistrations.Select(r => r.Id).ToHashSet();
    }

    private bool IsAllSelected() =>
        filteredRegistrations.Any() && filteredRegistrations.All(r => selectedIds.Contains(r.Id));

    private void ClearSelection() => selectedIds.Clear();

    private async Task BulkUpdateStatus()
    {
        // TODO: Implement bulk status update
        await Task.CompletedTask;
    }

    // Pagination
    private void GoToPage(int pageNum) => currentPage = pageNum;
    private void PreviousPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private IEnumerable<int> GetPageNumbers()
    {
        var pages = new List<int>();

        if (totalPages <= 7)
        {
            for (var i = 1; i <= totalPages; i++)
                pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1);

            var start = Math.Max(2, currentPage - 1);
            var end = Math.Min(totalPages - 1, currentPage + 1);

            for (var i = start; i <= end; i++)
                pages.Add(i);

            if (currentPage < totalPages - 2) pages.Add(-1);
            pages.Add(totalPages);
        }

        return pages;
    }

    // Delete
    private void ConfirmDelete(Registration registration)
    {
        registrationToDelete = registration;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        registrationToDelete = null;
        showDeleteModal = false;
    }

    private async Task ExecuteDelete()
    {
        if (registrationToDelete == null) return;

        isDeleting = true;

        try
        {
            await RegistrationRepository.DeleteAsync(registrationToDelete.Id);
            allRegistrations.Remove(registrationToDelete);
            selectedIds.Remove(registrationToDelete.Id);
            showDeleteModal = false;
            registrationToDelete = null;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ExportToExcel()
    {
        // TODO: Implement export
        await Task.CompletedTask;
    }

    // Helpers
    private string GetDivisionName(string divisionId) =>
        availableDivisions.FirstOrDefault(d => d.Id == divisionId)?.Name ?? "Unknown";

    private string GetCategoryName(string divisionId, string categoryId)
    {
        var division = availableDivisions.FirstOrDefault(d => d.Id == divisionId);
        return division?.FindCategory(categoryId)?.Name ?? "Unknown";
    }

    private string GetStatusDisplayName(RegistrationStatus status) => status switch
    {
        RegistrationStatus.AwaitingReview => "Awaiting Review",
        RegistrationStatus.Pending => "Pending",
        RegistrationStatus.Reviewed => "Reviewed",
        RegistrationStatus.Verified => "Verified",
        RegistrationStatus.Withdrawn => "Withdrawn",
        RegistrationStatus.Disqualified => "Disqualified",
        _ => status.ToString()
    };

    private RenderFragment RenderStatusBadge(RegistrationStatus status) => __builder =>
    {
        var (bg, text, ring) = status switch
        {
            RegistrationStatus.AwaitingReview => ("bg-amber-50", "text-amber-700", "ring-amber-600/20"),
            RegistrationStatus.Pending => ("bg-cyan-50", "text-cyan-700", "ring-cyan-600/20"),
            RegistrationStatus.Reviewed => ("bg-emerald-50", "text-emerald-700", "ring-emerald-600/20"),
            RegistrationStatus.Verified => ("bg-emerald-50", "text-emerald-700", "ring-emerald-600/20"),
            RegistrationStatus.Withdrawn => ("bg-slate-50", "text-slate-600", "ring-slate-500/20"),
            RegistrationStatus.Disqualified => ("bg-rose-50", "text-rose-700", "ring-rose-600/20"),
            _ => ("bg-slate-50", "text-slate-600", "ring-slate-500/20")
        };

        <span class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium @bg @text ring-1 ring-inset @ring">
            @GetStatusDisplayName(status)
        </span>
    };
}
