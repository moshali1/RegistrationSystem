@page "/admin/transfer-registration"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Application.Users
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Core.Domain.Users
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject UserService UserService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider

<PageTitle>Transfer Registration</PageTitle>

<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800">Transfer Registration</h1>
        <p class="text-sm text-slate-500 mt-1">Search for a registration and transfer ownership to a different user account</p>
    </div>

    <!-- Search Card -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
        <div class="bg-slate-800 px-5 py-3">
            <div class="flex items-center gap-3">
                @Icons.Search("h-4 w-4 text-slate-300")
                <span class="text-sm font-medium text-white">Find Registration</span>
            </div>
        </div>
        <div class="p-5">
            <div class="flex gap-3">
                <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown"
                       placeholder="Search by name or CID..."
                       class="flex-1 px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                <button type="button" @onclick="SearchRegistrations" disabled="@(isSearching || string.IsNullOrWhiteSpace(searchQuery))"
                        class="px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-400 text-white text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
                    @if (isSearching)
                    {
                        @Icons.Spinner("h-4 w-4")
                    }
                    else
                    {
                        @Icons.Search("h-4 w-4")
                    }
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Search Results -->
    @if (hasSearched && searchResults.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-8 text-center mb-6">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-3">
                @Icons.Search("h-6 w-6 text-slate-400")
            </div>
            <p class="text-sm text-slate-500">No registrations found matching "<span class="font-medium text-slate-700">@lastSearchQuery</span>"</p>
        </div>
    }
    else if (searchResults.Count > 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
            <div class="px-5 py-3 border-b border-slate-200 bg-slate-50">
                <span class="text-sm font-semibold text-slate-700">@searchResults.Count result(s)</span>
            </div>
            <div class="divide-y divide-slate-100 max-h-[400px] overflow-y-auto">
                @foreach (var reg in searchResults)
                {
                    var isSelected = selectedRegistration?.Id == reg.Id;
                    <button type="button" @onclick="() => SelectResult(reg)"
                            class="w-full px-5 py-3 text-left transition-colors cursor-pointer flex items-center justify-between gap-4 @(isSelected ? "bg-cyan-50 border-l-4 border-cyan-500" : "hover:bg-slate-50 border-l-4 border-transparent")">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-medium text-slate-800">@reg.PersonalInfo.FullName</span>
                                @if (!string.IsNullOrEmpty(reg.Cid))
                                {
                                    <span class="font-mono text-xs text-cyan-600 bg-cyan-50 px-1.5 py-0.5 rounded">@reg.Cid</span>
                                }
                            </div>
                            <p class="text-xs text-slate-500 mt-0.5">@GetDivisionName(reg) / @GetCategoryName(reg)</p>
                        </div>
                        <span class="text-xs font-medium text-slate-500 flex-shrink-0">@reg.Status</span>
                    </button>
                }
            </div>
        </div>
    }

    <!-- Selected Registration + Transfer -->
    @if (selectedRegistration != null)
    {
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">
            <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-600 flex items-center justify-center shadow-sm">
                        @Icons.User("h-4 w-4 text-white")
                    </div>
                    <div>
                        <h3 class="text-sm font-semibold text-slate-800">Selected Registration</h3>
                        <p class="text-xs text-slate-500">@selectedRegistration.PersonalInfo.FullName — @selectedRegistration.Cid</p>
                    </div>
                </div>
            </div>
            <div class="p-5 space-y-4">
                <!-- Current Owner -->
                <div class="rounded-xl border border-slate-200 p-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Current Owner</p>
                    @if (currentOwner != null)
                    {
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center">
                                @Icons.User("h-4 w-4 text-slate-500")
                            </div>
                            <div>
                                <p class="text-sm font-medium text-slate-800">@currentOwner.DisplayName</p>
                                <p class="text-xs text-slate-500">@currentOwner.Email · @currentOwner.UserType</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-slate-500">Owner not found (ID: @selectedRegistration.CreatorUserId)</p>
                    }
                </div>

                <!-- Transfer To -->
                <div class="rounded-xl border border-cyan-200 bg-cyan-50/50 p-4">
                    <p class="text-xs font-semibold text-cyan-700 uppercase tracking-wide mb-3">Transfer To</p>
                    <div class="flex gap-3">
                        <input type="email" @bind="transferEmail" @bind:event="oninput"
                               placeholder="Enter new owner's email address..."
                               class="flex-1 px-3 py-2 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                        <button type="button" @onclick="LookupUser" disabled="@(isLookingUp || string.IsNullOrWhiteSpace(transferEmail))"
                                class="px-4 py-2 rounded-xl bg-slate-600 hover:bg-slate-700 disabled:bg-slate-400 text-white text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
                            @if (isLookingUp)
                            {
                                @Icons.Spinner("h-4 w-4")
                            }
                            else
                            {
                                @Icons.Search("h-4 w-4")
                            }
                            Lookup
                        </button>
                    </div>

                    @if (lookupError != null)
                    {
                        <div class="mt-3 px-3 py-2 rounded-xl bg-red-50 border border-red-200">
                            <p class="text-sm text-red-700">@lookupError</p>
                        </div>
                    }

                    @if (targetUser != null)
                    {
                        <div class="mt-3 flex items-center gap-3 px-3 py-2 rounded-xl bg-white border border-cyan-200">
                            <div class="w-8 h-8 rounded-full bg-cyan-100 flex items-center justify-center">
                                @Icons.User("h-4 w-4 text-cyan-600")
                            </div>
                            <div class="flex-1">
                                <p class="text-sm font-medium text-slate-800">@targetUser.DisplayName</p>
                                <p class="text-xs text-slate-500">@targetUser.Email · @targetUser.UserType</p>
                            </div>
                            @Icons.CheckCircle("h-5 w-5 text-emerald-500")
                        </div>
                    }
                </div>

                <!-- Transfer Button -->
                @if (targetUser != null)
                {
                    <button type="button" @onclick="ExecuteTransfer" disabled="@isTransferring"
                            class="w-full px-4 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-400 text-white text-sm font-semibold transition-colors cursor-pointer flex items-center justify-center gap-2">
                        @if (isTransferring)
                        {
                            @Icons.Spinner("h-4 w-4")
                            <span>Transferring...</span>
                        }
                        else
                        {
                            @Icons.ArrowsRightLeft("h-4 w-4")
                            <span>Transfer to @targetUser.DisplayName</span>
                        }
                    </button>
                }
            </div>
        </div>

        <!-- Success Message -->
        @if (transferSuccess != null)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-5 mb-6">
                <div class="flex items-start gap-3">
                    @Icons.CheckCircle("h-5 w-5 text-emerald-600 flex-shrink-0 mt-0.5")
                    <div>
                        <p class="text-sm font-medium text-emerald-800">Transfer Successful</p>
                        <p class="text-sm text-emerald-700 mt-1">@transferSuccess</p>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    // Search
    private string searchQuery = string.Empty;
    private string lastSearchQuery = string.Empty;
    private bool isSearching = false;
    private bool hasSearched = false;
    private List<Registration> searchResults = new();

    // Settings
    private CompetitionSettings? settings;
    private int competitionYear;
    private List<Division> divisions = new();

    // Selection
    private Registration? selectedRegistration;
    private User? currentOwner;

    // Transfer
    private string transferEmail = string.Empty;
    private bool isLookingUp = false;
    private string? lookupError;
    private User? targetUser;
    private bool isTransferring = false;
    private string? transferSuccess;

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsService.GetSettingsAsync();
        competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;
        divisions = settings?.Divisions.Where(d => d.IsEnabled).ToList() ?? new();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            await SearchRegistrations();
        }
    }

    private async Task SearchRegistrations()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;

        isSearching = true;
        hasSearched = false;
        selectedRegistration = null;
        currentOwner = null;
        targetUser = null;
        lookupError = null;
        transferSuccess = null;
        StateHasChanged();

        try
        {
            var allRegs = await RegistrationService.GetAllByYearAsync(competitionYear);
            var query = searchQuery.Trim();

            searchResults = allRegs
                .Where(r =>
                    r.PersonalInfo.FullName.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    (r.Cid?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false))
                .Take(50)
                .ToList();

            lastSearchQuery = query;
            hasSearched = true;
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }

    private async Task SelectResult(Registration reg)
    {
        selectedRegistration = reg;
        targetUser = null;
        transferEmail = string.Empty;
        lookupError = null;
        transferSuccess = null;

        // Load current owner
        currentOwner = null;
        if (!string.IsNullOrEmpty(reg.CreatorUserId))
        {
            currentOwner = await UserService.GetByObjectIdentifierAsync(reg.CreatorUserId);
        }

        StateHasChanged();
    }

    private async Task LookupUser()
    {
        if (string.IsNullOrWhiteSpace(transferEmail)) return;

        isLookingUp = true;
        lookupError = null;
        targetUser = null;
        StateHasChanged();

        try
        {
            var email = transferEmail.Trim().ToLowerInvariant();
            var user = await UserService.GetByEmailAsync(email);

            if (user == null)
            {
                lookupError = $"No user found with email \"{transferEmail.Trim()}\". The user must have an existing account.";
                return;
            }

            // Don't allow transfer to same user
            if (currentOwner != null && user.ObjectIdentifier == currentOwner.ObjectIdentifier)
            {
                lookupError = "This user is already the owner of this registration.";
                return;
            }

            targetUser = user;
        }
        finally
        {
            isLookingUp = false;
            StateHasChanged();
        }
    }

    private async Task ExecuteTransfer()
    {
        if (selectedRegistration == null || targetUser == null) return;

        isTransferring = true;
        StateHasChanged();

        try
        {
            var oldOwnerName = currentOwner?.DisplayName ?? "Unknown";
            var oldOwnerId = selectedRegistration.CreatorUserId;

            // Update the CreatorUserId to the target user's ObjectIdentifier
            selectedRegistration.CreatorUserId = targetUser.ObjectIdentifier;

            var result = await RegistrationService.UpdateAsync(selectedRegistration);

            if (result.IsValid)
            {
                // Audit log
                await AuditContextProvider.SetCurrentUserContextAsync();
                await AuditService.LogAsync(
                    AuditAction.ManualCorrection,
                    "Registration",
                    selectedRegistration.Id,
                    summary: $"Registration transferred from {oldOwnerName} ({oldOwnerId}) to {targetUser.DisplayName} ({targetUser.ObjectIdentifier})",
                    entityDescription: $"{selectedRegistration.PersonalInfo.FullName} ({selectedRegistration.Cid})",
                    metadata: new Dictionary<string, string>
                    {
                        ["OldCreatorUserId"] = oldOwnerId,
                        ["NewCreatorUserId"] = targetUser.ObjectIdentifier,
                        ["OldOwnerName"] = oldOwnerName,
                        ["NewOwnerName"] = targetUser.DisplayName,
                        ["NewOwnerEmail"] = targetUser.Email
                    });

                transferSuccess = $"Registration for {selectedRegistration.PersonalInfo.FullName} ({selectedRegistration.Cid}) was transferred from {oldOwnerName} to {targetUser.DisplayName} ({targetUser.Email}).";

                // Update displayed current owner
                currentOwner = targetUser;
                targetUser = null;
                transferEmail = string.Empty;
            }
            else
            {
                lookupError = "Failed to save the transfer. Please try again.";
            }
        }
        catch (Exception ex)
        {
            lookupError = $"Transfer failed: {ex.Message}";
        }
        finally
        {
            isTransferring = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════════════════════

    private string GetDivisionName(Registration reg)
    {
        return divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId)?.Name ?? "Unknown";
    }

    private string GetCategoryName(Registration reg)
    {
        var division = divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId);
        return division?.Categories.FirstOrDefault(c => c.Id == reg.CompetitionSelection.CategoryId)?.Name ?? "Unknown";
    }
}
