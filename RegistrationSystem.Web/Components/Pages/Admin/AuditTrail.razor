@page "/admin/audit"
@page "/admin/audit/{EntityType}/{EntityId}"
@attribute [Authorize(Roles = "Admin")]

@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Domain.Auditing

@inject IAuditService AuditService
@inject NavigationManager NavigationManager

@implements IDisposable

<PageTitle>Audit Trail - Admin</PageTitle>

<!-- Header -->
<div class="mb-6">
    <div class="mb-2">
        <h1 class="text-2xl font-bold text-slate-800 select-none" @ondblclick="HandleHeaderDoubleClick">Audit Trail</h1>
        <p class="text-sm text-slate-500 mt-1">Track all system changes and activity</p>
    </div>

    <!-- Stats Cards -->
    @if (dailyStats != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center">
                        @Icons.Plus("h-5 w-5 text-white")
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@dailyStats.ActionCounts.GetValueOrDefault(AuditAction.Submitted)</p>
                        <p class="text-xs text-slate-500">Submitted Today</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-500 to-slate-600 flex items-center justify-center">
                        @Icons.EditSquare("h-5 w-5 text-white")
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@dailyStats.ActionCounts.GetValueOrDefault(AuditAction.Updated)</p>
                        <p class="text-xs text-slate-500">Updated Today</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center">
                        @Icons.ArrowsRightLeft("h-5 w-5 text-white")
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@dailyStats.ActionCounts.GetValueOrDefault(AuditAction.StatusChanged)</p>
                        <p class="text-xs text-slate-500">Status Changes</p>
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
                        @Icons.Clipboard("h-5 w-5 text-white")
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-800">@dailyStats.TotalActions</p>
                        <p class="text-xs text-slate-500">Total Actions</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Filters -->
<div class="bg-white rounded-xl border border-slate-200 p-5 mb-6 shadow-sm">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- Date Range -->
        <div class="space-y-1.5">
            <label class="text-xs font-medium text-slate-600 uppercase tracking-wide">From Date</label>
            <input type="date"
                   @bind="fromDate"
                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all" />
        </div>
        <div class="space-y-1.5">
            <label class="text-xs font-medium text-slate-600 uppercase tracking-wide">To Date</label>
            <input type="date"
                   @bind="toDate"
                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all" />
        </div>

        <!-- Entity Type -->
        <div class="space-y-1.5">
            <label class="text-xs font-medium text-slate-600 uppercase tracking-wide">Entity Type</label>
            <select @bind="selectedEntityType"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all">
                <option value="">All Types</option>
                <option value="Registration">Registration</option>
                <option value="NiqabBypass">Niqab Bypass</option>
                <option value="CompetitionSettings">Settings</option>
            </select>
        </div>

        <!-- Action Type -->
        <div class="space-y-1.5">
            <label class="text-xs font-medium text-slate-600 uppercase tracking-wide">Action</label>
            <select @bind="selectedAction"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all">
                <option value="">All Actions</option>
                @foreach (var action in Enum.GetValues<AuditAction>())
                {
                    <option value="@((int)action)">@action.GetDisplayName()</option>
                }
            </select>
        </div>

        <!-- Search -->
        <div class="space-y-1.5">
            <label class="text-xs font-medium text-slate-600 uppercase tracking-wide">Search</label>
            <div class="relative">
                <input type="text"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="ID, name, CID..."
                       class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all" />
                @Icons.Search("absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400")
            </div>
        </div>
    </div>

    <!-- Filter Actions -->
    <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-200">
        <div class="flex items-center gap-2">
            @if (hasActiveFilters)
            {
                <button type="button"
                        @onclick="ClearAllFilters"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition-colors">
                    @Icons.XMark("h-3.5 w-3.5")
                    Clear Filters
                </button>
            }
        </div>

        <button type="button"
                @onclick="ApplyFilters"
                disabled="@isLoading"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-teal-600 text-white text-sm font-semibold hover:from-cyan-700 hover:to-teal-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
            @if (isLoading)
            {
                @Icons.Spinner("animate-spin h-4 w-4")
            }
            else
            {
                @Icons.Filter("h-4 w-4")
            }
            Apply Filters
        </button>
    </div>

    <!-- Active Entity Filter -->
    @if (!string.IsNullOrEmpty(EntityType) && !string.IsNullOrEmpty(EntityId))
    {
        <div class="mt-4 pt-4 border-t border-slate-200 flex items-center gap-3">
            <span class="text-xs text-slate-500">Viewing history for:</span>
            <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-cyan-50 border border-cyan-200 text-cyan-700 text-sm font-medium">
                @Icons.Document("h-4 w-4")
                @EntityType / @EntityId
                <button type="button" @onclick="ClearEntityFilter" class="ml-1 hover:text-cyan-900 transition-colors">
                    @Icons.XMark("h-4 w-4")
                </button>
            </span>
        </div>
    }
</div>

@if (isLoading)
{
    <div class="flex items-center justify-center py-16">
        <div class="flex flex-col items-center gap-3">
            @Icons.Spinner("h-8 w-8 text-cyan-600 animate-spin")
            <span class="text-sm text-slate-500">Loading audit trail...</span>
        </div>
    </div>
}
else if (auditEntries.Count == 0)
{
    <div class="bg-white rounded-xl border border-slate-200 p-16 text-center shadow-sm">
        <div class="w-16 h-16 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-4">
            @Icons.Clipboard("h-8 w-8 text-slate-400")
        </div>
        <h3 class="text-lg font-semibold text-slate-800 mb-1">No audit entries found</h3>
        <p class="text-sm text-slate-500">Try adjusting your filters or date range.</p>
    </div>
}
else
{
    <!-- Results Count -->
    <div class="flex items-center justify-between mb-4">
        <p class="text-sm text-slate-600">
            Showing <span class="font-semibold text-slate-800">@auditEntries.Count</span> of <span class="font-semibold text-slate-800">@totalCount</span> entries
        </p>
    </div>

    <!-- Timeline -->
    <div class="space-y-3">
        @foreach (var entry in auditEntries)
        {
            <div class="group bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md hover:border-slate-300 transition-all">
                <div class="p-5">
                    <div class="flex items-start gap-4">
                        <!-- Timeline Indicator -->
                        <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-xl @GetActionStyles(entry.Action).bg flex items-center justify-center flex-shrink-0">
                                @RenderActionIcon(entry.Action)
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="flex-1 min-w-0">
                            <!-- Header -->
                            <div class="flex items-center gap-3 flex-wrap mb-2">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg @GetActionStyles(entry.Action).badge text-xs font-semibold">
                                    @entry.Action.GetDisplayName()
                                </span>
                                <span class="text-sm font-medium text-slate-700">@entry.EntityType</span>
                                @if (!string.IsNullOrEmpty(entry.EntityDescription))
                                {
                                    <span class="text-slate-300">•</span>
                                    <span class="text-sm text-slate-500 truncate max-w-[300px]">@entry.EntityDescription</span>
                                }
                            </div>

                            <!-- Summary -->
                            @if (!string.IsNullOrEmpty(entry.Summary))
                            {
                                <p class="text-sm text-slate-700 mb-3">
                                    @entry.Summary
                                    @if (entry.Metadata?.TryGetValue("Method", out var method) == true)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-500 ml-1.5">@method</span>
                                    }
                                </p>
                                @if (entry.Action == AuditAction.StatusChanged && entry.Metadata?.TryGetValue("Reason", out var reason) == true && !string.IsNullOrEmpty(reason))
                                {
                                    <p class="text-xs text-slate-500 -mt-2 mb-3 italic">@reason</p>
                                }
                            }

                            <!-- ID Verification Metadata -->
                            @if (entry.Action == AuditAction.IdVerification && entry.Metadata?.Count > 0)
                            {
                                <div class="flex flex-wrap gap-1.5 mb-3">
                                    @foreach (var (key, label) in idVerificationMetadataFields)
                                    {
                                        if (entry.Metadata.TryGetValue(key, out var value) && !string.IsNullOrEmpty(value))
                                        {
                                            var badgeColor = key is "FirstNameMatch" or "LastNameMatch" or "DateOfBirthMatch"
                                                ? value == "Match" ? "bg-emerald-100 text-emerald-600"
                                                : value == "NoMatch" ? "bg-red-100 text-red-600"
                                                : "bg-amber-100 text-amber-600"
                                                : "bg-slate-100 text-slate-500";
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium @badgeColor">@label: @value</span>
                                        }
                                    }
                                </div>
                                @if (entry.Metadata.TryGetValue("Reasoning", out var aiReasoning) && !string.IsNullOrEmpty(aiReasoning))
                                {
                                    <p class="text-xs text-slate-500 -mt-2 mb-3 italic">@aiReasoning</p>
                                }
                            }

                            <!-- Deletion Metadata -->
                            @if (entry.Action == AuditAction.Deleted && entry.Metadata?.Count > 0)
                            {
                                <div class="flex flex-wrap gap-1.5 mb-3">
                                    @foreach (var (key, label) in deletionMetadataFields)
                                    {
                                        if (entry.Metadata.TryGetValue(key, out var value) && !string.IsNullOrEmpty(value))
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-500">@label: @FormatMetadataValue(key, value)</span>
                                        }
                                    }
                                    @if (entry.Metadata.TryGetValue("AuditTrailDeleted", out var auditDeleted) && auditDeleted == "True")
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-100 text-red-500">Audit trail also deleted</span>
                                    }
                                </div>
                            }

                            <!-- Field Changes -->
                            @if (entry.Changes.Count > 0)
                            {
                                <div class="bg-slate-50 rounded-xl p-4 mb-3 space-y-2">
                                    @foreach (var change in entry.Changes.Take(expandedEntries.Contains(entry.Id) ? entry.Changes.Count : 3))
                                    {
                                        <div class="flex items-start gap-2 text-sm">
                                            @Icons.ArrowRight("h-4 w-4 text-cyan-500 mt-0.5 flex-shrink-0")
                                            <span class="text-slate-600">
                                                <span class="font-medium text-slate-700">@change.DisplayName:</span>
                                                @if (!string.IsNullOrEmpty(change.OldValue))
                                                {
                                                    <span class="text-red-400 line-through mx-1">@change.OldValue</span>
                                                    <span class="text-slate-400">→</span>
                                                }
                                                <span class="text-cyan-600 font-medium ml-1">@(change.NewValue ?? "(empty)")</span>
                                            </span>
                                        </div>
                                    }
                                    @if (entry.Changes.Count > 3 && !expandedEntries.Contains(entry.Id))
                                    {
                                        <button type="button"
                                                @onclick="() => expandedEntries.Add(entry.Id)"
                                                class="text-sm text-cyan-600 hover:text-cyan-700 font-medium flex items-center gap-1 mt-2">
                                            @Icons.ChevronDown("h-4 w-4")
                                            Show @(entry.Changes.Count - 3) more changes
                                        </button>
                                    }
                                </div>
                            }

                            <!-- Footer -->
                            <div class="flex items-center gap-5 text-xs text-slate-400">
                                <span class="flex items-center gap-1.5">
                                    @Icons.Clock("h-3.5 w-3.5")
                                    @entry.GetFormattedTimestamp("MMM d, yyyy h:mm tt")
                                </span>
                                <span class="flex items-center gap-1.5">
                                    @Icons.User("h-3.5 w-3.5")
                                    @entry.GetActorDescription()
                                </span>
                                @if (!string.IsNullOrEmpty(entry.EntityId) && string.IsNullOrEmpty(EntityId))
                                {
                                    <button type="button"
                                            @onclick="() => ViewEntityHistory(entry.EntityType, entry.EntityId)"
                                            class="text-cyan-500 hover:text-cyan-600 font-medium flex items-center gap-1 transition-colors">
                                        View full history
                                        @Icons.Chevron("h-3.5 w-3.5")
                                    </button>
                                }
                                @if (managementMode)
                                {
                                    <span class="ml-auto flex items-center gap-1">
                                        <button type="button"
                                                @onclick="() => OpenEditModal(entry)"
                                                class="p-1 rounded hover:bg-slate-100 text-slate-300 hover:text-slate-500 transition-colors"
                                                title="Edit summary">
                                            @Icons.EditSquare("h-3.5 w-3.5")
                                        </button>
                                        <button type="button"
                                                @onclick="() => OpenDeleteModal(entry)"
                                                class="p-1 rounded hover:bg-red-50 text-slate-300 hover:text-red-500 transition-colors"
                                                title="Delete entry">
                                            @Icons.Trash("h-3.5 w-3.5")
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalCount > pageSize)
    {
        <div class="flex items-center justify-center gap-3 mt-8">
            <button type="button"
                    disabled="@(currentPage == 1)"
                    @onclick="PreviousPage"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                @Icons.ChevronLeft("h-4 w-4")
                Previous
            </button>
            <div class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-sm font-medium text-slate-600 shadow-sm">
                Page @currentPage of @totalPages
            </div>
            <button type="button"
                    disabled="@(currentPage >= totalPages)"
                    @onclick="NextPage"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-300 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm">
                Next
                @Icons.Chevron("h-4 w-4")
            </button>
        </div>
    }
}

<!-- Password Gate Modal -->
@if (showPasswordModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="() => showPasswordModal = false">
        <div class="bg-white rounded-xl shadow-lg w-full max-w-sm mx-4 p-6" @onclick:stopPropagation>
            <div class="text-center mb-4">
                @Icons.Lock("h-8 w-8 text-slate-400 mx-auto mb-2")
                <h3 class="text-sm font-medium text-slate-600">Authentication Required</h3>
            </div>
            <input type="password"
                   @bind="enteredPassword"
                   @bind:event="oninput"
                   @onkeydown="HandlePasswordKeyDown"
                   placeholder="Enter access code"
                   class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-slate-400 focus:border-slate-400 focus:bg-white transition-all @(passwordError ? "border-red-300 ring-2 ring-red-200" : "")" />
            @if (passwordError)
            {
                <p class="text-xs text-red-500 text-center mt-2">Invalid code</p>
            }
            <div class="flex gap-2 mt-4">
                <button type="button"
                        @onclick="() => { showPasswordModal = false; enteredPassword = string.Empty; passwordError = false; }"
                        class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button type="button"
                        @onclick="VerifyPassword"
                        class="flex-1 px-4 py-2 rounded-xl bg-slate-700 text-white text-sm font-medium hover:bg-slate-800 transition-colors">
                    Unlock
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Summary Modal -->
@if (showEditModal && editingEntry != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseEditModal">
        <div class="bg-white rounded-xl shadow-lg w-full max-w-lg mx-4 p-6" @onclick:stopPropagation>
            <h3 class="text-lg font-semibold text-slate-800 mb-1">Edit Audit Entry</h3>
            <p class="text-xs text-slate-400 mb-4 font-mono">@editingEntry.Id</p>

            <div class="space-y-3">
                <div>
                    <label class="text-xs font-medium text-slate-500 uppercase tracking-wide">Summary</label>
                    <textarea @bind="editSummary"
                              rows="3"
                              class="w-full mt-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 focus:bg-white transition-all resize-none"></textarea>
                </div>
            </div>

            <div class="flex gap-2 mt-5">
                <button type="button"
                        @onclick="CloseEditModal"
                        class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button type="button"
                        @onclick="SaveEdit"
                        disabled="@isSaving"
                        class="flex-1 px-4 py-2 rounded-xl bg-cyan-600 text-white text-sm font-medium hover:bg-cyan-700 disabled:opacity-50 transition-colors">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && deletingEntry != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="() => { showDeleteModal = false; deletingEntry = null; }">
        <div class="bg-white rounded-xl shadow-lg w-full max-w-sm mx-4 p-6" @onclick:stopPropagation>
            <div class="text-center mb-4">
                @Icons.Trash("h-8 w-8 text-red-400 mx-auto mb-2")
                <h3 class="text-base font-semibold text-slate-800">Delete Audit Entry?</h3>
                <p class="text-sm text-slate-500 mt-1">This cannot be undone.</p>
            </div>
            <div class="bg-slate-50 rounded-lg p-3 mb-4 text-xs text-slate-600">
                <span class="font-medium">@deletingEntry.Action.GetDisplayName()</span> — @deletingEntry.EntityType
                @if (!string.IsNullOrEmpty(deletingEntry.Summary))
                {
                    <br /><span class="text-slate-400">@deletingEntry.Summary</span>
                }
            </div>
            <div class="flex gap-2">
                <button type="button"
                        @onclick="() => { showDeleteModal = false; deletingEntry = null; }"
                        class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button type="button"
                        @onclick="ConfirmDelete"
                        disabled="@isSaving"
                        class="flex-1 px-4 py-2 rounded-xl bg-red-600 text-white text-sm font-medium hover:bg-red-700 disabled:opacity-50 transition-colors">
                    @(isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public string? EntityId { get; set; }

    private List<AuditEntry> auditEntries = new();
    private AuditDailyStats? dailyStats;
    private HashSet<string> expandedEntries = new();

    private static readonly (string key, string label)[] deletionMetadataFields =
    [
        ("DateOfBirth", "DOB"),
        ("Division", "Division"),
        ("Category", "Category"),
        ("Portion", "Portion"),
        ("Status", "Status"),
        ("CreatorEmail", "Creator")
    ];

    private static readonly (string key, string label)[] idVerificationMetadataFields =
    [
        ("Outcome", "Result"),
        ("DocumentType", "Document"),
        ("IssuingCountry", "Country"),
        ("FirstNameMatch", "First Name"),
        ("LastNameMatch", "Last Name"),
        ("DateOfBirthMatch", "DOB")
    ];

    private static string FormatMetadataValue(string key, string value)
    {
        if (key == "DateOfBirth" && DateOnly.TryParse(value, out var dob))
            return dob.ToString("M/d/yyyy");
        return value;
    }

    private bool isLoading = true;
    private int totalCount;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    // Bind directly to DateOnly? — works with <input type="date"> in .NET 10 Blazor
    private DateOnly? fromDate;
    private DateOnly? toDate;
    private string selectedEntityType = "";
    private string selectedAction = "";
    private string searchText = "";

    private bool hasActiveFilters =>
        fromDate.HasValue ||
        toDate.HasValue ||
        !string.IsNullOrEmpty(selectedEntityType) ||
        !string.IsNullOrEmpty(selectedAction) ||
        !string.IsNullOrEmpty(searchText);

    protected override async Task OnInitializedAsync()
    {
        InitializeFilters();
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        InitializeFilters();
        await LoadData();
    }

    private void InitializeFilters()
    {
        if (string.IsNullOrEmpty(EntityType) || string.IsNullOrEmpty(EntityId))
        {
            fromDate = TodayCentral;
            toDate = TodayCentral;
        }
        else
        {
            fromDate = null;
            toDate = null;
            selectedEntityType = EntityType;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            dailyStats = await AuditService.GetDailyStatsAsync(TodayCentral);

            var criteria = new AuditSearchCriteria
            {
                EntityType = !string.IsNullOrEmpty(EntityType) ? EntityType :
                             !string.IsNullOrEmpty(selectedEntityType) ? selectedEntityType : null,
                EntityId = !string.IsNullOrEmpty(EntityId) ? EntityId : null,
                Action = !string.IsNullOrEmpty(selectedAction) && int.TryParse(selectedAction, out var actionInt)
                    ? (AuditAction)actionInt : null,
                FromDate = fromDate,
                ToDate = toDate,
                SearchText = !string.IsNullOrEmpty(searchText) ? searchText : null,
                Skip = (currentPage - 1) * pageSize,
                Take = pageSize
            };

            totalCount = await AuditService.CountAsync(criteria);
            auditEntries = (await AuditService.SearchAsync(criteria)).ToList();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        // fromDate and toDate are already bound directly via <input type="date">
        currentPage = 1;
        await LoadData();
    }

    private async Task ClearAllFilters()
    {
        fromDate = DateOnly.FromDateTime(DateTime.Today);
        toDate = DateOnly.FromDateTime(DateTime.Today);
        selectedEntityType = "";
        selectedAction = "";
        searchText = "";
        currentPage = 1;
        await LoadData();
    }

    private void ClearEntityFilter()
    {
        NavigationManager.NavigateTo("/admin/audit", forceLoad: true);
    }

    private void ViewEntityHistory(string entityType, string entityId)
    {
        NavigationManager.NavigateTo($"/admin/audit/{entityType}/{entityId}", forceLoad: true);
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadData();
        }
    }

    private (string bg, string badge) GetActionStyles(AuditAction action) => action switch
    {
        AuditAction.Submitted =>
            ("bg-gradient-to-br from-cyan-500 to-cyan-600", "bg-cyan-100 text-cyan-700"),
        AuditAction.Updated =>
            ("bg-gradient-to-br from-slate-500 to-slate-600", "bg-slate-100 text-slate-700"),
        AuditAction.Deleted or AuditAction.Disqualified =>
            ("bg-gradient-to-br from-red-500 to-red-600", "bg-red-100 text-red-700"),
        AuditAction.StatusChanged =>
            ("bg-gradient-to-br from-amber-500 to-amber-600", "bg-amber-100 text-amber-700"),
        AuditAction.Withdrawn =>
            ("bg-gradient-to-br from-amber-500 to-amber-600", "bg-amber-100 text-amber-700"),
        AuditAction.EmailSent or AuditAction.SmsSent =>
            ("bg-gradient-to-br from-slate-600 to-slate-700", "bg-slate-100 text-slate-700"),
        AuditAction.NiqabBypassCreated or AuditAction.NiqabBypassClaimed or AuditAction.NiqabBypassDeleted =>
            ("bg-gradient-to-br from-slate-600 to-slate-700", "bg-slate-100 text-slate-700"),
        AuditAction.SettingsUpdated =>
            ("bg-gradient-to-br from-slate-500 to-slate-600", "bg-slate-100 text-slate-700"),
        AuditAction.ManualCorrection =>
            ("bg-gradient-to-br from-amber-500 to-amber-600", "bg-amber-100 text-amber-700"),
        AuditAction.DataImport or AuditAction.DataExport =>
            ("bg-gradient-to-br from-slate-500 to-slate-600", "bg-slate-100 text-slate-700"),
        AuditAction.IdVerification =>
            ("bg-gradient-to-br from-cyan-500 to-cyan-600", "bg-cyan-100 text-cyan-700"),
        _ => ("bg-gradient-to-br from-slate-400 to-slate-500", "bg-slate-100 text-slate-600")
    };

    private RenderFragment RenderActionIcon(AuditAction action) => __builder =>
    {
        @switch (action)
        {
            case AuditAction.Submitted:
                @Icons.Plus("h-5 w-5 text-white")
                break;

            case AuditAction.Updated:
            case AuditAction.ManualCorrection:
                @Icons.EditSquare("h-5 w-5 text-white")
                break;

            case AuditAction.Deleted:
            case AuditAction.Disqualified:
                @Icons.Trash("h-5 w-5 text-white")
                break;

            case AuditAction.StatusChanged:
            case AuditAction.Withdrawn:
                @Icons.ArrowsRightLeft("h-5 w-5 text-white")
                break;

            case AuditAction.EmailSent:
            case AuditAction.SmsSent:
                @Icons.Envelope("h-5 w-5 text-white")
                break;

            case AuditAction.NiqabBypassCreated:
            case AuditAction.NiqabBypassClaimed:
            case AuditAction.NiqabBypassDeleted:
                @Icons.Shield("h-5 w-5 text-white")
                break;

            case AuditAction.SettingsUpdated:
                @Icons.Cog("h-5 w-5 text-white")
                break;

            case AuditAction.IdVerification:
                @Icons.ShieldCheckFilled("h-5 w-5 text-white")
                break;

            default:
                @Icons.InfoCircleOutline("h-5 w-5 text-white")
                break;
        }
    };

    // Add a helper to get "today" in Central Time
    private static readonly TimeZoneInfo CentralTz =
        TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");

    private static DateOnly TodayCentral =>
        DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, CentralTz));

    // ═══════════════════════════════════════════════════════════════════════════
    // MANAGEMENT MODE (hidden — double-click header to activate)
    // ═══════════════════════════════════════════════════════════════════════════

    private bool managementMode;
    private bool showPasswordModal;
    private string enteredPassword = "";
    private bool passwordError;
    private const string ManagementPassword = "123456";

    private bool showEditModal;
    private AuditEntry? editingEntry;
    private string editSummary = "";

    private bool showDeleteModal;
    private AuditEntry? deletingEntry;

    private bool isSaving;

    private void HandleHeaderDoubleClick()
    {
        if (managementMode)
        {
            managementMode = false;
            return;
        }

        showPasswordModal = true;
        enteredPassword = "";
        passwordError = false;
    }

    private void HandlePasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            VerifyPassword();
    }

    private void VerifyPassword()
    {
        if (enteredPassword == ManagementPassword)
        {
            managementMode = true;
            showPasswordModal = false;
            enteredPassword = "";
            passwordError = false;
        }
        else
        {
            passwordError = true;
        }
    }

    private void OpenEditModal(AuditEntry entry)
    {
        editingEntry = entry;
        editSummary = entry.Summary ?? "";
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingEntry = null;
        editSummary = "";
    }

    private async Task SaveEdit()
    {
        if (editingEntry == null) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            await AuditService.UpdateEntrySummaryAsync(editingEntry.Id, editSummary);
            editingEntry.Summary = editSummary;
            CloseEditModal();
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void OpenDeleteModal(AuditEntry entry)
    {
        deletingEntry = entry;
        showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        if (deletingEntry == null) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            await AuditService.DeleteEntryAsync(deletingEntry.Id);
            auditEntries.Remove(deletingEntry);
            totalCount--;
            showDeleteModal = false;
            deletingEntry = null;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
    }
}
