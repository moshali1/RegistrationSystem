@page "/admin/screening-exempt"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService

<PageTitle>Screening Exempt</PageTitle>

<div class="space-y-6">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
        <a href="admin/tools" class="hover:text-violet-600 transition-colors">Admin Tools</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">Screening Exempt</span>
    </div>

    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Screening Exempt</h1>
        <p class="text-sm text-slate-500 mt-1">Search verified Memorization competitors and manually override their screening exemption status.</p>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm">@errorMessage</div>
    }
    @if (successMessage != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg px-4 py-3 text-sm">@successMessage</div>
    }

    <!-- Search -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
        <div class="flex gap-3">
            <input @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged"
                   placeholder="Search by name or CID..."
                   class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent" />
            <button @onclick="LoadData" disabled="@isLoading"
                    class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-medium transition-colors cursor-pointer disabled:opacity-50">
                @if (isLoading)
                {
                    @Icons.Spinner("h-4 w-4 inline animate-spin mr-1")
                    <span>Loading...</span>
                }
                else
                {
                    <span>Load</span>
                }
            </button>
        </div>
        @if (!hasLoaded)
        {
            <p class="mt-3 text-xs text-slate-400">Click Load to fetch all verified Memorization registrations (excl. 3 Juz).</p>
        }
        else
        {
            <p class="mt-3 text-xs text-slate-400">@filteredRegistrations.Count of @allRegistrations.Count shown</p>
        }
    </div>

    <!-- Results -->
    @if (hasLoaded && filteredRegistrations.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">CID</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Name</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Category</th>
                        <th class="text-left px-4 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Screening Exempt</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var reg in filteredRegistrations)
                    {
                        var categoryName = GetCategoryName(reg.CompetitionSelection.CategoryId);
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-mono text-slate-700">@(reg.Cid ?? "—")</td>
                            <td class="px-4 py-3 text-slate-800 font-medium">
                                @reg.PersonalInfo.FirstName @reg.PersonalInfo.LastName
                            </td>
                            <td class="px-4 py-3 text-slate-500">@categoryName</td>
                            <td class="px-4 py-3">
                                @if (reg.ScreeningExempt == true)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">
                                        @Icons.Check("h-3 w-3 inline") Exempt
                                    </span>
                                }
                                else if (reg.ScreeningExempt == false)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                                        @Icons.XMark("h-3 w-3 inline") Must Screen
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500">
                                        — Not Set
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1 justify-end">
                                    @if (reg.ScreeningExempt != true)
                                    {
                                        <button @onclick="() => SetExempt(reg, true)"
                                                disabled="@(savingId == reg.Id)"
                                                class="px-2 py-1 text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 rounded hover:bg-emerald-100 transition-colors cursor-pointer disabled:opacity-50"
                                                title="Mark as exempt (bypass screening)">
                                            Set Exempt
                                        </button>
                                    }
                                    @if (reg.ScreeningExempt != false)
                                    {
                                        <button @onclick="() => SetExempt(reg, false)"
                                                disabled="@(savingId == reg.Id)"
                                                class="px-2 py-1 text-xs bg-amber-50 text-amber-700 border border-amber-200 rounded hover:bg-amber-100 transition-colors cursor-pointer disabled:opacity-50"
                                                title="Mark as must screen">
                                            Set Screening
                                        </button>
                                    }
                                    @if (reg.ScreeningExempt != null)
                                    {
                                        <button @onclick="() => SetExempt(reg, null)"
                                                disabled="@(savingId == reg.Id)"
                                                class="px-2 py-1 text-xs bg-slate-50 text-slate-500 border border-slate-200 rounded hover:bg-slate-100 transition-colors cursor-pointer disabled:opacity-50"
                                                title="Clear exemption status">
                                            Clear
                                        </button>
                                    }
                                    @if (savingId == reg.Id)
                                    {
                                        @Icons.Spinner("h-4 w-4 text-violet-500 animate-spin ml-1")
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (hasLoaded && filteredRegistrations.Count == 0)
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-10 text-center text-slate-400 text-sm">
            No registrations found matching "@searchTerm".
        </div>
    }
</div>

@code {
    private List<Registration> allRegistrations = new();
    private List<Registration> filteredRegistrations = new();
    private string searchTerm = "";
    private bool isLoading;
    private bool hasLoaded;
    private string? errorMessage;
    private string? successMessage;
    private string? savingId;

    private CompetitionSettings? settings;
    private string? memDivisionId;
    private string? threeJuzCategoryId;

    protected override async Task OnInitializedAsync()
    {
        settings = await SettingsService.GetSettingsAsync();
        if (settings != null)
        {
            var memDiv = settings.Divisions.FirstOrDefault(d =>
                d.Name.Contains("Memorization", StringComparison.OrdinalIgnoreCase) ||
                d.Name.Contains("Hifz", StringComparison.OrdinalIgnoreCase));
            if (memDiv != null)
            {
                memDivisionId = memDiv.Id;
                threeJuzCategoryId = memDiv.Categories
                    .FirstOrDefault(c => c.Name.Contains("3 Juz", StringComparison.OrdinalIgnoreCase))?.Id;
            }
        }
    }

    private async Task LoadData()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            if (memDivisionId == null)
            {
                errorMessage = "Memorization division not found in settings.";
                return;
            }
            var year = settings!.CompetitionInfo.CompetitionYear;
            var all = await RegistrationService.GetAllByYearAsync(year);
            allRegistrations = all
                .Where(r =>
                    r.Status == RegistrationStatus.Verified &&
                    r.CompetitionSelection.DivisionId == memDivisionId &&
                    r.CompetitionSelection.CategoryId != threeJuzCategoryId)
                .OrderBy(r => r.PersonalInfo.LastName)
                .ThenBy(r => r.PersonalInfo.FirstName)
                .ToList();
            hasLoaded = true;
            ApplyFilter();
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private void OnSearchChanged() => ApplyFilter();

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredRegistrations = allRegistrations.ToList();
            return;
        }
        var term = searchTerm.Trim();
        filteredRegistrations = allRegistrations.Where(r =>
            (r.Cid != null && r.Cid.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            r.PersonalInfo.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            r.PersonalInfo.LastName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            $"{r.PersonalInfo.FirstName} {r.PersonalInfo.LastName}".Contains(term, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    private async Task SetExempt(Registration reg, bool? value)
    {
        savingId = reg.Id;
        errorMessage = null;
        successMessage = null;
        try
        {
            await RegistrationService.UpdateScreeningExemptAsync(reg.Id, value);
            reg.ScreeningExempt = value;
            var label = value == true ? "Exempt" : value == false ? "Must Screen" : "Cleared";
            successMessage = $"{reg.PersonalInfo.FirstName} {reg.PersonalInfo.LastName} ({reg.Cid}) → {label}";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { savingId = null; }
    }

    private string GetCategoryName(string categoryId)
    {
        if (settings == null || memDivisionId == null) return categoryId;
        var div = settings.FindDivision(memDivisionId);
        return div?.FindCategory(categoryId)?.Name ?? categoryId;
    }
}
