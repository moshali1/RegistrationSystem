    // ═══════════════════════════════════════════════════════════════════════════
    // CHECK 7: ORPHANED RECORDS
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task RunCheck7()
    {
        check7State = CheckState.Running;
        check7Error = null;
        orphanedProgress = new();
        orphanedBookings = new();
        orphanedCancelledRegistrationIds = new();
        StateHasChanged();

        try
        {
            await EnsureDataLoadedAsync();
            var registrationIds = allRegistrations.Select(r => r.Id).ToHashSet();

            // Orphaned CompetitionProgress
            var allProgress = await CompetitionProgressService.GetAllByYearAsync(competitionYear);
            orphanedProgress = allProgress
                .Where(p => !registrationIds.Contains(p.RegistrationId))
                .ToList();

            // Orphaned SchedulingBookings — split by status
            var allBookings = await SchedulingService.GetAllBookingsAsync();
            var orphanedAll = allBookings.Where(b => !registrationIds.Contains(b.RegistrationId)).ToList();

            orphanedBookings = orphanedAll
                .Where(b => b.Status == BookingStatus.Active)
                .ToList();

            // Cancelled orphaned booking records — group by registration ID for bulk delete
            orphanedCancelledRegistrationIds = orphanedAll
                .Where(b => b.Status == BookingStatus.Cancelled)
                .Select(b => b.RegistrationId)
                .Distinct()
                .ToList();

            check7State = CheckState.Complete;
        }
        catch (Exception ex)
        {
            check7Error = ex.Message;
            check7State = CheckState.Error;
        }

        StateHasChanged();
    }

    private async Task DeleteOrphanedProgressAsync(string registrationId)
    {
        await CompetitionProgressService.DeleteByRegistrationIdAsync(registrationId);
        orphanedProgress.RemoveAll(p => p.RegistrationId == registrationId);
        StateHasChanged();
    }

    private async Task DeleteOrphanedBookingsAsync(string registrationId)
    {
        // Hard-delete all booking records (active and cancelled) for this orphaned registration
        await SchedulingService.DeleteAllBookingsByRegistrationIdAsync(registrationId);
        orphanedBookings.RemoveAll(b => b.RegistrationId == registrationId);
        orphanedCancelledRegistrationIds.Remove(registrationId);
        StateHasChanged();
    }

    private async Task DeleteAllCancelledOrphansAsync()
    {
        foreach (var regId in orphanedCancelledRegistrationIds.ToList())
            await SchedulingService.DeleteAllBookingsByRegistrationIdAsync(regId);
        orphanedCancelledRegistrationIds.Clear();
        StateHasChanged();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // CHECK 8: BOOKING / PROGRESS DRIFT
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task RunCheck8()
    {
        check8State = CheckState.Running;
        check8Error = null;
        driftedBookings = new();
        StateHasChanged();

        try
        {
            await EnsureDataLoadedAsync();
            var settings = await SettingsService.GetSettingsAsync();
            var registrationIds = allRegistrations.Select(r => r.Id).ToHashSet();

            var allBookings = await SchedulingService.GetAllBookingsAsync();
            var activeBookings = allBookings.Where(b => b.Status == BookingStatus.Active && registrationIds.Contains(b.RegistrationId)).ToList();

            if (!activeBookings.Any())
            {
                check8State = CheckState.Complete;
                StateHasChanged();
                return;
            }

            var progressMap = await CompetitionProgressService.GetByRegistrationIdsAsync(
                activeBookings.Select(b => b.RegistrationId).Distinct());

            var sessionMap = settings.SchedulingSessions.ToDictionary(s => s.Id);

            foreach (var booking in activeBookings)
            {
                if (!progressMap.TryGetValue(booking.RegistrationId, out var progress))
                {
                    driftedBookings.Add(new(booking, "No CompetitionProgress record exists for this registration"));
                    continue;
                }

                if (!sessionMap.TryGetValue(booking.SessionId, out var session)) continue;
                if (string.IsNullOrEmpty(session.LinkedRoundName)) continue;

                var roundEntry = progress.Rounds.FirstOrDefault(r =>
                    string.Equals(r.Name, session.LinkedRoundName, StringComparison.OrdinalIgnoreCase));

                if (roundEntry == null)
                {
                    driftedBookings.Add(new(booking, $"Round '{session.LinkedRoundName}' not found in CompetitionProgress"));
                }
                else if (roundEntry.Status != RoundEntryStatus.Scheduled)
                {
                    driftedBookings.Add(new(booking, $"Active booking exists but round status is '{roundEntry.Status}' (expected Scheduled)"));
                }
                else if (roundEntry.ScheduledDateTime.HasValue)
                {
                    // Compare slot time: booking stores Date + TimeUtc, progress stores a DateTimeOffset
                    var bookingUtc = new DateTimeOffset(booking.Date.Year, booking.Date.Month, booking.Date.Day,
                        booking.TimeUtc.Hour, booking.TimeUtc.Minute, 0, TimeSpan.Zero);
                    var diff = Math.Abs((bookingUtc - roundEntry.ScheduledDateTime.Value).TotalMinutes);
                    if (diff > 1)
                    {
                        driftedBookings.Add(new(booking,
                            $"Booking time {booking.TimeUtc:HH:mm} UTC ≠ progress time {roundEntry.ScheduledDateTime.Value.UtcDateTime:HH:mm} UTC"));
                    }
                }
            }

            check8State = CheckState.Complete;
        }
        catch (Exception ex)
        {
            check8Error = ex.Message;
            check8State = CheckState.Error;
        }

        StateHasChanged();
    }

    private async Task CancelDriftedBookingAsync(string bookingId)
    {
        var drift = driftedBookings.FirstOrDefault(d => d.Booking.Id == bookingId);
        if (drift == null) return;
        await SchedulingService.CancelAllByRegistrationIdAsync(drift.Booking.RegistrationId, "Data integrity fix — booking/progress drift");
        driftedBookings.RemoveAll(d => d.Booking.RegistrationId == drift.Booking.RegistrationId);
        StateHasChanged();
    }
