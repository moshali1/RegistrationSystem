@page "/admin/niqab-bypasses"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Messaging
@using RegistrationSystem.Core.Application.NiqabBypasses
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.NiqabBypasses
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Web.Services

@inject NiqabBypassService BypassService
@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject IEmailService EmailService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject NavigationManager NavigationManager

<PageTitle>Niqab Bypass Management</PageTitle>

<div class="space-y-6">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
        <a href="admin/tools" class="hover:text-cyan-600 transition-colors">Admin Tools</a>
        <span>/</span>
        <span class="text-slate-700 font-medium">Niqab Bypass Management</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Niqab Bypass Management</h1>
            <p class="text-sm text-slate-500 mt-1">Generate exception codes for competitors who wear niqab</p>
        </div>
        <button type="button"
                @onclick="ShowCreateModal"
                class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 text-white px-4 py-2 rounded-xl font-medium transition-all cursor-pointer">
            @Icons.Plus("h-5 w-5")
            Generate New Code
        </button>
    </div>

    <!-- Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3 text-sm text-emerald-800 flex items-center justify-between">
            <span>@successMessage</span>
            <button type="button" @onclick="() => successMessage = null" class="text-emerald-600 hover:text-emerald-800 cursor-pointer">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-sm text-red-800 flex items-center justify-between">
            <span>@errorMessage</span>
            <button type="button" @onclick="() => errorMessage = null" class="text-red-600 hover:text-red-800 cursor-pointer">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }

    <!-- Bypasses List -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        @if (isLoading)
        {
            <div class="p-8 text-center">
                @Icons.Spinner("h-8 w-8 text-cyan-600 mx-auto")
                <p class="mt-3 text-sm text-slate-500">Loading bypasses...</p>
            </div>
        }
        else if (bypasses.Count == 0)
        {
            <div class="p-8 text-center">
                <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4">
                    @Icons.Document("h-8 w-8 text-slate-400")
                </div>
                <p class="text-slate-600 font-medium">No bypass codes generated yet</p>
                <p class="text-sm text-slate-500 mt-1">Click "Generate New Code" to create an exception.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Code</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Competitor</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Date of Birth</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Status</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Registration</th>
                            <th class="px-4 py-3 text-left font-semibold text-slate-700">Created</th>
                            <th class="px-4 py-3 text-right font-semibold text-slate-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var bypass in bypasses)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3">
                                    <code class="bg-violet-100 text-violet-800 px-2 py-1 rounded font-mono text-sm">
                                        @bypass.Code
                                    </code>
                                </td>
                                <td class="px-4 py-3 font-medium text-slate-900">
                                    @bypass.FirstName @bypass.LastName
                                    @if (!string.IsNullOrEmpty(bypass.Notes))
                                    {
                                        <p class="text-xs text-slate-400 mt-0.5 truncate max-w-[200px]" title="@bypass.Notes">@bypass.Notes</p>
                                    }
                                </td>
                                <td class="px-4 py-3 text-slate-600">
                                    @bypass.DateOfBirth.ToString("MMM d, yyyy")
                                </td>
                                <td class="px-4 py-3">
                                    @if (bypass.IsUsed && registrationChecks.TryGetValue(bypass.Id, out var check) && check.HasRegistration)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">
                                            @Icons.CheckCircle("h-3 w-3")
                                            Registered
                                        </span>
                                    }
                                    else if (bypass.IsUsed)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                            @Icons.CheckCircle("h-3 w-3")
                                            Claimed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                                            @Icons.Clock("h-3 w-3")
                                            Pending
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (checkingBypassId == bypass.Id)
                                    {
                                        <div class="flex items-center gap-2 text-xs text-slate-500">
                                            @Icons.Spinner("h-3.5 w-3.5")
                                            <span>Checking...</span>
                                        </div>
                                    }
                                    else if (registrationChecks.TryGetValue(bypass.Id, out var regCheck))
                                    {
                                        @if (regCheck.HasRegistration)
                                        {
                                            <div>
                                                <span class="text-xs font-medium text-emerald-700">@regCheck.Cid</span>
                                                <span class="text-xs text-slate-400 mx-1">·</span>
                                                <span class="text-xs text-slate-600">@regCheck.Status</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">No registration found</span>
                                        }
                                        <p class="text-[10px] text-slate-400 mt-0.5">Checked @regCheck.CheckedAt?.FormatCentral("MMM d, h:mm tt")</p>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400">—</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-slate-600">
                                    @bypass.CreatedAt.FormatCentral("MMM d, yyyy")
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button"
                                                @onclick="() => CopyLink(bypass.Code)"
                                                class="text-slate-400 hover:text-cyan-600 p-1.5 rounded transition-colors cursor-pointer"
                                                title="Copy link">
                                            @Icons.Clipboard("h-4 w-4")
                                        </button>
                                        <button type="button"
                                                @onclick="() => CheckRegistration(bypass)"
                                                disabled="@(checkingBypassId == bypass.Id)"
                                                class="text-slate-400 hover:text-cyan-600 p-1.5 rounded transition-colors cursor-pointer disabled:opacity-50"
                                                title="Check registration">
                                            @Icons.Search("h-4 w-4")
                                        </button>
                                        @if (!bypass.IsUsed)
                                        {
                                            <button type="button"
                                                    @onclick="() => ShowEmailModal(bypass)"
                                                    class="text-slate-400 hover:text-cyan-600 p-1.5 rounded transition-colors cursor-pointer"
                                                    title="Send instructions email">
                                                @Icons.Envelope("h-4 w-4")
                                            </button>
                                            <button type="button"
                                                    @onclick="() => DeleteBypass(bypass)"
                                                    class="text-slate-400 hover:text-red-600 p-1.5 rounded transition-colors cursor-pointer"
                                                    title="Delete">
                                                @Icons.Trash("h-4 w-4")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var bypass in bypasses)
                {
                    <div class="p-4 space-y-3">
                        <!-- Card Header -->
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="font-medium text-slate-900 truncate">@bypass.FirstName @bypass.LastName</p>
                                <div class="flex items-center gap-2 mt-1">
                                    <code class="bg-violet-100 text-violet-800 px-1.5 py-0.5 rounded font-mono text-xs">@bypass.Code</code>
                                    <span class="text-xs text-slate-400">@bypass.DateOfBirth.ToString("MMM d, yyyy")</span>
                                </div>
                            </div>
                            <div class="flex-shrink-0">
                                @if (bypass.IsUsed && registrationChecks.TryGetValue(bypass.Id, out var mCheck) && mCheck.HasRegistration)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">
                                        @Icons.CheckCircle("h-3 w-3")
                                        Registered
                                    </span>
                                }
                                else if (bypass.IsUsed)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                                        @Icons.CheckCircle("h-3 w-3")
                                        Claimed
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700">
                                        @Icons.Clock("h-3 w-3")
                                        Pending
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Registration Check Result -->
                        @if (checkingBypassId == bypass.Id)
                        {
                            <div class="flex items-center gap-2 text-xs text-slate-500 bg-slate-50 rounded-lg px-3 py-2">
                                @Icons.Spinner("h-3.5 w-3.5")
                                <span>Checking registration...</span>
                            </div>
                        }
                        else if (registrationChecks.TryGetValue(bypass.Id, out var regCheck))
                        {
                            <div class="bg-slate-50 rounded-lg px-3 py-2">
                                @if (regCheck.HasRegistration)
                                {
                                    <div class="flex items-center gap-2">
                                        @Icons.CheckCircle("h-3.5 w-3.5 text-emerald-500")
                                        <span class="text-xs font-medium text-emerald-700">@regCheck.Cid</span>
                                        <span class="text-xs text-slate-400">·</span>
                                        <span class="text-xs text-slate-600">@regCheck.Status</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">No registration found</span>
                                }
                                <p class="text-[10px] text-slate-400 mt-0.5">Checked @regCheck.CheckedAt?.FormatCentral("MMM d, h:mm tt")</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(bypass.Notes))
                        {
                            <p class="text-xs text-slate-400 truncate" title="@bypass.Notes">@bypass.Notes</p>
                        }

                        <!-- Card Footer / Actions -->
                        <div class="flex items-center gap-1 pt-1 border-t border-slate-100">
                            <button type="button"
                                    @onclick="() => CopyLink(bypass.Code)"
                                    class="flex items-center gap-1.5 text-xs text-slate-500 hover:text-cyan-600 px-2 py-1.5 rounded transition-colors cursor-pointer">
                                @Icons.Clipboard("h-3.5 w-3.5")
                                Copy
                            </button>
                            <button type="button"
                                    @onclick="() => CheckRegistration(bypass)"
                                    disabled="@(checkingBypassId == bypass.Id)"
                                    class="flex items-center gap-1.5 text-xs text-slate-500 hover:text-cyan-600 px-2 py-1.5 rounded transition-colors cursor-pointer disabled:opacity-50">
                                @Icons.Search("h-3.5 w-3.5")
                                Check
                            </button>
                            @if (!bypass.IsUsed)
                            {
                                <button type="button"
                                        @onclick="() => ShowEmailModal(bypass)"
                                        class="flex items-center gap-1.5 text-xs text-slate-500 hover:text-cyan-600 px-2 py-1.5 rounded transition-colors cursor-pointer">
                                    @Icons.Envelope("h-3.5 w-3.5")
                                    Email
                                </button>
                                <button type="button"
                                        @onclick="() => DeleteBypass(bypass)"
                                        class="flex items-center gap-1.5 text-xs text-slate-500 hover:text-red-600 px-2 py-1.5 rounded transition-colors cursor-pointer ml-auto">
                                    @Icons.Trash("h-3.5 w-3.5")
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
@if (showCreateModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" @onclick="CloseCreateModal"></div>

        <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full">
            <div class="px-6 py-4 border-b border-slate-200">
                <h2 class="text-lg font-semibold text-slate-800">Generate Niqab Bypass Code</h2>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">First Name</label>
                    <input type="text" @bind="newFirstName" @bind:event="oninput"
                           class="w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
                           placeholder="Competitor's first name" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Last Name</label>
                    <input type="text" @bind="newLastName" @bind:event="oninput"
                           class="w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
                           placeholder="Competitor's last name" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Date of Birth</label>
                    <input type="date" @bind="newDateOfBirth"
                           class="w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Notes (optional)</label>
                    <textarea @bind="newNotes" rows="2"
                              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
                              placeholder="Any additional notes..."></textarea>
                </div>

                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl px-3 py-2 text-sm text-red-700">
                        @createError
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
                <button type="button"
                        @onclick="CloseCreateModal"
                        class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="CreateBypass"
                        disabled="@isCreating"
                        class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 disabled:opacity-50 text-white rounded-xl font-medium transition-colors flex items-center gap-2 cursor-pointer">
                    @if (isCreating)
                    {
                        @Icons.Spinner("h-4 w-4")
                    }
                    Generate Code
                </button>
            </div>
        </div>
    </div>
}

<!-- Created Code Modal -->
@if (showCodeModal && createdBypass != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" @onclick="CloseCodeModal"></div>

        <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full text-center">
            <div class="p-8">
                <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                    @Icons.CheckCircle("h-8 w-8 text-emerald-600")
                </div>

                <h2 class="text-xl font-semibold text-slate-800 mb-2">Code Generated!</h2>
                <p class="text-slate-600 mb-6">Share this link with <strong>@createdBypass.FirstName @createdBypass.LastName</strong></p>

                <div class="bg-slate-100 rounded-xl p-4 mb-6">
                    <p class="text-xs text-slate-500 mb-2">Bypass Code</p>
                    <code class="text-2xl font-mono font-bold text-violet-700">@createdBypass.Code</code>
                </div>

                <div class="bg-violet-50 rounded-xl p-4 mb-6">
                    <p class="text-xs text-slate-500 mb-2">Full Link</p>
                    <code class="text-sm text-violet-700 break-all">@GetBypassUrl(createdBypass.Code)</code>
                </div>

                <div class="flex gap-3">
                    <button type="button"
                            @onclick="() => CopyLink(createdBypass.Code)"
                            class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-xl font-medium transition-colors cursor-pointer">
                        Copy Link
                    </button>
                    <button type="button"
                            @onclick="CloseCodeModal"
                            class="flex-1 border border-slate-300 hover:bg-slate-50 text-slate-700 px-4 py-2 rounded-xl font-medium transition-colors cursor-pointer">
                        Done
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Send Email Modal -->
@if (showEmailModal && emailBypass != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" @onclick="CloseEmailModal"></div>

        <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full">
            <div class="px-6 py-4 border-b border-slate-200">
                <h2 class="text-lg font-semibold text-slate-800">Send Instructions Email</h2>
            </div>

            <div class="p-6 space-y-4">
                <!-- Bypass info summary -->
                <div class="bg-slate-50 rounded-xl p-4">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-violet-100 flex items-center justify-center flex-shrink-0">
                            @Icons.Document("h-4 w-4 text-violet-600")
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-slate-800">@emailBypass.FirstName @emailBypass.LastName</p>
                            <p class="text-xs text-slate-500">Code: <code class="font-mono text-violet-700">@emailBypass.Code</code></p>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Recipient Email</label>
                    <input type="email" @bind="emailRecipient" @bind:event="oninput"
                           class="w-full rounded-xl border border-slate-300 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"
                           placeholder="Enter email address..." />
                </div>

                <div class="bg-slate-50 rounded-xl p-3 text-xs text-slate-500">
                    <p class="font-medium text-slate-600 mb-1">Email will include:</p>
                    <ul class="space-y-0.5 ml-3 list-disc">
                        <li>Niqab exception approval notification</li>
                        <li>Bypass link: <code class="text-violet-600 font-mono">@GetBypassUrl(emailBypass.Code)</code></li>
                        <li>Step-by-step registration instructions</li>
                        <li>In-person verification requirement</li>
                    </ul>
                </div>

                @if (!string.IsNullOrEmpty(emailError))
                {
                    <div class="bg-red-50 border border-red-200 rounded-xl px-3 py-2 text-sm text-red-700">
                        @emailError
                    </div>
                }
            </div>

            <div class="px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
                <button type="button"
                        @onclick="CloseEmailModal"
                        class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium transition-colors cursor-pointer">
                    Cancel
                </button>
                <button type="button"
                        @onclick="SendInstructionsEmail"
                        disabled="@(isSendingEmail || string.IsNullOrWhiteSpace(emailRecipient))"
                        class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 disabled:opacity-50 text-white rounded-xl font-medium transition-colors flex items-center gap-2 cursor-pointer">
                    @if (isSendingEmail)
                    {
                        @Icons.Spinner("h-4 w-4")
                        <span>Sending...</span>
                    }
                    else
                    {
                        @Icons.Envelope("h-4 w-4")
                        <span>Send Email</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<NiqabBypass> bypasses = new();
    private bool isLoading = true;
    private string? successMessage;
    private string? errorMessage;

    // Create modal
    private bool showCreateModal = false;
    private string newFirstName = string.Empty;
    private string newLastName = string.Empty;
    private DateOnly newDateOfBirth;
    private string? newNotes;
    private string? createError;
    private bool isCreating = false;

    // Code display modal
    private bool showCodeModal = false;
    private NiqabBypass? createdBypass;

    // Registration check
    private Dictionary<string, (bool HasRegistration, string? Status, string? Cid, DateTimeOffset? CheckedAt)> registrationChecks = new();
    private string? checkingBypassId;

    // Send email modal
    private bool showEmailModal = false;
    private NiqabBypass? emailBypass;
    private string emailRecipient = string.Empty;
    private bool isSendingEmail = false;
    private string? emailError;

    private int competitionYear;

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetSettingsAsync();
        competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

        await LoadBypasses();
    }

    private async Task LoadBypasses()
    {
        isLoading = true;
        try
        {
            bypasses = (await BypassService.GetBypassesByYearAsync(competitionYear)).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load bypasses: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // CREATE BYPASS
    // ═══════════════════════════════════════════════════════════════════════════════

    private void ShowCreateModal()
    {
        newFirstName = string.Empty;
        newLastName = string.Empty;
        newDateOfBirth = default;
        newNotes = null;
        createError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private void CloseCodeModal()
    {
        showCodeModal = false;
        createdBypass = null;
    }

    private async Task CreateBypass()
    {
        createError = null;

        if (string.IsNullOrWhiteSpace(newFirstName))
        {
            createError = "First name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newLastName))
        {
            createError = "Last name is required.";
            return;
        }

        if (newDateOfBirth == default)
        {
            createError = "Date of birth is required.";
            return;
        }

        isCreating = true;

        try
        {
            createdBypass = await BypassService.CreateBypassAsync(
                newFirstName.Trim(),
                newLastName.Trim(),
                newDateOfBirth,
                competitionYear,
                notes: newNotes);

            showCreateModal = false;
            showCodeModal = true;

            // Audit log creation
            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogNiqabBypassCreatedAsync(
                createdBypass.Id,
                $"{createdBypass.FirstName} {createdBypass.LastName}",
                createdBypass.Code);

            await LoadBypasses();
        }
        catch (InvalidOperationException ex)
        {
            createError = ex.Message;
        }
        catch (Exception ex)
        {
            createError = $"Failed to create bypass: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // DELETE BYPASS
    // ═══════════════════════════════════════════════════════════════════════════════

    private async Task DeleteBypass(NiqabBypass bypass)
    {
        try
        {
            await BypassService.DeleteBypassAsync(bypass.Id);

            // Audit log deletion
            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogNiqabBypassDeletedAsync(
                bypass.Id,
                $"{bypass.FirstName} {bypass.LastName}",
                bypass.Code);

            successMessage = $"Bypass code for {bypass.FirstName} {bypass.LastName} deleted.";
            await LoadBypasses();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete: {ex.Message}";
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // CHECK REGISTRATION
    // ═══════════════════════════════════════════════════════════════════════════════

    private async Task CheckRegistration(NiqabBypass bypass)
    {
        checkingBypassId = bypass.Id;
        StateHasChanged();

        try
        {
            var matches = await RegistrationService.FindDuplicatesAsync(
                bypass.FirstName,
                bypass.LastName,
                bypass.DateOfBirth,
                competitionYear);

            if (matches.Count > 0)
            {
                var reg = matches[0]; // Take the first match
                registrationChecks[bypass.Id] = (true, reg.Status.ToString(), reg.Cid, DateTimeOffset.Now);
            }
            else
            {
                registrationChecks[bypass.Id] = (false, null, null, DateTimeOffset.Now);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to check registration: {ex.Message}";
        }
        finally
        {
            checkingBypassId = null;
            StateHasChanged();
        }
    }

