                                                            Open
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-xs text-slate-400 font-medium">Closed</span>
                                                    }
                                                </div>

                                                <div class="mt-1 flex items-center gap-3 flex-wrap text-xs text-slate-500">
                                                    @if (!string.IsNullOrEmpty(sess.LinkedRoundName))
                                                    {
                                                        <span class="flex items-center gap-1">
                                                            @Icons.Trophy("h-3 w-3 text-slate-400")
                                                            @sess.LinkedRoundName
                                                        </span>
                                                    }
                                                    @if (sess.GenderFilter != SessionGenderFilter.All)
                                                    {
                                                        <span class="flex items-center gap-1">
                                                            @Icons.Filter("h-3 w-3 text-slate-400")
                                                            @(sess.GenderFilter == SessionGenderFilter.MaleOnly ? "Males only" : "Females only")
                                                        </span>
                                                    }
                                                    @if (sess.GeographicFilter != SessionGeographicFilter.All)
                                                    {
                                                        <span class="flex items-center gap-1">
                                                            @Icons.MapPin("h-3 w-3 text-slate-400")
                                                            @(sess.GeographicFilter == SessionGeographicFilter.MinnesotaOnly ? "MN only" : "Outside MN")
                                                        </span>
                                                    }
                                                    @if (sess.AllowedCategoryIds.Count > 0)
                                                    {
                                                        <span class="flex items-center gap-1">
                                                            @Icons.Boxes("h-3 w-3 text-slate-400")
                                                            @sess.AllowedCategoryIds.Count @(sess.AllowedCategoryIds.Count == 1 ? "category" : "categories")
                                                        </span>
                                                    }
                                                    <span class="flex items-center gap-1">
                                                        @Icons.Clock("h-3 w-3 text-slate-400")
                                                        @activeSlotCount/@slotCount slots active
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1 flex-shrink-0">
                                                <button type="button"
                                                        title="@(sess.IsOpen ? "Close scheduling" : "Open scheduling")"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 @(sess.IsOpen ? "hover:text-amber-600 hover:bg-amber-50" : "hover:text-cyan-700 hover:bg-cyan-50") transition-colors"
                                                        @onclick="() => ToggleSessionOpen(sess)">
                                                    @if (sess.IsOpen)
                                                    {
                                                        @Icons.Lock("h-4 w-4")
                                                    }
                                                    else
                                                    {
                                                        @Icons.Key("h-4 w-4")
                                                    }
                                                </button>
                                                <button type="button"
                                                        title="Manage slots"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-cyan-700 hover:bg-cyan-50 transition-colors"
                                                        @onclick="() => OpenSlotGenerator(sess)">
                                                    @Icons.Plus("h-4 w-4")
                                                </button>
                                                <button type="button"
                                                        title="Set all slot capacities"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-amber-600 hover:bg-amber-50 transition-colors"
                                                        @onclick="() => OpenBulkCapacityModal(sess)">
                                                    @Icons.Users("h-4 w-4")
                                                </button>
                                                <button type="button"
                                                        title="Duplicate session"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-violet-600 hover:bg-violet-50 transition-colors"
                                                        @onclick="() => OpenDuplicateModal(sess)">
                                                    @Icons.Copy("h-4 w-4")
                                                </button>
                                                <button type="button"
                                                        title="Edit session"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-cyan-700 hover:bg-cyan-50 transition-colors"
                                                        @onclick="() => OpenEditSession(sess)">
                                                    @Icons.Edit("h-4 w-4")
                                                </button>
                                                <button type="button"
                                                        title="Delete session"
                                                        class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors"
                                                        @onclick="() => RequestDeleteSession(sess)">
                                                    @Icons.Trash("h-4 w-4")
                                                </button>
                                            </div>
                                        </div>

                                        @* Slot list - grouped by date *@
                                        @if (slotCount > 0)
                                        {
                                            <div class="mt-3 border-t border-slate-100 pt-3">
                                                <div class="space-y-2">
                                                    @foreach (var dateGroup in sess.Slots.GroupBy(s => s.Date).OrderBy(g => g.Key))
                                                    {
                                                        <div>
                                                            <p class="text-xs font-semibold text-slate-500 mb-1">@dateGroup.Key.ToString("ddd, MMM d")</p>
                                                            <div class="flex flex-wrap gap-1">
                                                                @foreach (var slot in dateGroup.OrderBy(s => s.TimeUtc))
                                                                {
                                                                    var slotId = slot.Id;
                                                                    var timeDisplay = SchedulingService.FormatSlotTime(slot.Date, slot.TimeUtc);
                                                                    <div class="flex items-center gap-1 rounded-md border @(slot.IsActive ? "border-slate-200 bg-white" : "border-slate-100 bg-slate-50") px-1.5 py-0.5">
                                                                        <span class="text-xs @(slot.IsActive ? "text-slate-700" : "text-slate-400 line-through")">@timeDisplay</span>
                                                                        @if (editingSlotId == slot.Id)
                                                                        {
                                                                            <input type="number" min="1" max="999"
                                                                                   class="w-10 text-[0.6rem] text-slate-700 font-mono rounded border border-cyan-400 px-1 py-0 focus:outline-none focus:ring-1 focus:ring-cyan-500"
                                                                                   @bind="editingSlotCapacity"
                                                                                   @onkeydown="e => SlotCapacityKeyDown(e, sess, slotId)"
                                                                                   @onblur="() => SaveSlotCapacity(sess, slotId)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <button type="button"
                                                                                    title="Edit capacity"
                                                                                    class="text-[0.6rem] text-slate-400 font-mono hover:text-cyan-600 cursor-pointer"
                                                                                    @onclick="() => StartEditSlotCapacity(slotId, slot.Capacity)">
                                                                                ×@slot.Capacity
                                                                            </button>
                                                                        }
                                                                        <button type="button"
                                                                                title="@(slot.IsActive ? "Deactivate slot" : "Activate slot")"
                                                                                class="cursor-pointer text-slate-300 hover:text-amber-500 transition-colors"
                                                                                @onclick="() => ToggleSlotActive(sess, slotId)">
                                                                            @if (slot.IsActive)
                                                                            {
                                                                                @Icons.Check("h-3 w-3 text-cyan-500")
                                                                            }
                                                                            else
                                                                            {
                                                                                @Icons.XMark("h-3 w-3 text-slate-300")
                                                                            }
                                                                        </button>
                                                                        <button type="button"
                                                                                title="Remove slot"
                                                                                class="cursor-pointer text-slate-300 hover:text-red-500 transition-colors"
                                                                                @onclick="() => RemoveSlot(sess, slotId)">
                                                                            @Icons.XMark("h-3 w-3")
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderPortionBadge(PortionOption opt) => __builder =>
    {
        var (label, icon) = opt switch
        {
            PortionOption.NotApplicable => ("N/A", "—"),
            PortionOption.TopOnly => ("Top", "▲"),
            PortionOption.BottomOnly => ("Bottom", "▼"),
            PortionOption.TopOrBottom => ("Either", "◆"),
            _ => ("?", "?")
        };

        @if (opt == PortionOption.NotApplicable)
        {
            <span class="text-slate-400 text-sm">—</span>
        }
        else
        {
            <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 text-slate-700 px-2 py-0.5 text-xs font-medium border border-slate-200" title="@GetPortionDisplayName(opt)">
                <span class="text-[0.65rem]">@icon</span>@label
            </span>
        }
    };

    private static string GetPortionDisplayName(PortionOption opt) => opt switch
    {
        PortionOption.NotApplicable => "Not Applicable",
        PortionOption.TopOnly => "Top Half Only",
        PortionOption.BottomOnly => "Bottom Half Only",
        PortionOption.TopOrBottom => "Top or Bottom",
        _ => "Unknown"
    };
}
