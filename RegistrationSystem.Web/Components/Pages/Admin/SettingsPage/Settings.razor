    private bool showCopyRoundsModal;
    private string copyRoundsSourceName = "";
    private HashSet<string> copyRoundsTargetIds = new();

    private void OpenCopyRoundsModal()
    {
        if (editingCategory is null) return;
        copyRoundsSourceName = editingCategory.Name;
        copyRoundsTargetIds = new HashSet<string>();
        showCopyRoundsModal = true;
    }

    private void CloseCopyRoundsModal()
    {
        showCopyRoundsModal = false;
        copyRoundsTargetIds = new HashSet<string>();
    }

    private void ToggleCopyTarget(string categoryId)
    {
        if (!copyRoundsTargetIds.Remove(categoryId))
            copyRoundsTargetIds.Add(categoryId);
    }

    private void ApplyCopyRounds()
    {
        if (editingCategory is null) return;

        var sourceRounds = editingCategory.Rounds;

        foreach (var division in settings!.Divisions)
        {
            foreach (var cat in division.Categories)
            {
                if (!copyRoundsTargetIds.Contains(cat.Id)) continue;

                // Deep-clone rounds with new IDs so each category has independent copies
                cat.Rounds = sourceRounds.Select(r => new RoundDefinition
                {
                    Id = Guid.NewGuid().ToString("N"),
                    Order = r.Order,
                    Name = r.Name,
                    HasSchedule = r.HasSchedule,
                    ResultType = r.ResultType,
                    AllowBypass = r.AllowBypass,
                    HasPlacement = r.HasPlacement,
                    PassMessage = r.PassMessage,
                    FailMessage = r.FailMessage,
                    ScheduleDetails = r.ScheduleDetails
                }).ToList();
            }
        }

        var count = copyRoundsTargetIds.Count;
        CloseCopyRoundsModal();
        successMessage = $"Rounds copied to {count} {(count == 1 ? "category" : "categories")}. Save to apply.";
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // SCHEDULING TAB
    // ═══════════════════════════════════════════════════════════════════════════

    // ── state ──────────────────────────────────────────────────────────────────
    private bool showSessionEditorModal;
    private bool isNewSession;
    private SchedulingSession? editingSession;

    private bool showSlotGeneratorModal;
    private SchedulingSession? slotGenTarget;
    private DateOnly slotGenStartDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly slotGenEndDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly slotGenStartTime = new TimeOnly(14, 0);  // 9 AM CT = 14:00 UTC
    private TimeOnly slotGenEndTime = new TimeOnly(22, 0);    // 5 PM CT = 22:00 UTC
    private int slotGenPerHour = 12;
    private int slotGenCapacity = 1;

    private bool showDeleteSessionModal;
    private SchedulingSession? deletingSession;

    private bool showBulkCapacityModal;
    private SchedulingSession? bulkCapacityTarget;
    private int bulkCapacityValue = 1;

    private string? editingSlotId;
    private int editingSlotCapacity;

    private bool showDuplicateModal;
    private SchedulingSession? duplicateSource;
    private string duplicateLabels = string.Empty;
    private string duplicateGroupId = string.Empty;

    // ── session group helpers ──────────────────────────────────────────────────

    private IEnumerable<IGrouping<string?, SchedulingSession>> GetSessionGroups()
    {
        // "Standalone" sessions (null GroupId) each appear alone; grouped sessions appear together
        // We key by GroupId, but for null we use the session Id so each is its own group
        return settings!.SchedulingSessions
            .GroupBy(s => s.GroupId ?? $"__solo__{s.Id}");
    }

    private List<string> GetAllRoundNames()
    {
        return settings!.Divisions
            .SelectMany(d => d.Categories)
            .SelectMany(c => c.Rounds)
            .Select(r => r.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();
    }

    private List<(string Id, string Label)> GetAllCategories()
    {
        return settings!.Divisions
            .SelectMany(d => d.Categories.Select(c => (c.Id, Label: $"{d.Name} – {c.Name}")))
            .OrderBy(x => x.Label)
            .ToList();
    }

    private List<string> GetExistingGroupIds()
    {
        return settings!.SchedulingSessions
            .Where(s => !string.IsNullOrEmpty(s.GroupId))
            .Select(s => s.GroupId!)
            .Distinct()
            .OrderBy(g => g)
            .ToList();
    }

    // ── session CRUD ───────────────────────────────────────────────────────────

    private void OpenAddSession()
    {
        editingSession = new SchedulingSession();
        isNewSession = true;
        showSessionEditorModal = true;
    }

    private void OpenEditSession(SchedulingSession session)
    {
        // Clone for editing so changes are not live until saved
        editingSession = new SchedulingSession
        {
            Id = session.Id,
            Name = session.Name,
            GroupId = session.GroupId,
            SectionLabel = session.SectionLabel,
            LinkedRoundName = session.LinkedRoundName,
            IsOpen = session.IsOpen,
            VirtualLink = session.VirtualLink,
            SchedulingOpensAt = session.SchedulingOpensAt,
            SchedulingClosesAt = session.SchedulingClosesAt,
            GenderFilter = session.GenderFilter,
            GeographicFilter = session.GeographicFilter,
            AllowedCategoryIds = new List<string>(session.AllowedCategoryIds),
            Slots = session.Slots   // slots are managed separately
        };
        isNewSession = false;
        showSessionEditorModal = true;
    }

    private void CloseSessionEditor() { showSessionEditorModal = false; editingSession = null; }

    private void SaveSessionEditor()
    {
        if (editingSession is null) return;
        if (isNewSession)
        {
            settings!.SchedulingSessions.Add(editingSession);
        }
        else
        {
            var idx = settings!.SchedulingSessions.FindIndex(s => s.Id == editingSession.Id);
            if (idx >= 0) settings.SchedulingSessions[idx] = editingSession;
        }
        CloseSessionEditor();
    }

    private void ToggleSessionOpen(SchedulingSession session)
    {
        session.IsOpen = !session.IsOpen;
    }

    private void RequestDeleteSession(SchedulingSession session)
    {
        deletingSession = session;
        showDeleteSessionModal = true;
    }

    private void ConfirmDeleteSession()
    {
        if (deletingSession is not null)
            settings!.SchedulingSessions.Remove(deletingSession);
        showDeleteSessionModal = false;
        deletingSession = null;
    }

    private void OpenDuplicateModal(SchedulingSession session)
    {
        duplicateSource = session;
        duplicateLabels = "B, C, D, E, F, G, H";
        duplicateGroupId = session.GroupId ?? string.Empty;
        showDuplicateModal = true;
    }

    private void CloseDuplicateModal()
    {
        showDuplicateModal = false;
        duplicateSource = null;
    }

    private List<string> ParseDuplicateLabels()
        => duplicateLabels
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => l.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void ConfirmDuplicate()
    {
        if (duplicateSource is null) return;
        var labels = ParseDuplicateLabels();
        var groupId = string.IsNullOrWhiteSpace(duplicateGroupId) ? null : duplicateGroupId.Trim();

        foreach (var label in labels)
        {
            var copy = new SchedulingSession
            {
                Id = Guid.NewGuid().ToString("N"),
                Name = duplicateSource.Name,
                GroupId = groupId,
                SectionLabel = label,
                LinkedRoundName = duplicateSource.LinkedRoundName,
                IsOpen = duplicateSource.IsOpen,
                SchedulingOpensAt = duplicateSource.SchedulingOpensAt,
                SchedulingClosesAt = duplicateSource.SchedulingClosesAt,
                GenderFilter = duplicateSource.GenderFilter,
                GeographicFilter = duplicateSource.GeographicFilter,
                AllowedCategoryIds = new List<string>(duplicateSource.AllowedCategoryIds),
                Slots = duplicateSource.Slots
                    .Select(s => new SchedulingSlot
                    {
                        Id = Guid.NewGuid().ToString("N"),
                        Date = s.Date,
                        TimeUtc = s.TimeUtc,
                        Capacity = s.Capacity,
                        IsActive = s.IsActive
                    })
                    .ToList()
            };
            settings!.SchedulingSessions.Add(copy);
        }

        CloseDuplicateModal();
    }

    private void ToggleCategoryFilter(string categoryId)
    {
        if (editingSession is null) return;
        if (!editingSession.AllowedCategoryIds.Remove(categoryId))
            editingSession.AllowedCategoryIds.Add(categoryId);
    }

    // ── slot generator ─────────────────────────────────────────────────────────

    private void OpenSlotGenerator(SchedulingSession session)
    {
        slotGenTarget = session;
        slotGenStartDate = DateOnly.FromDateTime(DateTime.Today);
        slotGenEndDate = DateOnly.FromDateTime(DateTime.Today);
        slotGenStartTime = new TimeOnly(14, 0);
        slotGenEndTime = new TimeOnly(22, 0);
        slotGenPerHour = 12;
        slotGenCapacity = 1;
        showSlotGeneratorModal = true;
    }

    private void CloseSlotGenerator() { showSlotGeneratorModal = false; slotGenTarget = null; }

    private int SlotGenPreviewCount()
    {
        if (slotGenEndDate < slotGenStartDate || slotGenPerHour <= 0) return 0;
        int days = slotGenEndDate.DayNumber - slotGenStartDate.DayNumber + 1;
        int minutesBetween = (int)(slotGenEndTime - slotGenStartTime).TotalMinutes;
        if (minutesBetween <= 0) return 0;
        int perDay = minutesBetween * slotGenPerHour / 60;
        return days * perDay;
    }

    private void GenerateSlots()
    {
        if (slotGenTarget is null || slotGenPerHour <= 0) return;
        int intervalMinutes = 60 / slotGenPerHour;
        var current = slotGenStartDate;
        while (current <= slotGenEndDate)
        {
            var time = slotGenStartTime;
            while (time < slotGenEndTime)
            {
                slotGenTarget.Slots.Add(new SchedulingSlot
                {
                    Date = current,
                    TimeUtc = time,
                    Capacity = slotGenCapacity,
                    IsActive = true
                });
                time = time.AddMinutes(intervalMinutes);
            }
            current = current.AddDays(1);
        }
        CloseSlotGenerator();
    }

    private void RemoveSlot(SchedulingSession session, string slotId)
    {
        var slot = session.Slots.FirstOrDefault(s => s.Id == slotId);
        if (slot is not null) session.Slots.Remove(slot);
    }

    private void ToggleSlotActive(SchedulingSession session, string slotId)
    {
        var slot = session.Slots.FirstOrDefault(s => s.Id == slotId);
        if (slot is not null) slot.IsActive = !slot.IsActive;
    }

    private void OpenBulkCapacityModal(SchedulingSession session)
    {
        bulkCapacityTarget = session;
        // Pre-fill with the most common current capacity across slots
        bulkCapacityValue = session.Slots.Count > 0
            ? session.Slots.GroupBy(s => s.Capacity).OrderByDescending(g => g.Count()).First().Key
            : 1;
        showBulkCapacityModal = true;
    }

    private void CloseBulkCapacityModal()
    {
        showBulkCapacityModal = false;
        bulkCapacityTarget = null;
    }

    private void ApplyBulkCapacity()
    {
        if (bulkCapacityTarget is null || bulkCapacityValue < 1) return;
        foreach (var slot in bulkCapacityTarget.Slots)
            slot.Capacity = bulkCapacityValue;
        CloseBulkCapacityModal();
    }

    private void StartEditSlotCapacity(string slotId, int currentCapacity)
    {
        editingSlotId = slotId;
        editingSlotCapacity = currentCapacity;
    }

    private void SaveSlotCapacity(SchedulingSession session, string slotId)
    {
        var slot = session.Slots.FirstOrDefault(s => s.Id == slotId);
        if (slot is not null && editingSlotCapacity >= 1)
            slot.Capacity = editingSlotCapacity;
        editingSlotId = null;
    }

    private void SlotCapacityKeyDown(KeyboardEventArgs e, SchedulingSession session, string slotId)
    {
        if (e.Key == "Enter") SaveSlotCapacity(session, slotId);
        else if (e.Key == "Escape") editingSlotId = null;
    }

    // ── render ─────────────────────────────────────────────────────────────────

    private RenderFragment RenderSchedulingTab() => __builder =>
    {
