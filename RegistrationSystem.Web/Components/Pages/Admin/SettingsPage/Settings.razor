@page "/admin/competition-settings"
@attribute [Authorize(Roles = "Admin")]
@namespace RegistrationSystem.Web.Components.Pages.Admin.SettingsPage
@using RegistrationSystem.Web.Components.Pages.Registration

<div class="space-y-6">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-semibold text-slate-800">Competition Settings</h1>
            @if (HasUnsavedChanges)
            {
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    Unsaved
                </span>
            }
        </div>
        <div class="flex items-center gap-2">
            @if (HasUnsavedChanges)
            {
                <button type="button"
                        class="cursor-pointer rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors"
                        @onclick="async () => await ReloadAsync()"
                        disabled="@isSaving">
                    Discard
                </button>
            }
            <button type="button"
                    class="cursor-pointer rounded-xl bg-cyan-700 text-white px-4 py-1.5 text-sm font-medium hover:bg-cyan-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-1.5 shadow-sm"
                    @onclick="SaveAsync"
                    disabled="@(isSaving || !HasUnsavedChanges)">
                @if (isSaving)
                {
                    @Icons.Spinner("animate-spin h-4 w-4")
                }
                Save Changes
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                @Icons.Spinner("h-8 w-8 text-cyan-700 animate-spin")
                <span class="text-sm text-slate-500">Loading settings...</span>
            </div>
        </div>
    }
    else if (settings is not null)
    {
        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2">
                    @Icons.XCircle("h-4 w-4 flex-shrink-0")
                    <span>@errorMessage</span>
                </div>
                <button type="button" class="cursor-pointer text-red-600 hover:text-red-800 transition-colors" @onclick="ClearMessages">
                    @Icons.XMark("h-4 w-4")
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2">
                    @Icons.CheckCircle("h-4 w-4 flex-shrink-0")
                    <span>@successMessage</span>
                </div>
                <button type="button" class="cursor-pointer text-cyan-600 hover:text-cyan-800 transition-colors" @onclick="ClearMessages">
                    @Icons.XMark("h-4 w-4")
                </button>
            </div>
        }

        <!-- Tabs -->
        <div class="border-b border-slate-200">
            <nav class="flex gap-1" aria-label="Tabs">
                <button type="button" class="@GetTabClasses(0) cursor-pointer" @onclick="() => TrySwitchTab(0)">
                    @Icons.ChartBar("h-4 w-4")
                    <span>Status</span>
                </button>
                <button type="button" class="@GetTabClasses(1) cursor-pointer" @onclick="() => TrySwitchTab(1)">
                    @Icons.Calendar("h-4 w-4")
                    <span>Schedule</span>
                </button>
                <button type="button" class="@GetTabClasses(2) cursor-pointer" @onclick="() => TrySwitchTab(2)">
                    @Icons.Boxes("h-4 w-4")
                    <span>Divisions</span>
                </button>
                <button type="button" class="@GetTabClasses(3) cursor-pointer" @onclick="() => TrySwitchTab(3)">
                    @Icons.InfoCircleOutline("h-4 w-4")
                    <span>Competition Info</span>
                </button>
                <button type="button" class="@GetTabClasses(4) cursor-pointer" @onclick="() => TrySwitchTab(4)">
                    @Icons.Cog("h-4 w-4")
                    <span>CID Config</span>
                </button>
            </nav>
        </div>

        <!-- Tab Content with Edit Panel -->
        <div class="flex gap-6">
            <!-- Main content -->
            <div class="flex-1 min-w-0 lg:max-w-[calc(100%-26rem)]">
                @if (activeTab == 0 && globalStatus is not null)
                {
                    @RenderStatusDashboard()
                }
                else if (activeTab == 1)
                {
                    @RenderScheduleTab()
                }
                else if (activeTab == 2)
                {
                    @RenderDivisionsTab()
                }
                else if (activeTab == 3)
                {
                    @RenderCompetitionInfoTab()
                }
                else if (activeTab == 4)
                {
                    @RenderCidConfigTab()
                }
            </div>

            <!-- Edit Panel (right side - desktop) - Always visible on Divisions tab -->
            @if (activeTab == 2)
            {
                <div class="hidden lg:block w-96 flex-shrink-0">
                    <div class="sticky top-4 rounded-xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                        @if (editingCategory is not null)
                        {
                            <CategoryEditPanel Category="editingCategory"
                                               DivisionName="@selectedDivision!.Name"
                                               IsSaving="isSaving"
                                               GlobalStart="settings!.RegistrationStart"
                                               GlobalEnd="settings.RegistrationEnd"
                                               OnClose="TryCloseEditPanel"
                                               OnSave="SaveCategoryEdits"
                                               OnDelete="() => RequestDeleteCategory(selectedDivision!, selectedCategory!)"
                                               OnToggleEnabled="TryToggleEditingCategory"
                                               OnInfoRequested='() => ShowInfo("Category Enable/Disable", GetCategoryEnableExplanation())'
                                               OnScheduleInfoRequested='() => ShowInfo("Schedule Override", GetScheduleOverrideExplanation())'
                                               OnClearOverride="ClearEditingCategoryOverride"
                                               OnEnableOverride="EnableEditingCategoryOverride"
                                               OnStartChanged="SetEditingCategoryStart"
                                               OnEndChanged="SetEditingCategoryEnd"
                                               OnAddRound="OpenAddRound"
                                               OnEditRound="OpenEditRound"
                                               OnDeleteRound="RequestDeleteRound"
                                               OnMoveRoundUp="MoveRoundUp"
                                               OnMoveRoundDown="MoveRoundDown" />
                        }
                        else if (editingDivision is not null)
                        {
                            <DivisionEditPanel Division="editingDivision"
                                               IsSaving="isSaving"
                                               OnClose="TryCloseEditPanel"
                                               OnSave="SaveDivisionEdits"
                                               OnDelete="() => RequestDeleteDivision(selectedDivision!)"
                                               OnToggleEnabled="TryToggleEditingDivision"
                                               OnInfoRequested='() => ShowInfo("Division Enable/Disable", GetDivisionEnableExplanation())' />
                        }
                        else
                        {
                            <EditPanelPlaceholder />
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Mobile Edit Panel (slide-in) -->
        @if (editPanelOpen && (editingDivision is not null || editingCategory is not null))
        {
            <div class="lg:hidden fixed inset-0 z-50">
                <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @onclick="TryCloseEditPanel"></div>
                <div class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl overflow-y-auto">
                    @if (editingCategory is not null)
                    {
                        <CategoryEditPanel Category="editingCategory"
                                           DivisionName="@selectedDivision!.Name"
                                           IsSaving="isSaving"
                                           GlobalStart="settings!.RegistrationStart"
                                           GlobalEnd="settings.RegistrationEnd"
                                           OnClose="TryCloseEditPanel"
                                           OnSave="SaveCategoryEdits"
                                           OnDelete="() => RequestDeleteCategory(selectedDivision!, selectedCategory!)"
                                           OnToggleEnabled="TryToggleEditingCategory"
                                           OnInfoRequested='() => ShowInfo("Category Enable/Disable", GetCategoryEnableExplanation())'
                                           OnScheduleInfoRequested='() => ShowInfo("Schedule Override", GetScheduleOverrideExplanation())'
                                           OnClearOverride="ClearEditingCategoryOverride"
                                           OnEnableOverride="EnableEditingCategoryOverride"
                                           OnStartChanged="SetEditingCategoryStart"
                                           OnEndChanged="SetEditingCategoryEnd"
                                           OnAddRound="OpenAddRound"
                                           OnEditRound="OpenEditRound"
                                           OnDeleteRound="RequestDeleteRound"
                                           OnMoveRoundUp="MoveRoundUp"
                                           OnMoveRoundDown="MoveRoundDown" />
                    }
                    else if (editingDivision is not null)
                    {
                        <DivisionEditPanel Division="editingDivision"
                                           IsSaving="isSaving"
                                           OnClose="TryCloseEditPanel"
                                           OnSave="SaveDivisionEdits"
                                           OnDelete="() => RequestDeleteDivision(selectedDivision!)"
                                           OnToggleEnabled="TryToggleEditingDivision"
                                           OnInfoRequested='() => ShowInfo("Division Enable/Disable", GetDivisionEnableExplanation())' />
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Modals -->
<Modal Visible="@showDeleteModal"
       Title="Confirm Delete"
       IconBgClass="bg-red-600"
       OnBackdropClick="CloseDeleteModal">
    <Icon>@Icons.TrashFilled("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <p>@deleteModalMessage</p>
    </ChildContent>
    <Footer>
        <div class="flex gap-3 justify-end">
            <button type="button"
                    class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                    @onclick="CloseDeleteModal">
                Cancel
            </button>
            <button type="button"
                    class="cursor-pointer rounded-lg bg-red-600 text-white px-4 py-2 text-sm font-medium hover:bg-red-700 transition-colors shadow-sm"
                    @onclick="ConfirmDelete">
                Delete
            </button>
        </div>
    </Footer>
</Modal>

<Modal Visible="@showHierarchyModal"
       Title="Cannot Enable"
       IconBgClass="bg-amber-600"
       OnBackdropClick="CloseHierarchyModal">
    <Icon>@Icons.Warning("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <p>@hierarchyModalMessage</p>
    </ChildContent>
    <Footer>
        <div class="flex justify-end">
            <button type="button"
                    class="cursor-pointer rounded-lg bg-cyan-700 text-white px-5 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm"
                    @onclick="CloseHierarchyModal">
                Understood
            </button>
        </div>
    </Footer>
</Modal>

<Modal Visible="@showInfoModal"
       Title="@infoModalTitle"
       IconBgClass="bg-cyan-600"
       OnBackdropClick="CloseInfoModal">
    <Icon>@Icons.Info("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <div class="prose prose-sm prose-slate">@((MarkupString)infoModalContent)</div>
    </ChildContent>
    <Footer>
        <div class="flex justify-end">
            <button type="button"
                    class="cursor-pointer rounded-lg bg-cyan-700 text-white px-5 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm"
                    @onclick="CloseInfoModal">
                Close
            </button>
        </div>
    </Footer>
</Modal>

<Modal Visible="@showUnsavedWarningModal"
       Title="Unsaved Changes"
       IconBgClass="bg-amber-600"
       AllowBackdropClose="false">
    <Icon>@Icons.Warning("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <p>You have unsaved changes. What would you like to do?</p>
    </ChildContent>
    <Footer>
        <button type="button"
                class="cursor-pointer w-full rounded-lg bg-cyan-700 text-white px-4 py-2.5 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm"
                @onclick="SaveAndSwitchTab">
            Save changes
        </button>
        <button type="button"
                class="cursor-pointer w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                @onclick="ConfirmDiscardAndSwitchTab">
            Discard changes
        </button>
        <button type="button"
                class="cursor-pointer w-full text-sm text-slate-500 hover:text-slate-700 py-2 transition-colors"
                @onclick="CancelTabSwitch">
            Cancel
        </button>
    </Footer>
</Modal>

<Modal Visible="@showUnsavedEditModal"
       Title="Unsaved Edits"
       IconBgClass="bg-amber-600"
       AllowBackdropClose="false">
    <Icon>@Icons.Warning("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <p>You have unsaved edits. Save them before switching?</p>
    </ChildContent>
    <Footer>
        <button type="button"
                class="cursor-pointer w-full rounded-lg bg-cyan-700 text-white px-4 py-2.5 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm"
                @onclick="SaveAndProceedPendingAction">
            Save & continue
        </button>
        <button type="button"
                class="cursor-pointer w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                @onclick="DiscardAndProceedPendingAction">
            Discard & continue
        </button>
        <button type="button"
                class="cursor-pointer w-full text-sm text-slate-500 hover:text-slate-700 py-2 transition-colors"
                @onclick="CancelPendingAction">
            Cancel
        </button>
    </Footer>
</Modal>

<!-- Round Editor Modal -->
<Modal Visible="@showRoundEditorModal"
       Title="@(isNewRound ? "Add Round" : "Edit Round")"
       IconBgClass="bg-cyan-600"
       MaxWidth="max-w-lg"
       OnBackdropClick="CloseRoundEditor">
    <Icon>@Icons.Trophy("h-6 w-6 text-white")</Icon>
    <ChildContent>
        @if (editingRoundDefinition is not null)
        {
            <div class="space-y-4 max-h-[60vh] overflow-y-auto">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Round Name</label>
                    <input type="text" @bind="editingRoundDefinition.Name" @bind:event="oninput"
                           placeholder="e.g., Video Qualification"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Result Type</label>
                    <select @bind="editingRoundDefinition.ResultType"
                            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                        <option value="@RoundResultType.PassFail">Pass / Fail</option>
                        <option value="@RoundResultType.QualifyEliminate">Qualify / Eliminate</option>
                    </select>
                    <p class="text-xs text-slate-500">
                        @(editingRoundDefinition.ResultType == RoundResultType.PassFail
                            ? "Binary pass/fail (e.g., video qualification, screening)"
                            : "Qualified/NotQualified/NoShow (e.g., preliminary, final)")
                    </p>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between py-2.5 px-3 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="flex items-center gap-2">
                            @Icons.Calendar("h-4 w-4 text-slate-500")
                            <div>
                                <label class="text-sm font-medium text-slate-700">Has Schedule</label>
                                <p class="text-xs text-slate-500">Live event with date/time</p>
                            </div>
                        </div>
                        <ToggleSwitch @bind-Value="editingRoundDefinition.HasSchedule" />
                    </div>

                    <div class="flex items-center justify-between py-2.5 px-3 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="flex items-center gap-2">
                            @Icons.ArrowRight("h-4 w-4 text-slate-500")
                            <div>
                                <label class="text-sm font-medium text-slate-700">Allow Bypass</label>
                                <p class="text-xs text-slate-500">Admin can skip this round</p>
                            </div>
                        </div>
                        <ToggleSwitch @bind-Value="editingRoundDefinition.AllowBypass" />
                    </div>

                    <div class="flex items-center justify-between py-2.5 px-3 rounded-lg bg-slate-50 border border-slate-200">
                        <div class="flex items-center gap-2">
                            @Icons.Award("h-4 w-4 text-slate-500")
                            <div>
                                <label class="text-sm font-medium text-slate-700">Has Placement</label>
                                <p class="text-xs text-slate-500">Track 1st, 2nd, 3rd positions</p>
                            </div>
                        </div>
                        <ToggleSwitch @bind-Value="editingRoundDefinition.HasPlacement" />
                    </div>
                </div>

                <div class="border-t border-slate-200 pt-4">
                    <button type="button" class="cursor-pointer flex items-center gap-2 text-xs font-semibold text-slate-700 mb-3"
                            @onclick="() => showRoundMessages = !showRoundMessages">
                        @Icons.Chevron($"h-3.5 w-3.5 text-slate-400 transition-transform duration-200 {(showRoundMessages ? "rotate-90" : "")}")
                        Messages
                        <span class="text-slate-400 font-normal">(optional)</span>
                    </button>

                    @if (showRoundMessages)
                    {
                        <div class="space-y-3">
                            <MessageEditor Label="Pass / Qualify Message"
                                           Description="Shown when competitor advances"
                                           @bind-Value="editingRoundDefinition.PassMessage" />
                            <MessageEditor Label="Fail / Eliminate Message"
                                           Description="Shown when competitor is eliminated"
                                           @bind-Value="editingRoundDefinition.FailMessage" />
                            @if (editingRoundDefinition.HasSchedule)
                            {
                                <MessageEditor Label="Schedule Details"
                                               Description="Venue, directions, parking, requirements"
                                               @bind-Value="editingRoundDefinition.ScheduleDetails" />
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <div class="flex gap-3 justify-end">
            <button type="button"
                    class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                    @onclick="CloseRoundEditor">
                Cancel
            </button>
            <button type="button"
                    class="cursor-pointer rounded-lg bg-cyan-700 text-white px-4 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    @onclick="SaveRoundEditor"
                    disabled="@(string.IsNullOrWhiteSpace(editingRoundDefinition?.Name))">
                @(isNewRound ? "Add Round" : "Save Changes")
            </button>
        </div>
    </Footer>
</Modal>

<!-- Delete Round Confirmation Modal -->
<Modal Visible="@showDeleteRoundModal"
       Title="Delete Round"
       IconBgClass="bg-red-600"
       OnBackdropClick="CloseDeleteRoundModal">
    <Icon>@Icons.TrashFilled("h-6 w-6 text-white")</Icon>
    <ChildContent>
        <p>Are you sure you want to delete the round <strong>"@deleteRoundName"</strong>? Remaining rounds will be renumbered.</p>
    </ChildContent>
    <Footer>
        <div class="flex gap-3 justify-end">
            <button type="button"
                    class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                    @onclick="CloseDeleteRoundModal">
                Cancel
            </button>
            <button type="button"
                    class="cursor-pointer rounded-lg bg-red-600 text-white px-4 py-2 text-sm font-medium hover:bg-red-700 transition-colors shadow-sm"
                    @onclick="ConfirmDeleteRound">
                Delete
            </button>
        </div>
    </Footer>
</Modal>

@code {
    // ═══════════════════════════════════════════════════════════════════════════
    // STATUS DASHBOARD TAB - 4 columns on desktop, 1 on mobile
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStatusDashboard() => __builder =>
    {
        <!-- Hero Status Card -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm mb-4">
            <div class="flex flex-col gap-4">
                <!-- Status indicator -->
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl @(globalStatus!.IsGloballyEnabled ? "bg-cyan-600" : "bg-slate-500") flex items-center justify-center shadow-lg flex-shrink-0">
                        @if (globalStatus.IsGloballyEnabled)
                        {
                            @Icons.CheckCircle("h-6 w-6 text-white")
                        }
                        else
                        {
                            @Icons.XCircle("h-6 w-6 text-white")
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-base font-semibold text-slate-900">
                            Global:
                            <span class="@(globalStatus.IsGloballyEnabled ? "text-cyan-700" : "text-slate-500")">
                                @(globalStatus.IsGloballyEnabled ? "Enabled" : "Disabled")
                            </span>
                        </h2>
                        @if (globalStatus.IsGloballyEnabled && globalStatus.GlobalStart.HasValue && globalStatus.GlobalEnd.HasValue)
                        {
                            <p class="text-xs text-slate-500 mt-0.5 truncate">
                                @globalStatus.GlobalStart.Value.ToString("MMM d") — @globalStatus.GlobalEnd.Value.ToString("MMM d, yyyy")
                                @if (globalStatus.IsWithinGlobalDateWindow)
                                {
                                    <span class="ml-1 inline-flex items-center gap-1 text-cyan-700 font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
                                        Active
                                    </span>
                                }
                            </p>
                        }
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Registration Hierarchy", GetRegistrationHierarchyExplanation())'>
                        @Icons.Info("h-5 w-5")
                    </button>
                </div>

                <!-- Stats grid - 2x2 on mobile, row on desktop -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold @(globalStatus.TotalOpenCategories > 0 ? "text-cyan-700" : "text-slate-400")">
                            @globalStatus.TotalOpenCategories
                        </div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Open</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold text-slate-700">@globalStatus.TotalCategories</div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Total</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold text-slate-700">
                            @globalStatus.EnabledDivisions<span class="text-sm font-normal text-slate-400">/@globalStatus.TotalDivisions</span>
                        </div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Div</div>
                        </div>
                    </div>
                    @if (globalStatus.CategoriesWithOverrides > 0)
                    {
                        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-violet-50 border border-violet-200 shadow-sm">
                            <div class="text-xl font-bold text-violet-700">@globalStatus.CategoriesWithOverrides</div>
                            <div class="text-xs text-violet-700 leading-tight">
                                <div class="font-semibold">OVR</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 shadow-sm">
                            <div class="text-xl font-bold text-slate-400">0</div>
                            <div class="text-xs text-slate-500 leading-tight">
                                <div class="font-semibold">OVR</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Divisions List -->
        @if (globalStatus.Divisions.Count > 0)
        {
            <div class="space-y-3">
                @foreach (var division in globalStatus.Divisions)
                {
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                        <!-- Division header -->
                        <div class="px-3 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="flex-shrink-0 @(division.IsManuallyEnabled ? "text-cyan-600" : "text-slate-400")">
                                    @if (division.IsManuallyEnabled)
                                    {
                                        @Icons.CheckCircle("h-4 w-4")
                                    }
                                    else
                                    {
                                        @Icons.XCircle("h-4 w-4")
                                    }
                                </span>
                                <span class="font-semibold text-slate-900 text-sm truncate">@division.DivisionName</span>
                            </div>
                            <span class="flex-shrink-0 text-xs @(division.OpenCategoryCount > 0 ? "text-cyan-700 font-semibold" : "text-slate-500")">
                                @division.OpenCategoryCount/@division.TotalCategoryCount
                            </span>
                        </div>

                        <!-- Categories - wrap naturally -->
                        @if (division.Categories.Count > 0)
                        {
                            <div class="p-2 flex flex-wrap gap-1.5">
                                @foreach (var cat in division.Categories)
                                {
                                    <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md border text-xs @(cat.IsOpen ? "bg-cyan-50 border-cyan-200 text-cyan-800" : "bg-slate-50 border-slate-200 text-slate-600")">
                                        <span class="@GetStatusDotClasses(cat)"></span>
                                        <span class="truncate max-w-[120px]">@cat.CategoryName</span>
                                        @if (cat.HasOverride)
                                        {
                                            @Icons.Calendar("h-3 w-3 text-violet-500 flex-shrink-0")
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="px-3 py-2.5 text-center text-xs text-slate-400">No categories</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 text-slate-500">
                @Icons.Boxes("mx-auto h-12 w-12 text-slate-300 mb-3")
                <p class="text-sm font-medium">No divisions configured</p>
                <p class="text-xs text-slate-400 mt-1">Go to the Divisions tab to add divisions and categories.</p>
            </div>
        }
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // SCHEDULE TAB - Global toggle + Window in same row on desktop
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderScheduleTab() => __builder =>
    {
        <div class="space-y-4">
            <!-- Global Registration Toggle -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-lg bg-cyan-600 flex items-center justify-center shadow flex-shrink-0">
                            @Icons.Lightning("h-5 w-5 text-white")
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-sm font-semibold text-slate-900">Global Registration</h2>
                            <p class="text-xs text-slate-500">Master switch for all registrations</p>
                        </div>
                        <button type="button"
                                class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                                @onclick='() => ShowInfo("Global Registration", GetGlobalToggleExplanation())'>
                            @Icons.Info("h-4 w-4")
                        </button>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="text-xs font-semibold @(settings!.RegistrationEnabled ? "text-cyan-700" : "text-slate-400")">
                            @(settings.RegistrationEnabled ? "ON" : "OFF")
                        </span>
                        <ToggleSwitch Value="@settings.RegistrationEnabled" OnToggled="ToggleGlobalRegistration" />
                    </div>
                </div>
            </section>

            <!-- Default Window -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-opacity @(settings!.RegistrationEnabled ? "" : "opacity-50 pointer-events-none")">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        @Icons.Calendar("h-5 w-5 text-slate-600")
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-semibold text-slate-900">Default Registration Window</h2>
                        <p class="text-xs text-slate-500">Used for categories without custom dates</p>
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Registration Window", GetRegistrationWindowExplanation())'>
                        @Icons.Info("h-4 w-4")
                    </button>
                </div>
                <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
                    <div class="space-y-1.5">
                        <label class="text-xs font-medium text-slate-700">Start Date</label>
                        <input type="datetime-local"
                               value="@(settings?.RegistrationStart?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                               @onchange="e => SetGlobalStart(e.Value?.ToString())"
                               disabled="@(!settings.RegistrationEnabled)"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 disabled:bg-slate-100 disabled:cursor-not-allowed" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-medium text-slate-700">End Date</label>
                        <input type="datetime-local"
                               value="@(settings?.RegistrationEnd?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                               @onchange="e => SetGlobalEnd(e.Value?.ToString())"
                               disabled="@(!settings.RegistrationEnabled)"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 disabled:bg-slate-100 disabled:cursor-not-allowed" />
                    </div>
                </div>
            </section>

            <!-- Pending Deadline -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
                        @Icons.Clock("h-5 w-5 text-amber-600")
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-semibold text-slate-900">Pending Deadline</h2>
                        <p class="text-xs text-slate-500">Deadline shown in pending status emails for competitors to submit corrections</p>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <input type="date"
                           value="@(settings?.PendingDeadline?.LocalDateTime.ToString("yyyy-MM-dd"))"
                           @onchange="e => SetPendingDeadline(e.Value?.ToString())"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                    @if (settings?.PendingDeadline is null)
                    {
                        <p class="text-xs text-amber-600">Not set — emails will say "as soon as possible"</p>
                    }
                </div>
            </section>

            <!-- Age Cutoff -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        @Icons.User("h-5 w-5 text-slate-600")
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-semibold text-slate-900">Age Cutoff Date</h2>
                        <p class="text-xs text-slate-500">Competitor age is calculated as of this date</p>
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Age Cutoff", GetAgeCutoffExplanation())'>
                        @Icons.Info("h-4 w-4")
                    </button>
                </div>
                <input type="date"
                       value="@ageCutoffDateString"
                       @onchange="OnAgeCutoffChanged"
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 cursor-pointer" />
            </section>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // DIVISIONS TAB
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderDivisionsTab() => __builder =>
    {
        <div class="space-y-3">
            @if (isAddingDivision)
            {
                <div class="rounded-xl border-2 border-dashed border-cyan-300 bg-cyan-50/50 p-3 sm:p-4">
                    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
                        <div class="flex-1">
                            <label class="text-xs font-medium text-slate-700 mb-1.5 block">Division Name</label>
                            <input type="text" @bind="newDivisionName" @bind:event="oninput" placeholder="e.g., Boys, Girls, Adults"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                        <div class="flex gap-2 sm:gap-3">
                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg bg-cyan-700 text-white px-4 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm" @onclick="ConfirmAddDivision">Add</button>
                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors" @onclick="CancelAddDivision">Cancel</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="cursor-pointer inline-flex items-center gap-2 text-sm text-cyan-700 hover:text-cyan-800 font-medium transition-colors" @onclick="StartAddDivision">
                    @Icons.Plus("h-4 w-4")
                    Add new division
                </button>
            }

            @foreach (var division in settings!.Divisions)
            {
                var isExpanded = IsDivisionExpanded(division.Id);
                var isSelected = selectedDivisionId == division.Id && selectedCategory is null;

                <div class="rounded-xl border @(isSelected ? "border-cyan-400 ring-2 ring-cyan-100" : isExpanded ? "border-slate-300" : "border-slate-200") bg-white shadow-sm overflow-hidden transition-all">
                    <div class="px-3 sm:px-4 py-3 bg-slate-50 flex items-center justify-between cursor-pointer hover:bg-slate-100 transition-all"
                         @onclick="() => ToggleDivisionExpand(division.Id)">
                        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                            @Icons.Chevron($"h-4 w-4 text-slate-400 transition-transform duration-200 flex-shrink-0 {(isExpanded ? "rotate-90" : "")}")
                            <span class="flex-shrink-0 @(division.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                @if (division.IsEnabled)
                                {
                                    @Icons.CheckCircle("h-5 w-5")
                                }
                                else
                                {
                                    @Icons.XCircle("h-5 w-5")
                                }
                            </span>
                            <span class="font-semibold text-slate-900 truncate">@division.Name</span>
                            @if (!division.IsEnabled)
                            {
                                <span class="hidden sm:inline-block rounded-full bg-slate-200 px-2 py-0.5 text-[0.65rem] font-semibold uppercase text-slate-600 tracking-wide flex-shrink-0">Disabled</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
                            <span class="text-xs text-slate-500 font-medium hidden sm:inline">@division.Categories.Count categories</span>
                            <span class="text-xs text-slate-500 font-medium sm:hidden">@division.Categories.Count</span>
                            <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 p-1.5 rounded-lg hover:bg-white transition-all"
                                    @onclick:stopPropagation="true" @onclick="() => BeginEditDivision(division)">
                                @Icons.Edit("h-4 w-4")
                            </button>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="p-3 sm:p-4 border-t border-slate-200 bg-white">
                            @if (addingCategoryToDivisionId == division.Id)
                            {
                                <div class="mb-4 rounded-lg border-2 border-dashed border-cyan-300 bg-cyan-50/50 p-3">
                                    <div class="flex flex-col sm:flex-row sm:items-end gap-2">
                                        <div class="flex-1">
                                            <input type="text" @bind="newCategoryName" @bind:event="oninput" placeholder="Category name"
                                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                                        </div>
                                        <div class="flex gap-2">
                                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg bg-cyan-700 text-white px-3 py-1.5 text-xs font-medium hover:bg-cyan-800 transition-colors" @onclick="() => ConfirmAddCategory(division)">Add</button>
                                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" @onclick="CancelAddCategory">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="cursor-pointer mb-4 inline-flex items-center gap-1.5 text-xs text-cyan-700 hover:text-cyan-800 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => StartAddCategory(division.Id)" disabled="@(!settings.RegistrationEnabled || !division.IsEnabled)">
                                    @Icons.Plus("h-3.5 w-3.5")
                                    Add category
                                </button>
                            }

                            @if (division.Categories.Count > 0)
                            {
                                <!-- Mobile: Card layout -->
                                <div class="sm:hidden space-y-2">
                                    @foreach (var category in division.Categories)
                                    {
                                        var catStatus = globalStatus?.Divisions.FirstOrDefault(d => d.DivisionId == division.Id)?.Categories.FirstOrDefault(c => c.CategoryId == category.Id);
                                        var isRowSelected = selectedCategoryId == category.Id;

                                        <div class="@(isRowSelected ? "bg-cyan-50 border-cyan-200" : "bg-slate-50 border-slate-200") border rounded-lg p-3 cursor-pointer active:bg-slate-100 transition-colors"
                                             @onclick="() => BeginEditCategory(division, category)">
                                            <div class="flex items-center justify-between mb-2">
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <span class="flex-shrink-0 @(category.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                                        @if (category.IsEnabled)
                                                        {
                                                            @Icons.CheckCircle("h-4 w-4")
                                                        }
                                                        else
                                                        {
                                                            @Icons.XCircle("h-4 w-4")
                                                        }
                                                    </span>
                                                    <span class="font-medium text-slate-900 truncate">@category.Name</span>
                                                </div>
                                                @if (catStatus is not null)
                                                {
                                                    <span class="@GetStatusBadgeClasses(catStatus) flex-shrink-0">@catStatus.StatusLabel</span>
                                                }
                                            </div>
                                            <div class="flex items-center gap-3 text-xs text-slate-500">
                                                @if (category.MaxAgeYears.HasValue)
                                                {
                                                    <span>≤@category.MaxAgeYears yrs</span>
                                                }
                                                @if (category.PortionOption != PortionOption.NotApplicable)
                                                {
                                                    <span>@GetPortionDisplayName(category.PortionOption)</span>
                                                }
                                                @if (IsCategoryOverrideSaved(category.Id))
                                                {
                                                    <span class="inline-flex items-center gap-1 text-violet-600">
                                                        @Icons.Calendar("h-3 w-3")
                                                        Override
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Desktop: Table layout -->
                                <div class="hidden sm:block overflow-x-auto rounded-lg border border-slate-200">
                                    <table class="w-full text-left">
                                        <thead class="bg-slate-50 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                                            <tr>
                                                <th class="px-3 py-2.5 w-24">Category</th>
                                                <th class="px-3 py-2.5 w-24">Status</th>
                                                <th class="px-3 py-2.5 w-20">Portion</th>
                                                <th class="px-3 py-2.5 w-20">Max Age</th>
                                                <th class="px-3 py-2.5 w-20">Schedule</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            @foreach (var category in division.Categories)
                                            {
                                                var catStatus = globalStatus?.Divisions.FirstOrDefault(d => d.DivisionId == division.Id)?.Categories.FirstOrDefault(c => c.CategoryId == category.Id);
                                                var isRowSelected = selectedCategoryId == category.Id;

                                                <tr class="@(isRowSelected ? "bg-cyan-50" : "hover:bg-slate-50") cursor-pointer transition-colors" @onclick="() => BeginEditCategory(division, category)">
                                                    <td class="px-3 py-2.5">
                                                        <div class="flex items-center gap-2.5">
                                                            <span class="@(category.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                                                @if (category.IsEnabled)
                                                                {
                                                                    @Icons.CheckCircle("h-4 w-4")
                                                                }
                                                                else
                                                                {
                                                                    @Icons.XCircle("h-4 w-4")
                                                                }
                                                            </span>
                                                            <div class="min-w-0">
                                                                <div class="text-sm font-medium text-slate-900 truncate">@category.Name</div>
                                                                @if (!string.IsNullOrEmpty(category.AlternateName))
                                                                {
                                                                    <div class="text-xs text-slate-500 truncate">@category.AlternateName</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2.5">
                                                        @if (catStatus is not null)
                                                        {
                                                            <span class="@GetStatusBadgeClasses(catStatus)">@catStatus.StatusLabel</span>
                                                        }
                                                    </td>
                                                    <td class="px-3 py-2.5">@RenderPortionBadge(category.PortionOption)</td>
                                                    <td class="px-3 py-2.5"><span class="text-sm text-slate-700">@(category.MaxAgeYears.HasValue ? $"≤{category.MaxAgeYears}" : "—")</span></td>
                                                    <td class="px-3 py-2.5">
                                                        @if (IsCategoryOverrideSaved(category.Id))
                                                        {
                                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-violet-100 text-violet-700 border border-violet-200" title="Schedule override active">
                                                                @Icons.Calendar("h-3.5 w-3.5")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-300">—</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-6 text-slate-500 border border-dashed border-slate-200 rounded-lg bg-slate-50/50">
                                    @Icons.Clipboard("mx-auto h-8 w-8 text-slate-300 mb-2")
                                    <p class="text-sm">No categories in this division yet.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (settings.Divisions.Count == 0)
            {
                <div class="text-center py-12 text-slate-500 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50/50">
                    @Icons.Boxes("mx-auto h-12 w-12 text-slate-300 mb-3")
                    <p class="text-sm font-medium text-slate-700">No divisions yet</p>
                    <p class="text-xs text-slate-400 mt-1">Click "Add new division" to get started.</p>
                </div>
            }
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // COMPETITION INFO TAB
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderCompetitionInfoTab() => __builder =>
    {
        <div class="space-y-6 py-4">
            <!-- Competition Details Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-cyan-600 flex items-center justify-center shadow">
                            @Icons.Building("h-4 w-4 text-white")
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">Competition Details</h3>
                            <p class="text-xs text-slate-500">Basic information about this competition</p>
                        </div>
                    </div>
                </div>
                <div class="p-5 space-y-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Competition Name</label>
                        <input type="text"
                               @bind="settings!.CompetitionInfo.CompetitionName"
                               @bind:event="oninput"
                               placeholder="e.g., North America Imam Al-Shatibi Qur'an Competition"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        <p class="text-xs text-slate-500">The official name displayed throughout the registration system</p>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Competition Year</label>
                        <input type="number"
                               @bind="settings!.CompetitionInfo.CompetitionYear"
                               min="2020"
                               max="2100"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        <p class="text-xs text-slate-500">The year this competition takes place</p>
                    </div>
                </div>
            </div>

            <!-- Legal & Policy URLs Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-violet-600 flex items-center justify-center shadow">
                            @Icons.Document("h-4 w-4 text-white")
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">Legal & Policy URLs</h3>
                            <p class="text-xs text-slate-500">Links to legal documents shown during registration</p>
                        </div>
                    </div>
                </div>
                <div class="p-5 space-y-4">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Privacy Policy URL</label>
                        <div class="flex gap-2">
                            <input type="url"
                                   @bind="settings!.CompetitionInfo.PrivacyPolicyUrl"
                                   @bind:event="oninput"
                                   placeholder="https://example.com/privacy-policy"
                                   class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            @if (!string.IsNullOrWhiteSpace(settings!.CompetitionInfo.PrivacyPolicyUrl))
                            {
                                <a href="@settings.CompetitionInfo.PrivacyPolicyUrl" target="_blank" class="inline-flex items-center justify-center px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-slate-500 hover:text-cyan-700 hover:border-cyan-200 transition-colors">
                                    @Icons.ExternalLink("h-4 w-4")
                                </a>
                            }
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Terms of Service URL</label>
                        <div class="flex gap-2">
                            <input type="url"
                                   @bind="settings!.CompetitionInfo.TermsOfServiceUrl"
                                   @bind:event="oninput"
                                   placeholder="https://example.com/terms-of-service"
                                   class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            @if (!string.IsNullOrWhiteSpace(settings!.CompetitionInfo.TermsOfServiceUrl))
                            {
                                <a href="@settings.CompetitionInfo.TermsOfServiceUrl" target="_blank" class="inline-flex items-center justify-center px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-slate-500 hover:text-cyan-700 hover:border-cyan-200 transition-colors">
                                    @Icons.ExternalLink("h-4 w-4")
                                </a>
                            }
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Competition Rules URL</label>
                        <div class="flex gap-2">
                            <input type="url"
                                   @bind="settings!.CompetitionInfo.RulesUrl"
                                   @bind:event="oninput"
                                   placeholder="https://example.com/rules"
                                   class="flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            @if (!string.IsNullOrWhiteSpace(settings!.CompetitionInfo.RulesUrl))
                            {
                                <a href="@settings.CompetitionInfo.RulesUrl" target="_blank" class="inline-flex items-center justify-center px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-slate-500 hover:text-cyan-700 hover:border-cyan-200 transition-colors">
                                    @Icons.ExternalLink("h-4 w-4")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    };

    // ─────────────────────────────────────────────────────────────────────────
    // CID CONFIGURATION TAB
    // ─────────────────────────────────────────────────────────────────────────

    private RenderFragment RenderCidConfigTab() => __builder =>
    {
        <div class="space-y-6 py-4">
            <!-- State Code Mapping Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-cyan-600 flex items-center justify-center shadow">
                            @Icons.Cog("h-4 w-4 text-white")
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">State Code Mapping</h3>
                            <p class="text-xs text-slate-500">Map US state abbreviations to CID region codes</p>
                        </div>
                    </div>
                </div>
                <div class="p-5 space-y-4">
                    @foreach (var kvp in settings!.CidConfiguration.StateCodeMapping.OrderBy(x => x.Key))
                    {
                        var stateKey = kvp.Key;
                        <div class="flex items-center gap-3">
                            <span class="w-12 text-sm font-mono font-semibold text-slate-700 text-center">@stateKey</span>
                            <span class="text-slate-400">→</span>
                            <input type="text"
                                   value="@kvp.Value"
                                   @onchange="(e) => UpdateStateCode(stateKey, e.Value?.ToString())"
                                   class="w-20 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-center font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            <button type="button"
                                    class="cursor-pointer text-slate-400 hover:text-red-600 transition-colors p-1 rounded-lg hover:bg-red-50"
                                    @onclick="() => RemoveStateMapping(stateKey)">
                                @Icons.XMark("h-4 w-4")
                            </button>
                        </div>
                    }

                    <!-- Add new mapping row -->
                    <div class="flex items-center gap-3 pt-2 border-t border-slate-100">
                        <input type="text"
                               @bind="newStateAbbreviation"
                               @bind:event="oninput"
                               placeholder="ST"
                               maxlength="2"
                               class="w-12 rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm text-center font-mono uppercase focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        <span class="text-slate-400">→</span>
                        <input type="text"
                               @bind="newStateCode"
                               @bind:event="oninput"
                               placeholder="Code"
                               class="w-20 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-center font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        <button type="button"
                                class="cursor-pointer text-sm text-cyan-700 hover:text-cyan-900 font-medium flex items-center gap-1 px-2 py-2 rounded-lg hover:bg-cyan-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                disabled="@(string.IsNullOrWhiteSpace(newStateAbbreviation) || string.IsNullOrWhiteSpace(newStateCode))"
                                @onclick="AddStateMapping">
                            @Icons.Plus("h-4 w-4")
                            Add
                        </button>
                    </div>
                </div>
            </div>

            <!-- Default State Code Card -->
            <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                <div class="px-5 py-4 border-b border-slate-200 bg-slate-50">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-slate-500 flex items-center justify-center shadow">
                            @Icons.Shield("h-4 w-4 text-white")
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">Default State Code</h3>
                            <p class="text-xs text-slate-500">Used when a registrant's state has no mapping</p>
                        </div>
                    </div>
                </div>
                <div class="p-5">
                    <div class="space-y-1.5">
                        <label class="text-xs font-semibold text-slate-700">Fallback Code</label>
                        <input type="text"
                               @bind="settings!.CidConfiguration.DefaultStateCode"
                               @bind:event="oninput"
                               class="w-20 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-center font-mono focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        <p class="text-xs text-slate-500">This code is assigned to registrants whose state is not in the mapping above</p>
                    </div>
                </div>
            </div>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderPortionBadge(PortionOption opt) => __builder =>
    {
        var (label, icon) = opt switch
        {
            PortionOption.NotApplicable => ("N/A", "—"),
            PortionOption.TopOnly => ("Top", "▲"),
            PortionOption.BottomOnly => ("Bottom", "▼"),
            PortionOption.TopOrBottom => ("Either", "◆"),
            _ => ("?", "?")
        };

        @if (opt == PortionOption.NotApplicable)
        {
            <span class="text-slate-400 text-sm">—</span>
        }
        else
        {
            <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 text-slate-700 px-2 py-0.5 text-xs font-medium border border-slate-200" title="@GetPortionDisplayName(opt)">
                <span class="text-[0.65rem]">@icon</span>@label
            </span>
        }
    };

    private static string GetPortionDisplayName(PortionOption opt) => opt switch
    {
        PortionOption.NotApplicable => "Not Applicable",
        PortionOption.TopOnly => "Top Half Only",
        PortionOption.BottomOnly => "Bottom Half Only",
        PortionOption.TopOrBottom => "Top or Bottom",
        _ => "Unknown"
    };
}
