@{
    var hasOverride = Category.RegistrationStart.HasValue || Category.RegistrationEnd.HasValue;
}

<div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
    <div>
        <h2 class="text-sm font-semibold text-slate-900">Edit Category</h2>
        <p class="text-xs text-slate-500">@DivisionName</p>
    </div>
    <button type="button" class="cursor-pointer text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-white transition-all" @onclick="OnClose">
        @Icons.XMark("h-5 w-5")
    </button>
</div>

<div class="p-5 space-y-5">
    <div class="space-y-1.5">
        <label class="text-xs font-semibold text-slate-700">Category Name</label>
        <input type="text" @bind="Category.Name" @bind:event="oninput"
               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
    </div>

    <div class="space-y-1.5">
        <label class="text-xs font-semibold text-slate-700">Alternate Name <span class="text-slate-400 font-normal">(optional)</span></label>
        <input type="text" @bind="Category.AlternateName" @bind:event="oninput" placeholder="e.g., Whole Qur'an"
               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
    </div>

    <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200">
        <div class="flex items-center gap-2">
            <label class="text-sm font-medium text-slate-700">Enabled</label>
            <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors" @onclick="OnInfoRequested">
                @Icons.Info("h-4 w-4")
            </button>
        </div>
        <ToggleSwitch Value="@Category.IsEnabled" OnToggled="OnToggleEnabled" />
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700">Portion</label>
            <select @bind="Category.PortionOption" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                @foreach (PortionOption opt in Enum.GetValues<PortionOption>())
                {
                    <option value="@opt">@GetPortionDisplayName(opt)</option>
                }
            </select>
        </div>
        <div class="space-y-1.5">
            <label class="text-xs font-semibold text-slate-700">Max Age</label>
            <InputNumber @bind-Value="Category.MaxAgeYears" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
        </div>
    </div>

    <!-- Video Requirements -->
    <div class="border-t border-slate-200 pt-5">
        <div class="flex items-center justify-between mb-3">
            <label class="text-xs font-semibold text-slate-700">Video Requirements</label>
        </div>
        <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200 mb-3">
            <div class="flex items-center gap-2">
                @Icons.Video("h-4 w-4 text-slate-500")
                <label class="text-sm font-medium text-slate-700">Requires Video Upload</label>
            </div>
            <ToggleSwitch @bind-Value="Category.RequiresVideo" />
        </div>
        @if (Category.RequiresVideo)
        {
            <div class="space-y-1.5">
                <label class="text-xs text-slate-600">Video Instructions</label>
                <textarea @bind="Category.VideoInstructions" @bind:event="oninput"
                          placeholder="e.g., Record Surah Al-Baqarah verses 1-20 with clear audio"
                          rows="3"
                          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"></textarea>
            </div>
        }
    </div>

    <!-- Competition Rounds -->
    <div class="border-t border-slate-200 pt-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                @Icons.Trophy("h-4 w-4 text-slate-500")
                <label class="text-xs font-semibold text-slate-700">Competition Rounds</label>
            </div>
            <span class="text-xs text-slate-400">@Category.Rounds.Count @(Category.Rounds.Count == 1 ? "round" : "rounds")</span>
        </div>

        @if (Category.Rounds.Count > 0)
        {
            var sortedRounds = Category.Rounds.OrderBy(r => r.Order).ToList();
            var minOrder = sortedRounds.First().Order;
            var maxOrder = sortedRounds.Last().Order;

            <div class="space-y-2">
                @foreach (var round in sortedRounds)
                {
                    var isFirst = round.Order == minOrder;
                    var isLast = round.Order == maxOrder;
                    var roundId = round.Id;

                    <div class="rounded-lg border border-slate-200 bg-slate-50 overflow-hidden">
                        <div class="px-3 py-2 flex items-center justify-between">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-5 h-5 rounded-md bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600 flex-shrink-0">
                                    @round.Order
                                </span>
                                <span class="text-sm font-medium text-slate-800 truncate">@round.Name</span>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                @if (round.HasSchedule)
                                {
                                    <span class="text-cyan-600" title="Has Schedule">
                                        @Icons.Calendar("h-3.5 w-3.5")
                                    </span>
                                }
                                @if (round.AllowBypass)
                                {
                                    <span class="text-amber-600" title="Bypass Allowed">
                                        @Icons.ArrowRight("h-3.5 w-3.5")
                                    </span>
                                }
                                @if (round.HasPlacement)
                                {
                                    <span class="text-violet-600" title="Has Placement">
                                        @Icons.Award("h-3.5 w-3.5")
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="px-3 py-1.5 bg-white border-t border-slate-100 flex items-center justify-between">
                            <div class="flex items-center gap-0.5">
                                <button type="button" disabled="@isFirst"
                                        class="cursor-pointer p-1 rounded text-slate-400 hover:text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
                                        @onclick="() => OnMoveRoundUp.InvokeAsync(roundId)">
                                    @Icons.ChevronUp("h-3.5 w-3.5")
                                </button>
                                <button type="button" disabled="@isLast"
                                        class="cursor-pointer p-1 rounded text-slate-400 hover:text-slate-700 disabled:opacity-30 disabled:cursor-not-allowed transition-colors"
                                        @onclick="() => OnMoveRoundDown.InvokeAsync(roundId)">
                                    @Icons.ChevronDown("h-3.5 w-3.5")
                                </button>
                            </div>
                            <div class="flex items-center gap-0.5">
                                <button type="button"
                                        class="cursor-pointer p-1 rounded text-slate-400 hover:text-cyan-700 transition-colors"
                                        @onclick="() => OnEditRound.InvokeAsync(roundId)">
                                    @Icons.Edit("h-3.5 w-3.5")
                                </button>
                                <button type="button"
                                        class="cursor-pointer p-1 rounded text-slate-400 hover:text-red-600 transition-colors"
                                        @onclick="() => OnDeleteRound.InvokeAsync(roundId)">
                                    @Icons.Trash("h-3.5 w-3.5")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50/50 p-4 text-center">
                <p class="text-xs text-slate-500">No rounds configured</p>
                <p class="text-xs text-slate-400 mt-0.5">Add rounds to define the competition pipeline</p>
            </div>
        }

        <div class="mt-3 flex items-center gap-3">
            <button type="button"
                    class="cursor-pointer inline-flex items-center gap-1.5 text-xs text-cyan-700 hover:text-cyan-800 font-medium transition-colors"
                    @onclick="OnAddRound">
                @Icons.Plus("h-3.5 w-3.5")
                Add round
            </button>
            @if (Category.Rounds.Count > 0)
            {
                <button type="button"
                        class="cursor-pointer inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-700 font-medium transition-colors"
                        @onclick="OnCopyRounds">
                    @Icons.Copy("h-3.5 w-3.5")
                    Copy to categories
                </button>
            }
        </div>
    </div>

    <!-- Multiple Registrations -->
    <div class="border-t border-slate-200 pt-5">
        <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2">
                @Icons.Users("h-4 w-4 text-slate-500")
                <div>
                    <label class="text-sm font-medium text-slate-700">Allow Multiple in Division</label>
                    <p class="text-xs text-slate-500">Allow competitor to register for other categories in same division</p>
                </div>
            </div>
            <ToggleSwitch @bind-Value="Category.AllowMultipleInDivision" />
        </div>
    </div>

    <!-- Registration Rules Section -->
    <div class="border-t border-slate-200 pt-5">
        <div class="flex items-center gap-2 mb-4">
            @Icons.Shield("h-4 w-4 text-slate-400")
            <label class="text-xs font-semibold text-slate-700">Registration Rules</label>
        </div>

        <!-- Allow Edit -->
        <div class="flex items-center justify-between py-2">
            <div class="flex items-center gap-3">
                @Icons.EditSquare("h-4 w-4 text-slate-400")
                <div>
                    <label class="text-sm font-medium text-slate-700">Allow Edits</label>
                    <p class="text-xs text-slate-500">Allow users to edit registrations sent back for corrections</p>
                </div>
            </div>
            <ToggleSwitch @bind-Value="Category.AllowEdit" />
        </div>

        <!-- Allow Withdraw -->
        <div class="flex items-center justify-between py-2">
            <div class="flex items-center gap-3">
                @Icons.Ban("h-4 w-4 text-slate-400")
                <div>
                    <label class="text-sm font-medium text-slate-700">Allow Withdrawals</label>
                    <p class="text-xs text-slate-500">Allow users to withdraw their registrations</p>
                </div>
            </div>
            <ToggleSwitch @bind-Value="Category.AllowWithdraw" />
        </div>
    </div>

    <div class="border-t border-slate-200 pt-5">
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <label class="text-xs font-semibold text-slate-700">Schedule Override</label>
                <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors" @onclick="OnScheduleInfoRequested">
                    @Icons.Info("h-4 w-4")
                </button>
            </div>
        </div>

        @if (hasOverride)
        {
            <div class="rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-sm text-violet-800 mb-3 flex items-center justify-between">
                <span class="flex items-center gap-2">
                    @Icons.CheckCircle("h-4 w-4")
                    Override active
                </span>
                <button type="button" class="cursor-pointer text-violet-700 hover:text-violet-900 font-medium text-sm transition-colors" @onclick="OnClearOverride">Clear</button>
            </div>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <label class="text-xs text-slate-600">Start Date & Time</label>
                    <input type="datetime-local"
                           value="@(Category.RegistrationStart?.FormatCentral("yyyy-MM-ddTHH:mm"))"
                           @onchange="e => OnStartChanged.InvokeAsync(e.Value?.ToString())"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs text-slate-600">End Date & Time</label>
                    <input type="datetime-local"
                           value="@(Category.RegistrationEnd?.FormatCentral("yyyy-MM-ddTHH:mm"))"
                           @onchange="e => OnEndChanged.InvokeAsync(e.Value?.ToString())"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                </div>
            </div>
        }
        else
        {
            <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-600">
                <p class="font-medium text-slate-700">Using global schedule</p>
                @if (GlobalStart.HasValue && GlobalEnd.HasValue)
                {
                    <p class="text-xs text-slate-500 mt-1">@GlobalStart.Value.ToString("MMM d") — @GlobalEnd.Value.ToString("MMM d, yyyy")</p>
                }
                <button type="button" class="cursor-pointer mt-3 inline-flex items-center gap-1.5 text-cyan-700 hover:text-cyan-800 font-medium text-sm transition-colors" @onclick="OnEnableOverride">
                    @Icons.Plus("h-4 w-4")
                    Set custom dates
                </button>
            </div>
        }
    </div>
</div>

<div class="px-5 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
    <button type="button" class="cursor-pointer text-sm text-slate-500 hover:text-red-600 transition-colors flex items-center gap-1.5" @onclick="OnDelete">
        @Icons.Trash("h-4 w-4")
        Delete
    </button>
    <button type="button" class="cursor-pointer rounded-lg bg-cyan-700 text-white px-5 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm disabled:opacity-50 flex items-center gap-1.5" @onclick="OnSave" disabled="@IsSaving">
        @if (IsSaving)
        {
            @Icons.Spinner("animate-spin h-4 w-4")
        }
        Save
    </button>
</div>

@code {
    [Parameter, EditorRequired] public Category Category { get; set; } = default!;
    [Parameter] public string DivisionName { get; set; } = string.Empty;
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public DateTimeOffset? GlobalStart { get; set; }
    [Parameter] public DateTimeOffset? GlobalEnd { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnToggleEnabled { get; set; }
    [Parameter] public EventCallback OnInfoRequested { get; set; }
    [Parameter] public EventCallback OnScheduleInfoRequested { get; set; }
    [Parameter] public EventCallback OnClearOverride { get; set; }
    [Parameter] public EventCallback OnEnableOverride { get; set; }
    [Parameter] public EventCallback<string?> OnStartChanged { get; set; }
    [Parameter] public EventCallback<string?> OnEndChanged { get; set; }
    [Parameter] public EventCallback OnAddRound { get; set; }
    [Parameter] public EventCallback<string> OnEditRound { get; set; }
    [Parameter] public EventCallback<string> OnDeleteRound { get; set; }
    [Parameter] public EventCallback<string> OnMoveRoundUp { get; set; }
    [Parameter] public EventCallback<string> OnMoveRoundDown { get; set; }
    [Parameter] public EventCallback OnCopyRounds { get; set; }

    private static string GetPortionDisplayName(PortionOption opt) => opt switch
    {
        PortionOption.NotApplicable => "Not Applicable",
        PortionOption.TopOnly => "Top Half Only",
        PortionOption.BottomOnly => "Bottom Half Only",
        PortionOption.TopOrBottom => "Top or Bottom",
        _ => "Unknown"
    };
}
