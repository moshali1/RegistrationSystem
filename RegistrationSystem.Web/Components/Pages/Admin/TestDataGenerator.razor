    // FILE UPLOAD
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task<FileUploadInfo> BuildFileUploadInfoAsync(
        string firstName, string lastName, DateOnly dob, string divisionName,
        bool requiresVideo, Random random)
    {
        string idStorageRef;
        string photoStorageRef;
        long idSize;
        long photoSize;
        var idDetails = "Test data — placeholder ID document";
        var photoDetails = "Test data — placeholder photo";

        if (uploadSampleImages && sampleIdBytes != null && samplePhotoBytes != null)
        {
            // Upload real sample images to blob storage
            var idContainerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Id);
            var photoContainerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Photo);

            var idBlobName = BlobStorageService.GenerateBlobName(
                FileType.Id, divisionName, firstName, lastName, dob, ".png");
            var photoBlobName = BlobStorageService.GenerateBlobName(
                FileType.Photo, divisionName, firstName, lastName, dob, ".png");

            using var idStream = new MemoryStream(sampleIdBytes);
            await BlobStorageService.UploadAsync(idStream, idContainerName, idBlobName, "image/png");

            using var photoStream = new MemoryStream(samplePhotoBytes);
            await BlobStorageService.UploadAsync(photoStream, photoContainerName, photoBlobName, "image/png");

            idStorageRef = idBlobName;
            photoStorageRef = photoBlobName;
            idSize = sampleIdBytes.Length;
            photoSize = samplePhotoBytes.Length;
            idDetails = "Test data — sample ID uploaded to blob storage";
            photoDetails = "Test data — sample photo uploaded to blob storage";
        }
        else
        {
            // Placeholder references only
            idStorageRef = $"test-placeholder/id-{Guid.NewGuid():N}.png";
            photoStorageRef = $"test-placeholder/photo-{Guid.NewGuid():N}.png";
            idSize = random.Next(100_000, 2_000_000);
            photoSize = random.Next(80_000, 1_500_000);
        }

        return new FileUploadInfo
        {
            IdDocument = new FileMetadata
            {
                FileName = $"TEST_ID_{firstName}_{lastName}.png",
                StorageReference = idStorageRef,
                FileSizeBytes = idSize,
                Extension = ".png",
                ContentType = "image/png",
                ValidationResult = new FileValidationResult { IsValid = true, Details = idDetails }
            },
            Photo = new FileMetadata
            {
                FileName = $"TEST_Photo_{firstName}_{lastName}.png",
                StorageReference = photoStorageRef,
                FileSizeBytes = photoSize,
                Extension = ".png",
                ContentType = "image/png",
                ValidationResult = new FileValidationResult { IsValid = true, Details = photoDetails }
            },
            Video = requiresVideo ? new FileMetadata
            {
                FileName = $"TEST_Video_{firstName}_{lastName}.mp4",
                StorageReference = $"test-placeholder/video-{Guid.NewGuid():N}.mp4",
                FileSizeBytes = random.Next(5_000_000, 50_000_000),
                Extension = ".mp4",
                ContentType = "video/mp4",
                ValidationResult = new FileValidationResult { IsValid = true, Details = "Test data — placeholder video" }
            } : null,
            NiqabBypassApproved = false
        };
    }

