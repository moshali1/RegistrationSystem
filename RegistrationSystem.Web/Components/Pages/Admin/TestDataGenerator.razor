    // DATA GENERATION HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private Gender PickGender(Random rng, int index) => genderDistribution switch
    {
        "male" => Gender.Male,
        "female" => Gender.Female,
        _ => index % 2 == 0 ? Gender.Male : Gender.Female
    };

    private PortionChoice PickPortion(Random rng) => portionDistribution switch
    {
        "top" => PortionChoice.Top,
        "bottom" => PortionChoice.Bottom,
        _ => rng.Next(2) == 0 ? PortionChoice.Top : PortionChoice.Bottom
    };

    private DateOnly GenerateDob(int targetAge, DateOnly cutoffDate)
    {
        var birthYear = cutoffDate.Year - targetAge;
        var month = Random.Shared.Next(1, 13);
        var maxDay = DateTime.DaysInMonth(birthYear, month);
        var day = Random.Shared.Next(1, maxDay + 1);
        return new DateOnly(birthYear, month, day);
    }

    private (string state, string city, string country) PickLocation(Random rng, int index)
    {
        var useMn = regionDistribution switch
        {
            "all-mn" => true,
            "all-other" => false,
            "mostly-mn" => rng.Next(100) < 70,
            _ => rng.Next(100) < 50 // mixed
        };

        if (useMn)
        {
            var city = _mnCities[rng.Next(_mnCities.Length)];
            return ("Minnesota", city, "United States");
        }
        else
        {
            var (state, city) = _otherLocations[rng.Next(_otherLocations.Length)];
            return (state, city, "United States");
        }
    }

    private static string GeneratePhone(Random rng)
    {
        return $"({rng.Next(200, 999):D3}) {rng.Next(200, 999):D3}-{rng.Next(1000, 9999):D4}";
    }

    private static string PickFirstName(Random rng, Gender gender)
    {
        return gender == Gender.Male
            ? _maleFirstNames[rng.Next(_maleFirstNames.Length)]
            : _femaleFirstNames[rng.Next(_femaleFirstNames.Length)];
    }

    private static string PickMiddleName(Random rng, Gender gender)
    {
        return gender == Gender.Male
            ? _maleMiddleNames[rng.Next(_maleMiddleNames.Length)]
            : _femaleMiddleNames[rng.Next(_femaleMiddleNames.Length)];
    }

    private static string GenerateTestCode()
    {
        return "T-" + Guid.NewGuid().ToString("N")[..5].ToUpperInvariant();
    }

    private static string PickInstitution(Random rng)
    {
        return _institutions[rng.Next(_institutions.Length)];
    }

    private void Log(string message, bool isError = false)
    {
        generationLog.Add(new LogEntry(DateTimeOffset.Now, message, isError));
    }

