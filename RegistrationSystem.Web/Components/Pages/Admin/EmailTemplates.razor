@page "/admin/email-templates"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using RegistrationSystem.Core.Application.Messaging
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Messaging
@using RegistrationSystem.Core.Domain.Settings
@inject EmailTemplateService EmailTemplateService
@inject SettingsService SettingsService
@inject NavigationManager NavigationManager
@inject IEmailService EmailService

<PageTitle>Email Templates</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
                <a href="admin/tools" class="hover:text-cyan-600 transition-colors">Admin Tools</a>
                <span>/</span>
                <span class="text-slate-700 font-medium">Email Templates</span>
            </div>
            <h1 class="text-2xl font-bold text-slate-800">Email Templates</h1>
            <p class="text-sm text-slate-500 mt-1">Create and manage reusable email templates with placeholder support</p>
        </div>
        <button type="button" @onclick="CreateNew"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-cyan-600 to-cyan-700
                       text-white text-sm font-semibold rounded-xl shadow-sm hover:from-cyan-700 hover:to-cyan-800
                       transition-all duration-200">
            @Icons.Plus("w-4 h-4")
            New Template
        </button>
    </div>

    <!-- Success / Error Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                @Icons.CheckCircle("h-4 w-4")
                <span>@successMessage</span>
            </div>
            <button type="button" @onclick="() => successMessage = null" class="text-emerald-600 hover:text-emerald-800 transition-colors">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                @Icons.XCircle("h-4 w-4")
                <span>@errorMessage</span>
            </div>
            <button type="button" @onclick="() => errorMessage = null" class="text-red-600 hover:text-red-800 transition-colors">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center min-h-[40vh]">
            <div class="w-16 h-16 rounded-2xl bg-cyan-100 flex items-center justify-center mb-4 animate-pulse">
                @Icons.Envelope("h-8 w-8 text-cyan-600")
            </div>
            <h2 class="text-lg font-semibold text-slate-800 mb-1">Loading Templates</h2>
            <p class="text-sm text-slate-500">Please wait...</p>
        </div>
    }
    else if (templates.Count == 0 && !showEditor)
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center mx-auto mb-5 shadow-lg">
                @Icons.Envelope("h-8 w-8 text-white")
            </div>
            <h3 class="text-xl font-semibold text-slate-800 mb-2">No Email Templates</h3>
            <p class="text-slate-500 mb-6">Create your first template to get started with email notifications.</p>
            <button type="button" @onclick="CreateNew"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-600 to-cyan-700
                           text-white text-sm font-semibold rounded-xl shadow-sm hover:from-cyan-700 hover:to-cyan-800
                           transition-all duration-200">
                @Icons.Plus("w-4 h-4")
                Create First Template
            </button>
        </div>
    }
    else
    {
        <div class="flex gap-6">
            <!-- Template List -->
            <div class="@(showEditor ? "w-1/2" : "w-full") transition-all duration-300">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gradient-to-r from-slate-700 to-slate-800">
                                    <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Template</th>
                                    <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Subject</th>
                                    <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-36">Scope</th>
                                    <th class="text-center px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-24">Status</th>
                                    <th class="text-center px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-36">Updated</th>
                                    <th class="text-center px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-32">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var template in templates)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors @(editingTemplate?.Id == template.Id ? "bg-cyan-50/50 ring-1 ring-inset ring-cyan-200" : "")">
                                        <td class="px-4 py-3.5">
                                            <div class="font-medium text-sm text-slate-800">@template.Name</div>
                                        </td>
                                        <td class="px-4 py-3.5">
                                            <div class="text-sm text-slate-600 truncate max-w-[200px]">@template.Subject</div>
                                        </td>
                                        <td class="px-4 py-3.5">
                                            @{ var scopeText = GetTemplateScopeDisplay(template); }
                                            @if (string.IsNullOrEmpty(template.DivisionId))
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">Global</span>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-slate-600">@scopeText</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3.5 text-center">
                                            @if (template.IsActive)
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                                    Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="px-4 py-3.5 text-center text-xs text-slate-500">
                                            @template.UpdatedAt.ToString("MMM d, yyyy")
                                        </td>
                                        <td class="px-4 py-3.5 text-center">
                                            <div class="flex items-center justify-center gap-1">
                                                <button type="button" @onclick="() => EditTemplate(template)"
                                                        title="Edit"
                                                        class="p-1.5 rounded-lg text-slate-400 hover:text-cyan-600 hover:bg-cyan-50 transition-colors">
                                                    @Icons.Edit("w-4 h-4")
                                                </button>
                                                <button type="button" @onclick="() => PreviewTemplate(template)"
                                                        title="Preview"
                                                        class="p-1.5 rounded-lg text-slate-400 hover:text-violet-600 hover:bg-violet-50 transition-colors">
                                                    @Icons.Eye("w-4 h-4")
                                                </button>
                                                <button type="button" @onclick="() => OpenTestEmailModal(template)"
                                                        title="Send Test Email"
                                                        class="p-1.5 rounded-lg text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition-colors">
                                                    @Icons.Envelope("w-4 h-4")
                                                </button>
                                                <button type="button" @onclick="() => RequestDelete(template)"
                                                        title="Delete"
                                                        class="p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors">
                                                    @Icons.Trash("w-4 h-4")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Placeholder Reference -->
                <div class="mt-4 rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <button type="button" @onclick="() => showPlaceholders = !showPlaceholders"
                            class="w-full px-4 py-3 flex items-center justify-between text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                        <div class="flex items-center gap-2">
                            @Icons.Info("w-4 h-4 text-slate-400")
                            <span>Available Placeholders</span>
                        </div>
                        <svg class="w-4 h-4 text-slate-400 transition-transform @(showPlaceholders ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    @if (showPlaceholders)
                    {
                        <div class="px-4 pb-4 border-t border-slate-100">
                            <div class="mt-3 grid grid-cols-2 gap-2">
                                @foreach (var ph in placeholderDescriptions)
                                {
                                    <div class="flex items-center gap-2 text-xs">
                                        <code class="px-1.5 py-0.5 rounded bg-slate-100 text-cyan-700 font-mono text-[11px]">@ph.Key</code>
                                        <span class="text-slate-500">@ph.Value</span>
                                    </div>
                                }
                            </div>
                            <div class="mt-3 pt-3 border-t border-slate-100">
                                <p class="text-[11px] text-slate-500">
                                    <strong>Per-registration:</strong> CompetitorName, CID, DivisionName, CategoryName, EditUrl, StatusComment.
                                    <strong>Account-grouped:</strong> ParticipantsTable renders a table of all participants in the email. Use with ParentName and SiteUrl for consolidated notifications.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Editor Panel (slide-in) -->
            @if (showEditor && editingTemplate != null)
            {
                <div class="w-1/2 transition-all duration-300">
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-4">
                        <!-- Editor Header -->
                        <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-700 to-slate-800">
                            <div>
                                <h2 class="text-sm font-semibold text-white">
                                    @(isNew ? "New Template" : "Edit Template")
                                </h2>
                                @if (!isNew)
                                {
                                    <p class="text-xs text-slate-400 mt-0.5">@editingTemplate.Name</p>
                                }
                            </div>
                            <button type="button" @onclick="CloseEditor"
                                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors">
                                @Icons.XMark("h-5 w-5")
                            </button>
                        </div>

                        <!-- Editor Form -->
                        <div class="p-5 space-y-4 max-h-[calc(100vh-200px)] overflow-y-auto">
                            <!-- Name -->
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-slate-700">Template Name <span class="text-red-500">*</span></label>
                                <input type="text" @bind="editingTemplate.Name" @bind:event="oninput"
                                       placeholder="e.g. Verified Notification"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                              focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            </div>

                            <!-- Division / Category Scope -->
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-slate-700">Scope</label>
                                <div class="grid grid-cols-2 gap-3">
                                    <select value="@(editingTemplate.DivisionId ?? "")"
                                            @onchange="OnEditorDivisionChanged"
                                            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                                   focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                                        <option value="">All Divisions (global)</option>
                                        @foreach (var div in divisions)
                                        {
                                            <option value="@div.Id">@div.Name</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrEmpty(editingTemplate.DivisionId))
                                    {
                                        <select @bind="editingTemplate.CategoryId"
                                                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                                       focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                                            <option value="">All Categories</option>
                                            @foreach (var cat in editorAvailableCategories)
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        </select>
                                    }
                                </div>
                                <p class="text-[11px] text-slate-500">Optional. Scoped templates only appear when bulk-selecting registrations matching this division/category.</p>
                            </div>

                            <!-- Subject -->
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-slate-700">Subject Line <span class="text-red-500">*</span></label>
                                <input type="text" @bind="editingTemplate.Subject" @bind:event="oninput"
                                       placeholder="e.g. Registration {{CID}} - Verified"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                              focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                            </div>

                            <!-- HTML Body -->
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-slate-700">HTML Body <span class="text-red-500">*</span></label>
                                <textarea @bind="editingTemplate.HtmlBody" @bind:event="oninput"
                                          rows="14"
                                          placeholder="Enter HTML email template..."
                                          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                                 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500
                                                 font-mono text-slate-700 leading-relaxed"></textarea>
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] text-slate-400">@(editingTemplate.HtmlBody?.Length ?? 0) characters</span>
                                    @if (!string.IsNullOrEmpty(editingTemplate.HtmlBody))
                                    {
                                        <button type="button" @onclick="() => PreviewTemplate(editingTemplate)"
                                                class="text-[11px] text-cyan-600 hover:text-cyan-700 font-medium">
                                            Preview HTML
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Plain Text Body -->
                            <div class="space-y-1.5">
                                <label class="text-xs font-semibold text-slate-700">Plain Text Body</label>
                                <textarea @bind="editingTemplate.PlainTextBody" @bind:event="oninput"
                                          rows="6"
                                          placeholder="Plain text fallback (optional)..."
                                          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                                 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500
                                                 font-mono text-slate-700 leading-relaxed"></textarea>
                            </div>

                            <!-- Active Toggle -->
                            <div class="flex items-center justify-between py-2">
                                <div>
                                    <label class="text-xs font-semibold text-slate-700">Active</label>
                                    <p class="text-[11px] text-slate-500">Only active templates appear in template selectors</p>
                                </div>
                                <button type="button" @onclick="() => editingTemplate.IsActive = !editingTemplate.IsActive"
                                        class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent
                                               transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2
                                               @(editingTemplate.IsActive ? "bg-cyan-600" : "bg-slate-200")">
                                    <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0
                                                 transition duration-200 ease-in-out @(editingTemplate.IsActive ? "translate-x-5" : "translate-x-0")"></span>
                                </button>
                            </div>
                        </div>

                        <!-- Editor Footer -->
                        <div class="px-5 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                            <button type="button" @onclick="CloseEditor"
                                    class="text-sm text-slate-500 hover:text-slate-700 transition-colors">
                                Cancel
                            </button>
                            <button type="button" @onclick="SaveTemplateAsync" disabled="@isSaving"
                                    class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-600 to-cyan-700
                                           text-white text-sm font-semibold rounded-lg shadow-sm hover:from-cyan-700 hover:to-cyan-800
                                           disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200">
                                @if (isSaving)
                                {
                                    @Icons.Spinner("animate-spin h-4 w-4")
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>@(isNew ? "Create Template" : "Save Changes")</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Preview Modal -->
    @if (showPreview && previewTemplate != null)
    {
        <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
            <div class="flex min-h-screen items-center justify-center p-4">
                <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"
                     @onclick="() => showPreview = false"></div>
                <div class="relative bg-white rounded-xl shadow-2xl max-w-2xl w-full overflow-hidden border border-slate-200">
                    <!-- Preview Header -->
                    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-700 to-slate-800">
                        <div>
                            <h3 class="text-sm font-semibold text-white">Email Preview</h3>
                            <p class="text-xs text-slate-400 mt-0.5">@previewTemplate.Name</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="SetPreviewHtml"
                                    class="px-2.5 py-1 rounded-md text-xs font-medium transition-colors
                                           @(previewMode == "html" ? "bg-white/20 text-white" : "text-slate-400 hover:text-white")">
                                HTML
                            </button>
                            <button type="button" @onclick="SetPreviewText"
                                    class="px-2.5 py-1 rounded-md text-xs font-medium transition-colors
                                           @(previewMode == "text" ? "bg-white/20 text-white" : "text-slate-400 hover:text-white")">
                                Plain Text
                            </button>
                            <button type="button" @onclick="() => showPreview = false"
                                    class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors ml-2">
                                @Icons.XMark("h-5 w-5")
                            </button>
                        </div>
                    </div>
                    <!-- Subject Preview -->
                    <div class="px-6 py-3 bg-slate-50 border-b border-slate-200">
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-slate-500 font-medium">Subject:</span>
                            <span class="text-slate-800">@RenderPreviewText(previewTemplate.Subject)</span>
                        </div>
                    </div>
                    <!-- Body Preview -->
                    <div class="p-6 max-h-[60vh] overflow-y-auto">
                        @if (previewMode == "html" && !string.IsNullOrEmpty(previewTemplate.HtmlBody))
                        {
                            <div class="border border-slate-200 rounded-lg overflow-hidden">
                                <iframe srcdoc="@RenderPreviewText(previewTemplate.HtmlBody)"
                                        class="w-full min-h-[400px] border-0"
                                        sandbox="allow-same-origin"
                                        title="Email Preview"></iframe>
                            </div>
                        }
                        else if (previewMode == "text" && !string.IsNullOrEmpty(previewTemplate.PlainTextBody))
                        {
                            <pre class="whitespace-pre-wrap text-sm text-slate-700 font-mono leading-relaxed bg-slate-50 rounded-lg p-4 border border-slate-200">@RenderPreviewText(previewTemplate.PlainTextBody)</pre>
                        }
                        else
                        {
                            <div class="text-center py-8 text-sm text-slate-500">
                                No @previewMode content available for this template.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Delete Confirmation Modal -->
    <Modal Visible="@showDeleteModal"
           Title="Delete Template"
           IconBgClass="bg-red-600"
           OnBackdropClick="() => showDeleteModal = false">
        <Icon>@Icons.TrashFilled("h-6 w-6 text-white")</Icon>
        <ChildContent>
            <p>Are you sure you want to delete <strong>@deleteTarget?.Name</strong>? This action cannot be undone.</p>
        </ChildContent>
        <Footer>
            <div class="flex gap-3 justify-end w-full">
                <button type="button" @onclick="() => showDeleteModal = false"
                        class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300
                               rounded-lg hover:bg-slate-50 transition-colors">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDeleteAsync" disabled="@isSaving"
                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white
                               bg-red-600 rounded-lg hover:bg-red-700 disabled:opacity-50 transition-colors">
                    @if (isSaving)
                    {
                        @Icons.Spinner("animate-spin h-4 w-4")
                    }
                    Delete
                </button>
            </div>
        </Footer>
    </Modal>

    <!-- Send Test Email Modal -->
    @if (showTestEmailModal && testEmailTemplate != null)
    {
        <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
            <div class="flex min-h-screen items-center justify-center p-4">
                <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"
                     @onclick="CloseTestEmailModal"></div>
                <div class="relative bg-white rounded-xl shadow-2xl max-w-lg w-full overflow-hidden border border-slate-200">
                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-700 to-slate-800">
                        <div>
                            <h3 class="text-sm font-semibold text-white">Send Test Email</h3>
                            <p class="text-xs text-slate-400 mt-0.5">@testEmailTemplate.Name</p>
                        </div>
                        <button type="button" @onclick="CloseTestEmailModal"
                                class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition-colors">
                            @Icons.XMark("h-5 w-5")
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5">
                        <!-- Recipient Email -->
                        <div class="space-y-1.5">
                            <label class="text-xs font-semibold text-slate-700">Recipient Email <span class="text-red-500">*</span></label>
                            <input type="email" @bind="testEmailAddress" @bind:event="oninput"
                                   placeholder="you@example.com"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                          focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>

                        <!-- Recipient Name -->
                        <div class="space-y-1.5">
                            <label class="text-xs font-semibold text-slate-700">Recipient Name</label>
                            <input type="text" @bind="testEmailRecipientName" @bind:event="oninput"
                                   placeholder="Test Recipient"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm
                                          focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>

                        <!-- Sample Data Notice -->
                        <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                            <p class="text-xs font-semibold text-slate-700 mb-2">Sample placeholder data</p>
                            <div class="grid grid-cols-2 gap-x-4 gap-y-1">
                                @foreach (var kv in samplePlaceholders.Where(p => p.Key != "{{ParticipantsTable}}"))
                                {
                                    <div class="flex items-center gap-1.5 text-[11px]">
                                        <code class="text-cyan-700 font-mono">@kv.Key</code>
                                        <span class="text-slate-400">=</span>
                                        <span class="text-slate-600 truncate">@kv.Value</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Test Email Result -->
                        @if (!string.IsNullOrEmpty(testEmailResult))
                        {
                            <div class="rounded-lg border px-4 py-3 text-sm flex items-center gap-2
                                        @(testEmailSuccess ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-red-200 bg-red-50 text-red-800")">
                                @if (testEmailSuccess)
                                {
                                    @Icons.CheckCircle("h-4 w-4")
                                }
                                else
                                {
                                    @Icons.XCircle("h-4 w-4")
                                }
                                <span>@testEmailResult</span>
                            </div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                        <button type="button" @onclick="CloseTestEmailModal"
                                class="text-sm text-slate-500 hover:text-slate-700 transition-colors">
                            Cancel
                        </button>
                        <button type="button" @onclick="SendTestEmailAsync"
                                disabled="@(isSendingTest || string.IsNullOrWhiteSpace(testEmailAddress))"
                                class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-600 to-cyan-700
                                       text-white text-sm font-semibold rounded-lg shadow-sm hover:from-cyan-700 hover:to-cyan-800
                                       disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200">
                            @if (isSendingTest)
                            {
                                @Icons.Spinner("animate-spin h-4 w-4")
                                <span>Sending...</span>
                            }
                            else
                            {
                                @Icons.Envelope("h-4 w-4")
                                <span>Send Test</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ═══════════════════════════════════════════════════════════════
    // STATE
    // ═══════════════════════════════════════════════════════════════
    private List<EmailTemplate> templates = new();
    private EmailTemplate? editingTemplate;
    private EmailTemplate? previewTemplate;
    private EmailTemplate? deleteTarget;

    private bool isLoading = true;
    private bool isSaving;
    private bool showEditor;
    private bool isNew;
    private bool showPreview;
    private string previewMode = "html";
    private bool showDeleteModal;
    private bool showPlaceholders;

    private string? successMessage;
    private string? errorMessage;

    // Test email state
    private bool showTestEmailModal;
    private bool isSendingTest;
    private bool testEmailSuccess;
    private EmailTemplate? testEmailTemplate;
    private string testEmailAddress = string.Empty;
    private string testEmailRecipientName = "Test Recipient";
    private string? testEmailResult;

    // Division/Category data for scope dropdowns
    private List<Division> divisions = new();
    private List<Category> editorAvailableCategories = new();

    private static readonly Dictionary<string, string> placeholderDescriptions = new()
    {
        ["{{CompetitorName}}"] = "Full name",
        ["{{CID}}"] = "Competition ID",
        ["{{DivisionName}}"] = "Division",
        ["{{CategoryName}}"] = "Category",
        ["{{ParentName}}"] = "Parent/Guardian",
        ["{{StatusComment}}"] = "Status comment",
        ["{{Deadline}}"] = "Registration deadline date",
        ["{{SiteUrl}}"] = "Competition site URL",
        ["{{EditUrl}}"] = "Registration edit URL",
        ["{{ParticipantsTable}}"] = "Participants table (account-grouped)"
    };

    private static readonly string sampleParticipantsTableHtml = EmailTemplateService.BuildParticipantsTableHtml(new List<ParticipantRow>
    {
        new("IS-2026-0042", "Ahmad bin Khalid", "Youth", "10 Juz", "Top"),
        new("IS-2026-0043", "Fatimah bint Khalid", "Youth", "5 Juz", null)
    });

    private static readonly string sampleParticipantsTablePlainText = EmailTemplateService.BuildParticipantsTablePlainText(new List<ParticipantRow>
    {
        new("IS-2026-0042", "Ahmad bin Khalid", "Youth", "10 Juz", "Top"),
        new("IS-2026-0043", "Fatimah bint Khalid", "Youth", "5 Juz", null)
    });

    // Built at runtime so {{SiteUrl}} resolves to the current host (localhost in dev, production URL in prod)
    private Dictionary<string, string> samplePlaceholders = new();
    private Dictionary<string, string> samplePlainTextPlaceholders = new();

    private void BuildSamplePlaceholders()
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');

        samplePlaceholders = new Dictionary<string, string>
        {
            ["{{CompetitorName}}"] = "Ahmad bin Khalid",
            ["{{CID}}"] = "IS-2026-0042",
            ["{{DivisionName}}"] = "Youth",
            ["{{CategoryName}}"] = "10 Juz",
            ["{{ParentName}}"] = "Khalid Al-Rashid",
            ["{{StatusComment}}"] = "Missing ID document photo",
            ["{{Deadline}}"] = "June 15, 2026",
            ["{{SiteUrl}}"] = baseUrl,
            ["{{EditUrl}}"] = $"{baseUrl}/edit/123",
            ["{{ParticipantsTable}}"] = sampleParticipantsTableHtml
        };

        samplePlainTextPlaceholders = new Dictionary<string, string>
        {
            ["{{CompetitorName}}"] = "Ahmad bin Khalid",
            ["{{CID}}"] = "IS-2026-0042",
            ["{{DivisionName}}"] = "Youth",
            ["{{CategoryName}}"] = "10 Juz",
            ["{{ParentName}}"] = "Khalid Al-Rashid",
            ["{{StatusComment}}"] = "Missing ID document photo",
            ["{{Deadline}}"] = "June 15, 2026",
            ["{{SiteUrl}}"] = baseUrl,
            ["{{EditUrl}}"] = $"{baseUrl}/edit/123",
            ["{{ParticipantsTable}}"] = sampleParticipantsTablePlainText
        };
    }

    // ═══════════════════════════════════════════════════════════════
    // LIFECYCLE
    // ═══════════════════════════════════════════════════════════════
    protected override async Task OnInitializedAsync()
    {
        BuildSamplePlaceholders();
        var settings = await SettingsService.GetSettingsAsync();
        divisions = settings?.Divisions.Where(d => d.IsEnabled).ToList() ?? new();
        await LoadTemplatesAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        isLoading = true;
        ClearMessages();
        StateHasChanged();

        try
        {
            templates = await EmailTemplateService.GetAllAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading templates: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // CRUD
    // ═══════════════════════════════════════════════════════════════
    private void CreateNew()
    {
        editingTemplate = new EmailTemplate();
        editorAvailableCategories = new();
        isNew = true;
        showEditor = true;
        ClearMessages();
    }

    private void EditTemplate(EmailTemplate template)
    {
        // Clone to avoid modifying the list item directly
        editingTemplate = new EmailTemplate
        {
            Id = template.Id,
            Name = template.Name,
            Subject = template.Subject,
            HtmlBody = template.HtmlBody,
            PlainTextBody = template.PlainTextBody,
            IsActive = template.IsActive,
            DivisionId = template.DivisionId,
            CategoryId = template.CategoryId,
            CreatedAt = template.CreatedAt,
            UpdatedAt = template.UpdatedAt
        };

        // Populate categories for the selected division
        if (!string.IsNullOrEmpty(editingTemplate.DivisionId))
        {
            var division = divisions.FirstOrDefault(d => d.Id == editingTemplate.DivisionId);
            editorAvailableCategories = division?.Categories.Where(c => c.IsEnabled).ToList() ?? new();
        }
        else
        {
            editorAvailableCategories = new();
        }

        isNew = false;
        showEditor = true;
        ClearMessages();
    }

    private async Task SaveTemplateAsync()
    {
        if (editingTemplate is null) return;

        isSaving = true;
        ClearMessages();

        try
        {
            await EmailTemplateService.SaveAsync(editingTemplate);
            successMessage = isNew ? "Template created successfully!" : "Template updated successfully!";
            showEditor = false;
            editingTemplate = null;
            await LoadTemplatesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void RequestDelete(EmailTemplate template)
    {
        deleteTarget = template;
        showDeleteModal = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteTarget is null) return;

        isSaving = true;
        ClearMessages();

        try
        {
            await EmailTemplateService.DeleteAsync(deleteTarget.Id);
            successMessage = $"Template \"{deleteTarget.Name}\" deleted.";
            showDeleteModal = false;
            deleteTarget = null;

            // If we were editing the deleted template, close the editor
            if (editingTemplate?.Id == deleteTarget?.Id)
            {
                showEditor = false;
                editingTemplate = null;
            }

            await LoadTemplatesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting template: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // PREVIEW
    // ═══════════════════════════════════════════════════════════════
    private void PreviewTemplate(EmailTemplate template)
    {
        previewTemplate = template;
        previewMode = "html";
        showPreview = true;
    }

    private string RenderPreviewText(string content)
    {
        if (string.IsNullOrEmpty(content)) return content;

        // Use the appropriate sample placeholders based on content type
        var placeholders = previewMode == "text" ? samplePlainTextPlaceholders : samplePlaceholders;
        foreach (var (placeholder, value) in placeholders)
        {
            content = content.Replace(placeholder, value, StringComparison.OrdinalIgnoreCase);
        }

        return content;
    }

    // ═══════════════════════════════════════════════════════════════
    // DIVISION/CATEGORY SCOPE
    // ═══════════════════════════════════════════════════════════════
    private void OnEditorDivisionChanged(ChangeEventArgs e)
    {
        if (editingTemplate is null) return;

        var divisionId = e.Value?.ToString();
        editingTemplate.DivisionId = string.IsNullOrEmpty(divisionId) ? null : divisionId;
        editingTemplate.CategoryId = null;

        if (!string.IsNullOrEmpty(editingTemplate.DivisionId))
        {
            var division = divisions.FirstOrDefault(d => d.Id == editingTemplate.DivisionId);
            editorAvailableCategories = division?.Categories.Where(c => c.IsEnabled).ToList() ?? new();
        }
        else
        {
            editorAvailableCategories = new();
        }
    }

    private string GetTemplateScopeDisplay(EmailTemplate template)
    {
        if (string.IsNullOrEmpty(template.DivisionId))
            return "Global";

        var divisionName = divisions.FirstOrDefault(d => d.Id == template.DivisionId)?.Name ?? "Unknown";

        if (string.IsNullOrEmpty(template.CategoryId))
            return divisionName;

        var division = divisions.FirstOrDefault(d => d.Id == template.DivisionId);
        var categoryName = division?.Categories.FirstOrDefault(c => c.Id == template.CategoryId)?.Name ?? "Unknown";
        return $"{divisionName} / {categoryName}";
    }

    // ═══════════════════════════════════════════════════════════════
    // TEST EMAIL
    // ═══════════════════════════════════════════════════════════════
    private void OpenTestEmailModal(EmailTemplate template)
    {
        testEmailTemplate = template;
        testEmailAddress = string.Empty;
        testEmailRecipientName = "Test Recipient";
        testEmailResult = null;
        testEmailSuccess = false;
        showTestEmailModal = true;
    }

    private void CloseTestEmailModal()
    {
        showTestEmailModal = false;
        testEmailTemplate = null;
        testEmailResult = null;
    }

    private async Task SendTestEmailAsync()
    {
        if (testEmailTemplate is null || string.IsNullOrWhiteSpace(testEmailAddress)) return;

        isSendingTest = true;
        testEmailResult = null;
        StateHasChanged();

        try
        {
            // Render template with the same sample placeholders used in preview
            var (subject, plainText, html) = EmailTemplateService.RenderTemplate(
                testEmailTemplate, samplePlaceholders, samplePlainTextPlaceholders);

            // Prefix subject so recipient knows it's a test
            subject = $"[TEST] {subject}";

            var sent = await EmailService.SendEmailAsync(
                testEmailAddress.Trim(),
                testEmailRecipientName.Trim(),
                subject,
                plainText,
                html);

            if (sent)
            {
                testEmailSuccess = true;
                testEmailResult = $"Test email sent to {testEmailAddress}";
            }
            else
            {
                testEmailSuccess = false;
                testEmailResult = "Email service returned failure. Check SendGrid configuration.";
            }
        }
        catch (Exception ex)
        {
            testEmailSuccess = false;
            testEmailResult = $"Failed to send: {ex.Message}";
        }
        finally
        {
            isSendingTest = false;
            StateHasChanged();
        }
    }

    // ═══════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════
    private void CloseEditor()
    {
        showEditor = false;
        editingTemplate = null;
    }

    private void SetPreviewHtml() => previewMode = "html";
    private void SetPreviewText() => previewMode = "text";

    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
    }
}
