    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: Spacing & Layout                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="spacing">
        <SectionHeader Title="Spacing & Layout" Subtitle="Consistent spacing patterns and responsive breakpoints" />

        <div class="mt-4 bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-6">
            <!-- Spacing Scale -->
            <div class="space-y-3">
                <h3 class="text-sm font-semibold text-slate-700">Common Spacing Scale</h3>
                <div class="space-y-2">
                    @foreach (var (name, rem, desc) in spacingScale)
                    {
                        <div class="flex items-center gap-4">
                            <span class="text-xs text-slate-400 w-12 shrink-0 text-right font-mono">@name</span>
                            <div class="h-3 bg-cyan-500 rounded" style="width: @rem"></div>
                            <span class="text-xs text-slate-500">@desc</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Breakpoints -->
            <div class="space-y-3">
                <h3 class="text-sm font-semibold text-slate-700">Responsive Breakpoints</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-200">
                                <th class="text-left py-2 pr-4 font-semibold text-slate-600 text-xs uppercase">Prefix</th>
                                <th class="text-left py-2 pr-4 font-semibold text-slate-600 text-xs uppercase">Min-Width</th>
                                <th class="text-left py-2 font-semibold text-slate-600 text-xs uppercase">Usage</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <tr>
                                <td class="py-2 pr-4 font-mono text-xs text-cyan-700">(default)</td>
                                <td class="py-2 pr-4 text-slate-600">0px</td>
                                <td class="py-2 text-slate-500">Mobile-first base styles</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4 font-mono text-xs text-cyan-700">sm:</td>
                                <td class="py-2 pr-4 text-slate-600">640px</td>
                                <td class="py-2 text-slate-500">Rarely used — small tablets</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4 font-mono text-xs text-cyan-700 font-bold">md:</td>
                                <td class="py-2 pr-4 text-slate-600 font-medium">768px</td>
                                <td class="py-2 text-slate-500 font-medium">Primary breakpoint — table ↔ card, sidebar toggle</td>
                            </tr>
                            <tr>
                                <td class="py-2 pr-4 font-mono text-xs text-cyan-700">lg:</td>
                                <td class="py-2 pr-4 text-slate-600">1024px</td>
                                <td class="py-2 text-slate-500">Large padding <code class="bg-slate-100 px-1 py-0.5 rounded text-xs">lg:p-8</code></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Page Wrapper -->
            <div class="space-y-3">
                <h3 class="text-sm font-semibold text-slate-700">Page Wrapper Pattern</h3>
                <div class="bg-slate-50 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600">
                    All pages wrap content in <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs">&lt;div class="space-y-6"&gt;</code>.
                    Main layout provides <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs">p-4 md:p-6 lg:p-8</code> padding.
                    Never use <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs line-through">max-w-* mx-auto</code> — let content fill the container.
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION: Breadcrumbs                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="breadcrumbs">
        <SectionHeader Title="Breadcrumbs" Subtitle="Navigation breadcrumb pattern for sub-pages" />

        <div class="mt-4 bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-4">
            <!-- Example -->
            <div class="flex items-center gap-2 text-sm text-slate-500">
                <a href="#breadcrumbs" class="hover:text-cyan-600 transition-colors">Admin Tools</a>
                <span>/</span>
                <span class="text-slate-700 font-medium">Email Templates</span>
            </div>

            <div class="flex items-center gap-2 text-sm text-slate-500">
                <a href="#breadcrumbs" class="hover:text-cyan-600 transition-colors">Admin Tools</a>
                <span>/</span>
                <a href="#breadcrumbs" class="hover:text-cyan-600 transition-colors">Email Templates</a>
                <span>/</span>
                <span class="text-slate-700 font-medium">Edit Template</span>
            </div>

            <div class="bg-slate-50 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600">
                <span class="font-medium text-slate-800">Pattern:</span>
                <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs">text-sm text-slate-500</code> with
                <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs">hover:text-cyan-600</code> on links.
                Current page uses <code class="bg-slate-200 px-1.5 py-0.5 rounded text-xs">text-slate-700 font-medium</code>.
                Placed at the top of the page, above the h1 title.
            </div>
        </div>
    </section>
</div>

@* ──────────────────────────────────────────────────────────────────────── *@
@* Helper sub-components (render fragments)                                  *@
@* ──────────────────────────────────────────────────────────────────────── *@

@code {
    private bool showDemoModal = false;
    private bool showDangerModal = false;

    // Quick-nav sections
    private record NavSection(string Id, string Label);
    private static NavSection[] sections = new[]
    {
        new NavSection("colors", "Colors"),
        new NavSection("badges", "Badges"),
        new NavSection("buttons", "Buttons"),
        new NavSection("alerts", "Alerts"),
        new NavSection("cards", "Cards"),
        new NavSection("typography", "Typography"),
        new NavSection("forms", "Forms"),
        new NavSection("tables", "Tables"),
        new NavSection("modal", "Modal"),
        new NavSection("loading", "Loading"),
        new NavSection("empty", "Empty States"),
        new NavSection("icons", "Icons"),
        new NavSection("spacing", "Spacing"),
        new NavSection("breadcrumbs", "Breadcrumbs"),
    };

    // Spacing scale for visualization
    private static (string Name, string Rem, string Desc)[] spacingScale = new[]
    {
        ("1", "0.25rem", "4px — tight gaps"),
        ("2", "0.5rem", "8px — icon padding"),
        ("3", "0.75rem", "12px — small gaps"),
        ("4", "1rem", "16px — mobile padding, form gaps"),
        ("5", "1.25rem", "20px — card inner spacing"),
        ("6", "1.5rem", "24px — section gaps, page spacing"),
        ("8", "2rem", "32px — large section gaps"),
    };

    // ─── Color Swatch ────────────────────────────────────────────────────
    private RenderFragment ColorSwatch(string Color, string Label, string Hex, bool TextLight = false) => __builder =>
    {
        <div class="space-y-1.5">
            <div class="@Color h-14 rounded-lg shadow-sm border border-black/5 flex items-end p-2">
                <span class="@(TextLight ? "text-white/80" : "text-black/40") text-xs font-mono">@Hex</span>
            </div>
            <span class="text-xs text-slate-600 font-medium">@Label</span>
        </div>
    };

    // ─── Section Header ──────────────────────────────────────────────────
    private RenderFragment SectionHeader(string Title, string Subtitle) => __builder =>
    {
        <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
            <div class="w-1 h-8 bg-cyan-600 rounded-full"></div>
            <div>
                <h2 class="text-lg font-semibold text-slate-800">@Title</h2>
                <p class="text-xs text-slate-500 mt-0.5">@Subtitle</p>
            </div>
        </div>
    };

    // ─── Icon Preview ────────────────────────────────────────────────────
    private RenderFragment IconPreview(string Name, RenderFragment ChildContent) => __builder =>
    {
        <div class="flex flex-col items-center gap-2 p-3 rounded-lg hover:bg-slate-50 transition-colors group">
            <div class="text-slate-600 group-hover:text-cyan-600 transition-colors">
                @ChildContent
            </div>
            <span class="text-[10px] text-slate-400 group-hover:text-slate-600 text-center leading-tight">@Name</span>
        </div>
    };
}
