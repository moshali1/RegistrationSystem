    private void ShowBypassModal(CompetitionProgress competitor, RoundDefinition roundDef)
    {
        bypassRegistrationId = competitor.RegistrationId;
        bypassCompetitorName = competitor.CompetitorName;
        bypassRoundDefId = roundDef.Id;
        bypassRoundName = roundDef.Name;
        bypassReason = "";
        showBypassModal = true;
    }

    private void CloseBypassModal()
    {
        showBypassModal = false;
        bypassRegistrationId = "";
        bypassCompetitorName = "";
        bypassRoundDefId = "";
        bypassRoundName = "";
        bypassReason = "";
    }

    private async Task ConfirmBypass()
    {
        if (isOperating) return;

        isOperating = true;
        errorMessage = "";

        try
        {
            var reason = string.IsNullOrWhiteSpace(bypassReason) ? null : bypassReason.Trim();
            await CompetitionProgressService.SetBypassAsync(
                bypassRegistrationId, bypassRoundDefId, true, reason);

            await RefreshData();
            CloseBypassModal();

            // Refresh the active modal if it's open
            if (showActiveModal && activeModalRoundDef != null)
            {
                var catProgress = GetCategoryProgress(activeModalCategoryId);
                activeModalCompetitors = catProgress
                    .Where(p => p.GetRound(activeModalRoundDef.Id)?.Status == RoundEntryStatus.Active)
                    .ToList();
                // Remove bypassed competitor from pending results
                pendingResults.Remove(bypassRegistrationId);
                pendingPlacements.Remove(bypassRegistrationId);
            }

            successMessage = $"{bypassCompetitorName} bypassed";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isOperating = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // MODAL DISPLAY HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private static string GetAcknowledgmentTime(RoundEntry? entry)
    {
        if (entry?.AcknowledgedAt == null) return "—";

        return entry.AcknowledgedAt.Value.FormatCentral("MMM d, h:mm tt");
    }

    private static string GetTimeSinceAssignment(RoundEntry? entry)
    {
        if (entry?.ScheduledDateTime == null) return "—";

        var timeSince = DateTimeOffset.UtcNow - entry.ScheduledDateTime.Value;

        if (timeSince.TotalDays >= 1)
            return $"{(int)timeSince.TotalDays}d ago";
        else if (timeSince.TotalHours >= 1)
            return $"{(int)timeSince.TotalHours}h ago";
        else
            return $"{(int)timeSince.TotalMinutes}m ago";
    }
