    // ═══════════════════════════════════════════════════════════════════════════
    // SCHEDULE MODAL
    // ═══════════════════════════════════════════════════════════════════════════

    private void ShowScheduleModal(Category category, RoundDefinition roundDef)
    {
        var categoryProgress = GetCategoryProgress(category.Id);
        scheduleCompetitors = categoryProgress
            .Where(p => p.GetRound(roundDef.Id)?.Status == RoundEntryStatus.Active)
            .ToList();

        scheduleCategoryId = category.Id;
        scheduleRoundDefId = roundDef.Id;
        scheduleRoundName = $"{category.Name} — {roundDef.Name}";
        scheduleDateTime = null;
        scheduleSelected = new HashSet<string>(scheduleCompetitors.Select(c => c.RegistrationId));
        showScheduleModal = true;
    }

    private void CloseScheduleModal()
    {
        showScheduleModal = false;
        scheduleCompetitors.Clear();
        scheduleSelected.Clear();
        scheduleDateTime = null;
    }

    private void ScheduleSelectAll() =>
        scheduleSelected = new HashSet<string>(scheduleCompetitors.Select(c => c.RegistrationId));

    private void ScheduleDeselectAll() =>
        scheduleSelected.Clear();

    private void ToggleScheduleSelection(string registrationId)
    {
        if (!scheduleSelected.Remove(registrationId))
            scheduleSelected.Add(registrationId);
    }

    private async Task AssignSchedule()
    {
        if (isOperating || !scheduleDateTime.HasValue || scheduleSelected.Count == 0) return;

        isOperating = true;
        errorMessage = "";

        try
        {
            var dateTime = new DateTimeOffset(scheduleDateTime.Value);
            await CompetitionProgressService.BulkAssignScheduleAsync(
                scheduleSelected.ToList(), scheduleRoundDefId, dateTime);

            var count = scheduleSelected.Count;
            await RefreshData();
            CloseScheduleModal();
            successMessage = $"Schedule assigned to {count} competitor(s)";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isOperating = false;
        }
    }

