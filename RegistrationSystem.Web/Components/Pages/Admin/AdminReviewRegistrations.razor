@page "/admin/registrations"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Azure
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject BlobSasService BlobSasService
@inject NavigationManager NavigationManager

<PageTitle>Review Registrations</PageTitle>

<div class="max-w-[1800px] mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Review Registrations</h1>
            <p class="text-sm text-slate-500 mt-1">Review and process competitor registrations</p>
        </div>
        @if (stats != null)
        {
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-cyan-50 border border-cyan-200">
                    <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
                    <span class="text-sm font-medium text-cyan-700">@stats.AwaitingReview Awaiting</span>
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-50 border border-amber-200">
                    <div class="w-2 h-2 rounded-full bg-amber-500"></div>
                    <span class="text-sm font-medium text-amber-700">@stats.Pending Pending</span>
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-200">
                    <span class="text-sm font-medium text-slate-600">@stats.Total Total</span>
                </div>
            </div>
        }
    </div>

    <!-- Filters Bar -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-6 overflow-hidden">
        <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-5 py-3">
            <div class="flex flex-wrap items-center gap-4">
                <!-- Status Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Status</span>
                    <div class="flex rounded-lg overflow-hidden border border-slate-600">
                        @foreach (var status in filterStatuses)
                        {
                            <button type="button"
                                    @onclick="() => ToggleStatusFilter(status)"
                                    class="px-3 py-1.5 text-xs font-medium transition-colors @(selectedStatuses.Contains(status) ? "bg-cyan-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500")">
                                @status
                            </button>
                        }
                    </div>
                </div>

                <!-- Division Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Division</span>
                    <select @bind="selectedDivisionId" @bind:after="OnDivisionChanged"
                            class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500">
                        <option value="">All Divisions</option>
                        @foreach (var division in divisions)
                        {
                            <option value="@division.Id">@division.Name</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                @if (!string.IsNullOrEmpty(selectedDivisionId))
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Category</span>
                        <select @bind="selectedCategoryId"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500">
                            <option value="">All Categories</option>
                            @foreach (var category in availableCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                }

                <!-- Search -->
                <div class="flex-1 min-w-[200px]">
                    <input type="text" @bind="searchQuery" @bind:event="oninput"
                           placeholder="Search by name or CID..."
                           class="w-full px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white placeholder-slate-400 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" />
                </div>

                <!-- Fetch Button -->
                <button type="button" @onclick="FetchRegistrations" disabled="@isLoading"
                        class="px-4 py-1.5 rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 disabled:from-slate-500 disabled:to-slate-600 text-white text-sm font-medium transition-all flex items-center gap-2">
                    @if (isLoading)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                    }
                    else
                    {
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                    }
                    Fetch
                </button>
            </div>
        </div>
    </div>

    @if (registrations.Count == 0 && !isLoading)
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center mx-auto mb-4">
                <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-slate-800 mb-2">No Registrations Found</h3>
            <p class="text-sm text-slate-500">Adjust your filters or click Fetch to load registrations.</p>
        </div>
    }
    else if (registrations.Count > 0)
    {
        <!-- Main Content: 3 Column Layout -->
        <div class="flex gap-6">
            <!-- Left Sidebar: Registration List -->
            <div class="w-72 flex-shrink-0">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-6">
                    <div class="bg-gradient-to-r from-slate-50 to-slate-100 px-4 py-3 border-b border-slate-200">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-slate-700">Registrations</span>
                            <span class="text-xs text-slate-500">@filteredRegistrations.Count of @registrations.Count</span>
                        </div>
                    </div>
                    <div class="max-h-[calc(100vh-280px)] overflow-y-auto divide-y divide-slate-100">
                        @foreach (var reg in filteredRegistrations)
                        {
                            var isSelected = selectedRegistration?.Id == reg.Id;
                            <button type="button" @onclick="() => SelectRegistration(reg)"
                                    class="w-full px-4 py-3 text-left transition-colors @(isSelected ? "bg-cyan-50 border-l-4 border-cyan-500" : "hover:bg-slate-50 border-l-4 border-transparent")">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-medium text-slate-800 truncate">@reg.PersonalInfo.FullName</p>
                                        <p class="text-xs text-slate-500 mt-0.5">@GetDivisionName(reg) / @GetCategoryName(reg)</p>
                                    </div>
                                    <span class="@GetStatusBadgeClass(reg.Status) px-1.5 py-0.5 rounded text-xs font-medium flex-shrink-0">
                                        @GetStatusShortName(reg.Status)
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(reg.Cid))
                                {
                                    <p class="text-xs font-mono text-slate-400 mt-1">@reg.Cid</p>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Center: Registration Details -->
            <div class="flex-1 min-w-0">
                @if (selectedRegistration != null)
                {
                    <!-- Quick Actions Bar -->
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="SelectPrevious" disabled="@(!CanGoPrevious)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                                <svg class="h-4 w-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                            </button>
                            <span class="text-sm text-slate-500">@(currentIndex + 1) of @filteredRegistrations.Count</span>
                            <button type="button" @onclick="SelectNext" disabled="@(!CanGoNext)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                                <svg class="h-4 w-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/admin/registrations/@selectedRegistration.Id"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors flex items-center gap-1.5">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                Details
                            </a>
                            <a href="/admin/registrations/@selectedRegistration.Id/edit"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors flex items-center gap-1.5">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit
                            </a>
                            <a href="/admin/audit/Registration/@selectedRegistration.Id"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors flex items-center gap-1.5">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Audit
                            </a>
                        </div>
                    </div>

                    <!-- Registration Card -->
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                        <!-- Header -->
                        <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-6 py-4">
                            <div class="flex items-center justify-between">
                                <div>
                                    <h2 class="text-xl font-bold text-white">@selectedRegistration.PersonalInfo.FullName</h2>
                                    <div class="flex items-center gap-3 mt-1">
                                        @if (!string.IsNullOrEmpty(selectedRegistration.Cid))
                                        {
                                            <span class="font-mono text-cyan-300 text-sm">@selectedRegistration.Cid</span>
                                        }
                                        <span class="text-slate-400 text-sm">•</span>
                                        <span class="text-slate-300 text-sm">Submitted @FormatDate(selectedRegistration.SubmittedAt)</span>
                                    </div>
                                </div>
                                <span class="@GetStatusBadgeClass(selectedRegistration.Status) px-3 py-1.5 rounded-lg text-sm font-medium">
                                    @selectedRegistration.Status
                                </span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-6">
                            <div class="grid grid-cols-2 gap-6">
                                <!-- Left Column: Personal & Competition Info -->
                                <div class="space-y-6">
                                    <!-- Personal Info -->
                                    <div>
                                        <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-lg bg-cyan-100 flex items-center justify-center">
                                                <svg class="h-3.5 w-3.5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                                            Personal Information
                                        </h3>
                                        <div class="bg-slate-50 rounded-lg p-4 space-y-2">
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Full Name</span>
                                                <span class="text-sm font-medium text-slate-800">@selectedRegistration.PersonalInfo.FullName</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Date of Birth</span>
                                                <span class="text-sm font-medium text-slate-800">@selectedRegistration.PersonalInfo.DateOfBirth.ToString("MMMM d, yyyy")</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Age</span>
                                                <span class="text-sm font-medium text-slate-800">@CalculateAge(selectedRegistration.PersonalInfo.DateOfBirth) years</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Gender</span>
                                                <span class="text-sm font-medium text-slate-800">@selectedRegistration.PersonalInfo.Gender</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Location</span>
                                                <span class="text-sm font-medium text-slate-800">@selectedRegistration.AddressInfo.City, @selectedRegistration.AddressInfo.StateProvince</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Competition Info -->
                                    <div>
                                        <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-lg bg-amber-100 flex items-center justify-center">
                                                <svg class="h-3.5 w-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                                </svg>
                                            </div>
                                            Competition
                                        </h3>
                                        <div class="bg-slate-50 rounded-lg p-4 space-y-2">
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Division</span>
                                                <span class="text-sm font-medium text-slate-800">@GetDivisionName(selectedRegistration)</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Category</span>
                                                <span class="text-sm font-medium text-slate-800">@GetCategoryName(selectedRegistration)</span>
                                            </div>
                                            @if (selectedRegistration.CompetitionSelection.PortionChoice.HasValue)
                                            {
                                                <div class="flex justify-between">
                                                    <span class="text-sm text-slate-500">Portion</span>
                                                    <span class="text-sm font-medium text-slate-800">@selectedRegistration.CompetitionSelection.PortionChoice</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Contact Info -->
                                    <div>
                                        <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-lg bg-slate-200 flex items-center justify-center">
                                                <svg class="h-3.5 w-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                                </svg>
                                            </div>
                                            Contacts
                                        </h3>
                                        <div class="bg-slate-50 rounded-lg p-4 space-y-2">
                                            <div class="flex justify-between">
                                                <span class="text-sm text-slate-500">Parent</span>
                                                <span class="text-sm font-medium text-slate-800">@selectedRegistration.ParentInfo.FullName</span>
                                            </div>
                                            @if (selectedRegistration.TeacherInfo != null)
                                            {
                                                <div class="flex justify-between">
                                                    <span class="text-sm text-slate-500">Teacher</span>
                                                    <span class="text-sm font-medium text-slate-800">@selectedRegistration.TeacherInfo.FullName</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Files & Status -->
                                <div class="space-y-6">
                                    <!-- Files -->
                                    <div>
                                        <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-lg bg-cyan-100 flex items-center justify-center">
                                                <svg class="h-3.5 w-3.5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                            </div>
                                            Documents
                                            @if (selectedRegistration.FileUploadInfo.NiqabBypassApproved)
                                            {
                                                <span class="ml-2 px-2 py-0.5 rounded bg-slate-100 text-xs font-medium text-slate-600">Niqab Bypass</span>
                                            }
                                        </h3>
                                        <div class="grid grid-cols-2 gap-3">
                                            <!-- ID Document -->
                                            @if (selectedRegistration.FileUploadInfo.IdDocument != null)
                                            {
                                                <button type="button" @onclick="() => OpenIdInLightbox()"
                                                        class="group relative aspect-[4/3] rounded-lg border-2 border-slate-200 hover:border-cyan-400 overflow-hidden transition-colors cursor-pointer">
                                                    @if (IsImageFile(selectedRegistration.FileUploadInfo.IdDocument.Extension))
                                                    {
                                                        <img src="@GetFileUrl(selectedRegistration.FileUploadInfo.IdDocument.StorageReference)"
                                                             alt="ID Document" class="w-full h-full object-cover" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-full h-full bg-slate-100 flex items-center justify-center">
                                                            <svg class="h-10 w-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                            </svg>
                                                        </div>
                                                    }
                                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                                        <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 px-2 py-1 rounded text-xs font-medium text-slate-700">
                                                            View ID
                                                        </span>
                                                    </div>
                                                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1">
                                                        <span class="text-xs font-medium text-white">ID Document</span>
                                                    </div>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="aspect-[4/3] rounded-lg border-2 border-dashed border-red-300 bg-red-50 flex items-center justify-center">
                                                    <span class="text-xs font-medium text-red-500">No ID</span>
                                                </div>
                                            }

                                            <!-- Photo -->
                                            @if (selectedRegistration.FileUploadInfo.Photo != null)
                                            {
                                                <button type="button" @onclick="() => OpenPhotoInLightbox()"
                                                        class="group relative aspect-[4/3] rounded-lg border-2 border-slate-200 hover:border-cyan-400 overflow-hidden transition-colors cursor-pointer">
                                                    <img src="@GetFileUrl(selectedRegistration.FileUploadInfo.Photo.StorageReference)"
                                                         alt="Competitor Photo" class="w-full h-full object-cover" />
                                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                                        <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 px-2 py-1 rounded text-xs font-medium text-slate-700">
                                                            View Photo
                                                        </span>
                                                    </div>
                                                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1">
                                                        <span class="text-xs font-medium text-white">Photo</span>
                                                    </div>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="aspect-[4/3] rounded-lg border-2 border-dashed border-red-300 bg-red-50 flex items-center justify-center">
                                                    <span class="text-xs font-medium text-red-500">No Photo</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Video Download -->
                                        @if (selectedRegistration.FileUploadInfo.Video != null)
                                        {
                                            <div class="mt-3">
                                                <button type="button" @onclick="DownloadVideo"
                                                        class="w-full px-4 py-2 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-sm font-medium text-slate-700 transition-colors flex items-center justify-center gap-2">
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                                    </svg>
                                                    Download Video (@FormatFileSize(selectedRegistration.FileUploadInfo.Video.FileSizeBytes))
                                                </button>
                                            </div>
                                        }
                                        else if (CategoryRequiresVideo(selectedRegistration))
                                        {
                                            <div class="mt-3 px-4 py-2 rounded-lg border border-dashed border-amber-300 bg-amber-50 text-center">
                                                <span class="text-xs font-medium text-amber-600">⚠️ Video required but not uploaded</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Current Status -->
                                    @if (!string.IsNullOrEmpty(selectedRegistration.StatusComment))
                                    {
                                        <div>
                                            <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                                <div class="w-6 h-6 rounded-lg bg-amber-100 flex items-center justify-center">
                                                    <svg class="h-3.5 w-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                                    </svg>
                                                </div>
                                                Status Comment
                                            </h3>
                                            <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                                                <p class="text-sm text-amber-800">@selectedRegistration.StatusComment</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Update Status -->
                                    <div>
                                        <h3 class="text-sm font-semibold text-slate-800 mb-3 flex items-center gap-2">
                                            <div class="w-6 h-6 rounded-lg bg-cyan-100 flex items-center justify-center">
                                                <svg class="h-3.5 w-3.5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                </svg>
                                            </div>
                                            Update Status
                                        </h3>
                                        <div class="space-y-3">
                                            <select @bind="newStatus"
                                                    class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 text-sm">
                                                <option value="">Select new status...</option>
                                                @foreach (var status in GetAvailableStatuses(selectedRegistration.Status))
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </select>
                                            <textarea @bind="newComment" rows="2"
                                                      placeholder="Add a comment (optional for approval, required for rejection)..."
                                                      class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 text-sm resize-none"></textarea>
                                            <button type="button" @onclick="UpdateStatus" disabled="@(string.IsNullOrEmpty(newStatus) || isUpdating)"
                                                    class="w-full px-4 py-2 rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 disabled:from-slate-400 disabled:to-slate-500 text-white text-sm font-medium transition-all flex items-center justify-center gap-2">
                                                @if (isUpdating)
                                                {
                                                    <div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                                                    <span>Updating...</span>
                                                }
                                                else
                                                {
                                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                    <span>Apply Status</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- No Selection State -->
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-12 text-center">
                        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-100 to-cyan-200 flex items-center justify-center mx-auto mb-4">
                            <svg class="h-8 w-8 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-slate-800 mb-2">Select a Registration</h3>
                        <p class="text-sm text-slate-500">Click on a registration from the list to review it.</p>
                    </div>
                }
            </div>

            <!-- Right Sidebar: Quick Presets -->
            <div class="w-72 flex-shrink-0">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-6">
                    <div class="bg-gradient-to-r from-slate-50 to-slate-100 px-4 py-3 border-b border-slate-200">
                        <span class="text-sm font-semibold text-slate-700">Quick Actions</span>
                    </div>
                    <div class="p-4 space-y-4 max-h-[calc(100vh-280px)] overflow-y-auto">
                        <!-- Approve -->
                        <div>
                            <h4 class="text-xs font-semibold text-cyan-700 uppercase tracking-wide mb-2 flex items-center gap-1">
                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                                Approve
                            </h4>
                            <div class="space-y-1.5">
                                <button type="button" @onclick='() => ApplyPreset("Reviewed", "")'
                                        class="w-full px-3 py-2 rounded-lg border border-cyan-200 bg-cyan-50 hover:bg-cyan-100 text-left text-xs text-cyan-800 transition-colors">
                                    Mark as Reviewed ✓
                                </button>
                                <button type="button" @onclick='() => ApplyPreset("Verified", "")'
                                        class="w-full px-3 py-2 rounded-lg border border-cyan-200 bg-cyan-50 hover:bg-cyan-100 text-left text-xs text-cyan-800 transition-colors">
                                    Mark as Verified ✓
                                </button>
                            </div>
                        </div>

                        <!-- Send Back (Pending) -->
                        <div>
                            <h4 class="text-xs font-semibold text-amber-700 uppercase tracking-wide mb-2 flex items-center gap-1">
                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                Send Back
                            </h4>
                            <div class="space-y-1.5">
                                @foreach (var preset in pendingPresets)
                                {
                                    <button type="button" @onclick="() => ApplyPreset(nameof(RegistrationStatus.Pending), preset)"
                                            class="w-full px-3 py-2 rounded-lg border border-amber-200 bg-amber-50 hover:bg-amber-100 text-left text-xs text-amber-800 transition-colors">
                                        @preset
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Disqualify -->
                        <div>
                            <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2 flex items-center gap-1">
                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                                Disqualify
                            </h4>
                            <div class="space-y-1.5">
                                @foreach (var preset in disqualifyPresets)
                                {
                                    <button type="button" @onclick="() => ApplyPreset(nameof(RegistrationStatus.Disqualified), preset)"
                                            class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-left text-xs text-slate-700 transition-colors">
                                        @preset
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Withdraw -->
                        <div>
                            <h4 class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2 flex items-center gap-1">
                                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                Withdraw
                            </h4>
                            <div class="space-y-1.5">
                                <button type="button" @onclick='() => ApplyPreset("Withdrawn", "Withdrawn by administrator")'
                                        class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-left text-xs text-slate-700 transition-colors">
                                    Admin Withdrawal
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

