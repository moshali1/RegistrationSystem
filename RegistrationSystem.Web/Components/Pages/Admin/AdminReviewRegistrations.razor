@code {
    // State
    private bool isLoading = false;
    private bool isInitialLoading = true;
    private bool isUpdating = false;
    private string? statusUpdateError;
    private string loadingMessage = "Fetching competition settings...";
    private CompetitionSettings? settings;
    private int competitionYear;

    // Filter state
    private List<RegistrationStatus> filterStatuses = new()
    {
        RegistrationStatus.AwaitingReview,
        RegistrationStatus.Pending,
        RegistrationStatus.Reviewed
    };
    private HashSet<RegistrationStatus> selectedStatuses = new()
    {
        RegistrationStatus.AwaitingReview,
        RegistrationStatus.Pending
    };
    private string selectedDivisionId = string.Empty;
    private string selectedCategoryId = string.Empty;
    private string searchQuery = string.Empty;

    // Data
    private List<Division> divisions = new();
    private List<Category> availableCategories = new();
    private List<Registration> registrations = new();
    private Registration? selectedRegistration;
    private RegistrationStats? stats;

    // Status update
    private string newStatus = string.Empty;
    private string newComment = string.Empty;

    // Submitter info
    private SubmitterInfo? submitterInfo;

    // Email tracking
    private int pendingEmailsSentCount = 0;
    private bool isResendingEmail = false;

    // Lightbox
    private string? lightboxUrl;
    private string rotationClass = string.Empty;
    private string scaleClass = string.Empty;
    private bool isScaled = false;

    // Preset comments
    private static readonly string[] pendingPresets = new[]
    {
        "Invalid ID: Please upload competitor's ID, not parent's",
        "Invalid ID: Please upload a valid identification document",
        "Invalid Photo: Please upload a clear headshot of competitor",
        "Invalid Photo: Please upload competitor's photo, not parent's",
        "Invalid Photo: Please upload a standalone photo, not a photo cropped from an ID or document",
        "Missing Video: Please upload a recitation video",
        "Invalid Video: Please upload a video that meets requirements",
        "Age Mismatch: Competitor age doesn't match selected category",
        "Incomplete Information: Please complete all required fields"
    };

    private static readonly string[] disqualifyPresets = new[]
    {
        "Duplicate Registration",
        "Ineligible: Does not meet competition requirements",
        "Fraudulent Information"
    };

    // Computed
    private List<Registration> filteredRegistrations => registrations
        .Where(r => selectedStatuses.Contains(r.Status))
        .Where(r => string.IsNullOrEmpty(selectedDivisionId) || r.CompetitionSelection.DivisionId == selectedDivisionId)
        .Where(r => string.IsNullOrEmpty(selectedCategoryId) || r.CompetitionSelection.CategoryId == selectedCategoryId)
        .Where(r => MatchesSearch(r))
        .ToList();

    private int currentIndex => selectedRegistration != null
        ? filteredRegistrations.FindIndex(r => r.Id == selectedRegistration.Id)
        : -1;

    private bool CanGoPrevious => currentIndex > 0;
    private bool CanGoNext => currentIndex >= 0 && currentIndex < filteredRegistrations.Count - 1;

    private int GetStatusCount(RegistrationStatus status) => registrations.Count(r => r.Status == status);

    private bool MatchesSearch(Registration r)
    {
        if (string.IsNullOrEmpty(searchQuery)) return true;

        var query = searchQuery.Trim();

        // CID match
        if (r.Cid?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;

        var fullName = r.PersonalInfo.FullName;
        var firstName = r.PersonalInfo.FirstName;
        var lastName = r.PersonalInfo.LastName;

        // Direct full name match
        if (fullName.Contains(query, StringComparison.OrdinalIgnoreCase))
            return true;

        // Multi-word search: each query part must match first, middle, or last name
        // This allows "John Smith" to match "John Michael Smith"
        var queryParts = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (queryParts.Length > 1)
        {
            var middleName = r.PersonalInfo.MiddleName ?? "";
            return queryParts.All(part =>
                firstName.Contains(part, StringComparison.OrdinalIgnoreCase) ||
                middleName.Contains(part, StringComparison.OrdinalIgnoreCase) ||
                lastName.Contains(part, StringComparison.OrdinalIgnoreCase));
        }

        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        isInitialLoading = true;

        loadingMessage = "Loading competition settings...";
        StateHasChanged();

        settings = await SettingsService.GetSettingsAsync();
        competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

        if (settings != null)
        {
            divisions = settings.Divisions.Where(d => d.IsEnabled).ToList();
        }

        loadingMessage = "Fetching registrations...";
        StateHasChanged();

        await FetchRegistrations();

        isInitialLoading = false;
        StateHasChanged();
    }

    private async Task FetchRegistrations()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var allRegistrations = await RegistrationService.GetAllByYearAsync(competitionYear);
            registrations = allRegistrations.ToList();

            // Calculate stats
            stats = new RegistrationStats
            {
                AwaitingReview = registrations.Count(r => r.Status == RegistrationStatus.AwaitingReview),
                Pending = registrations.Count(r => r.Status == RegistrationStatus.Pending),
                Total = registrations.Count
            };

            // Select first if available
            if (selectedRegistration == null && filteredRegistrations.Any())
            {
                await SelectRegistrationAsync(filteredRegistrations.First());
            }
            else if (selectedRegistration != null)
            {
                // Refresh selected registration
                var refreshed = registrations.FirstOrDefault(r => r.Id == selectedRegistration.Id);
                if (refreshed != null)
                {
                    await SelectRegistrationAsync(refreshed);
                }
                else
                {
                    selectedRegistration = null;
                    submitterInfo = null;
                }
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ToggleStatusFilter(RegistrationStatus status)
    {
        if (selectedStatuses.Contains(status))
        {
            if (selectedStatuses.Count > 1)
                selectedStatuses.Remove(status);
        }
        else
        {
            selectedStatuses.Add(status);
        }
    }

    private void OnDivisionChanged()
    {
        selectedCategoryId = string.Empty;

        if (!string.IsNullOrEmpty(selectedDivisionId))
        {
            var division = divisions.FirstOrDefault(d => d.Id == selectedDivisionId);
            availableCategories = division?.Categories.Where(c => c.IsEnabled).ToList() ?? new();
        }
        else
        {
            availableCategories = new();
        }
    }

    private async Task SelectRegistrationAsync(Registration reg)
    {
        selectedRegistration = reg;
        newStatus = string.Empty;
        newComment = string.Empty;
        pendingEmailsSentCount = 0;
        await LoadSubmitterInfo(reg);
        _ = LoadEmailSentCount(reg);
        _ = PreloadAdjacentImages();
    }

    private void SelectRegistration(Registration reg)
    {
        _ = SelectRegistrationAsync(reg);
    }

    private void SelectPrevious()
    {
        if (CanGoPrevious)
        {
            _ = SelectRegistrationAsync(filteredRegistrations[currentIndex - 1]);
        }
    }

    private void SelectNext()
    {
        if (CanGoNext)
        {
            _ = SelectRegistrationAsync(filteredRegistrations[currentIndex + 1]);
        }
    }

    private async Task LoadSubmitterInfo(Registration reg)
    {
        try
        {
            submitterInfo = null;

            if (!string.IsNullOrEmpty(reg.CreatorUserId))
            {
                var user = await UserService.GetByObjectIdentifierAsync(reg.CreatorUserId);
                if (user != null)
                {
                    submitterInfo = new SubmitterInfo
                    {
                        Name = user.DisplayName,
                        UserTypeLabel = user.UserType
                    };
                }
            }

            // Get submission date from audit trail
            var auditEntries = await AuditService.GetEntityHistoryAsync("Registration", reg.Id);
            var submissionEntry = auditEntries
                .Where(e => e.Action == AuditAction.Submitted)
                .OrderByDescending(e => e.Timestamp)
                .FirstOrDefault();

            if (submitterInfo != null && submissionEntry != null)
            {
                submitterInfo.SubmittedAt = submissionEntry.Timestamp;
            }
            else if (submissionEntry != null)
            {
                submitterInfo = new SubmitterInfo
                {
                    Name = "Unknown",
                    SubmittedAt = submissionEntry.Timestamp
                };
            }

            StateHasChanged();
        }
        catch
        {
            // Best-effort, don't break navigation
        }
    }

    private async Task SendPendingEmailAsync(Registration registration)
    {
        try
        {
            var user = await UserService.GetByObjectIdentifierAsync(registration.CreatorUserId);
            if (user == null || string.IsNullOrWhiteSpace(user.Email))
                return;

            var divisionName = GetDivisionName(registration);
            var categoryName = GetCategoryName(registration);
            var editUrl = $"{EmailOptions.SiteUrl.TrimEnd('/')}/registration/{registration.Id}/edit";

            var (subject, plainText, html) = PendingStatusEmailBuilder.Build(
                parentName: user.DisplayName,
                competitorFullName: registration.PersonalInfo.FullName,
                cid: registration.Cid ?? "N/A",
                divisionName: divisionName,
                categoryName: categoryName,
                statusComment: registration.StatusComment ?? "",
                registrationEditUrl: editUrl,
                registrationDeadline: settings?.RegistrationEnd,
                siteUrl: EmailOptions.SiteUrl);

            var sent = await EmailService.SendEmailAsync(user.Email, user.DisplayName, subject, plainText, html);

            if (sent)
            {
                await AuditService.LogEmailSentAsync(
                    "Registration",
                    registration.Id,
                    user.Email,
                    "PendingStatus",
                    $"{registration.PersonalInfo.FullName} ({registration.Cid})");
            }
        }
        catch
        {
            // Email is fire-and-forget; don't break the UI flow
        }
    }

    private async Task LoadEmailSentCount(Registration reg)
    {
        try
        {
            var auditEntries = await AuditService.GetEntityHistoryAsync("Registration", reg.Id);
            pendingEmailsSentCount = auditEntries.Count(e => e.Action == AuditAction.EmailSent);
            StateHasChanged();
        }
        catch
        {
            // Best-effort
        }
    }

    private async Task UpdatePendingComment()
    {
        if (selectedRegistration == null || selectedRegistration.Status != RegistrationStatus.Pending)
            return;

        if (string.IsNullOrWhiteSpace(newComment))
            return;

        isUpdating = true;
        statusUpdateError = null;
        StateHasChanged();

        try
        {
            var oldComment = selectedRegistration.StatusComment;
            selectedRegistration.StatusComment = newComment;

            try
            {
                await RegistrationService.AdminUpdateStatusAsync(selectedRegistration);
            }
            catch (InvalidOperationException ex)
            {
                selectedRegistration.StatusComment = oldComment;
                statusUpdateError = ex.Message;
                return;
            }

            // Log audit
            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogAsync(
                AuditAction.StatusChanged,
                "Registration",
                selectedRegistration.Id,
                summary: $"Pending comment updated: {newComment}",
                entityDescription: $"{selectedRegistration.PersonalInfo.FullName} ({selectedRegistration.Cid})");

            // Send updated email notification
            await SendPendingEmailAsync(selectedRegistration);
            pendingEmailsSentCount++;

            newComment = string.Empty;
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private async Task ResendPendingEmail()
    {
        if (selectedRegistration == null || selectedRegistration.Status != RegistrationStatus.Pending)
            return;

        isResendingEmail = true;
        StateHasChanged();

        try
        {
            await SendPendingEmailAsync(selectedRegistration);
            pendingEmailsSentCount++;
        }
        finally
        {
            isResendingEmail = false;
            StateHasChanged();
        }
    }

    private void ApplyPreset(string status, string comment)
    {
        newStatus = status;
        newComment = comment;
    }

    private async Task MarkAsReviewed()
    {
        newStatus = nameof(RegistrationStatus.Reviewed);
        newComment = string.Empty;
        await UpdateStatus();
    }

    private async Task UpdateStatus()
    {
        if (selectedRegistration == null || string.IsNullOrEmpty(newStatus)) return;

        // Validate comment required for Pending/Disqualified
        if ((newStatus == nameof(RegistrationStatus.Pending) || newStatus == nameof(RegistrationStatus.Disqualified))
            && string.IsNullOrWhiteSpace(newComment))
        {
            return;
        }

        statusUpdateError = null;

        isUpdating = true;
        StateHasChanged();

        try
        {
            var oldStatus = selectedRegistration.Status;
            var newStatusEnum = Enum.Parse<RegistrationStatus>(newStatus);

            // Capture the next registration to navigate to BEFORE the status change,
            // because changing the status may remove it from the filtered list
            Registration? nextRegistration = null;
            var idx = currentIndex;
            if (idx >= 0 && idx < filteredRegistrations.Count - 1)
            {
                nextRegistration = filteredRegistrations[idx + 1];
            }
            else if (idx > 0)
            {
                nextRegistration = filteredRegistrations[idx - 1];
            }

            selectedRegistration.Status = newStatusEnum;
            selectedRegistration.StatusComment = string.IsNullOrWhiteSpace(newComment) ? null : newComment;

            // Handle withdrawal comment
            if (newStatusEnum == RegistrationStatus.Withdrawn)
            {
                selectedRegistration.WithdrawComment = string.IsNullOrWhiteSpace(newComment)
                    ? "Withdrawn by administrator"
                    : newComment;
            }

            // Save via admin method (bypasses user-facing edit checks)
            try
            {
                await RegistrationService.AdminUpdateStatusAsync(selectedRegistration);
            }
            catch (InvalidOperationException ex)
            {
                // Revert in-memory status change
                selectedRegistration.Status = oldStatus;
                statusUpdateError = ex.Message;
                return;
            }

            // Log audit
            await AuditContextProvider.SetCurrentUserContextAsync();
            await AuditService.LogAsync(
                AuditAction.StatusChanged,
                "Registration",
                selectedRegistration.Id,
                summary: $"Status changed from {StatusBadge.GetDisplayName(oldStatus)} to {StatusBadge.GetDisplayName(newStatusEnum)}",
                entityDescription: $"{selectedRegistration.PersonalInfo.FullName} ({selectedRegistration.Cid})");

            // Send pending status email notification
            if (newStatusEnum == RegistrationStatus.Pending
                && !string.IsNullOrWhiteSpace(selectedRegistration.StatusComment))
            {
                await SendPendingEmailAsync(selectedRegistration);
            }

            // Update stats
            if (stats != null)
            {
                if (oldStatus == RegistrationStatus.AwaitingReview) stats.AwaitingReview--;
                if (oldStatus == RegistrationStatus.Pending) stats.Pending--;
                if (newStatusEnum == RegistrationStatus.AwaitingReview) stats.AwaitingReview++;
                if (newStatusEnum == RegistrationStatus.Pending) stats.Pending++;
            }

            // Clear form and advance to next registration
            newStatus = string.Empty;
            newComment = string.Empty;

            if (nextRegistration != null)
            {
                await SelectRegistrationAsync(nextRegistration);
            }
            else
            {
                selectedRegistration = null;
                submitterInfo = null;
            }
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private List<RegistrationStatus> GetAvailableStatuses(RegistrationStatus current) => current switch
    {
        RegistrationStatus.AwaitingReview => new()
        {
            RegistrationStatus.Reviewed,
            RegistrationStatus.Pending,
            RegistrationStatus.Disqualified,
            RegistrationStatus.Withdrawn
        },
        RegistrationStatus.Pending => new()
        {
            RegistrationStatus.Reviewed,
            RegistrationStatus.Disqualified,
            RegistrationStatus.Withdrawn
        },
        RegistrationStatus.Reviewed => new()
        {
            RegistrationStatus.Verified,
            RegistrationStatus.Pending,
            RegistrationStatus.Disqualified,
            RegistrationStatus.Withdrawn
        },
        _ => new()
    };

    // ═══════════════════════════════════════════════════════════════════════════════
    // LIGHTBOX
    // ═══════════════════════════════════════════════════════════════════════════════

    private void OpenIdInLightbox()
    {
        if (selectedRegistration?.FileUploadInfo.IdDocument != null)
        {
            var url = GetFileUrl(selectedRegistration.FileUploadInfo.IdDocument.StorageReference);
            if (IsImageFile(selectedRegistration.FileUploadInfo.IdDocument.Extension))
            {
                lightboxUrl = url;
                rotationClass = string.Empty;
                rotationDegrees = 0;
                scaleClass = string.Empty;
                isScaled = false;
            }
            else
            {
                // PDF — open in new tab (handled by <a> tag now, this is fallback)
                NavigationManager.NavigateTo(url!, forceLoad: true);
            }
        }
    }

    private void OpenPhotoInLightbox()
    {
        if (selectedRegistration?.FileUploadInfo.Photo != null)
        {
            lightboxUrl = GetFileUrl(selectedRegistration.FileUploadInfo.Photo.StorageReference);
            rotationClass = string.Empty;
            rotationDegrees = 0;
            scaleClass = string.Empty;
            isScaled = false;
        }
    }

    private void DownloadVideo()
    {
        if (selectedRegistration?.FileUploadInfo.Video != null)
        {
            var url = GetFileUrl(selectedRegistration.FileUploadInfo.Video.StorageReference);
            NavigationManager.NavigateTo(url!, forceLoad: true);
        }
    }

    private void CloseLightbox() => lightboxUrl = null;

    private int rotationDegrees = 0;

    private void RotateImage()
    {
        rotationDegrees = (rotationDegrees + 90) % 360;
        rotationClass = rotationDegrees switch
        {
            0 => "",
            90 => "rotate-90",
            180 => "rotate-180",
            270 => "[transform:rotate(270deg)]",
            _ => ""
        };
    }

    private void ToggleScale()
    {
        isScaled = !isScaled;
        scaleClass = isScaled ? "scale-75" : "";
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // IMAGE PRELOADING
    // ═══════════════════════════════════════════════════════════════════════════════

    private async Task PreloadAdjacentImages()
    {
        try
        {
            var urls = new List<string>();
            var idx = currentIndex;

            // Preload next 2 and previous 1 registrations' images
            foreach (var offset in new[] { 1, 2, -1 })
            {
                var targetIdx = idx + offset;
                if (targetIdx >= 0 && targetIdx < filteredRegistrations.Count)
                {
                    var reg = filteredRegistrations[targetIdx];
                    if (reg.FileUploadInfo.IdDocument != null && IsImageFile(reg.FileUploadInfo.IdDocument.Extension))
                    {
                        var url = GetFileUrl(reg.FileUploadInfo.IdDocument.StorageReference);
                        if (url != null) urls.Add(url);
                    }
                    if (reg.FileUploadInfo.Photo != null)
                    {
                        var url = GetFileUrl(reg.FileUploadInfo.Photo.StorageReference);
                        if (url != null) urls.Add(url);
                    }
                }
            }

            if (urls.Count > 0)
            {
                await JSRuntime.InvokeVoidAsync("preloadImages", urls.ToArray());
            }
        }
        catch
        {
            // Preloading is best-effort, don't break the app
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // HELPERS
