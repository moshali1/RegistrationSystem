    private string GetDivisionName(Registration reg)
    {
        return divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId)?.Name ?? "Unknown";
    }

    private string GetCategoryName(Registration reg)
    {
        var division = divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId);
        return division?.Categories.FirstOrDefault(c => c.Id == reg.CompetitionSelection.CategoryId)?.Name ?? "Unknown";
    }

    private bool CategoryRequiresVideo(Registration reg)
    {
        var division = divisions.FirstOrDefault(d => d.Id == reg.CompetitionSelection.DivisionId);
        var category = division?.Categories.FirstOrDefault(c => c.Id == reg.CompetitionSelection.CategoryId);
        return category?.RequiresVideo ?? false;
    }

    private string? GetFileUrl(string storageReference)
    {
        return BlobSasService.GenerateSasUriFromReference(storageReference, competitionYear);
    }

    private bool IsImageFile(string extension)
    {
        var ext = extension.ToLowerInvariant().TrimStart('.');
        return ext is "jpg" or "jpeg" or "png" or "gif" or "webp" or "bmp";
    }

    private int CalculateAge(DateOnly dateOfBirth)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth > today.AddYears(-age)) age--;
        return age;
    }

    private string FormatDate(DateTimeOffset? date)
    {
        if (date == null) return "Unknown";
        return date.Value.ToLocalTime().ToString("MMM d, yyyy");
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private class RegistrationStats
    {
        public int AwaitingReview { get; set; }
        public int Pending { get; set; }
        public int Total { get; set; }
    }

    private class SubmitterInfo
    {
        public string Name { get; set; } = "";
        public string UserTypeLabel { get; set; } = "";
        public DateTimeOffset? SubmittedAt { get; set; }

        public string UserTypeDisplay => string.IsNullOrEmpty(UserTypeLabel) ? "Unknown" : UserTypeLabel;
    }
