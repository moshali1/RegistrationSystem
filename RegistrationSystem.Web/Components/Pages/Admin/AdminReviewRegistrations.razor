@page "/admin/registration-review"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Azure
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using Microsoft.JSInterop
@using RegistrationSystem.Core.Application.Messaging
@using RegistrationSystem.Core.Application.Users
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject BlobSasService BlobSasService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject UserService UserService
@inject IEmailService EmailService
@inject EmailOptions EmailOptions

<PageTitle>Registration Review</PageTitle>

<!-- Mobile: Show desktop-only message -->
<div class="lg:hidden flex flex-col items-center justify-center min-h-[60vh] px-6 text-center">
    <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
        @Icons.Monitor("h-8 w-8 text-slate-400")
    </div>
    <h2 class="text-lg font-semibold text-slate-800 mb-2">Desktop Required</h2>
    <p class="text-sm text-slate-500 max-w-sm">
        The Registration Review dashboard requires a larger screen. Please switch to a desktop or laptop to use this feature.
    </p>
</div>

<!-- Desktop: Full Layout -->
<div class="hidden lg:block max-w-[1800px] mx-auto">
    <!-- Header -->
    <div class="mb-4">
        <h1 class="text-2xl font-bold text-slate-800">Registration Review</h1>
        <p class="text-sm text-slate-500 mt-1">Review and process competitor registrations</p>
    </div>

    <!-- Filters Bar -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-4 overflow-hidden">
        <div class="bg-slate-800 px-5 py-3">
            <div class="flex flex-wrap items-center gap-4">
                <!-- Status Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Status</span>
                    <div class="flex rounded-lg overflow-hidden border border-slate-600 divide-x divide-slate-500">
                        @foreach (var status in filterStatuses)
                        {
                            var count = GetStatusCount(status);
                            <button type="button"
                                    @onclick="() => ToggleStatusFilter(status)"
                                    class="px-3 py-1.5 text-xs font-medium transition-colors cursor-pointer flex items-center gap-1.5 @(selectedStatuses.Contains(status) ? "bg-cyan-600 text-white" : "bg-slate-600 text-slate-300 hover:bg-slate-500")">
                                @StatusBadge.GetShortName(status)
                                @if (count > 0)
                                {
                                    <span class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full text-[10px] font-bold leading-none @(selectedStatuses.Contains(status) ? "bg-white/25 text-white" : "bg-slate-500 text-slate-200")">
                                        @count
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </div>

                <!-- Division Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Division</span>
                    <select @bind="selectedDivisionId" @bind:after="OnDivisionChanged"
                            class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                        <option value="">All Divisions</option>
                        @foreach (var division in divisions)
                        {
                            <option value="@division.Id">@division.Name</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                @if (!string.IsNullOrEmpty(selectedDivisionId))
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-300 uppercase tracking-wide">Category</span>
                        <select @bind="selectedCategoryId"
                                class="px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 cursor-pointer">
                            <option value="">All Categories</option>
                            @foreach (var category in availableCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                }

                <!-- Search -->
                <div class="flex-1 min-w-[200px]">
                    <input type="text" @bind="searchQuery" @bind:event="oninput"
                           placeholder="Search by name or CID..."
                           class="w-full px-3 py-1.5 rounded-lg bg-slate-600 border border-slate-500 text-sm text-white placeholder-slate-400 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500" />
                </div>

                <!-- Fetch Button -->
                <button type="button" @onclick="FetchRegistrations" disabled="@isLoading"
                        class="px-4 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-500 text-white text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
                    @if (isLoading)
                    {
                        @Icons.Spinner("h-4 w-4")
                    }
                    else
                    {
                        @Icons.Refresh("h-4 w-4")
                    }
                    Fetch
                </button>
            </div>
        </div>
    </div>

    @if (isInitialLoading)
    {
        <!-- Loading Screen -->
        <div class="flex flex-col items-center justify-center min-h-[60vh]">
            <div class="w-16 h-16 rounded-2xl bg-cyan-100 flex items-center justify-center mb-4">
                @Icons.Spinner("h-8 w-8 text-cyan-600")
            </div>
            <h2 class="text-lg font-semibold text-slate-800 mb-1">Loading Registrations</h2>
            <p class="text-sm text-slate-500">@loadingMessage</p>
        </div>
    }
    else if (registrations.Count == 0 && !isLoading)
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center mx-auto mb-5 shadow-lg">
                @Icons.ClipboardCheck("h-7 w-7 text-white")
            </div>
            <h2 class="text-xl font-semibold text-slate-800 mb-2">No Registrations Found</h2>
            <p class="text-slate-500 text-sm">No registrations match the current filters.</p>
        </div>
    }
    else if (registrations.Count > 0)
    {
        <!-- Main Content: 3 Column Layout -->
        <div class="flex gap-3 xl:gap-4">
            <!-- Left Sidebar: Registration List (hidden on medium, visible on xl) -->
            <div class="hidden xl:block w-64 flex-shrink-0">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-4">
                    <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-slate-700">Registrations</span>
                            <span class="text-[10px] text-slate-500">@filteredRegistrations.Count / @registrations.Count</span>
                        </div>
                    </div>
                    <div class="max-h-[calc(100vh-200px)] overflow-y-auto divide-y divide-slate-100">
                        @foreach (var reg in filteredRegistrations)
                        {
                            var isSelected = selectedRegistration?.Id == reg.Id;
                            <button type="button" @onclick="() => SelectRegistration(reg)"
                                    class="w-full px-3 py-2 text-left transition-colors cursor-pointer @(isSelected ? "bg-cyan-50 border-l-3 border-cyan-500" : "hover:bg-slate-50 border-l-3 border-transparent")">
                                <div class="flex items-center justify-between gap-1.5">
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xs font-medium text-slate-800 truncate">@reg.PersonalInfo.FullName</p>
                                        <p class="text-[10px] text-slate-500 mt-0.5 truncate">@GetDivisionName(reg) / @GetCategoryName(reg)</p>
                                    </div>
                                    <StatusBadge Status="reg.Status" Size="StatusBadge.StatusBadgeSize.Mini" />
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Center: Registration Details -->
            <div class="flex-1 min-w-0">
                @if (selectedRegistration != null)
                {
                    <!-- Quick Actions Bar -->
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <!-- Medium screens: left/right arrows -->
                            <button type="button" @onclick="SelectPrevious" disabled="@(!CanGoPrevious)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer xl:hidden">
                                @Icons.Chevron("h-4 w-4 text-slate-600 rotate-180")
                            </button>
                            <!-- XL screens: up/down arrows -->
                            <button type="button" @onclick="SelectPrevious" disabled="@(!CanGoPrevious)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer hidden xl:block">
                                @Icons.Chevron("h-4 w-4 text-slate-600 -rotate-90")
                            </button>
                            <span class="text-sm text-slate-500">@(currentIndex + 1) of @filteredRegistrations.Count</span>
                            <!-- Medium screens: left/right arrows -->
                            <button type="button" @onclick="SelectNext" disabled="@(!CanGoNext)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer xl:hidden">
                                @Icons.Chevron("h-4 w-4 text-slate-600")
                            </button>
                            <!-- XL screens: up/down arrows -->
                            <button type="button" @onclick="SelectNext" disabled="@(!CanGoNext)"
                                    class="p-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors cursor-pointer hidden xl:block">
                                @Icons.Chevron("h-4 w-4 text-slate-600 rotate-90")
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/admin/registration/@selectedRegistration.Id" target="_blank"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors cursor-pointer flex items-center gap-1.5">
                                @Icons.Eye("h-4 w-4")
                                Details
                            </a>
                            <a href="/admin/registration/@selectedRegistration.Id/edit" target="_blank"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors cursor-pointer flex items-center gap-1.5">
                                @Icons.Edit("h-4 w-4")
                                Edit
                            </a>
                            <a href="/admin/audit/Registration/@selectedRegistration.Id" target="_blank"
                               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-sm font-medium text-slate-600 transition-colors cursor-pointer flex items-center gap-1.5">
                                @Icons.Clock("h-4 w-4")
                                Audit
                            </a>
                        </div>
                    </div>

                    <!-- Registration Card -->
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                        <!-- Header -->
                        <div class="bg-slate-800 px-5 py-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <h2 class="text-lg font-bold text-white">@selectedRegistration.PersonalInfo.FullName</h2>
                                    @if (!string.IsNullOrEmpty(selectedRegistration.Cid))
                                    {
                                        <span class="font-mono text-cyan-300 text-sm">@selectedRegistration.Cid</span>
                                    }
                                </div>
                                <StatusBadge Status="selectedRegistration.Status" Size="StatusBadge.StatusBadgeSize.Large" />
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-4">
                            <div class="grid grid-cols-1 xl:grid-cols-2 gap-3">
                                <!-- Left Column: Personal & Competition Info -->
                                <div class="space-y-3">
                                    <!-- Personal Info -->
                                    <div class="rounded-lg border border-slate-200 overflow-hidden">
                                        <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                                            <div class="flex items-center gap-2">
                                                @Icons.User("h-4 w-4 text-cyan-600")
                                                <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Personal</h3>
                                            </div>
                                        </div>
                                        <div class="px-3 py-2 space-y-1.5">
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Full Name</span>
                                                <span class="text-xs font-medium text-slate-800">@selectedRegistration.PersonalInfo.FullName</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Date of Birth</span>
                                                <span class="text-xs font-medium text-slate-800">@selectedRegistration.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy") (@(CalculateAge(selectedRegistration.PersonalInfo.DateOfBirth))y)</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Gender</span>
                                                <span class="text-xs font-medium text-slate-800">@selectedRegistration.PersonalInfo.Gender</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Location</span>
                                                <span class="text-xs font-medium text-slate-800">@selectedRegistration.AddressInfo.City, @selectedRegistration.AddressInfo.StateProvince</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Competition Info -->
                                    <div class="rounded-lg border border-slate-200 overflow-hidden">
                                        <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                                            <div class="flex items-center gap-2">
                                                @Icons.Award("h-4 w-4 text-amber-600")
                                                <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Competition</h3>
                                            </div>
                                        </div>
                                        <div class="px-3 py-2 space-y-1.5">
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Division</span>
                                                <span class="text-xs font-medium text-slate-800">@GetDivisionName(selectedRegistration)</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Category</span>
                                                <span class="text-xs font-medium text-slate-800">@GetCategoryName(selectedRegistration)</span>
                                            </div>
                                            @if (selectedRegistration.CompetitionSelection.PortionChoice.HasValue)
                                            {
                                                <div class="flex justify-between">
                                                    <span class="text-xs text-slate-500">Portion</span>
                                                    <span class="text-xs font-medium text-slate-800">@selectedRegistration.CompetitionSelection.PortionChoice</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Contact Info -->
                                    <div class="rounded-lg border border-slate-200 overflow-hidden">
                                        <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                                            <div class="flex items-center gap-2">
                                                @Icons.Phone("h-4 w-4 text-slate-500")
                                                <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Contacts</h3>
                                            </div>
                                        </div>
                                        <div class="px-3 py-2 space-y-1.5">
                                            <div class="flex justify-between">
                                                <span class="text-xs text-slate-500">Parent</span>
                                                <span class="text-xs font-medium text-slate-800">
                                                    @selectedRegistration.ParentInfo.FullName
                                                    @if (!string.IsNullOrEmpty(selectedRegistration.ParentInfo.PhoneNumber))
                                                    {
                                                        <span class="text-slate-300 mx-1">|</span>
                                                        <span class="text-slate-500 font-normal">@selectedRegistration.ParentInfo.PhoneNumber</span>
                                                    }
                                                </span>
                                            </div>
                                            @if (selectedRegistration.TeacherInfo != null)
                                            {
                                                <div class="flex justify-between">
                                                    <span class="text-xs text-slate-500">Teacher</span>
                                                    <span class="text-xs font-medium text-slate-800">
                                                        @selectedRegistration.TeacherInfo.FullName
                                                        @if (!string.IsNullOrEmpty(selectedRegistration.TeacherInfo.PhoneNumber))
                                                        {
                                                            <span class="text-slate-300 mx-1">|</span>
                                                            <span class="text-slate-500 font-normal">@selectedRegistration.TeacherInfo.PhoneNumber</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column: Files & Status -->
                                <div class="space-y-3">
                                    <!-- Files -->
                                    <div class="rounded-lg border border-slate-200 overflow-hidden">
                                        <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                                            <div class="flex items-center gap-2">
                                                @Icons.Photo("h-4 w-4 text-cyan-600")
                                                <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Documents</h3>
                                                @if (selectedRegistration.FileUploadInfo.NiqabBypassApproved)
                                                {
                                                    <span class="ml-auto px-1.5 py-0.5 rounded bg-slate-100 text-[10px] font-medium text-slate-600">Niqab Bypass</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="p-3">
                                            <div class="grid grid-cols-2 gap-2">
                                                <!-- ID Document -->
                                                @if (selectedRegistration.FileUploadInfo.IdDocument != null)
                                                {
                                                    @if (IsImageFile(selectedRegistration.FileUploadInfo.IdDocument.Extension))
                                                    {
                                                        <button type="button" @onclick="() => OpenIdInLightbox()" @key="@($"id-{selectedRegistration.Id}")"
                                                                class="group relative aspect-[4/3] rounded-lg border-2 border-slate-200 hover:border-cyan-400 overflow-hidden transition-colors cursor-pointer">
                                                            <img src="@GetFileUrl(selectedRegistration.FileUploadInfo.IdDocument.StorageReference)"
                                                                 alt="ID Document" class="w-full h-full object-cover" loading="eager" />
                                                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                                                <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 px-2 py-1 rounded text-xs font-medium text-slate-700">
                                                                    View ID
                                                                </span>
                                                            </div>
                                                            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1">
                                                                <span class="text-xs font-medium text-white">ID Document</span>
                                                            </div>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <!-- PDF Document - opens in new tab -->
                                                        <a href="@GetFileUrl(selectedRegistration.FileUploadInfo.IdDocument.StorageReference)" target="_blank" rel="noopener noreferrer"
                                                           class="group relative aspect-[4/3] rounded-lg border-2 border-slate-200 hover:border-cyan-400 overflow-hidden transition-colors cursor-pointer flex flex-col items-center justify-center bg-slate-50">
                                                            @Icons.FilePdf("h-12 w-12 text-red-500 group-hover:text-red-600 transition-colors")
                                                            <span class="mt-2 text-xs font-medium text-slate-600 group-hover:text-slate-800 transition-colors">ID Document (PDF)</span>
                                                            <span class="mt-1 text-xs text-slate-400">Click to open</span>
                                                        </a>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="aspect-[4/3] rounded-lg border-2 border-dashed border-red-300 bg-red-50 flex items-center justify-center">
                                                        <span class="text-xs font-medium text-red-500">No ID</span>
                                                    </div>
                                                }

                                                <!-- Photo -->
                                                @if (selectedRegistration.FileUploadInfo.Photo != null)
                                                {
                                                    <button type="button" @onclick="() => OpenPhotoInLightbox()" @key="@($"photo-{selectedRegistration.Id}")"
                                                            class="group relative aspect-[4/3] rounded-lg border-2 border-slate-200 hover:border-cyan-400 overflow-hidden transition-colors cursor-pointer">
                                                        <img src="@GetFileUrl(selectedRegistration.FileUploadInfo.Photo.StorageReference)"
                                                             alt="Competitor Photo" class="w-full h-full object-cover" loading="eager" />
                                                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                                            <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-white/90 px-2 py-1 rounded text-xs font-medium text-slate-700">
                                                                View Photo
                                                            </span>
                                                        </div>
                                                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/60 to-transparent px-2 py-1">
                                                            <span class="text-xs font-medium text-white">Photo</span>
                                                        </div>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="aspect-[4/3] rounded-lg border-2 border-dashed border-red-300 bg-red-50 flex items-center justify-center">
                                                        <span class="text-xs font-medium text-red-500">No Photo</span>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Video Download -->
                                            @if (selectedRegistration.FileUploadInfo.Video != null)
                                            {
                                                <div class="mt-2">
                                                    <button type="button" @onclick="DownloadVideo"
                                                            class="w-full px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-xs font-medium text-slate-700 transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                                        @Icons.Download("h-3.5 w-3.5")
                                                        Download Video (@FormatFileSize(selectedRegistration.FileUploadInfo.Video.FileSizeBytes))
                                                    </button>
                                                </div>
                                            }
                                            else if (CategoryRequiresVideo(selectedRegistration))
                                            {
                                                <div class="mt-2 px-3 py-1.5 rounded-lg border border-dashed border-amber-300 bg-amber-50 text-center">
                                                    <span class="text-[11px] font-medium text-amber-600">Video required but not uploaded</span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Current Status Comment -->
                                    @if (!string.IsNullOrEmpty(selectedRegistration.StatusComment))
                                    {
                                        <div class="bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
                                            <div class="flex items-start gap-2">
                                                @Icons.ChatBubble("h-3.5 w-3.5 text-amber-600 mt-0.5 shrink-0")
                                                <p class="text-xs text-amber-800">@selectedRegistration.StatusComment</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Update Status -->
                                    <div class="rounded-lg border border-slate-200 overflow-hidden">
                                        <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                                            <div class="flex items-center gap-2">
                                                @Icons.Refresh("h-4 w-4 text-cyan-600")
                                                <h3 class="text-xs font-semibold text-slate-700 uppercase tracking-wide">Update Status</h3>
                                            </div>
                                        </div>
                                        <div class="px-3 py-2.5 space-y-2">
                                            <select @bind="newStatus"
                                                    class="w-full px-3 py-1.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-xs cursor-pointer">
                                                <option value="">Select new status...</option>
                                                @foreach (var status in GetAvailableStatuses(selectedRegistration.Status))
                                                {
                                                    <option value="@status">@StatusBadge.GetDisplayName(status)</option>
                                                }
                                            </select>
                                            <textarea @bind="newComment" rows="2"
                                                      placeholder="Comment (optional for approval, required for rejection)..."
                                                      class="w-full px-3 py-1.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-xs resize-none"></textarea>
                                            <div class="flex gap-2">
                                                <button type="button" @onclick="UpdateStatus" disabled="@(string.IsNullOrEmpty(newStatus) || isUpdating)"
                                                        class="flex-1 px-3 py-1.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-400 text-white text-xs font-medium transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                                    @if (isUpdating)
                                                    {
                                                        @Icons.Spinner("h-3.5 w-3.5")
                                                        <span>Updating...</span>
                                                    }
                                                    else
                                                    {
                                                        @Icons.CheckCircle("h-3.5 w-3.5")
                                                        <span>Apply Status</span>
                                                    }
                                                </button>
                                                @if (selectedRegistration.Status == RegistrationStatus.AwaitingReview || selectedRegistration.Status == RegistrationStatus.Pending)
                                                {
                                                    <button type="button" @onclick="MarkAsReviewed" disabled="@isUpdating"
                                                            title="Mark as Reviewed"
                                                            class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-400 text-white text-xs font-medium transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                                        @if (isUpdating)
                                                        {
                                                            @Icons.Spinner("h-3.5 w-3.5")
                                                        }
                                                        else
                                                        {
                                                            @Icons.CheckCircle("h-3.5 w-3.5")
                                                            <span>Reviewed</span>
                                                        }
                                                    </button>
                                                }
                                            </div>
                                            @if (selectedRegistration.Status == RegistrationStatus.Pending)
                                            {
                                                <div class="pt-2 border-t border-slate-100 space-y-1.5">
                                                    <button type="button" @onclick="UpdatePendingComment"
                                                            disabled="@(string.IsNullOrWhiteSpace(newComment) || isUpdating)"
                                                            class="w-full px-3 py-1.5 rounded-xl border border-amber-300 bg-amber-50 hover:bg-amber-100 disabled:bg-slate-100 disabled:border-slate-200 text-xs font-medium text-amber-800 disabled:text-slate-400 transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                                        @if (isUpdating)
                                                        {
                                                            @Icons.Spinner("h-3.5 w-3.5")
                                                            <span>Updating...</span>
                                                        }
                                                        else
                                                        {
                                                            @Icons.ChatBubble("h-3.5 w-3.5")
                                                            <span>Update Comment & Notify</span>
                                                        }
                                                    </button>
                                                    <button type="button" @onclick="ResendPendingEmail"
                                                            disabled="@(isResendingEmail || string.IsNullOrEmpty(selectedRegistration.StatusComment))"
                                                            class="w-full px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 disabled:bg-slate-50 text-xs font-medium text-slate-600 disabled:text-slate-400 transition-colors cursor-pointer flex items-center justify-center gap-1.5">
                                                        @if (isResendingEmail)
                                                        {
                                                            @Icons.Spinner("h-3.5 w-3.5")
                                                            <span>Sending...</span>
                                                        }
                                                        else
                                                        {
                                                            @Icons.Envelope("h-3.5 w-3.5")
                                                            <span>Resend Email</span>
                                                        }
                                                        @if (pendingEmailsSentCount > 0)
                                                        {
                                                            <span class="ml-auto px-1.5 py-0.5 rounded-full bg-slate-200 text-[10px] font-bold text-slate-600">@pendingEmailsSentCount sent</span>
                                                        }
                                                    </button>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(statusUpdateError))
                                            {
                                                <div class="flex items-start gap-2 rounded-lg bg-red-50 border border-red-200 px-3 py-2 text-xs text-red-700">
                                                    @Icons.XCircle("h-3.5 w-3.5 text-red-500 mt-0.5 shrink-0")
                                                    <div>
                                                        <span class="font-medium">Error:</span> @statusUpdateError
                                                    </div>
                                                    <button type="button" @onclick="() => statusUpdateError = null" class="ml-auto shrink-0 text-red-400 hover:text-red-600 cursor-pointer">
                                                        @Icons.XCircle("h-3.5 w-3.5")
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Submission Footer -->
                            @if (submitterInfo != null)
                            {
                                <div class="mt-3 pt-3 border-t border-slate-200">
                                    <div class="flex items-center justify-between text-xs text-slate-500">
                                        <div class="flex items-center gap-1.5">
                                            @Icons.User("h-3.5 w-3.5 text-slate-400")
                                            <span>Submitted by</span>
                                            <span class="font-medium text-slate-700">@submitterInfo.Name</span>
                                            <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-medium">@submitterInfo.UserTypeDisplay</span>
                                        </div>
                                        @if (submitterInfo.SubmittedAt.HasValue)
                                        {
                                            <div class="flex items-center gap-1.5">
                                                @Icons.Clock("h-3.5 w-3.5 text-slate-400")
                                                <span>@submitterInfo.SubmittedAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- No Selection State -->
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm p-12 text-center">
                        <div class="w-16 h-16 rounded-2xl bg-cyan-100 flex items-center justify-center mx-auto mb-4">
                            @Icons.Cursor("h-8 w-8 text-cyan-600")
                        </div>
                        <h3 class="text-lg font-semibold text-slate-800 mb-2">Select a Registration</h3>
                        <p class="text-sm text-slate-500">Click on a registration from the list to review it.</p>
                    </div>
                }
            </div>

            <!-- Right Sidebar: Quick Presets -->
            <div class="w-56 xl:w-60 flex-shrink-0">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden sticky top-4">
                    <div class="px-3 py-2 border-b border-slate-200 bg-slate-50">
                        <span class="text-xs font-semibold text-slate-700">Quick Actions</span>
                    </div>
                    <div class="p-3 space-y-3 max-h-[calc(100vh-200px)] overflow-y-auto">
                        <!-- Approve -->
                        <div>
                            <h4 class="text-[10px] font-semibold text-cyan-700 uppercase tracking-wide mb-1.5 flex items-center gap-1">
                                @Icons.CheckCircle("h-3 w-3")
                                Approve
                            </h4>
                            <div class="space-y-1">
                                <button type="button" @onclick='() => ApplyPreset("Reviewed", "")'
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-cyan-200 bg-cyan-50 hover:bg-cyan-100 text-left text-[11px] text-cyan-800 transition-colors cursor-pointer">
                                    Mark as Reviewed
                                </button>
                                <button type="button" @onclick='() => ApplyPreset("Verified", "")'
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-cyan-200 bg-cyan-50 hover:bg-cyan-100 text-left text-[11px] text-cyan-800 transition-colors cursor-pointer">
                                    Mark as Verified
                                </button>
                            </div>
                        </div>

                        <!-- Send Back (Pending) -->
                        <div>
                            <h4 class="text-[10px] font-semibold text-amber-700 uppercase tracking-wide mb-1.5 flex items-center gap-1">
                                @Icons.Warning("h-3 w-3")
                                Send Back
                            </h4>
                            <div class="space-y-1">
                                @foreach (var preset in pendingPresets)
                                {
                                    <button type="button" @onclick="() => ApplyPreset(nameof(RegistrationStatus.Pending), preset)"
                                            class="w-full px-2.5 py-1.5 rounded-lg border border-amber-200 bg-amber-50 hover:bg-amber-100 text-left text-[11px] leading-tight text-amber-800 transition-colors cursor-pointer">
                                        @preset
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Disqualify -->
                        <div>
                            <h4 class="text-[10px] font-semibold text-slate-600 uppercase tracking-wide mb-1.5 flex items-center gap-1">
                                @Icons.XCircle("h-3 w-3")
                                Disqualify
                            </h4>
                            <div class="space-y-1">
                                @foreach (var preset in disqualifyPresets)
                                {
                                    <button type="button" @onclick="() => ApplyPreset(nameof(RegistrationStatus.Disqualified), preset)"
                                            class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-left text-[11px] leading-tight text-slate-700 transition-colors cursor-pointer">
                                        @preset
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Withdraw -->
                        <div>
                            <h4 class="text-[10px] font-semibold text-slate-600 uppercase tracking-wide mb-1.5 flex items-center gap-1">
                                @Icons.Ban("h-3 w-3")
                                Withdraw
                            </h4>
                            <div class="space-y-1">
                                <button type="button" @onclick='() => ApplyPreset("Withdrawn", "Withdrawn by administrator")'
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-left text-[11px] text-slate-700 transition-colors cursor-pointer">
                                    Admin Withdrawal
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

