    private RenderFragment RenderDivisionEditPanel() => __builder =>
    {
        <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-100 to-slate-50">
            <h2 class="text-sm font-semibold text-slate-900">Edit Division</h2>
