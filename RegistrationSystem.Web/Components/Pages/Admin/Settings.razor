@page "/admin/competition-settings"
@attribute [Authorize(Roles = "Admin")]
@namespace RegistrationSystem.Web.Components.Pages.Admin

<div class="space-y-4">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-semibold text-slate-800">Competition Settings</h1>
            @if (HasUnsavedChanges)
            {
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                    Unsaved
                </span>
            }
        </div>
        <div class="flex items-center gap-2">
            @if (HasUnsavedChanges)
            {
                <button type="button"
                        class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors"
                        @onclick="async () => await ReloadAsync()"
                        disabled="@isSaving">
                    Discard
                </button>
            }
            <button type="button"
                    class="cursor-pointer rounded-md bg-cyan-700 text-white px-4 py-1.5 text-sm font-medium hover:bg-cyan-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98] transition-all flex items-center gap-1.5 shadow-sm"
                    @onclick="SaveAsync"
                    disabled="@(isSaving || !HasUnsavedChanges)">
                @if (isSaving)
                {
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                    </svg>
                }
                Save Changes
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
                <span class="text-sm text-slate-500">Loading settings...</span>
            </div>
        </div>
    }
    else if (settings is not null)
    {
        <!-- Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                    </svg>
                    <span>@errorMessage</span>
                </div>
                <button type="button" class="cursor-pointer text-red-600 hover:text-red-800 transition-colors" @onclick="ClearMessages">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>@successMessage</span>
                </div>
                <button type="button" class="cursor-pointer text-cyan-600 hover:text-cyan-800 transition-colors" @onclick="ClearMessages">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
        }

        <!-- Tabs -->
        <div class="border-b border-slate-200">
            <nav class="flex gap-1" aria-label="Tabs">
                <button type="button" class="@GetTabClasses(0) cursor-pointer" @onclick="() => TrySwitchTab(0)">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span>Status</span>
                </button>
                <button type="button" class="@GetTabClasses(1) cursor-pointer" @onclick="() => TrySwitchTab(1)">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Schedule</span>
                </button>
                <button type="button" class="@GetTabClasses(2) cursor-pointer" @onclick="() => TrySwitchTab(2)">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <span>Divisions</span>
                </button>
                <button type="button" class="@GetTabClasses(3) cursor-pointer" @onclick="() => TrySwitchTab(3)">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Competition Info</span>
                </button>
            </nav>
        </div>

        <!-- Tab Content with Edit Panel -->
        <div class="flex gap-6">
            <!-- Main content -->
            <div class="flex-1 min-w-0 lg:max-w-[calc(100%-26rem)]">
                @if (activeTab == 0 && globalStatus is not null)
                {
                    @RenderStatusDashboard()
                }
                else if (activeTab == 1)
                {
                    @RenderScheduleTab()
                }
                else if (activeTab == 2)
                {
                    @RenderDivisionsTab()
                }
                else if (activeTab == 3)
                {
                    @RenderCompetitionInfoTab()
                }
            </div>

            <!-- Edit Panel (right side - desktop) - Always visible on Divisions tab -->
            @if (activeTab == 2)
            {
                <div class="hidden lg:block w-96 flex-shrink-0">
                    <div class="sticky top-4 rounded-xl border border-slate-200 bg-white shadow-lg overflow-hidden">
                        @if (editingCategory is not null)
                        {
                            @RenderCategoryEditPanel()
                        }
                        else if (editingDivision is not null)
                        {
                            @RenderDivisionEditPanel()
                        }
                        else
                        {
                            @RenderEditPanelPlaceholder()
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Mobile Edit Panel (slide-in) -->
        @if (editPanelOpen && (editingDivision is not null || editingCategory is not null))
        {
            <div class="lg:hidden fixed inset-0 z-50">
                <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @onclick="TryCloseEditPanel"></div>
                <div class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl overflow-y-auto">
                    @if (editingCategory is not null)
                    {
                        @RenderCategoryEditPanel()
                    }
                    else if (editingDivision is not null)
                    {
                        @RenderDivisionEditPanel()
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Modals -->
@if (showDeleteModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @onclick="CloseDeleteModal"></div>
            <div class="relative bg-gradient-to-br from-white to-slate-50 rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200">
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow-lg">
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="flex-1 pt-1">
                            <h3 class="text-lg font-semibold text-slate-900">Confirm Delete</h3>
                            <p class="mt-2 text-sm text-slate-600">@deleteModalMessage</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex gap-3 justify-end">
                    <button type="button"
                            class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                            @onclick="CloseDeleteModal">
                        Cancel
                    </button>
                    <button type="button"
                            class="cursor-pointer rounded-lg bg-gradient-to-r from-red-600 to-red-700 text-white px-4 py-2 text-sm font-medium hover:from-red-700 hover:to-red-800 transition-all shadow-sm"
                            @onclick="ConfirmDelete">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showHierarchyModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @onclick="CloseHierarchyModal"></div>
            <div class="relative bg-gradient-to-br from-white to-slate-50 rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200">
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-lg">
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="flex-1 pt-1">
                            <h3 class="text-lg font-semibold text-slate-900">Cannot Enable</h3>
                            <p class="mt-2 text-sm text-slate-600">@hierarchyModalMessage</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end">
                    <button type="button"
                            class="cursor-pointer rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm"
                            @onclick="CloseHierarchyModal">
                        Understood
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showInfoModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @onclick="CloseInfoModal"></div>
            <div class="relative bg-gradient-to-br from-white to-slate-50 rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200">
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow-lg">
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="flex-1 pt-1">
                            <h3 class="text-lg font-semibold text-slate-900">@infoModalTitle</h3>
                            <div class="mt-2 text-sm text-slate-600 prose prose-sm prose-slate">@((MarkupString)infoModalContent)</div>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end">
                    <button type="button"
                            class="cursor-pointer rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm"
                            @onclick="CloseInfoModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUnsavedWarningModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
            <div class="relative bg-gradient-to-br from-white to-slate-50 rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200">
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-lg">
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="flex-1 pt-1">
                            <h3 class="text-lg font-semibold text-slate-900">Unsaved Changes</h3>
                            <p class="mt-2 text-sm text-slate-600">You have unsaved changes. What would you like to do?</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col gap-2">
                    <button type="button"
                            class="cursor-pointer w-full rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-4 py-2.5 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm"
                            @onclick="SaveAndSwitchTab">
                        Save changes
                    </button>
                    <button type="button"
                            class="cursor-pointer w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                            @onclick="ConfirmDiscardAndSwitchTab">
                        Discard changes
                    </button>
                    <button type="button"
                            class="cursor-pointer w-full text-sm text-slate-500 hover:text-slate-700 py-2 transition-colors"
                            @onclick="CancelTabSwitch">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showUnsavedEditModal)
{
    <div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex min-h-screen items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
            <div class="relative bg-gradient-to-br from-white to-slate-50 rounded-xl shadow-2xl max-w-sm w-full overflow-hidden border border-slate-200">
                <div class="px-6 pt-6 pb-4">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-lg">
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="flex-1 pt-1">
                            <h3 class="text-lg font-semibold text-slate-900">Unsaved Edits</h3>
                            <p class="mt-2 text-sm text-slate-600">You have unsaved edits. Save them before switching?</p>
                        </div>
                    </div>
                </div>
                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col gap-2">
                    <button type="button"
                            class="cursor-pointer w-full rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-4 py-2.5 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm"
                            @onclick="SaveAndProceedPendingAction">
                        Save & continue
                    </button>
                    <button type="button"
                            class="cursor-pointer w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-colors shadow-sm"
                            @onclick="DiscardAndProceedPendingAction">
                        Discard & continue
                    </button>
                    <button type="button"
                            class="cursor-pointer w-full text-sm text-slate-500 hover:text-slate-700 py-2 transition-colors"
                            @onclick="CancelPendingAction">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ═══════════════════════════════════════════════════════════════════════════
    // STATUS DASHBOARD TAB - 4 columns on desktop, 1 on mobile
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStatusDashboard() => __builder =>
    {
        <!-- Hero Status Card -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-4 shadow-sm mb-4">
            <div class="flex flex-col gap-4">
                <!-- Status indicator -->
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl @(globalStatus!.IsGloballyEnabled ? "bg-gradient-to-br from-cyan-500 to-cyan-700" : "bg-gradient-to-br from-slate-400 to-slate-500") flex items-center justify-center shadow-lg flex-shrink-0">
                        @if (globalStatus.IsGloballyEnabled)
                        {
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-base font-semibold text-slate-900">
                            Global:
                            <span class="@(globalStatus.IsGloballyEnabled ? "text-cyan-700" : "text-slate-500")">
                                @(globalStatus.IsGloballyEnabled ? "Enabled" : "Disabled")
                            </span>
                        </h2>
                        @if (globalStatus.IsGloballyEnabled && globalStatus.GlobalStart.HasValue && globalStatus.GlobalEnd.HasValue)
                        {
                            <p class="text-xs text-slate-500 mt-0.5 truncate">
                                @globalStatus.GlobalStart.Value.ToString("MMM d") — @globalStatus.GlobalEnd.Value.ToString("MMM d, yyyy")
                                @if (globalStatus.IsWithinGlobalDateWindow)
                                {
                                    <span class="ml-1 inline-flex items-center gap-1 text-cyan-700 font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
                                        Active
                                    </span>
                                }
                            </p>
                        }
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Registration Hierarchy", GetRegistrationHierarchyExplanation())'>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>

                <!-- Stats grid - 2x2 on mobile, row on desktop -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold @(globalStatus.TotalOpenCategories > 0 ? "text-cyan-700" : "text-slate-400")">
                            @globalStatus.TotalOpenCategories
                        </div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Open</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold text-slate-700">@globalStatus.TotalCategories</div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Total</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-white border border-slate-200 shadow-sm">
                        <div class="text-xl font-bold text-slate-700">
                            @globalStatus.EnabledDivisions<span class="text-sm font-normal text-slate-400">/@globalStatus.TotalDivisions</span>
                        </div>
                        <div class="text-xs text-slate-600 leading-tight">
                            <div class="font-semibold">Div</div>
                        </div>
                    </div>
                    @if (globalStatus.CategoriesWithOverrides > 0)
                    {
                        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-violet-50 border border-violet-200 shadow-sm">
                            <div class="text-xl font-bold text-violet-700">@globalStatus.CategoriesWithOverrides</div>
                            <div class="text-xs text-violet-700 leading-tight">
                                <div class="font-semibold">OVR</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 shadow-sm">
                            <div class="text-xl font-bold text-slate-400">0</div>
                            <div class="text-xs text-slate-500 leading-tight">
                                <div class="font-semibold">OVR</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Divisions List -->
        @if (globalStatus.Divisions.Count > 0)
        {
            <div class="space-y-3">
                @foreach (var division in globalStatus.Divisions)
                {
                    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                        <!-- Division header -->
                        <div class="px-3 py-2.5 bg-gradient-to-r from-slate-50 to-white border-b border-slate-100 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="flex-shrink-0 @(division.IsManuallyEnabled ? "text-cyan-600" : "text-slate-400")">
                                    @if (division.IsManuallyEnabled)
                                    {
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                    }
                                </span>
                                <span class="font-semibold text-slate-900 text-sm truncate">@division.DivisionName</span>
                            </div>
                            <span class="flex-shrink-0 text-xs @(division.OpenCategoryCount > 0 ? "text-cyan-700 font-semibold" : "text-slate-500")">
                                @division.OpenCategoryCount/@division.TotalCategoryCount
                            </span>
                        </div>

                        <!-- Categories - wrap naturally -->
                        @if (division.Categories.Count > 0)
                        {
                            <div class="p-2 flex flex-wrap gap-1.5">
                                @foreach (var cat in division.Categories)
                                {
                                    <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md border text-xs @(cat.IsOpen ? "bg-cyan-50 border-cyan-200 text-cyan-800" : "bg-slate-50 border-slate-200 text-slate-600")">
                                        <span class="@GetStatusDotClasses(cat)"></span>
                                        <span class="truncate max-w-[120px]">@cat.CategoryName</span>
                                        @if (cat.HasOverride)
                                        {
                                            <svg class="h-3 w-3 text-violet-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="px-3 py-2.5 text-center text-xs text-slate-400">No categories</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 text-slate-500">
                <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <p class="text-sm font-medium">No divisions configured</p>
                <p class="text-xs text-slate-400 mt-1">Go to the Divisions tab to add divisions and categories.</p>
            </div>
        }
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // SCHEDULE TAB - Global toggle + Window in same row on desktop
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderScheduleTab() => __builder =>
    {
        <div class="space-y-4">
            <!-- Global Registration Toggle -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow flex-shrink-0">
                            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-sm font-semibold text-slate-900">Global Registration</h2>
                            <p class="text-xs text-slate-500">Master switch for all registrations</p>
                        </div>
                        <button type="button"
                                class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                                @onclick='() => ShowInfo("Global Registration", GetGlobalToggleExplanation())'>
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <span class="text-xs font-semibold @(settings!.RegistrationEnabled ? "text-cyan-700" : "text-slate-400")">
                            @(settings.RegistrationEnabled ? "ON" : "OFF")
                        </span>
                        <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                            <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                            <input type="checkbox" checked="@settings.RegistrationEnabled" @onchange="ToggleGlobalRegistration" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                        </label>
                    </div>
                </div>
            </section>

            <!-- Default Window -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition-opacity @(settings!.RegistrationEnabled ? "" : "opacity-50 pointer-events-none")">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-semibold text-slate-900">Default Registration Window</h2>
                        <p class="text-xs text-slate-500">Used for categories without custom dates</p>
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Registration Window", GetRegistrationWindowExplanation())'>
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
                <div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
                    <div class="space-y-1.5">
                        <label class="text-xs font-medium text-slate-700">Start Date</label>
                        <input type="datetime-local"
                               value="@(settings?.RegistrationStart?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                               @onchange="e => SetGlobalStart(e.Value?.ToString())"
                               disabled="@(!settings.RegistrationEnabled)"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 disabled:bg-slate-100 disabled:cursor-not-allowed" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-xs font-medium text-slate-700">End Date</label>
                        <input type="datetime-local"
                               value="@(settings?.RegistrationEnd?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                               @onchange="e => SetGlobalEnd(e.Value?.ToString())"
                               disabled="@(!settings.RegistrationEnabled)"
                               class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 disabled:bg-slate-100 disabled:cursor-not-allowed" />
                    </div>
                </div>
            </section>

            <!-- Age Cutoff -->
            <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-semibold text-slate-900">Age Cutoff Date</h2>
                        <p class="text-xs text-slate-500">Competitor age is calculated as of this date</p>
                    </div>
                    <button type="button"
                            class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors flex-shrink-0"
                            @onclick='() => ShowInfo("Age Cutoff", GetAgeCutoffExplanation())'>
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                        </svg>
                    </button>
                </div>
                <input type="date"
                       value="@ageCutoffDateString"
                       @onchange="OnAgeCutoffChanged"
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 cursor-pointer" />
            </section>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // DIVISIONS TAB
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderDivisionsTab() => __builder =>
    {
        <div class="space-y-3">
            @if (isAddingDivision)
            {
                <div class="rounded-xl border-2 border-dashed border-cyan-300 bg-cyan-50/50 p-3 sm:p-4">
                    <div class="flex flex-col sm:flex-row sm:items-end gap-3">
                        <div class="flex-1">
                            <label class="text-xs font-medium text-slate-700 mb-1.5 block">Division Name</label>
                            <input type="text" @bind="newDivisionName" @bind:event="oninput" placeholder="e.g., Boys, Girls, Adults"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                        <div class="flex gap-2 sm:gap-3">
                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg bg-cyan-700 text-white px-4 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors shadow-sm" @onclick="ConfirmAddDivision">Add</button>
                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors" @onclick="CancelAddDivision">Cancel</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="cursor-pointer inline-flex items-center gap-2 text-sm text-cyan-700 hover:text-cyan-800 font-medium transition-colors" @onclick="StartAddDivision">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    Add new division
                </button>
            }

            @foreach (var division in settings!.Divisions)
            {
                var isExpanded = IsDivisionExpanded(division.Id);
                var isSelected = selectedDivisionId == division.Id && selectedCategory is null;

                <div class="rounded-xl border @(isSelected ? "border-cyan-400 ring-2 ring-cyan-100" : isExpanded ? "border-slate-300" : "border-slate-200") bg-white shadow-sm overflow-hidden transition-all">
                    <div class="px-3 sm:px-4 py-3 @(isExpanded ? "bg-gradient-to-r from-slate-100 to-slate-50" : "bg-gradient-to-r from-slate-50 to-white") flex items-center justify-between cursor-pointer hover:from-slate-100 hover:to-slate-50 transition-all"
                         @onclick="() => ToggleDivisionExpand(division.Id)">
                        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
                            <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 flex-shrink-0 @(isExpanded ? "rotate-90" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                            <span class="flex-shrink-0 @(division.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                @if (division.IsEnabled)
                                {
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                }
                                else
                                {
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                                }
                            </span>
                            <span class="font-semibold text-slate-900 truncate">@division.Name</span>
                            @if (!division.IsEnabled)
                            {
                                <span class="hidden sm:inline-block rounded-full bg-slate-200 px-2 py-0.5 text-[0.65rem] font-semibold uppercase text-slate-600 tracking-wide flex-shrink-0">Disabled</span>
                            }
                        </div>
                        <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
                            <span class="text-xs text-slate-500 font-medium hidden sm:inline">@division.Categories.Count categories</span>
                            <span class="text-xs text-slate-500 font-medium sm:hidden">@division.Categories.Count</span>
                            <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 p-1.5 rounded-lg hover:bg-white transition-all"
                                    @onclick:stopPropagation="true" @onclick="() => BeginEditDivision(division)">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                            </button>
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="p-3 sm:p-4 border-t border-slate-200 bg-white">
                            @if (addingCategoryToDivisionId == division.Id)
                            {
                                <div class="mb-4 rounded-lg border-2 border-dashed border-cyan-300 bg-cyan-50/50 p-3">
                                    <div class="flex flex-col sm:flex-row sm:items-end gap-2">
                                        <div class="flex-1">
                                            <input type="text" @bind="newCategoryName" @bind:event="oninput" placeholder="Category name"
                                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                                        </div>
                                        <div class="flex gap-2">
                                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg bg-cyan-700 text-white px-3 py-1.5 text-xs font-medium hover:bg-cyan-800 transition-colors" @onclick="() => ConfirmAddCategory(division)">Add</button>
                                            <button type="button" class="flex-1 sm:flex-none cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" @onclick="CancelAddCategory">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="cursor-pointer mb-4 inline-flex items-center gap-1.5 text-xs text-cyan-700 hover:text-cyan-800 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                        @onclick="() => StartAddCategory(division.Id)" disabled="@(!settings.RegistrationEnabled || !division.IsEnabled)">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    Add category
                                </button>
                            }

                            @if (division.Categories.Count > 0)
                            {
                                <!-- Mobile: Card layout -->
                                <div class="sm:hidden space-y-2">
                                    @foreach (var category in division.Categories)
                                    {
                                        var catStatus = globalStatus?.Divisions.FirstOrDefault(d => d.DivisionId == division.Id)?.Categories.FirstOrDefault(c => c.CategoryId == category.Id);
                                        var isRowSelected = selectedCategoryId == category.Id;

                                        <div class="@(isRowSelected ? "bg-cyan-50 border-cyan-200" : "bg-slate-50 border-slate-200") border rounded-lg p-3 cursor-pointer active:bg-slate-100 transition-colors"
                                             @onclick="() => BeginEditCategory(division, category)">
                                            <div class="flex items-center justify-between mb-2">
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <span class="flex-shrink-0 @(category.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                                        @if (category.IsEnabled)
                                                        {
                                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                                        }
                                                        else
                                                        {
                                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                                                        }
                                                    </span>
                                                    <span class="font-medium text-slate-900 truncate">@category.Name</span>
                                                </div>
                                                @if (catStatus is not null)
                                                {
                                                    <span class="@GetStatusBadgeClasses(catStatus) flex-shrink-0">@catStatus.StatusLabel</span>
                                                }
                                            </div>
                                            <div class="flex items-center gap-3 text-xs text-slate-500">
                                                @if (category.MaxAgeYears.HasValue)
                                                {
                                                    <span>≤@category.MaxAgeYears yrs</span>
                                                }
                                                @if (category.PortionOption != PortionOption.NotApplicable)
                                                {
                                                    <span>@GetPortionDisplayName(category.PortionOption)</span>
                                                }
                                                @if (IsCategoryOverrideSaved(category.Id))
                                                {
                                                    <span class="inline-flex items-center gap-1 text-violet-600">
                                                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                                        Override
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Desktop: Table layout -->
                                <div class="hidden sm:block overflow-x-auto rounded-lg border border-slate-200">
                                    <table class="w-full text-left">
                                        <thead class="bg-slate-50 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                                            <tr>
                                                <th class="px-3 py-2.5 w-24">Category</th>
                                                <th class="px-3 py-2.5 w-24">Status</th>
                                                <th class="px-3 py-2.5 w-20">Portion</th>
                                                <th class="px-3 py-2.5 w-20">Max Age</th>
                                                <th class="px-3 py-2.5 w-20">Schedule</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            @foreach (var category in division.Categories)
                                            {
                                                var catStatus = globalStatus?.Divisions.FirstOrDefault(d => d.DivisionId == division.Id)?.Categories.FirstOrDefault(c => c.CategoryId == category.Id);
                                                var isRowSelected = selectedCategoryId == category.Id;

                                                <tr class="@(isRowSelected ? "bg-cyan-50" : "hover:bg-slate-50") cursor-pointer transition-colors" @onclick="() => BeginEditCategory(division, category)">
                                                    <td class="px-3 py-2.5">
                                                        <div class="flex items-center gap-2.5">
                                                            <span class="@(category.IsEnabled ? "text-cyan-600" : "text-slate-400")">
                                                                @if (category.IsEnabled)
                                                                {
                                                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                                                }
                                                                else
                                                                {
                                                                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                                                                }
                                                            </span>
                                                            <div class="min-w-0">
                                                                <div class="text-sm font-medium text-slate-900 truncate">@category.Name</div>
                                                                @if (!string.IsNullOrEmpty(category.AlternateName))
                                                                {
                                                                    <div class="text-xs text-slate-500 truncate">@category.AlternateName</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2.5">
                                                        @if (catStatus is not null)
                                                        {
                                                            <span class="@GetStatusBadgeClasses(catStatus)">@catStatus.StatusLabel</span>
                                                        }
                                                    </td>
                                                    <td class="px-3 py-2.5">@RenderPortionBadge(category.PortionOption)</td>
                                                    <td class="px-3 py-2.5"><span class="text-sm text-slate-700">@(category.MaxAgeYears.HasValue ? $"≤{category.MaxAgeYears}" : "—")</span></td>
                                                    <td class="px-3 py-2.5">
                                                        @if (IsCategoryOverrideSaved(category.Id))
                                                        {
                                                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-violet-100 text-violet-700 border border-violet-200" title="Schedule override active">
                                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-300">—</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-6 text-slate-500 border border-dashed border-slate-200 rounded-lg bg-slate-50/50">
                                    <svg class="mx-auto h-8 w-8 text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                                    <p class="text-sm">No categories in this division yet.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (settings.Divisions.Count == 0)
            {
                <div class="text-center py-12 text-slate-500 border-2 border-dashed border-slate-200 rounded-xl bg-slate-50/50">
                    <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    <p class="text-sm font-medium text-slate-700">No divisions yet</p>
                    <p class="text-xs text-slate-400 mt-1">Click "Add new division" to get started.</p>
                </div>
            }
        </div>
    };

