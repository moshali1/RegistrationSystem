    // CATEGORY EDIT PANEL
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderCategoryEditPanel() => __builder =>
    {
        var hasOverride = editingCategory!.RegistrationStart.HasValue || editingCategory.RegistrationEnd.HasValue;

        <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between bg-gradient-to-r from-slate-100 to-slate-50">
            <div>
                <h2 class="text-sm font-semibold text-slate-900">Edit Category</h2>
                <p class="text-xs text-slate-500">@selectedDivision!.Name</p>
            </div>
            <button type="button" class="cursor-pointer text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-white transition-all" @onclick="TryCloseEditPanel">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
            </button>
        </div>

        <div class="p-5 space-y-5">
            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-700">Category Name</label>
                <input type="text" @bind="editingCategory.Name" @bind:event="oninput"
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
            </div>

            <div class="space-y-1.5">
                <label class="text-xs font-semibold text-slate-700">Alternate Name <span class="text-slate-400 font-normal">(optional)</span></label>
                <input type="text" @bind="editingCategory.AlternateName" @bind:event="oninput" placeholder="e.g., Whole Qur'an"
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
            </div>

            <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200">
                <div class="flex items-center gap-2">
                    <label class="text-sm font-medium text-slate-700">Enabled</label>
                    <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors" @onclick='() => ShowInfo("Category Enable/Disable", GetCategoryEnableExplanation())'>
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                    </button>
                </div>
                <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                    <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                    <input type="checkbox" checked="@editingCategory.IsEnabled" @onchange="TryToggleEditingCategory" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                </label>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Portion</label>
                    <select @bind="editingCategory.PortionOption" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                        @foreach (PortionOption opt in Enum.GetValues<PortionOption>())
                        {
                            <option value="@opt">@GetPortionDisplayName(opt)</option>
                        }
                    </select>
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs font-semibold text-slate-700">Max Age</label>
                    <InputNumber @bind-Value="editingCategory.MaxAgeYears" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                </div>
            </div>

            <!-- Video Requirements -->
            <div class="border-t border-slate-200 pt-5">
                <div class="flex items-center justify-between mb-3">
                    <label class="text-xs font-semibold text-slate-700">Video Requirements</label>
                </div>
                <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200 mb-3">
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <label class="text-sm font-medium text-slate-700">Requires Video Upload</label>
                    </div>
                    <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                        <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                        <input type="checkbox" @bind="editingCategory.RequiresVideo" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                    </label>
                </div>
                @if (editingCategory.RequiresVideo)
                {
                    <div class="space-y-1.5">
                        <label class="text-xs text-slate-600">Video Instructions</label>
                        <textarea @bind="editingCategory.VideoInstructions" @bind:event="oninput"
                                  placeholder="e.g., Record Surah Al-Baqarah verses 1-20 with clear audio"
                                  rows="3"
                                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500"></textarea>
                    </div>
                }
            </div>

            <!-- Screening Round -->
            <div class="border-t border-slate-200 pt-5">
                <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200">
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                        </svg>
                        <div>
                            <label class="text-sm font-medium text-slate-700">Enable Screening Round</label>
                            <p class="text-xs text-slate-500">Pass/fail qualification round (some competitors may bypass)</p>
                        </div>
                    </div>
                    <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                        <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                        <input type="checkbox" @bind="editingCategory.ScreeningRoundEnabled" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                    </label>
                </div>
            </div>

            <!-- Multiple Registrations -->
            <div class="border-t border-slate-200 pt-5">
                <div class="flex items-center justify-between py-3 px-4 rounded-lg bg-slate-50 border border-slate-200">
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        <div>
                            <label class="text-sm font-medium text-slate-700">Allow Multiple in Division</label>
                            <p class="text-xs text-slate-500">Allow competitor to register for other categories in same division</p>
                        </div>
                    </div>
                    <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                        <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                        <input type="checkbox" @bind="editingCategory.AllowMultipleInDivision" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                    </label>
                </div>
            </div>

            <!-- Registration Rules Section -->
            <div class="border-t border-slate-200 pt-5">
                <div class="flex items-center gap-2 mb-4">
                    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <label class="text-xs font-semibold text-slate-700">Registration Rules</label>
                </div>

                <!-- Allow Edit -->
                <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3">
                        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        <div>
                            <label class="text-sm font-medium text-slate-700">Allow Edits</label>
                            <p class="text-xs text-slate-500">Allow users to edit registrations sent back for corrections</p>
                        </div>
                    </div>
                    <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                        <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                        <input type="checkbox" @bind="editingCategory.AllowEdit" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                    </label>
                </div>

                <!-- Allow Withdraw -->
                <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3">
                        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                        </svg>
                        <div>
                            <label class="text-sm font-medium text-slate-700">Allow Withdrawals</label>
                            <p class="text-xs text-slate-500">Allow users to withdraw their registrations</p>
                        </div>
                    </div>
                    <label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5 outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5 transition-colors duration-200 ease-in-out has-[:checked]:bg-cyan-700 has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
                        <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5 transition-transform duration-200 ease-in-out group-has-[:checked]:translate-x-5"></span>
                        <input type="checkbox" @bind="editingCategory.AllowWithdraw" class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
                    </label>
                </div>
            </div>

            <div class="border-t border-slate-200 pt-5">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-semibold text-slate-700">Schedule Override</label>
                        <button type="button" class="cursor-pointer text-slate-400 hover:text-cyan-700 transition-colors" @onclick='() => ShowInfo("Schedule Override", GetScheduleOverrideExplanation())'>
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                        </button>
                    </div>
                </div>

                @if (hasOverride)
                {
                    <div class="rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-sm text-violet-800 mb-3 flex items-center justify-between">
                        <span class="flex items-center gap-2">
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                            Override active
                        </span>
                        <button type="button" class="cursor-pointer text-violet-700 hover:text-violet-900 font-medium text-sm transition-colors" @onclick="ClearEditingCategoryOverride">Clear</button>
                    </div>
                    <div class="space-y-3">
                        <div class="space-y-1.5">
                            <label class="text-xs text-slate-600">Start Date & Time</label>
                            <input type="datetime-local"
                                   value="@(editingCategory.RegistrationStart?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                                   @onchange="e => SetEditingCategoryStart(e.Value?.ToString())"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-xs text-slate-600">End Date & Time</label>
                            <input type="datetime-local"
                                   value="@(editingCategory.RegistrationEnd?.LocalDateTime.ToString("yyyy-MM-ddTHH:mm"))"
                                   @onchange="e => SetEditingCategoryEnd(e.Value?.ToString())"
                                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-600">
                        <p class="font-medium text-slate-700">Using global schedule</p>
                        @if (settings!.RegistrationStart.HasValue && settings.RegistrationEnd.HasValue)
                        {
                            <p class="text-xs text-slate-500 mt-1">@settings.RegistrationStart.Value.ToString("MMM d") — @settings.RegistrationEnd.Value.ToString("MMM d, yyyy")</p>
                        }
                        <button type="button" class="cursor-pointer mt-3 inline-flex items-center gap-1.5 text-cyan-700 hover:text-cyan-800 font-medium text-sm transition-colors" @onclick="EnableEditingCategoryOverride">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                            Set custom dates
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="px-5 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
            <button type="button" class="cursor-pointer text-sm text-slate-500 hover:text-red-600 transition-colors flex items-center gap-1.5" @onclick="() => RequestDeleteCategory(selectedDivision!, selectedCategory!)">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Delete
            </button>
            <button type="button" class="cursor-pointer rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm disabled:opacity-50 flex items-center gap-1.5" @onclick="SaveCategoryEdits" disabled="@isSaving">
                @if (isSaving)
                {
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                    </svg>
                }
                Save
            </button>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderPortionBadge(PortionOption opt) => __builder =>
    {
        var (label, icon) = opt switch
        {
            PortionOption.NotApplicable => ("N/A", "—"),
            PortionOption.TopOnly => ("Top", "▲"),
            PortionOption.BottomOnly => ("Bottom", "▼"),
            PortionOption.TopOrBottom => ("Either", "◆"),
            _ => ("?", "?")
        };

        @if (opt == PortionOption.NotApplicable)
        {
            <span class="text-slate-400 text-sm">—</span>
        }
        else
        {
            <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 text-slate-700 px-2 py-0.5 text-xs font-medium border border-slate-200" title="@GetPortionDisplayName(opt)">
                <span class="text-[0.65rem]">@icon</span>@label
            </span>
        }
    };

    private static string GetPortionDisplayName(PortionOption opt) => opt switch
    {
        PortionOption.NotApplicable => "Not Applicable",
        PortionOption.TopOnly => "Top Half Only",
        PortionOption.BottomOnly => "Bottom Half Only",
        PortionOption.TopOrBottom => "Top or Bottom",
        _ => "Unknown"
    };
}
