@page "/profile"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Domain.Users

<PageTitle>Profile</PageTitle>

<div class="space-y-4">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Profile</h1>
            <p class="text-sm text-slate-500 mt-1">Manage your account information</p>
        </div>
        @if (!isLoading && user is not null && !isEditing && isAdmin)
        {
            <button type="button"
                    class="cursor-pointer rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 text-white px-4 py-2 text-sm font-semibold transition-all shadow-sm flex items-center gap-1.5"
                    @onclick="StartEditing">
                @Icons.Edit("h-4 w-4")
                Edit Profile
            </button>
        }
    </div>

    <!-- Messages -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                @Icons.XCircle("h-4 w-4 flex-shrink-0")
                <span>@errorMessage</span>
            </div>
            <button type="button" class="cursor-pointer text-red-600 hover:text-red-800 transition-colors" @onclick="ClearMessages">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="rounded-xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                @Icons.CheckCircle("h-4 w-4 flex-shrink-0")
                <span>@successMessage</span>
            </div>
            <button type="button" class="cursor-pointer text-cyan-600 hover:text-cyan-800 transition-colors" @onclick="ClearMessages">
                @Icons.XMark("h-4 w-4")
            </button>
        </div>
    }

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                @Icons.Spinner("h-8 w-8 text-cyan-600")
                <span class="text-sm text-slate-500">Loading profile...</span>
            </div>
        </div>
    }
    else if (user is null)
    {
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-8 shadow-sm text-center">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-3">
                @Icons.Warning("h-6 w-6 text-slate-400")
            </div>
            <p class="text-slate-500 text-sm">Unable to load profile. Please try again.</p>
        </div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <!-- Profile Card (left) -->
            <div class="lg:col-span-1">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="bg-gradient-to-br from-slate-800 to-cyan-900 px-6 py-8">
                        <div class="w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto ring-4 ring-white/30">
                            <span class="text-3xl font-bold text-white">@GetInitials(user)</span>
                        </div>
                        <div class="text-center mt-4">
                            <h2 class="text-lg font-semibold text-white">
                                @(string.IsNullOrEmpty(user.DisplayName) ? "No display name" : user.DisplayName)
                            </h2>
                            <p class="text-cyan-100 text-sm mt-0.5">@user.Email</p>
                        </div>
                    </div>
                    <div class="px-6 py-4 flex justify-center">
                        @if (!string.IsNullOrEmpty(user.UserType))
                        {
                            <span class="@GetUserTypeBadgeClasses(user.UserType)">
                                @user.UserType
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-slate-50 px-2.5 py-0.5 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-200">
                                No type assigned
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Details (right) -->
            <div class="lg:col-span-2 space-y-4">
                <!-- Account Info -->
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="px-5 py-3 border-b border-slate-200 bg-slate-50">
                        <div class="flex items-center gap-2">
                            @Icons.Shield("h-4 w-4 text-cyan-600")
                            <h3 class="text-sm font-semibold text-slate-700">Account Information</h3>
                        </div>
                    </div>
                    <div class="p-5">
                        <dl class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Email Address</dt>
                                <dd class="mt-1 text-sm text-slate-800">@user.Email</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Account Type</dt>
                                <dd class="mt-1">
                                    @if (!string.IsNullOrEmpty(user.UserType))
                                    {
                                        <span class="@GetUserTypeBadgeClasses(user.UserType)">@user.UserType</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-slate-400">—</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Personal Info -->
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="px-5 py-3 border-b border-slate-200 bg-slate-50">
                        <div class="flex items-center gap-2">
                            @Icons.User("h-4 w-4 text-cyan-600")
                            <h3 class="text-sm font-semibold text-slate-700">Personal Information</h3>
                        </div>
                    </div>

                    @if (isEditing && isAdmin)
                    {
                        <div class="p-5 space-y-4">
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <label class="text-xs font-medium text-slate-600 mb-1.5 block">First Name</label>
                                    <input type="text"
                                           @bind="editFirstName"
                                           @bind:event="oninput"
                                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                                </div>
                                <div>
                                    <label class="text-xs font-medium text-slate-600 mb-1.5 block">Last Name</label>
                                    <input type="text"
                                           @bind="editLastName"
                                           @bind:event="oninput"
                                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                                </div>
                            </div>
                            <div>
                                <label class="text-xs font-medium text-slate-600 mb-1.5 block">Display Name</label>
                                <input type="text"
                                       @bind="editDisplayName"
                                       @bind:event="oninput"
                                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                                <p class="text-xs text-slate-500 mt-1.5">This is how your name appears throughout the app and in Azure</p>
                            </div>
                            <div class="flex items-center justify-end gap-2 pt-2">
                                <button type="button"
                                        class="cursor-pointer rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                                        @onclick="CancelEditing"
                                        disabled="@isSaving">
                                    Cancel
                                </button>
                                <button type="button"
                                        class="cursor-pointer rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 text-white px-4 py-2 text-sm font-semibold disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-1.5 shadow-sm"
                                        @onclick="SaveProfile"
                                        disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        @Icons.Spinner("h-4 w-4")
                                    }
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5">
                            <dl class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">First Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.FirstName) ? "—" : user.FirstName)</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Last Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.LastName) ? "—" : user.LastName)</dd>
                                </div>
                                <div class="sm:col-span-2">
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Display Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.DisplayName) ? "—" : user.DisplayName)</dd>
                                </div>
                            </dl>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* Logout Warning Modal *@
@if (showLogoutWarning)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @onclick="CancelLogoutWarning"></div>

        <!-- Modal -->
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-md rounded-xl bg-white shadow-2xl">
                <!-- Header -->
                <div class="flex items-center gap-3 px-5 py-4 border-b border-slate-200">
                    <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                        @Icons.Warning("h-5 w-5 text-amber-600")
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800">Display Name Change</h3>
                        <p class="text-sm text-slate-500">This requires re-authentication</p>
                    </div>
                </div>

                <!-- Body -->
                <div class="px-5 py-4">
                    <p class="text-sm text-slate-600">
                        Changing your display name will update it in Azure. To see the changes reflected in the app,
                        you will need to <span class="font-semibold text-slate-800">sign out and sign back in</span>.
                    </p>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-slate-100 bg-slate-50 rounded-b-xl">
                    <button type="button"
                            class="cursor-pointer rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                            @onclick="CancelLogoutWarning">
                        Cancel
                    </button>
                    <button type="button"
                            class="cursor-pointer rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 text-white px-4 py-2 text-sm font-semibold transition-all shadow-sm"
                            @onclick="ConfirmSaveWithLogout">
                        Continue & Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}
