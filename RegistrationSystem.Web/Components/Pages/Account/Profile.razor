@page "/profile"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Domain.Users

<PageTitle>Profile</PageTitle>

<div class="space-y-4">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-semibold text-slate-800">Profile</h1>
        </div>
        @if (!isLoading && user is not null && !isEditing && isAdmin)
        {
            <button type="button"
                    class="cursor-pointer rounded-md bg-cyan-700 text-white px-4 py-1.5 text-sm font-medium hover:bg-cyan-800 active:scale-[0.98] transition-all flex items-center gap-1.5 shadow-sm"
                    @onclick="StartEditing">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                Edit Profile
            </button>
        }
    </div>

    <!-- Messages -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
                <span>@errorMessage</span>
            </div>
            <button type="button" class="cursor-pointer text-red-600 hover:text-red-800 transition-colors" @onclick="ClearMessages">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="rounded-lg border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-2">
                <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>@successMessage</span>
            </div>
            <button type="button" class="cursor-pointer text-cyan-600 hover:text-cyan-800 transition-colors" @onclick="ClearMessages">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
    }

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
                <span class="text-sm text-slate-500">Loading profile...</span>
            </div>
        </div>
    }
    else if (user is null)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm text-center">
            <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-3">
                <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <p class="text-slate-500 text-sm">Unable to load profile. Please try again.</p>
        </div>
    }
    else
    {
        <div class="grid gap-4 lg:grid-cols-3">
            <!-- Profile Card (left) -->
            <div class="lg:col-span-1">
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="bg-gradient-to-br from-slate-800 to-cyan-900 px-6 py-8">
                        <div class="w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto ring-4 ring-white/30">
                            <span class="text-3xl font-bold text-white">@GetInitials(user)</span>
                        </div>
                        <div class="text-center mt-4">
                            <h2 class="text-lg font-semibold text-white">
                                @(string.IsNullOrEmpty(user.DisplayName) ? "No display name" : user.DisplayName)
                            </h2>
                            <p class="text-cyan-100 text-sm mt-0.5">@user.Email</p>
                        </div>
                    </div>
                    <div class="px-6 py-4 flex justify-center">
                        @if (!string.IsNullOrEmpty(user.UserType))
                        {
                            <span class="@GetUserTypeBadgeClasses(user.UserType)">
                                @user.UserType
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-slate-50 px-2.5 py-0.5 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-200">
                                No type assigned
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Details (right) -->
            <div class="lg:col-span-2 space-y-4">
                <!-- Account Info -->
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="px-5 py-3 bg-gradient-to-r from-slate-700 to-slate-800">
                        <div class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <h3 class="text-sm font-medium text-white">Account Information</h3>
                        </div>
                    </div>
                    <div class="p-5">
                        <dl class="grid gap-4 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Email Address</dt>
                                <dd class="mt-1 text-sm text-slate-800">@user.Email</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Account Type</dt>
                                <dd class="mt-1">
                                    @if (!string.IsNullOrEmpty(user.UserType))
                                    {
                                        <span class="@GetUserTypeBadgeClasses(user.UserType)">@user.UserType</span>
                                    }
                                    else
                                    {
                                        <span class="text-sm text-slate-400">—</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Personal Info -->
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <div class="px-5 py-3 bg-gradient-to-r from-slate-700 to-slate-800">
                        <div class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <h3 class="text-sm font-medium text-white">Personal Information</h3>
                        </div>
                    </div>

                    @if (isEditing && isAdmin)
                    {
                        <div class="p-5 space-y-4">
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <label class="text-xs font-medium text-slate-600 mb-1.5 block">First Name</label>
                                    <input type="text"
                                           @bind="editFirstName"
                                           @bind:event="oninput"
                                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                                </div>
                                <div>
                                    <label class="text-xs font-medium text-slate-600 mb-1.5 block">Last Name</label>
                                    <input type="text"
                                           @bind="editLastName"
                                           @bind:event="oninput"
                                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                                </div>
                            </div>
                            <div>
                                <label class="text-xs font-medium text-slate-600 mb-1.5 block">Display Name</label>
                                <input type="text"
                                       @bind="editDisplayName"
                                       @bind:event="oninput"
                                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                                <p class="text-xs text-slate-500 mt-1.5">This is how your name appears throughout the app and in Azure</p>
                            </div>
                            <div class="flex items-center justify-end gap-2 pt-2">
                                <button type="button"
                                        class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors"
                                        @onclick="CancelEditing"
                                        disabled="@isSaving">
                                    Cancel
                                </button>
                                <button type="button"
                                        class="cursor-pointer rounded-md bg-cyan-700 text-white px-4 py-1.5 text-sm font-medium hover:bg-cyan-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98] transition-all flex items-center gap-1.5 shadow-sm"
                                        @onclick="SaveProfile"
                                        disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                                        </svg>
                                    }
                                    Save Changes
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5">
                            <dl class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">First Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.FirstName) ? "—" : user.FirstName)</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Last Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.LastName) ? "—" : user.LastName)</dd>
                                </div>
                                <div class="sm:col-span-2">
                                    <dt class="text-xs font-medium text-slate-500 uppercase tracking-wide">Display Name</dt>
                                    <dd class="mt-1 text-sm text-slate-800">@(string.IsNullOrEmpty(user.DisplayName) ? "—" : user.DisplayName)</dd>
                                </div>
                            </dl>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* Logout Warning Modal *@
@if (showLogoutWarning)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" @onclick="CancelLogoutWarning"></div>

        <!-- Modal -->
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="relative w-full max-w-md rounded-xl bg-white shadow-2xl">
                <!-- Header -->
                <div class="flex items-center gap-3 px-5 py-4 border-b border-slate-200">
                    <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center">
                        <svg class="h-5 w-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800">Display Name Change</h3>
                        <p class="text-sm text-slate-500">This requires re-authentication</p>
                    </div>
                </div>

                <!-- Body -->
                <div class="px-5 py-4">
                    <p class="text-sm text-slate-600">
                        Changing your display name will update it in Azure. To see the changes reflected in the app,
                        you will need to <span class="font-semibold text-slate-800">sign out and sign back in</span>.
                    </p>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-2 px-5 py-4 border-t border-slate-100 bg-slate-50 rounded-b-xl">
                    <button type="button"
                            class="cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                            @onclick="CancelLogoutWarning">
                        Cancel
                    </button>
                    <button type="button"
                            class="cursor-pointer rounded-md bg-cyan-700 text-white px-4 py-2 text-sm font-medium hover:bg-cyan-800 transition-colors"
                            @onclick="ConfirmSaveWithLogout">
                        Continue & Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}
