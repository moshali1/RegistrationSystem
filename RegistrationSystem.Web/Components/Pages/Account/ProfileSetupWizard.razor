@namespace RegistrationSystem.Web.Components.Pages.Account
@using RegistrationSystem.Core.Application.Users
@using RegistrationSystem.Core.Application.Consents
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Consents
@using RegistrationSystem.Core.Domain.Users

@inject UserService UserService
@inject ConsentService ConsentService
@inject SettingsService SettingsService
@inject IHttpContextAccessor HttpContextAccessor

<div class="fixed inset-0 z-50 overflow-y-auto">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm"></div>

    <!-- Modal -->
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="relative w-full max-w-lg bg-gradient-to-br from-white to-slate-50 rounded-2xl shadow-2xl overflow-hidden border border-slate-200">

            <!-- Progress Header -->
            <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-6 py-5">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br @(currentStep == 1 ? "from-cyan-500 to-cyan-700" : "from-emerald-500 to-emerald-700") flex items-center justify-center shadow-lg flex-shrink-0">
                        @if (currentStep == 1)
                        {
                            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-lg font-semibold text-white">
                            @(currentStep == 1 ? "Profile Verification" : "Terms & Consent")
                        </h2>
                        <p class="text-sm text-slate-300">Step @currentStep of 2</p>
                    </div>
                </div>

                <!-- Progress Steps -->
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2 flex-1">
                        <div class="w-8 h-8 rounded-full @(currentStep >= 1 ? "bg-cyan-500" : "bg-slate-600") flex items-center justify-center text-white text-sm font-semibold shadow">
                            @if (currentStep > 1)
                            {
                                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            }
                            else
                            {
                                <span>1</span>
                            }
                        </div>
                        <div class="flex-1 h-1 rounded-full @(currentStep > 1 ? "bg-cyan-500" : "bg-slate-600")"></div>
                    </div>
                    <div class="flex items-center gap-2 flex-1">
                        <div class="w-8 h-8 rounded-full @(currentStep >= 2 ? "bg-cyan-500" : "bg-slate-600") flex items-center justify-center text-white text-sm font-semibold shadow">
                            2
                        </div>
                        <div class="flex-1 h-1 rounded-full bg-slate-600"></div>
                    </div>
                </div>
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="px-6 pt-4">
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 flex items-start gap-2 shadow-sm">
                        <svg class="h-4 w-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        <span>@errorMessage</span>
                    </div>
                </div>
            }

            @if (currentStep == 1)
            {
                @RenderStep1()
            }
            else
            {
                @RenderStep2()
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public User User { get; set; } = default!;

    [Parameter]
    public EventCallback OnSetupComplete { get; set; }

    // Step tracking
    private int currentStep = 1;

    // Step 1: Profile fields
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string userType = string.Empty;
    private bool isAdultStudent;

    // Step 2: Consent fields
    private bool acknowledgedPrivacyPolicy;
    private bool acknowledgedTermsOfService;
    private string signedName = string.Empty;

    // Settings
    private string competitionName = string.Empty;
    private int competitionYear;
    private string privacyPolicyUrl = string.Empty;
    private string termsOfServiceUrl = string.Empty;
    private string rulesUrl = string.Empty;

    // Computed
    private ConsentRole consentRole => ConsentService.GetConsentRoleFromUserType(userType);

    // State
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        // Pre-fill from user data if available
        firstName = User.FirstName ?? string.Empty;
        lastName = User.LastName ?? string.Empty;
        userType = User.UserType ?? string.Empty;

        // Load competition info from settings
        var settings = await SettingsService.GetSettingsAsync();
        if (settings?.CompetitionInfo is not null)
        {
            competitionName = settings.CompetitionInfo.CompetitionName;
            competitionYear = settings.CompetitionInfo.CompetitionYear;
            privacyPolicyUrl = settings.CompetitionInfo.PrivacyPolicyUrl;
            termsOfServiceUrl = settings.CompetitionInfo.TermsOfServiceUrl;
            rulesUrl = settings.CompetitionInfo.RulesUrl;
        }
        else
        {
            // Fallback defaults
            competitionYear = DateTime.UtcNow.Year;
            competitionName = "North America Imam Al-Shatibi Qur'an Competition";
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // STEP 1: PROFILE VERIFICATION
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStep1() => __builder =>
    {
        <!-- Disclaimer Banner -->
        <div class="px-6 py-4 bg-gradient-to-r from-amber-50 to-amber-100/50 border-b border-amber-200">
            <div class="flex gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow">
                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-amber-800">Important Notice</p>
                    <p class="text-sm text-amber-700 mt-0.5">
                        Enter your <span class="font-semibold">legal name</span> as it appears on official documents.
                        This is a one-time verification and <span class="font-semibold">cannot be changed</span>.
                    </p>
                </div>
            </div>
        </div>

        <!-- Form Content -->
        <div class="px-6 py-5 space-y-5">
            <!-- Name Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-slate-700">
                        First Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           @bind="firstName"
                           @bind:event="oninput"
                           placeholder="e.g., Muhammad"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                </div>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-slate-700">
                        Last Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text"
                           @bind="lastName"
                           @bind:event="oninput"
                           placeholder="e.g., Ahmad"
                           class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                </div>
            </div>

            <!-- Display Name Preview -->
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Display Name Preview</p>
                        <p class="text-sm text-slate-800 font-semibold mt-0.5 truncate">
                            @if (!string.IsNullOrWhiteSpace(firstName) || !string.IsNullOrWhiteSpace(lastName))
                            {
                                @GetDisplayNamePreview()
                            }
                            else
                            {
                                <span class="text-slate-400 font-normal italic">Enter your name above</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- User Type Selection -->
            <div class="space-y-3">
                <label class="text-sm font-medium text-slate-700">
                    I am a <span class="text-red-500">*</span>
                </label>
                @if (!string.IsNullOrEmpty(User.UserType))
                {
                    <p class="text-xs text-slate-500 -mt-1">
                        Based on your account, you're registered as a <span class="font-semibold text-slate-700">@User.UserType</span>.
                    </p>
                }
                <div class="grid grid-cols-3 gap-3">
                    <button type="button"
                            class="@GetUserTypeButtonClasses("Student")"
                            @onclick="@(() => SelectUserType("Student"))">
                        <div class="w-10 h-10 rounded-lg @(userType == "Student" ? "bg-cyan-100" : "bg-slate-100") flex items-center justify-center mx-auto mb-2 transition-colors">
                            <svg class="h-5 w-5 @(userType == "Student" ? "text-cyan-700" : "text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                            </svg>
                        </div>
                        <span class="text-sm font-medium">Student</span>
                    </button>
                    <button type="button"
                            class="@GetUserTypeButtonClasses("Parent")"
                            @onclick="@(() => SelectUserType("Parent"))">
                        <div class="w-10 h-10 rounded-lg @(userType == "Parent" ? "bg-cyan-100" : "bg-slate-100") flex items-center justify-center mx-auto mb-2 transition-colors">
                            <svg class="h-5 w-5 @(userType == "Parent" ? "text-cyan-700" : "text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <span class="text-sm font-medium">Parent</span>
                    </button>
                    <button type="button"
                            class="@GetUserTypeButtonClasses("Teacher")"
                            @onclick="@(() => SelectUserType("Teacher"))">
                        <div class="w-10 h-10 rounded-lg @(userType == "Teacher" ? "bg-cyan-100" : "bg-slate-100") flex items-center justify-center mx-auto mb-2 transition-colors">
                            <svg class="h-5 w-5 @(userType == "Teacher" ? "text-cyan-700" : "text-slate-500")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                            </svg>
                        </div>
                        <span class="text-sm font-medium">Teacher</span>
                    </button>
                </div>
            </div>

            <!-- Age Confirmation for Students -->
            @if (userType.Equals("Student", StringComparison.OrdinalIgnoreCase))
            {
                <div class="rounded-xl border border-cyan-200 bg-cyan-50 p-4">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox"
                               @bind="isAdultStudent"
                               class="mt-0.5 h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" />
                        <div>
                            <span class="text-sm text-slate-700 font-medium">Age Confirmation</span>
                            <p class="text-sm text-slate-600 mt-0.5">
                                I confirm that I am <span class="font-semibold">at least 18 years old</span> and am registering myself for the competition.
                            </p>
                        </div>
                    </label>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50">
            <button type="button"
                    class="w-full cursor-pointer rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-4 py-3 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-sm"
                    @onclick="GoToStep2"
                    disabled="@isSaving">
                <span>Continue to Consent</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
            </button>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // STEP 2: CONSENT
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStep2() => __builder =>
    {
        <div class="px-6 py-5 max-h-[60vh] overflow-y-auto">
            <!-- Consent Title Card -->
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm mb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center shadow flex-shrink-0">
                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="text-sm font-semibold text-slate-800">
                            @ConsentTexts.GetTitle(consentRole, competitionYear)
                        </h3>
                        <p class="text-xs text-slate-500 mt-0.5">Please read carefully before signing</p>
                    </div>
                </div>
            </div>

            <!-- Consent Text -->
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 mb-5">
                <div class="prose prose-sm prose-slate max-w-none">
                    <div class="whitespace-pre-line text-sm text-slate-600 leading-relaxed">@ConsentTexts.GetConsentText(consentRole, competitionName, competitionYear)</div>
                </div>
            </div>

            <!-- Document Links -->
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm mb-5">
                <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-3">Required Documents</p>
                <div class="flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(privacyPolicyUrl))
                    {
                        <a href="@privacyPolicyUrl" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition-colors">
                            <svg class="h-4 w-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Privacy Policy
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(termsOfServiceUrl))
                    {
                        <a href="@termsOfServiceUrl" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition-colors">
                            <svg class="h-4 w-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Terms of Service
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(rulesUrl))
                    {
                        <a href="@rulesUrl" target="_blank" rel="noopener noreferrer"
                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-sm text-slate-700 hover:bg-slate-100 hover:border-slate-300 transition-colors">
                            <svg class="h-4 w-4 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                            Rules & Regulations
                        </a>
                    }
                </div>
            </div>

            <!-- Acknowledgments -->
            <div class="space-y-3 mb-5">
                <div class="rounded-xl border @(acknowledgedPrivacyPolicy ? "border-cyan-200 bg-cyan-50" : "border-slate-200 bg-white") p-4 transition-colors">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox"
                               @bind="acknowledgedPrivacyPolicy"
                               class="mt-0.5 h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" />
                        <span class="text-sm text-slate-700">
                            I have read and acknowledge the <span class="font-semibold">Privacy Policy</span>.
                        </span>
                    </label>
                </div>
                <div class="rounded-xl border @(acknowledgedTermsOfService ? "border-cyan-200 bg-cyan-50" : "border-slate-200 bg-white") p-4 transition-colors">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox"
                               @bind="acknowledgedTermsOfService"
                               class="mt-0.5 h-4 w-4 rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 cursor-pointer" />
                        <span class="text-sm text-slate-700">
                            I have read and agree to the <span class="font-semibold">Terms of Service</span>.
                        </span>
                    </label>
                </div>
            </div>

            <!-- Digital Signature -->
            <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                    </div>
                    <div>
                        <label class="text-sm font-medium text-slate-700">Digital Signature <span class="text-red-500">*</span></label>
                        <p class="text-xs text-slate-500">Type your full legal name to sign</p>
                    </div>
                </div>
                <input type="text"
                       @bind="signedName"
                       @bind:event="oninput"
                       placeholder="Type your full legal name"
                       class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
            </div>
        </div>

        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50">
            <div class="flex gap-3">
                <button type="button"
                        class="cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-colors flex items-center gap-2 shadow-sm"
                        @onclick="GoToStep1"
                        disabled="@isSaving">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                    </svg>
                    Back
                </button>
                <button type="button"
                        class="flex-1 cursor-pointer rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-4 py-3 text-sm font-medium hover:from-cyan-700 hover:to-cyan-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-sm"
                        @onclick="Submit"
                        disabled="@isSaving">
                    @if (isSaving)
                    {
                        <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                        </svg>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Submit & Continue</span>
                    }
                </button>
            </div>
            <p class="text-xs text-slate-500 text-center mt-3">
                By clicking "Submit & Continue", you confirm that all information is accurate.
            </p>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPER METHODS
    // ═══════════════════════════════════════════════════════════════════════════

    private string GetDisplayNamePreview()
    {
        var first = FormatNamePart(firstName);
        var last = FormatNamePart(lastName);
        return $"{first} {last}".Trim();
    }

    private static string FormatNamePart(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return string.Empty;

        var trimmed = name.Trim();
        var words = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var formatted = words.Select(w =>
            w.Length > 0 ? char.ToUpper(w[0]) + w[1..].ToLower() : w);
        return string.Join(" ", formatted);
    }

    private string GetUserTypeButtonClasses(string type)
    {
        var isSelected = userType.Equals(type, StringComparison.OrdinalIgnoreCase);
        return isSelected
            ? "cursor-pointer rounded-xl border-2 border-cyan-500 bg-cyan-50 px-3 py-4 text-center text-cyan-800 transition-all shadow-sm"
            : "cursor-pointer rounded-xl border-2 border-slate-200 bg-white px-3 py-4 text-center text-slate-600 hover:border-slate-300 hover:bg-slate-50 transition-all";
    }

    private void SelectUserType(string type)
    {
        userType = type;
        if (!type.Equals("Student", StringComparison.OrdinalIgnoreCase))
        {
            isAdultStudent = false;
        }
    }

    private void GoToStep1()
    {
        errorMessage = null;
        currentStep = 1;
    }

    private void GoToStep2()
    {
        errorMessage = null;

        // Validate Step 1
        if (string.IsNullOrWhiteSpace(firstName))
        {
            errorMessage = "Please enter your first name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(lastName))
        {
            errorMessage = "Please enter your last name.";
            return;
        }

        if (!IsValidName(firstName) || !IsValidName(lastName))
        {
            errorMessage = "Names can only contain letters, spaces, hyphens, and apostrophes.";
            return;
        }

        if (string.IsNullOrWhiteSpace(userType))
        {
            errorMessage = "Please select your user type.";
            return;
        }

        if (userType.Equals("Student", StringComparison.OrdinalIgnoreCase) && !isAdultStudent)
        {
            errorMessage = "Students must confirm they are at least 18 years old.";
            return;
        }

        currentStep = 2;
    }

    private static bool IsValidName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return false;
        return name.All(c => char.IsLetter(c) || c == ' ' || c == '-' || c == '\'');
    }

    private async Task Submit()
    {
        errorMessage = null;

        // Validate Step 2
        if (!acknowledgedPrivacyPolicy)
        {
            errorMessage = "Please acknowledge the Privacy Policy.";
            return;
        }

        if (!acknowledgedTermsOfService)
        {
            errorMessage = "Please agree to the Terms of Service.";
            return;
        }

        if (string.IsNullOrWhiteSpace(signedName))
        {
            errorMessage = "Please sign with your full legal name.";
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            // Get IP and User Agent for audit trail
            var httpContext = HttpContextAccessor.HttpContext;
            var ipAddress = httpContext?.Connection?.RemoteIpAddress?.ToString() ?? "Unknown";
            var userAgent = httpContext?.Request?.Headers?.UserAgent.ToString() ?? "Unknown";

            // 1. Complete profile verification (saves to Azure AD and DB)
            await UserService.CompleteProfileVerificationAsync(
                User.ObjectIdentifier,
                firstName.Trim(),
                lastName.Trim(),
                userType);

            // 2. Record consent
            await ConsentService.RecordConsentAsync(
                User.ObjectIdentifier,
                consentRole,
                competitionYear,
                competitionName,
                signedName.Trim(),
                ipAddress,
                userAgent);

            // 3. Notify parent component
            await OnSetupComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }
}
