                                    </span>
                                }
                                else if (newIdFileName != null)
                                {
                                    @:New: @newIdFileName
                                }
                                else
                                {
                                    @:Click to upload new ID
                                }
                            </span>
                        </div>
                    </label>
                    @if (newIdFileName != null)
                    {
                        <button type="button" @onclick="ClearNewIdFile" class="text-slate-400 hover:text-red-500">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
                <p class="mt-1.5 text-xs text-slate-500">JPEG, PNG, or PDF • Max 5 MB</p>
            </div>

            <!-- Photo -->
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-sm font-medium text-slate-700">
                        Competitor Photo <span class="text-red-500">*</span>
                    </label>
                    @if (registration!.FileUploadInfo.Photo != null)
                    {
                        <span class="text-xs text-slate-500">
                            Current: @registration.FileUploadInfo.Photo.FileName
                            (@FormatFileSize(registration.FileUploadInfo.Photo.FileSizeBytes))
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(photoValidationError))
                {
                    <div class="mb-2 text-sm text-red-600 flex items-center gap-1">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        @photoValidationError
                    </div>
                }
                @if (!string.IsNullOrEmpty(photoValidationSuccess))
                {
                    <div class="mb-2 text-sm text-cyan-600 flex items-center gap-1">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        @photoValidationSuccess
                    </div>
                }

                <div class="flex items-center gap-3">
                    <label class="flex-1 relative cursor-pointer">
                        <InputFile OnChange="OnPhotoFileSelected" accept=".jpg,.jpeg,.png"
                                   class="absolute inset-0 opacity-0 cursor-pointer" disabled="@isValidatingPhoto" />
                        <div class="px-4 py-2 rounded-lg border border-dashed border-slate-300 hover:border-cyan-400 hover:bg-cyan-50 text-center transition-colors">
                            <span class="text-sm text-slate-600">
                                @if (isValidatingPhoto)
                                {
                                    <span class="flex items-center justify-center gap-2">
                                        <span class="animate-spin rounded-full h-4 w-4 border-2 border-cyan-600 border-t-transparent"></span>
                                        Validating...
                                    </span>
                                }
                                else if (newPhotoFileName != null)
                                {
                                    @:New: @newPhotoFileName
                                }
                                else
                                {
                                    @:Click to upload new photo
                                }
                            </span>
                        </div>
                    </label>
                    @if (newPhotoFileName != null)
                    {
                        <button type="button" @onclick="ClearNewPhotoFile" class="text-slate-400 hover:text-red-500">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
                <p class="mt-1.5 text-xs text-slate-500">JPEG or PNG • Max 5 MB • Clear headshot of competitor</p>
            </div>

            <!-- Video (if required) -->
            @if (selectedCategory?.RequiresVideo == true)
            {
                <div class="pt-4 border-t border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-medium text-slate-700">
                            Video <span class="text-red-500">*</span>
                        </label>
                        @if (registration!.FileUploadInfo.Video != null)
                        {
                            <span class="text-xs text-slate-500">
                                Current: @FormatFileSize(registration.FileUploadInfo.Video.FileSizeBytes)
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(videoValidationError))
                    {
                        <div class="mb-2 text-sm text-red-600 flex items-center gap-1">
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                            @videoValidationError
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(videoUploadSuccess))
                    {
                        <div class="mb-2 text-sm text-cyan-600 flex items-center gap-1">
                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            @videoUploadSuccess
                        </div>
                    }

                    @if (isUploadingVideo)
                    {
                        <div class="px-4 py-3 rounded-lg border border-cyan-200 bg-cyan-50">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm text-cyan-700">Uploading video...</span>
                                <span class="text-sm font-medium text-cyan-700">@videoUploadProgress%</span>
                            </div>
                            <div class="w-full bg-cyan-200 rounded-full h-2">
                                <div class="bg-cyan-600 h-2 rounded-full transition-all" style="width: @(videoUploadProgress)%"></div>
                            </div>
                            <button type="button" @onclick="CancelVideoUpload" class="mt-2 text-xs text-cyan-600 hover:text-cyan-800">
                                Cancel upload
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center gap-3">
                            <label class="flex-1 relative cursor-pointer">
                                <InputFile OnChange="OnVideoFileSelected" accept=".mp4,.mov,.avi,.webm"
                                           class="absolute inset-0 opacity-0 cursor-pointer" />
                                <div class="px-4 py-2 rounded-lg border border-dashed border-slate-300 hover:border-cyan-400 hover:bg-cyan-50 text-center transition-colors">
                                    <span class="text-sm text-slate-600">
                                        @if (newVideoFileName != null)
                                        {
                                            @:New: @newVideoFileName
                                        }
                                        else
                                        {
                                            @:Click to upload new video
                                        }
                                    </span>
                                </div>
                            </label>
                            @if (newVideoFileName != null)
                            {
                                <button type="button" @onclick="ClearNewVideoFile" class="text-slate-400 hover:text-red-500">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            }
                        </div>
                        <p class="mt-1.5 text-xs text-slate-500">MP4, MOV, AVI, or WebM • Max 500 MB</p>
                    }
                </div>
            }
        </div>
    };
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    // State
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isAdmin = false;
    private bool canEdit = false;
    private string activeTab = "competitor";
    private List<string> validationErrors = new();

    // Data
    private Registration? registration;
    private Registration? originalRegistration;
    private CompetitionSettings? settings;
    private int competitionYear;
    private string currentUserId = string.Empty;

    // Track if division changed (for CID regeneration)
    private string originalDivisionId = string.Empty;
    private bool divisionChanged => registration?.CompetitionSelection.DivisionId != originalDivisionId;

    // Track name/DOB changes for niqab bypass clearing
    private string originalFirstName = string.Empty;
    private string originalLastName = string.Empty;
    private DateOnly originalDateOfBirth;

    // Division/Category data
    private IReadOnlyList<Division> availableDivisions = Array.Empty<Division>();
    private IReadOnlyList<Category> availableCategories = Array.Empty<Category>();
    private Category? selectedCategory;

    // Location data
    private IReadOnlyList<StateProvince> availableStates = Array.Empty<StateProvince>();

    // Teacher fields (since TeacherInfo can be null)
    private string teacherFirstName = string.Empty;
    private string teacherLastName = string.Empty;
    private string teacherPhone = string.Empty;
    private string teacherInstitution = string.Empty;

    // File upload state
    private bool isValidatingId = false;
    private bool isValidatingPhoto = false;
    private bool isUploadingVideo = false;
    private string? idValidationError;
    private string? idValidationSuccess;
    private string? photoValidationError;
    private string? photoValidationSuccess;
    private string? videoValidationError;
    private string? videoUploadSuccess;
    private int videoUploadProgress = 0;
    private CancellationTokenSource? videoUploadCts;

    // New file data (if changed)
    private byte[]? newIdBytes;
    private string? newIdFileName;
    private string? newIdContentType;
    private long newIdSize;
    private bool newIdValidated;

    private byte[]? newPhotoBytes;
    private string? newPhotoFileName;
    private string? newPhotoContentType;
    private long newPhotoSize;
    private bool newPhotoValidated;

    private string? newVideoFileName;
    private string? newVideoBlobUri;
    private string? newVideoBlobName;
    private long newVideoSize;
    private string? newVideoContentType;
    private bool newVideoUploaded;

    private static readonly Dictionary<string, string> tabs = new()
    {
        { "competitor", "Competitor" },
        { "competition", "Competition" },
        { "contacts", "Contacts" },
        { "files", "Files" }
    };

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            // Get current user
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null)
            {
                NavigationManager.NavigateTo("/");
                return;
            }
            currentUserId = user.ObjectIdentifier;
            isAdmin = NavigationManager.Uri.Contains("/admin/") &&
                      user.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase);

            // Load registration
            registration = await RegistrationService.GetByIdAsync(Id);
            if (registration == null)
            {
                isLoading = false;
                return;
            }

            // Check ownership
            if (!isAdmin && registration.CreatorUserId != currentUserId)
            {
                registration = null;
                isLoading = false;
                return;
            }

            // Store original for comparison
            originalRegistration = CloneRegistration(registration);
            originalDivisionId = registration.CompetitionSelection.DivisionId;
            originalFirstName = registration.PersonalInfo.FirstName;
            originalLastName = registration.PersonalInfo.LastName;
            originalDateOfBirth = registration.PersonalInfo.DateOfBirth;

            // Load teacher fields
            if (registration.TeacherInfo != null)
            {
                teacherFirstName = registration.TeacherInfo.FirstName;
                teacherLastName = registration.TeacherInfo.LastName;
                teacherPhone = registration.TeacherInfo.PhoneNumber;
                teacherInstitution = registration.TeacherInfo.Institution ?? string.Empty;
            }

            // Load settings
            settings = await SettingsService.GetSettingsAsync();
            competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

            // Check edit permission — needs settings loaded for category-level AllowEdit check
            canEdit = isAdmin || CanEdit(registration);
            if (!canEdit)
            {
                isLoading = false;
                return;
            }

            // Load divisions and categories
            availableDivisions = await RegistrationService.GetAvailableDivisionsAsync();
            await LoadCategoriesAsync();
            UpdateSelectedCategory();

            // Load states based on country
            LoadStatesForCountry();
        }
        finally
        {
            isLoading = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // PERMISSIONS
    // ═══════════════════════════════════════════════════════════════════════════════

    private bool CanEdit(Registration reg)
    {
        if (reg.Status != RegistrationStatus.AwaitingReview &&
            reg.Status != RegistrationStatus.Pending)
            return false;

        var cat = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);

        return cat?.AllowEdit ?? true;
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // DATA LOADING
    // ═══════════════════════════════════════════════════════════════════════════════

    private Registration CloneRegistration(Registration source)
    {
        return new Registration
        {
            Id = source.Id,
            CompetitionYear = source.CompetitionYear,
            Cid = source.Cid,
            PersonalInfo = new PersonalInfo
            {
                FirstName = source.PersonalInfo.FirstName,
                MiddleName = source.PersonalInfo.MiddleName,
                LastName = source.PersonalInfo.LastName,
                PreferredName = source.PersonalInfo.PreferredName,
                Gender = source.PersonalInfo.Gender,
                DateOfBirth = source.PersonalInfo.DateOfBirth,
                PhoneNumber = source.PersonalInfo.PhoneNumber
            },
            AddressInfo = new AddressInfo
            {
                City = source.AddressInfo.City,
                StateProvince = source.AddressInfo.StateProvince,
                Country = source.AddressInfo.Country
            },
            CompetitionSelection = new CompetitionSelection
            {
                DivisionId = source.CompetitionSelection.DivisionId,
                CategoryId = source.CompetitionSelection.CategoryId,
                PortionChoice = source.CompetitionSelection.PortionChoice
            },
            ParentInfo = new ParentInfo
            {
                FirstName = source.ParentInfo.FirstName,
                LastName = source.ParentInfo.LastName,
                PhoneNumber = source.ParentInfo.PhoneNumber
            },
            TeacherInfo = source.TeacherInfo != null ? new TeacherInfo
            {
                FirstName = source.TeacherInfo.FirstName,
                LastName = source.TeacherInfo.LastName,
                PhoneNumber = source.TeacherInfo.PhoneNumber,
                Institution = source.TeacherInfo.Institution
            } : null,
            FileUploadInfo = new FileUploadInfo
            {
                IdDocument = source.FileUploadInfo.IdDocument,
                Photo = source.FileUploadInfo.Photo,
                Video = source.FileUploadInfo.Video,
                NiqabBypassApproved = source.FileUploadInfo.NiqabBypassApproved
            },
            Status = source.Status,
            StatusComment = source.StatusComment,
            CreatorUserId = source.CreatorUserId
        };
    }

    private async Task LoadCategoriesAsync()
    {
        if (string.IsNullOrEmpty(registration?.CompetitionSelection.DivisionId))
        {
            availableCategories = Array.Empty<Category>();
            return;
        }

        availableCategories = await RegistrationService.GetAvailableCategoriesAsync(
            registration.CompetitionSelection.DivisionId,
            registration.PersonalInfo.DateOfBirth);
    }

    private void UpdateSelectedCategory()
    {
        if (registration == null || string.IsNullOrEmpty(registration.CompetitionSelection.CategoryId))
        {
            selectedCategory = null;
            return;
        }

        var division = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
        selectedCategory = division?.Categories.FirstOrDefault(c => c.Id == registration.CompetitionSelection.CategoryId);
    }

    private void LoadStatesForCountry()
    {
        if (registration == null || string.IsNullOrEmpty(registration.AddressInfo.Country))
        {
            availableStates = Array.Empty<StateProvince>();
            return;
        }

        var country = LocationData.Countries.FirstOrDefault(c => c.Name == registration.AddressInfo.Country);
        availableStates = country?.StatesProvinces ?? Array.Empty<StateProvince>();
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // EVENT HANDLERS
    // ═══════════════════════════════════════════════════════════════════════════════

    private void OnDateOfBirthChanged(ChangeEventArgs e)
    {
        if (registration == null) return;

        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            registration.PersonalInfo.DateOfBirth = date;
            _ = LoadCategoriesAsync();
        }
    }

    private void OnCountryChanged()
    {
        if (registration == null) return;

        registration.AddressInfo.StateProvince = string.Empty;
        LoadStatesForCountry();
    }

    private async Task OnDivisionChanged(ChangeEventArgs e)
    {
        if (registration == null) return;

        registration.CompetitionSelection.DivisionId = e.Value?.ToString() ?? string.Empty;
        registration.CompetitionSelection.CategoryId = string.Empty;
        registration.CompetitionSelection.PortionChoice = null;
        selectedCategory = null;

        await LoadCategoriesAsync();
    }

    private void OnCategoryChanged()
    {
        UpdateSelectedCategory();

        if (selectedCategory?.PortionOption != PortionOption.TopOrBottom)
        {
            registration!.CompetitionSelection.PortionChoice = null;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // FILE UPLOAD HANDLERS
    // ═══════════════════════════════════════════════════════════════════════════════

    private async Task OnIdFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        idValidationError = null;
        idValidationSuccess = null;
        newIdValidated = false;
        newIdBytes = null;
        newIdFileName = file.Name;
        newIdContentType = file.ContentType;
        newIdSize = file.Size;

        byte[] fileBytes;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            fileBytes = memoryStream.ToArray();
            newIdBytes = fileBytes;
        }
        catch
        {
            idValidationError = "Error reading file. Please try again.";
            newIdFileName = null;
            return;
        }

        if (registration!.FileUploadInfo.NiqabBypassApproved)
        {
            newIdValidated = true;
            idValidationSuccess = "ID document accepted (niqab bypass approved).";
            StateHasChanged();
            return;
        }

        isValidatingId = true;
        StateHasChanged();

        try
        {
            using var validationStream = new MemoryStream(fileBytes);
            var result = await FileValidationService.ValidateIdDocumentAsync(
                validationStream, file.Name, file.Size,
                bypassFaceDetection: registration.FileUploadInfo.NiqabBypassApproved);

            if (result.IsValid)
            {
                newIdValidated = true;
                idValidationSuccess = "ID document uploaded. Will be reviewed after submission.";
            }
            else
            {
                newIdBytes = null;
                newIdFileName = null;
                idValidationError = result.ErrorSummary;
            }
        }
        catch
        {
            newIdBytes = null;
            newIdFileName = null;
            idValidationError = "Error validating file. Please try again.";
        }
        finally
        {
            isValidatingId = false;
            StateHasChanged();
        }
    }

    private async Task OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        photoValidationError = null;
        photoValidationSuccess = null;
        newPhotoValidated = false;
        newPhotoBytes = null;
        newPhotoFileName = file.Name;
        newPhotoContentType = file.ContentType;
        newPhotoSize = file.Size;

        byte[] fileBytes;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            fileBytes = memoryStream.ToArray();
            newPhotoBytes = fileBytes;
        }
        catch
        {
            photoValidationError = "Error reading file. Please try again.";
            newPhotoFileName = null;
            return;
        }

        if (registration!.FileUploadInfo.NiqabBypassApproved)
        {
            newPhotoValidated = true;
            photoValidationSuccess = "Photo accepted (niqab bypass approved).";
            StateHasChanged();
            return;
        }

        isValidatingPhoto = true;
        StateHasChanged();

        try
        {
            using var validationStream = new MemoryStream(fileBytes);
            var result = await FileValidationService.ValidatePhotoAsync(
                validationStream, file.Name, file.Size,
                bypassFaceDetection: registration.FileUploadInfo.NiqabBypassApproved);

            if (result.IsValid)
            {
                newPhotoValidated = true;
                photoValidationSuccess = "Photo uploaded. Will be reviewed after submission.";
            }
            else
            {
                newPhotoBytes = null;
                newPhotoFileName = null;
                photoValidationError = result.ErrorSummary;
            }
        }
        catch
        {
            newPhotoBytes = null;
            newPhotoFileName = null;
            photoValidationError = "Error validating file. Please try again.";
        }
        finally
        {
            isValidatingPhoto = false;
            StateHasChanged();
        }
    }

    private async Task OnVideoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || registration == null) return;

        videoValidationError = null;
        videoUploadSuccess = null;
        videoUploadProgress = 0;
        newVideoUploaded = false;
        newVideoFileName = file.Name;
        newVideoContentType = file.ContentType;
        newVideoSize = file.Size;

        var validationResult = FileValidationService.ValidateVideo(file.Name, file.Size, file.ContentType);
        if (!validationResult.IsValid)
        {
            videoValidationError = validationResult.ErrorSummary;
            newVideoFileName = null;
            StateHasChanged();
            return;
        }

        Stream? stream = null;
        try
        {
            stream = file.OpenReadStream(maxAllowedSize: FileValidationService.MaxVideoSize);
        }
        catch
        {
            videoValidationError = "Error reading file. Please try again.";
            newVideoFileName = null;
            StateHasChanged();
            return;
        }

        videoUploadCts?.Cancel();
        videoUploadCts = new CancellationTokenSource();

        isUploadingVideo = true;
        StateHasChanged();

        try
        {
            var division = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
            var divisionName = division?.Name ?? "unknown";

            var containerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Video);
            var blobName = BlobStorageService.GenerateVideoBlobName(divisionName, Path.GetExtension(file.Name));

            newVideoBlobName = blobName;

            var progress = new Progress<long>(bytesUploaded =>
            {
                if (file.Size > 0)
                {
                    videoUploadProgress = (int)((bytesUploaded * 100) / file.Size);
                    InvokeAsync(StateHasChanged);
                }
            });

            var blobUri = await BlobStorageService.UploadWithProgressAsync(
                stream, file.Size, containerName, blobName, file.ContentType,
                progress, videoUploadCts.Token);

            newVideoBlobUri = blobUri;
            newVideoUploaded = true;
            videoUploadProgress = 100;
            videoUploadSuccess = $"Video uploaded successfully ({FormatFileSize(file.Size)}).";
        }
        catch (OperationCanceledException)
        {
            ClearNewVideoFile();
            videoValidationError = "Upload cancelled.";
        }
        catch
        {
            ClearNewVideoFile();
            videoValidationError = "Error uploading video. Please try again.";
        }
        finally
        {
            if (stream != null) await stream.DisposeAsync();
            isUploadingVideo = false;
            StateHasChanged();
        }
    }

    private void CancelVideoUpload() => videoUploadCts?.Cancel();

    private void ClearNewIdFile()
    {
        newIdBytes = null;
        newIdFileName = null;
        newIdContentType = null;
        newIdSize = 0;
        newIdValidated = false;
        idValidationError = null;
        idValidationSuccess = null;
    }

    private void ClearNewPhotoFile()
    {
        newPhotoBytes = null;
        newPhotoFileName = null;
        newPhotoContentType = null;
        newPhotoSize = 0;
        newPhotoValidated = false;
        photoValidationError = null;
        photoValidationSuccess = null;
    }

    private void ClearNewVideoFile()
    {
        videoUploadCts?.Cancel();
        newVideoFileName = null;
        newVideoBlobUri = null;
        newVideoBlobName = null;
        newVideoSize = 0;
        newVideoContentType = null;
        newVideoUploaded = false;
        videoUploadSuccess = null;
        videoUploadProgress = 0;
    }

    // ═══════════════════════════════════════════════════════════════════════════════
    // SAVE CHANGES
    // ═══════════════════════════════════════════════════════════════════════════════

    private async Task SaveChanges()
    {
        if (registration == null || originalRegistration == null) return;

        validationErrors.Clear();
        isSaving = true;
        StateHasChanged();

        try
        {
            // ═══════════════════════════════════════════════════════════════════════════════
            // VALIDATION
            // ═══════════════════════════════════════════════════════════════════════════════

            ValidateName(registration.PersonalInfo.FirstName, "First name", minLength: 2, required: true);
            ValidateName(registration.PersonalInfo.MiddleName, "Middle name", minLength: 1, required: false);
            ValidateName(registration.PersonalInfo.LastName, "Last name", minLength: 2, required: true);
            ValidateName(registration.PersonalInfo.PreferredName, "Preferred name", minLength: 1, required: false);

            if (registration.PersonalInfo.DateOfBirth == default)
                validationErrors.Add("Date of birth is required.");

            if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PhoneNumber) &&
                !IsValidPhoneNumber(registration.PersonalInfo.PhoneNumber))
                validationErrors.Add("Please enter a valid 10-digit phone number.");

            if (string.IsNullOrWhiteSpace(registration.AddressInfo.Country))
                validationErrors.Add("Country is required.");
            if (string.IsNullOrWhiteSpace(registration.AddressInfo.StateProvince))
                validationErrors.Add("State/Province is required.");
            if (string.IsNullOrWhiteSpace(registration.AddressInfo.City))
                validationErrors.Add("City is required.");

            if (string.IsNullOrWhiteSpace(registration.CompetitionSelection.DivisionId))
                validationErrors.Add("Please select a division.");
            if (string.IsNullOrWhiteSpace(registration.CompetitionSelection.CategoryId))
                validationErrors.Add("Please select a category.");

            if (selectedCategory?.PortionOption == PortionOption.TopOrBottom &&
                registration.CompetitionSelection.PortionChoice == null)
                validationErrors.Add("Please select a portion (Top or Bottom).");

            if (selectedCategory?.RequiresVideo == true)
            {
                var hasExistingVideo = registration.FileUploadInfo.Video != null;
                var hasNewVideo = newVideoUploaded;

                if (!hasExistingVideo && !hasNewVideo)
                    validationErrors.Add("Please upload a video for this category.");
                else if (isUploadingVideo)
                    validationErrors.Add("Please wait for the video upload to complete.");
            }

            if (registration.FileUploadInfo.IdDocument == null && !newIdValidated)
                validationErrors.Add("ID document is required.");
            if (registration.FileUploadInfo.Photo == null && !newPhotoValidated)
                validationErrors.Add("Photo is required.");

            ValidateName(registration.ParentInfo.FirstName, "Parent/Guardian first name", minLength: 2, required: true);
            ValidateName(registration.ParentInfo.LastName, "Parent/Guardian last name", minLength: 2, required: true);
            if (string.IsNullOrWhiteSpace(registration.ParentInfo.PhoneNumber))
                validationErrors.Add("Parent/Guardian phone number is required.");
            else if (!IsValidPhoneNumber(registration.ParentInfo.PhoneNumber))
                validationErrors.Add("Please enter a valid 10-digit phone number for Parent/Guardian.");

            ValidateName(teacherFirstName, "Teacher first name", minLength: 2, required: true);
            ValidateName(teacherLastName, "Teacher last name", minLength: 2, required: true);
            if (string.IsNullOrWhiteSpace(teacherPhone))
                validationErrors.Add("Teacher phone number is required.");
            else if (!IsValidPhoneNumber(teacherPhone))
                validationErrors.Add("Please enter a valid 10-digit phone number for Teacher.");
            if (string.IsNullOrWhiteSpace(teacherInstitution))
                validationErrors.Add("Institution name is required.");
            else if (teacherInstitution.Trim().Length < 2)
                validationErrors.Add("Institution name must be at least 2 characters.");

            if (validationErrors.Any())
                return;

            // ═══════════════════════════════════════════════════════════════════════════════
            // PREPARE & SAVE
            // ═══════════════════════════════════════════════════════════════════════════════

            registration.TeacherInfo = new TeacherInfo
            {
                FirstName = teacherFirstName,
                LastName = teacherLastName,
                PhoneNumber = teacherPhone,
                Institution = string.IsNullOrWhiteSpace(teacherInstitution) ? null : teacherInstitution
            };

            // Clear niqab bypass if name or DOB changed
            var nameOrDobChanged = registration.PersonalInfo.FirstName != originalFirstName ||
                                   registration.PersonalInfo.LastName != originalLastName ||
                                   registration.PersonalInfo.DateOfBirth != originalDateOfBirth;

            if (nameOrDobChanged && registration.FileUploadInfo.NiqabBypassApproved)
                registration.FileUploadInfo.NiqabBypassApproved = false;

            await UploadNewFilesAsync();

            await AuditContextProvider.SetCurrentUserContextAsync();

            var changes = BuildChangesList();

            var updateResult = await RegistrationService.UpdateAsync(registration);
            if (!updateResult.IsValid)
            {
                validationErrors.AddRange(updateResult.Errors);
                return;
            }

            // Check if CID was regenerated (division change)
            var updated = await RegistrationService.GetByIdAsync(registration.Id);
            if (updated != null && updated.Cid != originalRegistration.Cid)
            {
                changes.Add(new FieldChange
                {
                    FieldName = "Cid",
                    DisplayName = "Competitor ID (CID)",
                    OldValue = originalRegistration.Cid ?? "(none)",
                    NewValue = updated.Cid ?? "(none)"
                });
            }

            if (changes.Any())
            {
                var divisionName = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId)?.Name ?? "Unknown";
                var categoryName = selectedCategory?.Name ?? "Unknown";

                await AuditService.LogFieldChangesAsync(
                    "Registration",
                    registration.Id,
                    changes,
                    summary: $"Registration updated ({changes.Count} field(s) changed)",
                    entityDescription: $"{registration.PersonalInfo.FullName} - {divisionName} / {categoryName}");
            }

            // Redirect back to this registration's details page
            NavigationManager.NavigateTo(isAdmin ? $"/admin/registration/{Id}" : $"/registration/{Id}");
        }
        catch (Exception ex)
        {
            validationErrors.Add($"Error saving changes: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void ValidateName(string? value, string fieldName, int minLength, bool required)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            if (required)
                validationErrors.Add($"{fieldName} is required.");
            return;
        }

        var trimmed = value.Trim();
        if (trimmed.Length < minLength)
            validationErrors.Add($"{fieldName} must be at least {minLength} character{(minLength > 1 ? "s" : "")}.");

        if (trimmed.Any(char.IsDigit))
            validationErrors.Add($"{fieldName} cannot contain numbers.");
    }

    private bool IsValidPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return false;
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return digits.Length == 10;
    }

    private async Task UploadNewFilesAsync()
    {
        if (registration == null) return;

        var division = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
        var divisionName = division?.Name ?? "unknown";

        if (newIdBytes != null && newIdValidated)
        {
            var containerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Id);
            var blobName = BlobStorageService.GenerateBlobName(
                FileType.Id, divisionName,
                registration.PersonalInfo.FirstName,
                registration.PersonalInfo.LastName,
                registration.PersonalInfo.DateOfBirth,
                Path.GetExtension(newIdFileName ?? ".jpg"));

            using var stream = new MemoryStream(newIdBytes);
            await BlobStorageService.UploadAsync(stream, containerName, blobName, newIdContentType ?? "image/jpeg");

            registration.FileUploadInfo.IdDocument = new FileMetadata
            {
                FileName = newIdFileName ?? "id.jpg",
                StorageReference = blobName,
                FileSizeBytes = newIdSize,
                Extension = Path.GetExtension(newIdFileName ?? ".jpg"),
                ContentType = newIdContentType ?? "image/jpeg"
            };
        }

        if (newPhotoBytes != null && newPhotoValidated)
        {
            var containerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Photo);
            var blobName = BlobStorageService.GenerateBlobName(
                FileType.Photo, divisionName,
                registration.PersonalInfo.FirstName,
                registration.PersonalInfo.LastName,
                registration.PersonalInfo.DateOfBirth,
                Path.GetExtension(newPhotoFileName ?? ".jpg"));

            using var stream = new MemoryStream(newPhotoBytes);
            await BlobStorageService.UploadAsync(stream, containerName, blobName, newPhotoContentType ?? "image/jpeg");

            registration.FileUploadInfo.Photo = new FileMetadata
            {
                FileName = newPhotoFileName ?? "photo.jpg",
                StorageReference = blobName,
                FileSizeBytes = newPhotoSize,
                Extension = Path.GetExtension(newPhotoFileName ?? ".jpg"),
                ContentType = newPhotoContentType ?? "image/jpeg"
            };
        }

        if (newVideoUploaded && !string.IsNullOrEmpty(newVideoBlobUri))
        {
            registration.FileUploadInfo.Video = new FileMetadata
            {
                FileName = newVideoFileName ?? "video.mp4",
                StorageReference = newVideoBlobName ?? "video.mp4",
                FileSizeBytes = newVideoSize,
                Extension = Path.GetExtension(newVideoFileName ?? ".mp4"),
                ContentType = newVideoContentType ?? "video/mp4"
            };
        }
    }

    private List<FieldChange> BuildChangesList()
    {
        var changes = new List<FieldChange>();
        if (registration == null || originalRegistration == null) return changes;

        // Personal Info
        AddChange(changes, "PersonalInfo.FirstName", "First Name", originalRegistration.PersonalInfo.FirstName, registration.PersonalInfo.FirstName);
        AddChange(changes, "PersonalInfo.MiddleName", "Middle Name", originalRegistration.PersonalInfo.MiddleName, registration.PersonalInfo.MiddleName);
        AddChange(changes, "PersonalInfo.LastName", "Last Name", originalRegistration.PersonalInfo.LastName, registration.PersonalInfo.LastName);
        AddChange(changes, "PersonalInfo.PreferredName", "Preferred Name", originalRegistration.PersonalInfo.PreferredName, registration.PersonalInfo.PreferredName);
        AddChange(changes, "PersonalInfo.Gender", "Gender", originalRegistration.PersonalInfo.Gender.ToString(), registration.PersonalInfo.Gender.ToString());
        AddChange(changes, "PersonalInfo.DateOfBirth", "Date of Birth", originalRegistration.PersonalInfo.DateOfBirth.ToString("yyyy-MM-dd"), registration.PersonalInfo.DateOfBirth.ToString("yyyy-MM-dd"));
        AddChange(changes, "PersonalInfo.PhoneNumber", "Phone", originalRegistration.PersonalInfo.PhoneNumber ?? "", registration.PersonalInfo.PhoneNumber ?? "");

        // Address
        AddChange(changes, "AddressInfo.Country", "Country", originalRegistration.AddressInfo.Country, registration.AddressInfo.Country);
        AddChange(changes, "AddressInfo.StateProvince", "State", originalRegistration.AddressInfo.StateProvince, registration.AddressInfo.StateProvince);
        AddChange(changes, "AddressInfo.City", "City", originalRegistration.AddressInfo.City, registration.AddressInfo.City);

        // Competition
        if (originalRegistration.CompetitionSelection.DivisionId != registration.CompetitionSelection.DivisionId)
        {
            var oldDiv = availableDivisions.FirstOrDefault(d => d.Id == originalRegistration.CompetitionSelection.DivisionId)?.Name ?? originalRegistration.CompetitionSelection.DivisionId;
            var newDiv = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId)?.Name ?? registration.CompetitionSelection.DivisionId;
            changes.Add(new FieldChange { FieldName = "CompetitionSelection.DivisionId", DisplayName = "Division", OldValue = oldDiv, NewValue = newDiv });
        }

        if (originalRegistration.CompetitionSelection.CategoryId != registration.CompetitionSelection.CategoryId)
        {
            var oldDiv = availableDivisions.FirstOrDefault(d => d.Id == originalRegistration.CompetitionSelection.DivisionId);
            var newDiv = availableDivisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
            var oldCat = oldDiv?.Categories.FirstOrDefault(c => c.Id == originalRegistration.CompetitionSelection.CategoryId)?.Name ?? originalRegistration.CompetitionSelection.CategoryId;
            var newCat = newDiv?.Categories.FirstOrDefault(c => c.Id == registration.CompetitionSelection.CategoryId)?.Name ?? registration.CompetitionSelection.CategoryId;
            changes.Add(new FieldChange { FieldName = "CompetitionSelection.CategoryId", DisplayName = "Category", OldValue = oldCat, NewValue = newCat });
        }

        AddChange(changes, "CompetitionSelection.PortionChoice", "Portion", originalRegistration.CompetitionSelection.PortionChoice?.ToString() ?? "", registration.CompetitionSelection.PortionChoice?.ToString() ?? "");

        // Parent Info
        AddChange(changes, "ParentInfo.FirstName", "Parent First Name", originalRegistration.ParentInfo.FirstName, registration.ParentInfo.FirstName);
        AddChange(changes, "ParentInfo.LastName", "Parent Last Name", originalRegistration.ParentInfo.LastName, registration.ParentInfo.LastName);
        AddChange(changes, "ParentInfo.PhoneNumber", "Parent Phone", originalRegistration.ParentInfo.PhoneNumber, registration.ParentInfo.PhoneNumber);

        // Teacher Info
        var origTeacher = originalRegistration.TeacherInfo;
        var newTeacher = registration.TeacherInfo;
        AddChange(changes, "TeacherInfo.FirstName", "Teacher First Name", origTeacher?.FirstName ?? "", newTeacher?.FirstName ?? "");
        AddChange(changes, "TeacherInfo.LastName", "Teacher Last Name", origTeacher?.LastName ?? "", newTeacher?.LastName ?? "");
        AddChange(changes, "TeacherInfo.PhoneNumber", "Teacher Phone", origTeacher?.PhoneNumber ?? "", newTeacher?.PhoneNumber ?? "");
        AddChange(changes, "TeacherInfo.Institution", "Institution", origTeacher?.Institution ?? "", newTeacher?.Institution ?? "");

        // Files
        if (newIdBytes != null && newIdValidated)
        {
            changes.Add(new FieldChange
            {
                FieldName = "FileUploadInfo.IdDocument",
                DisplayName = "ID Document",
                OldValue = originalRegistration.FileUploadInfo.IdDocument?.StorageReference ?? "(none)",
                NewValue = "(new file uploaded)"
            });
        }

        if (newPhotoBytes != null && newPhotoValidated)
        {
            changes.Add(new FieldChange
            {
                FieldName = "FileUploadInfo.Photo",
                DisplayName = "Photo",
                OldValue = originalRegistration.FileUploadInfo.Photo?.StorageReference ?? "(none)",
                NewValue = "(new file uploaded)"
            });
        }

        if (newVideoUploaded)
        {
            changes.Add(new FieldChange
            {
                FieldName = "FileUploadInfo.Video",
                DisplayName = "Video",
                OldValue = originalRegistration.FileUploadInfo.Video?.StorageReference ?? "(none)",
                NewValue = "(new file uploaded)"
            });
        }

        if (originalRegistration.FileUploadInfo.NiqabBypassApproved && !registration.FileUploadInfo.NiqabBypassApproved)
        {
            changes.Add(new FieldChange
            {
                FieldName = "FileUploadInfo.NiqabBypassApproved",
                DisplayName = "Niqab Bypass",
                OldValue = "Approved",
                NewValue = "Cleared (name/DOB changed)"
            });
        }

        return changes;
    }

    private void AddChange(List<FieldChange> changes, string fieldName, string displayName, string oldValue, string newValue)
    {
        if (oldValue != newValue)
        {
            changes.Add(new FieldChange
            {
                FieldName = fieldName,
                DisplayName = displayName,
                OldValue = string.IsNullOrEmpty(oldValue) ? "(empty)" : oldValue,
                NewValue = string.IsNullOrEmpty(newValue) ? "(empty)" : newValue
            });
        }
    }

