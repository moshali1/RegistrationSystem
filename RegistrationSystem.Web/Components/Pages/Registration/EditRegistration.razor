@page "/registration/{Id}/edit"
@page "/admin/registration/{Id}/edit"

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject FileValidationService FileValidationService
@inject BlobStorageService BlobStorageService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider

@attribute [Authorize]

<PageTitle>Edit Registration</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center py-16">
        <div class="flex flex-col items-center gap-3">
            <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
            <span class="text-sm text-slate-500">Loading registration...</span>
        </div>
    </div>
}
else if (registration == null || !canEdit)
{
    <div class="max-w-lg mx-auto">
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-4">
                <svg class="h-7 w-7 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h2 class="text-lg font-semibold text-slate-800 mb-2">Cannot Edit Registration</h2>
            <p class="text-sm text-slate-600 mb-6">
                @if (registration == null)
                {
                    @:This registration was not found or you don't have permission to view it.
                }
                else
                {
                    @:This registration cannot be edited. Only registrations with "Awaiting Review" or "Pending" status can be edited.
                }
            </p>
            <a href="@(isAdmin ? "/admin/registrations" : "/registrations")"
               class="inline-flex items-center gap-2 rounded-xl bg-slate-600 text-white px-5 py-2.5 text-sm font-medium hover:bg-slate-700 transition-all">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Back to Registrations
            </a>
        </div>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">Edit Registration</h1>
                <p class="text-sm text-slate-500 mt-1">
                    @originalRegistration!.PersonalInfo.FullName
                    @if (!string.IsNullOrEmpty(originalRegistration.Cid))
                    {
                        <span class="font-mono ml-1">(@originalRegistration.Cid)</span>
                    }
                </p>
            </div>
            <StatusBadge Status="originalRegistration.Status" Size="StatusBadge.StatusBadgeSize.Large" />
        </div>

        <!-- Error Messages -->
        @if (validationErrors.Any())
        {
            <div class="mb-4 rounded-xl border border-red-200 bg-gradient-to-r from-red-50 to-white px-4 py-3 shadow-sm">
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0">
                        <svg class="h-4 w-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="text-sm">
                        <p class="font-medium text-red-800">Please fix the following:</p>
                        <ul class="mt-1.5 space-y-1 text-red-700">
                            @foreach (var error in validationErrors)
                            {
                                <li>• @error</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <!-- Tabs -->
        <!-- Tabs -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-r from-slate-700 to-slate-800 shadow-lg mb-4 overflow-hidden">
            <div class="px-5 py-4">
                <div class="flex gap-2">
                    @foreach (var tab in tabs)
                    {
                        <button type="button"
                                @onclick="() => activeTab = tab.Key"
                                class="cursor-pointer flex-1 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all @(activeTab == tab.Key ? "bg-cyan-500 text-white shadow-md" : "text-slate-400 hover:text-white hover:bg-slate-600")">
                            @tab.Value
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-6">
                @switch (activeTab)
                {
                    case "competitor":
                        @RenderCompetitorTab()
                        break;
                    case "competition":
                        @RenderCompetitionTab()
                        break;
                    case "contacts":
                        @RenderContactsTab()
                        break;
                    case "files":
                        @RenderFilesTab()
                        break;
                }
            </div>

            <!-- Footer Actions -->
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
                <a href="@(isAdmin ? $"/admin/registration/{Id}" : $"/registration/{Id}")"
                   class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                    Cancel
                </a>
                <button type="button"
                        @onclick="SaveChanges"
                        disabled="@isSaving"
                        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-700 hover:to-cyan-800 disabled:opacity-50 text-white text-sm font-semibold transition-all shadow-lg active:scale-[0.98] flex items-center gap-2">
                    @if (isSaving)
                    {
                        <div class="animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>Save Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* ═══════════════════════════════════════════════════════════════════════════════════ *@
@* TAB RENDER FRAGMENTS *@
@* ═══════════════════════════════════════════════════════════════════════════════════ *@

@{
    RenderFragment RenderCompetitorTab() => __builder =>
    {
        <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- First Name -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        First Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" @bind="registration!.PersonalInfo.FirstName" @bind:event="oninput"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                           placeholder="Competitor's first name" />
                </div>

                <!-- Middle Name -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">Middle Name</label>
                    <input type="text" @bind="registration!.PersonalInfo.MiddleName" @bind:event="oninput"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                           placeholder="Optional" />
                </div>

                <!-- Last Name -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        Last Name <span class="text-red-500">*</span>
                    </label>
                    <input type="text" @bind="registration!.PersonalInfo.LastName" @bind:event="oninput"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                           placeholder="Competitor's last name" />
                </div>

                <!-- Preferred Name -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">Preferred Name</label>
                    <input type="text" @bind="registration!.PersonalInfo.PreferredName" @bind:event="oninput"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                           placeholder="Name for certificate (optional)" />
                </div>

                <!-- Gender -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        Gender <span class="text-red-500">*</span>
                    </label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="gender" value="@Gender.Male"
                                   checked="@(registration!.PersonalInfo.Gender == Gender.Male)"
                                   @onchange="() => registration!.PersonalInfo.Gender = Gender.Male"
                                   class="text-cyan-600 focus:ring-cyan-500" />
                            <span class="text-sm text-slate-700">Male</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="gender" value="@Gender.Female"
                                   checked="@(registration!.PersonalInfo.Gender == Gender.Female)"
                                   @onchange="() => registration!.PersonalInfo.Gender = Gender.Female"
                                   class="text-cyan-600 focus:ring-cyan-500" />
                            <span class="text-sm text-slate-700">Female</span>
                        </label>
                    </div>
                </div>

                <!-- Date of Birth -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        Date of Birth <span class="text-red-500">*</span>
                    </label>
                    <input type="date" value="@registration!.PersonalInfo.DateOfBirth.ToString("yyyy-MM-dd")"
                           @onchange="OnDateOfBirthChanged"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                </div>

                <!-- Phone -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">Competitor Phone</label>
                    <input type="tel" @bind="registration!.PersonalInfo.PhoneNumber" @bind:event="oninput"
                           class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                           placeholder="10-digit phone (optional)" />
                </div>
            </div>

            <!-- Address Section -->
            <div class="pt-4 border-t border-slate-200">
                <h3 class="text-sm font-semibold text-slate-800 mb-4">Location</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Country -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Country <span class="text-red-500">*</span>
                        </label>
                        <select @bind="registration!.AddressInfo.Country"
                                @bind:after="OnCountryChanged"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm">
                            <option value="">Select country</option>
                            @foreach (var country in LocationData.Countries)
                            {
                                <option value="@country.Name">@country.Name</option>
                            }
                        </select>
                    </div>

                    <!-- State/Province -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            State/Province <span class="text-red-500">*</span>
                        </label>
                        <select @bind="registration!.AddressInfo.StateProvince"
                                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                                disabled="@(availableStates.Count == 0)">
                            <option value="">Select state</option>
                            @foreach (var state in availableStates)
                            {
                                <option value="@state.Name">@state.Name</option>
                            }
                        </select>
                    </div>

                    <!-- City -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            City <span class="text-red-500">*</span>
                        </label>
                        <input type="text" @bind="registration!.AddressInfo.City" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                               placeholder="City name" />
                    </div>
                </div>
            </div>
        </div>
    };

    RenderFragment RenderCompetitionTab() => __builder =>
    {
        <div class="space-y-6">
            @if (divisionChanged)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
                    <div class="flex items-start gap-2">
                        <svg class="h-5 w-5 text-amber-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <div class="text-sm">
                            <p class="font-medium text-amber-800">Division Changed</p>
                            <p class="text-amber-700 mt-0.5">A new Competitor ID (CID) will be generated when you save.</p>
                        </div>
                    </div>
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Division -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        Division <span class="text-red-500">*</span>
                    </label>
                    <select value="@registration!.CompetitionSelection.DivisionId"
                            @onchange="OnDivisionChanged"
                            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm">
                        <option value="">Select division</option>
                        @foreach (var division in availableDivisions)
                        {
                            <option value="@division.Id">@division.Name</option>
                        }
                    </select>
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1.5">
                        Category <span class="text-red-500">*</span>
                    </label>
                    <select @bind="registration!.CompetitionSelection.CategoryId"
                            @bind:after="OnCategoryChanged"
                            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                            disabled="@(availableCategories.Count == 0)">
                        <option value="">Select category</option>
                        @foreach (var category in availableCategories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                </div>

                <!-- Portion Choice (if applicable) -->
                @if (selectedCategory?.PortionOption == PortionOption.TopOrBottom)
                {
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Portion Choice <span class="text-red-500">*</span>
                        </label>
                        <div class="flex gap-4">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="portion"
                                       checked="@(registration!.CompetitionSelection.PortionChoice == PortionChoice.Top)"
                                       @onchange="() => registration!.CompetitionSelection.PortionChoice = PortionChoice.Top"
                                       class="text-cyan-600 focus:ring-cyan-500" />
                                <span class="text-sm text-slate-700">Top Half</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="portion"
                                       checked="@(registration!.CompetitionSelection.PortionChoice == PortionChoice.Bottom)"
                                       @onchange="() => registration!.CompetitionSelection.PortionChoice = PortionChoice.Bottom"
                                       class="text-cyan-600 focus:ring-cyan-500" />
                                <span class="text-sm text-slate-700">Bottom Half</span>
                            </label>
                        </div>
                    </div>
                }
            </div>

            <!-- Video Requirement Notice -->
            @if (selectedCategory?.RequiresVideo == true)
            {
                var hasVideo = registration!.FileUploadInfo.Video != null || newVideoUploaded;
                <div class="rounded-lg border @(hasVideo ? "border-cyan-200 bg-cyan-50" : "border-red-200 bg-red-50") px-4 py-3">
                    <div class="flex items-start gap-2">
                        <svg class="h-5 w-5 @(hasVideo ? "text-cyan-500" : "text-red-500") mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <div class="text-sm">
                            <p class="font-medium @(hasVideo ? "text-cyan-800" : "text-red-800")">Video Required</p>
                            <p class="@(hasVideo ? "text-cyan-700" : "text-red-700") mt-0.5">
                                @if (hasVideo)
                                {
                                    @:Video uploaded ✓
                                }
                                else
                                {
                                    @:This category requires a video submission. Please go to the Files tab to upload.
                                }
                                @if (!string.IsNullOrEmpty(selectedCategory.VideoInstructions))
                                {
                                    <span class="block mt-1">@selectedCategory.VideoInstructions</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    RenderFragment RenderContactsTab() => __builder =>
    {
        <div class="space-y-6">
            <!-- Parent/Guardian Section -->
            <div>
                <h3 class="text-sm font-semibold text-slate-800 mb-4">Parent/Guardian</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            First Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" @bind="registration!.ParentInfo.FirstName" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Last Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" @bind="registration!.ParentInfo.LastName" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Phone <span class="text-red-500">*</span>
                        </label>
                        <input type="tel" @bind="registration!.ParentInfo.PhoneNumber" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                               placeholder="10-digit phone" />
                    </div>
                </div>
            </div>

            <!-- Teacher Section -->
            <div class="pt-4 border-t border-slate-200">
                <h3 class="text-sm font-semibold text-slate-800 mb-4">Teacher/Instructor</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            First Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" @bind="teacherFirstName" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Last Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" @bind="teacherLastName" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">
                            Phone <span class="text-red-500">*</span>
                        </label>
                        <input type="tel" @bind="teacherPhone" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                               placeholder="10-digit phone" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1.5">Institution</label>
                        <input type="text" @bind="teacherInstitution" @bind:event="oninput"
                               class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500 text-sm"
                               placeholder="Qur'an Institution (optional)" />
                    </div>
                </div>
            </div>
        </div>
    };

    RenderFragment RenderFilesTab() => __builder =>
    {
        <div class="space-y-6">
            <!-- Video Required Warning -->
            @if (selectedCategory?.RequiresVideo == true && registration!.FileUploadInfo.Video == null && !newVideoUploaded)
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3">
                    <div class="flex items-start gap-2">
                        <svg class="h-5 w-5 text-red-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <div class="text-sm">
                            <p class="font-medium text-red-800">Video Required</p>
                            <p class="text-red-700 mt-0.5">
                                The selected category requires a video submission. Please upload a video below.
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Niqab Bypass Info -->
            @if (registration!.FileUploadInfo.NiqabBypassApproved)
            {
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                    <div class="flex items-center gap-2">
                        <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span class="text-sm font-medium text-slate-700">Niqab Exception Approved</span>
                    </div>
                </div>
            }

