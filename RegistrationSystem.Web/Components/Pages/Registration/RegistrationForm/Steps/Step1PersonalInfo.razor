@namespace RegistrationSystem.Web.Components.Pages.Registration.RegistrationForm.Steps
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings

<div class="p-6">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow-lg">
            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
        </div>
        <div>
            <h2 class="text-lg font-semibold text-slate-800">Personal Information</h2>
            <p class="text-sm text-slate-500">Competitor's details</p>
        </div>
    </div>

    <div class="space-y-5">
        <!-- Name Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">First Name <span class="text-red-500">*</span></label>
                <input type="text"
                       @bind="FormState.FirstName"
                       @bind:event="oninput"
                       @bind:after="OnInputChanged"
                       placeholder="Competitor's first name"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
            </div>
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">Middle Name</label>
                <input type="text"
                       @bind="FormState.MiddleName"
                       @bind:event="oninput"
                       @bind:after="OnInputChanged"
                       placeholder="Optional"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
            </div>
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">Last Name <span class="text-red-500">*</span></label>
                <input type="text"
                       @bind="FormState.LastName"
                       @bind:event="oninput"
                       @bind:after="OnInputChanged"
                       placeholder="Competitor's last name"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
            </div>
        </div>

        <!-- Preferred Name -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">Preferred Name <span class="text-slate-400 font-normal">(optional)</span></label>
                <input type="text"
                       @bind="FormState.PreferredName"
                       @bind:event="oninput"
                       @bind:after="OnInputChanged"
                       placeholder="Nickname for announcements"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                <p class="text-xs text-slate-500">This name will be used during announcements if provided.</p>
            </div>
        </div>

        <!-- Gender and DOB -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2">
                <label class="text-sm font-medium text-slate-700">Gender <span class="text-red-500">*</span></label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="relative cursor-pointer">
                        <input type="radio" name="gender" class="peer sr-only"
                               checked="@(FormState.Gender == Gender.Male)"
                               @onchange="@(() => { FormState.Gender = Gender.Male; OnInputChanged(); })" />
                        <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                            Male
                        </div>
                    </label>
                    <label class="relative cursor-pointer">
                        <input type="radio" name="gender" class="peer sr-only"
                               checked="@(FormState.Gender == Gender.Female)"
                               @onchange="@(() => { FormState.Gender = Gender.Female; OnInputChanged(); })" />
                        <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                            Female
                        </div>
                    </label>
                </div>
            </div>
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">Date of Birth <span class="text-red-500">*</span></label>
                <input type="date"
                       value="@(FormState.DateOfBirth == default ? "" : FormState.DateOfBirth.ToString("yyyy-MM-dd"))"
                       @onchange="OnDateOfBirthChanged"
                       class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                @if (FormState.DateOfBirth != default && Settings != null)
                {
                    <p class="text-xs text-slate-500">
                        Age as of @Settings.AgeCutoffDate.ToString("MMM d, yyyy"): <span class="font-semibold text-cyan-700">@RegistrationFormHelpers.CalculateAge(FormState.DateOfBirth, Settings.AgeCutoffDate) years</span>
                    </p>
                }
            </div>
        </div>

        <!-- Competitor Phone -->
        <div class="space-y-1.5">
            <label class="text-sm font-medium text-slate-700">Competitor Phone <span class="text-slate-400 font-normal">(optional)</span></label>
            <input type="tel"
                   @bind="FormState.CompetitorPhone"
                   @bind:event="oninput"
                   @bind:after="OnInputChanged"
                   placeholder="(555) 123-4567"
                   class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
        </div>
    </div>
</div>

<StepFooter ShowBack="false" OnNext="OnNext" OnBack="OnBack" />