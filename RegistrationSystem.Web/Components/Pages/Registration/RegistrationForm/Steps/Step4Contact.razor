@namespace RegistrationSystem.Web.Components.Pages.Registration.Steps

<div class="p-6">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow-lg">
            @Icons.MapPin("h-5 w-5 text-white")
        </div>
        <div>
            <h2 class="text-lg font-semibold text-slate-800">Contact Information</h2>
            <p class="text-sm text-slate-500">Address, guardian, and teacher details</p>
        </div>
    </div>

    <div class="space-y-6">
        <!-- Address Section -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                @Icons.Home("h-4 w-4 text-slate-500")
                Address
            </h3>
            <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Country <span class="text-red-500">*</span></label>
                        <select @onchange="HandleCountryChanged"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow">
                            <option value="">Select country...</option>
                            @foreach (var country in LocationData.Countries)
                            {
                                <option value="@country.Name" selected="@(FormState.Country == country.Name)">
                                    @country.Name
                                </option>
                            }
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">
                            @(SelectedCountry?.StateLabel ?? "State/Province") <span class="text-red-500">*</span>
                        </label>
                        @if (SelectedCountry != null && AvailableStates.Any())
                        {
                            <select @onchange="HandleStateChanged"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow">
                                <option value="">Select @SelectedCountry.StateLabel.ToLower()...</option>
                                @foreach (var state in AvailableStates)
                                {
                                    <option value="@state.Name" selected="@(FormState.StateProvince == state.Name)">
                                        @state.Name
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" disabled placeholder="Select country first"
                                   class="w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-400" />
                        }
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-slate-700">City <span class="text-red-500">*</span></label>
                    <input type="text"
                           @bind="FormState.City"
                           @bind:event="oninput"
                           @bind:after="OnInputChanged"
                           placeholder="City name"
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                </div>
            </div>
        </div>

        <!-- Parent/Guardian Section -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                @Icons.Users("h-4 w-4 text-slate-500")
                Parent/Guardian
            </h3>
            <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">First Name <span class="text-red-500">*</span></label>
                        <input type="text"
                               @bind="FormState.ParentFirstName"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="Parent's first name"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Last Name <span class="text-red-500">*</span></label>
                        <input type="text"
                               @bind="FormState.ParentLastName"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="Parent's last name"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-sm font-medium text-slate-700">Phone Number <span class="text-red-500">*</span></label>
                    <input type="tel"
                           @bind="FormState.ParentPhone"
                           @bind:event="oninput"
                           @bind:after="OnInputChanged"
                           placeholder="(555) 123-4567"
                           class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                </div>
            </div>
        </div>

        <!-- Teacher Section -->
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="text-sm font-semibold text-slate-700 mb-4 flex items-center gap-2">
                @Icons.Document("h-4 w-4 text-slate-500")
                Teacher/Institution
            </h3>
            <div class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">First Name <span class="text-red-500">*</span></label>
                        <input type="text"
                               @bind="FormState.TeacherFirstName"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="Teacher's first name"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Last Name <span class="text-red-500">*</span></label>
                        <input type="text"
                               @bind="FormState.TeacherLastName"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="Teacher's last name"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Phone Number <span class="text-red-500">*</span></label>
                        <input type="tel"
                               @bind="FormState.TeacherPhone"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="(555) 123-4567"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Institution <span class="text-red-500">*</span></label>
                        <input type="text"
                               @bind="FormState.TeacherInstitution"
                               @bind:event="oninput"
                               @bind:after="OnInputChanged"
                               placeholder="Qur'an Institution"
                               class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<StepFooter ShowBack="true" OnNext="OnNext" OnBack="OnBack" />