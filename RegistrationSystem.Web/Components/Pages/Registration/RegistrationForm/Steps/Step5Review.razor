@namespace RegistrationSystem.Web.Components.Pages.Registration.Steps
@using RegistrationSystem.Core.Domain.Settings

<div class="p-6">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center shadow-lg">
            @Icons.CheckCircle("h-5 w-5 text-white")
        </div>
        <div>
            <h2 class="text-lg font-semibold text-slate-800">Review & Submit</h2>
            <p class="text-sm text-slate-500">Verify all information is correct</p>
        </div>
    </div>

    <div class="space-y-4">
        <!-- Personal Info Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Personal Information</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(1)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div>
                        <span class="text-slate-500">Full Name:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.GetFormattedFullName()</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(FormState.PreferredName))
                    {
                        <div>
                            <span class="text-slate-500">Preferred Name:</span>
                            <span class="font-medium text-slate-800 ml-1">@FormState.PreferredName</span>
                        </div>
                    }
                    <div>
                        <span class="text-slate-500">Gender:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.Gender</span>
                    </div>
                    <div>
                        <span class="text-slate-500">Date of Birth:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.DateOfBirth.ToString("MMMM d, yyyy")</span>
                    </div>
                    @if (Settings != null)
                    {
                        <div>
                            <span class="text-slate-500">Age (as of @Settings.AgeCutoffDate.ToString("MMM d, yyyy")):</span>
                            <span class="font-medium text-slate-800 ml-1">@RegistrationFormHelpers.CalculateAge(FormState.DateOfBirth, Settings.AgeCutoffDate) years</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(FormState.CompetitorPhone))
                    {
                        <div>
                            <span class="text-slate-500">Phone:</span>
                            <span class="font-medium text-slate-800 ml-1">@FormState.CompetitorPhone</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ID & Photo Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">ID & Photo Verification</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(2)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div class="flex items-center gap-2">
                        <span class="text-slate-500">ID Document:</span>
                        @if (FormState.IdValidated)
                        {
                            <span class="inline-flex items-center gap-1 text-emerald-700">
                                @Icons.Check("h-4 w-4")
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="text-amber-600">Not uploaded</span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-slate-500">Photo:</span>
                        @if (FormState.PhotoValidated)
                        {
                            <span class="inline-flex items-center gap-1 text-emerald-700">
                                @Icons.Check("h-4 w-4")
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="text-amber-600">Not uploaded</span>
                        }
                    </div>
                    @if (FormState.NiqabBypassApproved)
                    {
                        <div class="sm:col-span-2">
                            <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-violet-100 text-violet-700">
                                @Icons.ShieldCheckFilled("h-3.5 w-3.5")
                                Niqab exception approved
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Competition Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Competition Selection</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(3)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div>
                        <span class="text-slate-500">Division:</span>
                        <span class="font-medium text-slate-800 ml-1">@(SelectedDivision?.Name ?? "—")</span>
                    </div>
                    <div>
                        <span class="text-slate-500">Category:</span>
                        <span class="font-medium text-slate-800 ml-1">@(SelectedCategory?.Name ?? "—")</span>
                    </div>
                    @if (SelectedCategory?.MaxAgeYears.HasValue == true)
                    {
                        <div>
                            <span class="text-slate-500">Max Age:</span>
                            <span class="font-medium text-slate-800 ml-1">@SelectedCategory.MaxAgeYears years</span>
                        </div>
                    }
                    @if (FormState.PortionChoice.HasValue)
                    {
                        <div>
                            <span class="text-slate-500">Portion:</span>
                            <span class="font-medium text-slate-800 ml-1">@FormState.PortionChoice Half</span>
                        </div>
                    }
                    @if (SelectedCategory?.RequiresVideo == true)
                    {
                        <div class="sm:col-span-2 flex items-center gap-2">
                            <span class="text-slate-500">Video:</span>
                            @if (FormState.VideoUploaded && !string.IsNullOrEmpty(FormState.VideoFileName))
                            {
                                <span class="inline-flex items-center gap-1.5 text-emerald-700">
                                    @Icons.Check("h-4 w-4")
                                    Uploaded (@RegistrationFormHelpers.FormatFileSize(FormState.VideoSize))
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-red-100 text-red-700 text-xs font-medium">
                                    @Icons.Video("h-3.5 w-3.5")
                                    Required - Not uploaded
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Address Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Address</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(4)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div>
                        <span class="text-slate-500">City:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.City</span>
                    </div>
                    <div>
                        <span class="text-slate-500">@(SelectedCountry?.StateLabel ?? "State/Province"):</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.StateProvince</span>
                    </div>
                    <div>
                        <span class="text-slate-500">Country:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.Country</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parent/Guardian Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Parent/Guardian</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(4)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div>
                        <span class="text-slate-500">Name:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.ParentFirstName @FormState.ParentLastName</span>
                    </div>
                    <div>
                        <span class="text-slate-500">Phone:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.ParentPhone</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Teacher/Institution Card -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                <span class="text-sm font-semibold text-slate-700">Teacher/Institution</span>
                <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => OnGoToStep.InvokeAsync(4)">Edit</button>
            </div>
            <div class="p-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                    <div>
                        <span class="text-slate-500">Name:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.TeacherFirstName @FormState.TeacherLastName</span>
                    </div>
                    <div>
                        <span class="text-slate-500">Phone:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.TeacherPhone</span>
                    </div>
                    <div class="sm:col-span-2">
                        <span class="text-slate-500">Institution:</span>
                        <span class="font-medium text-slate-800 ml-1">@FormState.TeacherInstitution</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Terms Card -->
        <div class="rounded-xl border-2 @(FormState.TermsAccepted ? "border-emerald-300 bg-emerald-50" : "border-cyan-200 bg-cyan-50") p-4 transition-colors">
            <label class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox"
                       @bind="FormState.TermsAccepted"
                       class="mt-0.5 h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
                <div>
                    <span class="text-sm text-slate-800 font-medium">I confirm all information is accurate</span>
                    <p class="text-xs text-slate-600 mt-1">
                        By submitting, I agree to the <a href="@(Settings?.CompetitionInfo?.RulesUrl ?? "#")" target="_blank" class="text-cyan-700 hover:underline">competition rules</a> and <a href="@(Settings?.CompetitionInfo?.TermsOfServiceUrl ?? "#")" target="_blank" class="text-cyan-700 hover:underline">terms of service</a>.
                    </p>
                </div>
            </label>
        </div>
    </div>
</div>

<!-- Submit Footer -->
<div class="px-6 py-4 border-t border-slate-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between gap-3">
    <button type="button"
            class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-all shadow-sm flex items-center gap-2"
            @onclick="OnBack"
            disabled="@IsSubmitting">
        @Icons.ArrowLeft("h-4 w-4")
        Back
    </button>
    <button type="button"
            class="cursor-pointer rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 text-white px-6 py-2.5 text-sm font-semibold hover:from-emerald-700 hover:to-emerald-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98] transition-all shadow-lg flex items-center gap-2"
            @onclick="OnSubmit"
            disabled="@(IsSubmitting || !FormState.TermsAccepted)">
        @if (IsSubmitting)
        {
            @Icons.Spinner("animate-spin h-4 w-4")
            <span>Submitting...</span>
        }
        else
        {
            @Icons.Check("h-4 w-4")
            <span>Submit Registration</span>
        }
    </button>
</div>