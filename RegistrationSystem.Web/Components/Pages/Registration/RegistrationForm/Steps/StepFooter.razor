<div class="px-6 py-4 border-t border-slate-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between gap-3">
    @if (ShowBack)
    {
        <button type="button"
                class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-all shadow-sm flex items-center gap-2"
                @onclick="OnBack">
            @Icons.ArrowLeft("h-4 w-4")
            Back
        </button>
    }
    else
    {
        <div></div>
    }
    <button type="button"
            class="cursor-pointer rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-6 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 active:scale-[0.98] transition-all shadow-lg flex items-center gap-2"
            @onclick="OnNext">
        <span>Continue</span>
        @Icons.ArrowRight("h-4 w-4")
    </button>
</div>

@code {
    [Parameter] public bool ShowBack { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
}