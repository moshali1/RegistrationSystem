@namespace RegistrationSystem.Web.Components.Pages.Registration.Steps
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings

<div class="p-6">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow-lg">
            @Icons.Trophy("h-5 w-5 text-white")
        </div>
        <div>
            <h2 class="text-lg font-semibold text-slate-800">Competition Selection</h2>
            <p class="text-sm text-slate-500">Choose division and category</p>
        </div>
    </div>

    <div class="space-y-5">
        <!-- Division -->
        <div class="space-y-1.5">
            <label class="text-sm font-medium text-slate-700">Division <span class="text-red-500">*</span></label>
            <select @onchange="HandleDivisionChanged"
                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow">
                <option value="">Select a division...</option>
                @foreach (var division in AvailableDivisions)
                {
                    <option value="@division.Id" selected="@(FormState.DivisionId == division.Id)">
                        @division.Name
                    </option>
                }
            </select>
        </div>

        <!-- Category -->
        @if (!string.IsNullOrEmpty(FormState.DivisionId))
        {
            <div class="space-y-1.5">
                <label class="text-sm font-medium text-slate-700">Category <span class="text-red-500">*</span></label>
                @if (AvailableCategories.Any())
                {
                    <select @onchange="HandleCategoryChanged"
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-shadow">
                        <option value="">Select a category...</option>
                        @foreach (var category in AvailableCategories)
                        {
                            var ageText = category.MaxAgeYears.HasValue ? $" (Max: {category.MaxAgeYears} yrs)" : "";
                            <option value="@category.Id" selected="@(FormState.CategoryId == category.Id)">
                                @category.Name@ageText
                            </option>
                        }
                    </select>
                }
                else
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                        <span class="font-medium">No eligible categories.</span> Based on the competitor's age, there are no categories available in this division.
                    </div>
                }
            </div>
        }

        <!-- Category Details Card -->
        @if (selectedCategory != null)
        {
            <div class="rounded-xl border border-cyan-200 bg-gradient-to-br from-cyan-50 to-white p-5 shadow-sm">
                <h3 class="text-sm font-semibold text-slate-800 mb-4 flex items-center gap-2">
                    @Icons.Info("h-4 w-4 text-cyan-600")
                    Category Details
                </h3>
                <div class="grid grid-cols-2 gap-4">
                    @if (selectedCategory.MaxAgeYears.HasValue)
                    {
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                            <span class="text-sm text-slate-600">Max Age: <span class="font-medium text-slate-800">@selectedCategory.MaxAgeYears years</span></span>
                        </div>
                    }
                    @if (selectedCategory.PortionOption != PortionOption.NotApplicable)
                    {
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                            <span class="text-sm text-slate-600">Portion: <span class="font-medium text-slate-800">@RegistrationFormHelpers.GetPortionLabel(selectedCategory.PortionOption)</span></span>
                        </div>
                    }
                    @if (selectedCategory.RequiresVideo)
                    {
                        <div class="col-span-2 flex items-center gap-2 text-cyan-700 bg-cyan-50 rounded-lg px-3 py-2">
                            @Icons.Video("h-4 w-4")
                            <span class="text-sm font-medium">Video upload required</span>
                        </div>
                    }
                </div>

                <!-- Age Eligibility Check -->
                @if (FormState.DateOfBirth != default && selectedCategory.MaxAgeYears.HasValue && Settings != null)
                {
                    var age = RegistrationFormHelpers.CalculateAge(FormState.DateOfBirth, Settings.AgeCutoffDate);
                    var isEligible = age <= selectedCategory.MaxAgeYears.Value;

                    <div class="mt-4 rounded-lg @(isEligible ? "bg-emerald-100 border-emerald-200" : "bg-red-100 border-red-200") border px-4 py-3">
                        <div class="flex items-center gap-2">
                            @if (isEligible)
                            {
                                @Icons.CheckCircle("h-5 w-5 text-emerald-600")
                                <span class="text-sm font-medium text-emerald-800">Age eligible: @age years (max: @selectedCategory.MaxAgeYears)</span>
                            }
                            else
                            {
                                @Icons.XCircle("h-5 w-5 text-red-600")
                                <span class="text-sm font-medium text-red-800">Not eligible: @age years exceeds max of @selectedCategory.MaxAgeYears</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Portion Choice -->
            @if (selectedCategory.PortionOption == PortionOption.TopOrBottom)
            {
                <div class="space-y-2">
                    <label class="text-sm font-medium text-slate-700">Portion Choice <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="portion" class="peer sr-only"
                                   checked="@(FormState.PortionChoice == PortionChoice.Top)"
                                   @onchange="@(() => { FormState.PortionChoice = PortionChoice.Top; OnDataChanged.InvokeAsync(); })" />
                            <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                                Top Half
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="portion" class="peer sr-only"
                                   checked="@(FormState.PortionChoice == PortionChoice.Bottom)"
                                   @onchange="@(() => { FormState.PortionChoice = PortionChoice.Bottom; OnDataChanged.InvokeAsync(); })" />
                            <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                                Bottom Half
                            </div>
                        </label>
                    </div>
                </div>
            }

            <!-- Video Upload Section -->
            @if (selectedCategory.RequiresVideo)
            {
                <div class="mt-6 rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-5">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center shadow">
                            @Icons.Video("h-5 w-5 text-white")
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">Video Upload Required</h3>
                            <p class="text-xs text-slate-500">This category requires a recitation video</p>
                        </div>
                    </div>

                    <!-- Video Instructions -->
                    @if (!string.IsNullOrWhiteSpace(selectedCategory.VideoInstructions))
                    {
                        <div class="rounded-lg bg-white border border-slate-200 p-4 mb-4">
                            <div class="flex items-start gap-2">
                                @Icons.Info("h-5 w-5 text-cyan-600 flex-shrink-0 mt-0.5")
                                <div>
                                    <p class="text-sm font-medium text-slate-700 mb-1">Instructions</p>
                                    <p class="text-sm text-slate-600">@selectedCategory.VideoInstructions</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- File Upload Area -->
                    @if (!FormState.VideoUploaded && !isUploadingVideo)
                    {
                        <div class="space-y-3">
                            <label class="block">
                                <div class="rounded-xl border-2 border-dashed border-slate-300 bg-white p-6 text-center cursor-pointer hover:border-cyan-400 hover:bg-cyan-50/50 transition-all">
                                    <input type="file"
                                           id="video-upload-input"
                                           accept="video/*"
                                           disabled="@(isUploadingVideo || string.IsNullOrEmpty(FormState.DivisionId))"
                                           class="block w-full text-sm text-slate-500
                                                  file:mr-4 file:py-2 file:px-4
                                                  file:rounded-lg file:border-0
                                                  file:text-sm file:font-medium
                                                  file:bg-cyan-50 file:text-cyan-700
                                                  hover:file:bg-cyan-100
                                                  disabled:opacity-50 disabled:cursor-not-allowed" />
                                    @Icons.Document("h-10 w-10 text-slate-400 mx-auto mb-3")
                                    <p class="text-sm font-medium text-slate-700">Click to upload video</p>
                                    <p class="text-xs text-slate-500 mt-1">MP4, MOV, WebM, AVI, MKV up to 500 MB</p>
                                </div>
                            </label>
                        </div>
                    }

                    <!-- Upload Progress -->
                    @if (isUploadingVideo)
                    {
                        <div class="space-y-3">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-slate-600 truncate max-w-[200px]">@FormState.VideoFileName</span>
                                <span class="text-cyan-600 font-medium">@videoUploadProgress%</span>
                            </div>
                            <div class="h-3 bg-slate-200 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-cyan-500 to-cyan-600 transition-all duration-300 ease-out"
                                     style="width: @(videoUploadProgress)%"></div>
                            </div>
                            <div class="flex items-center justify-between">
                                <p class="text-xs text-slate-500">Uploading @RegistrationFormHelpers.FormatFileSize(FormState.VideoSize)...</p>
                                <button type="button" @onclick="CancelVideoUpload"
                                        class="text-xs text-red-600 hover:text-red-700 font-medium">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Upload Complete -->
                    @if (FormState.VideoUploaded && !isUploadingVideo)
                    {
                        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                            <div class="flex items-start gap-3">
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.CheckCircle("h-6 w-6 text-emerald-600")
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-emerald-800">Video Uploaded</p>
                                    <p class="text-sm text-emerald-700 truncate">@FormState.VideoFileName</p>
                                    <p class="text-xs text-emerald-600 mt-1">@RegistrationFormHelpers.FormatFileSize(FormState.VideoSize)</p>
                                </div>
                                <button type="button" @onclick="(() => ClearVideoFile())"
                                        class="text-slate-400 hover:text-red-500 transition-colors p-1"
                                        title="Remove video">
                                    @Icons.XMark("h-5 w-5")
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Validation Error -->
                    @if (!string.IsNullOrEmpty(videoValidationError))
                    {
                        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mt-3">
                            <div class="flex items-center gap-2 text-red-700">
                                @Icons.XCircle("h-4 w-4 flex-shrink-0")
                                <span class="text-sm">@videoValidationError</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<StepFooter ShowBack="true" OnNext="OnNext" OnBack="OnBack" />