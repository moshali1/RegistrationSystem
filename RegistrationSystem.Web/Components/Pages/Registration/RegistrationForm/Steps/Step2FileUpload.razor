@using RegistrationSystem.Core.Domain.Registrations
@inject FileValidationService FileValidationService

@namespace RegistrationSystem.Web.Components.Pages.Registration.RegistrationForm.Steps

<div class="p-6">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center shadow-lg">
            @Icons.IdCard("h-5 w-5 text-white")
        </div>
        <div>
            <h2 class="text-lg font-semibold text-slate-800">ID & Photo Verification</h2>
            <p class="text-sm text-slate-500">Upload your identification document and a recent photo</p>
        </div>
    </div>

    <!-- Niqab Bypass Notification -->
    @if (FormState.NiqabBypassApproved)
    {
        <div class="mb-6 rounded-xl border-2 border-violet-300 bg-gradient-to-r from-violet-50 to-white p-4">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
                    @Icons.ShieldCheckFilled("h-5 w-5 text-violet-600")
                </div>
                <div>
                    <h3 class="font-semibold text-violet-800">Niqab Exception Approved</h3>
                    <p class="text-sm text-violet-700 mt-1">
                        Face detection has been bypassed for your registration. You still need to upload your ID and photo,
                        but face verification will be conducted in person by a female volunteer before the competition.
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="space-y-6">
        <!-- ID Document Upload -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200">
                <div class="flex items-center gap-2">
                    @Icons.IdCard("h-5 w-5 text-slate-600")
                    <span class="font-semibold text-slate-700">ID Document</span>
                    <span class="text-red-500 text-sm">*</span>
                </div>
            </div>
            <div class="p-4">
                <p class="text-sm text-slate-600 mb-4">
                    Upload competitor's government-issued ID (passport, driver's license, birth certificate).
                    Accepted formats: JPEG, PNG, or PDF. Maximum size: 5MB.
                </p>

                @if (!FormState.HasIdDocument)
                {
                    <label class="block @(isSelectingIdFile ? "pointer-events-none" : "cursor-pointer")">
                        <div class="border-2 border-dashed @(isSelectingIdFile ? "border-cyan-400 bg-cyan-50" : "border-slate-300 hover:border-cyan-400 hover:bg-cyan-50/50") rounded-xl p-8 text-center transition-colors">
                            @if (isSelectingIdFile)
                            {
                                <div class="w-12 h-12 rounded-full bg-cyan-100 flex items-center justify-center mx-auto mb-3">
                                    @Icons.Spinner("h-6 w-6 text-cyan-600 animate-spin")
                                </div>
                                <span class="text-sm font-medium text-cyan-700">Reading file...</span>
                                <span class="text-xs text-cyan-600 block mt-1">Please wait</span>
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                                    @Icons.Document("h-6 w-6 text-slate-400")
                                </div>
                                <span class="text-sm font-medium text-slate-700">Click to upload ID document</span>
                                <span class="text-xs text-slate-500 block mt-1">JPEG, PNG, or PDF up to 5MB</span>
                            }
                        </div>
                        <InputFile OnChange="OnIdFileSelected" accept=".jpg,.jpeg,.png,.pdf" class="hidden" disabled="@isSelectingIdFile" />
                    </label>
                }
                else
                {
                    <div class="rounded-xl border @(FormState.IdValidated ? "border-emerald-300 bg-emerald-50" : isValidatingId ? "border-cyan-300 bg-cyan-50" : "border-slate-300 bg-slate-50") p-4">
                        <div class="flex items-center gap-3">
                            @if (isValidatingId)
                            {
                                <div class="w-10 h-10 rounded-lg bg-cyan-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.Spinner("h-5 w-5 text-cyan-600 animate-spin")
                                </div>
                            }
                            else if (FormState.IdValidated)
                            {
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.CheckCircle("h-5 w-5 text-emerald-600")
                                </div>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.Document("h-5 w-5 text-slate-500")
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-800 truncate">@FormState.IdDocumentFileName</p>
                                <p class="text-xs text-slate-500">@RegistrationFormHelpers.FormatFileSize(FormState.IdDocumentSize)</p>
                                @if (isValidatingId)
                                {
                                    <p class="text-xs text-cyan-700 mt-1">Validating document...</p>
                                }
                                else if (!string.IsNullOrEmpty(idValidationSuccess))
                                {
                                    <p class="text-xs text-emerald-700 mt-1">@idValidationSuccess</p>
                                }
                            </div>
                            @if (!isValidatingId)
                            {
                                <button type="button" @onclick="ClearIdFile" class="text-slate-400 hover:text-red-500 p-1 transition-colors">
                                    @Icons.XMark("h-5 w-5")
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(idValidationError))
                {
                    <div class="mt-3 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-start gap-2">
                        @Icons.Warning("h-5 w-5 text-red-500 flex-shrink-0 mt-0.5")
                        <span>@idValidationError</span>
                    </div>
                }
            </div>
        </div>

        <!-- Photo Upload -->
        <div class="rounded-xl border border-slate-200 overflow-hidden">
            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200">
                <div class="flex items-center gap-2">
                    @Icons.Photo("h-5 w-5 text-slate-600")
                    <span class="font-semibold text-slate-700">Recent Photo</span>
                    <span class="text-red-500 text-sm">*</span>
                </div>
            </div>
            <div class="p-4">
                <p class="text-sm text-slate-600 mb-4">
                    Upload a recent standalone photo of the competitor (not cropped from an ID).
                    Use a plain background (doesn't have to be white). This photo will be used publicly at the competition.
                    Accepted formats: JPEG or PNG. Maximum size: 5MB.
                </p>
                <p class="text-xs text-amber-700 font-medium mb-4">
                    ⚠️ DO NOT upload parent's photo. Upload competitor's photo only.
                </p>

                @if (!FormState.HasPhoto)
                {
                    <label class="block @(isSelectingPhotoFile ? "pointer-events-none" : (!FormState.IdValidated && !FormState.NiqabBypassApproved ? "opacity-60 pointer-events-none" : "cursor-pointer"))">
                        <div class="border-2 border-dashed @(isSelectingPhotoFile ? "border-cyan-400 bg-cyan-50" : "border-slate-300 hover:border-cyan-400 hover:bg-cyan-50/50") rounded-xl p-8 text-center transition-colors">
                            @if (isSelectingPhotoFile)
                            {
                                <div class="w-12 h-12 rounded-full bg-cyan-100 flex items-center justify-center mx-auto mb-3">
                                    @Icons.Spinner("h-6 w-6 text-cyan-600 animate-spin")
                                </div>
                                <span class="text-sm font-medium text-cyan-700">Reading file...</span>
                                <span class="text-xs text-cyan-600 block mt-1">Please wait</span>
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-3">
                                    @Icons.Photo("h-6 w-6 text-slate-400")
                                </div>
                                @if (!FormState.IdValidated && !FormState.NiqabBypassApproved)
                                {
                                    <span class="text-sm font-medium text-slate-500">Please upload ID document first</span>
                                }
                                else
                                {
                                    <span class="text-sm font-medium text-slate-700">Click to upload photo</span>
                                    <span class="text-xs text-slate-500 block mt-1">JPEG or PNG up to 5MB</span>
                                }
                            }
                        </div>
                        <InputFile OnChange="OnPhotoFileSelected" accept=".jpg,.jpeg,.png" class="hidden" disabled="@(isSelectingPhotoFile || (!FormState.IdValidated && !FormState.NiqabBypassApproved))" />
                    </label>
                }
                else
                {
                    <div class="rounded-xl border @(FormState.PhotoValidated ? "border-emerald-300 bg-emerald-50" : isValidatingPhoto ? "border-cyan-300 bg-cyan-50" : "border-slate-300 bg-slate-50") p-4">
                        <div class="flex items-center gap-3">
                            @if (isValidatingPhoto)
                            {
                                <div class="w-10 h-10 rounded-lg bg-cyan-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.Spinner("h-5 w-5 text-cyan-600 animate-spin")
                                </div>
                            }
                            else if (FormState.PhotoValidated)
                            {
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.CheckCircle("h-5 w-5 text-emerald-600")
                                </div>
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                    @Icons.Photo("h-5 w-5 text-slate-500")
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-800 truncate">@FormState.PhotoFileName</p>
                                <p class="text-xs text-slate-500">@RegistrationFormHelpers.FormatFileSize(FormState.PhotoSize)</p>
                                @if (isValidatingPhoto)
                                {
                                    <p class="text-xs text-cyan-700 mt-1">Verifying photo...</p>
                                }
                                else if (!string.IsNullOrEmpty(photoValidationSuccess))
                                {
                                    <p class="text-xs text-emerald-700 mt-1">@photoValidationSuccess</p>
                                }
                            </div>
                            @if (!isValidatingPhoto)
                            {
                                <button type="button" @onclick="ClearPhotoFile" class="text-slate-400 hover:text-red-500 p-1 transition-colors">
                                    @Icons.XMark("h-5 w-5")
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(photoValidationError))
                {
                    <div class="mt-3 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-start gap-2">
                        @Icons.Warning("h-5 w-5 text-red-500 flex-shrink-0 mt-0.5")
                        <span>@photoValidationError</span>
                    </div>
                }
            </div>
        </div>

        <!-- Status Summary -->
        @if (FormState.IdValidated && FormState.PhotoValidated)
        {
            <div class="rounded-xl border-2 border-emerald-300 bg-gradient-to-r from-emerald-50 to-white p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                        @Icons.CheckCircle("h-6 w-6 text-emerald-600")
                    </div>
                    <div>
                        <p class="font-semibold text-emerald-800">Verification Complete</p>
                        <p class="text-sm text-emerald-700">
                            @if (FormState.NiqabBypassApproved)
                            {
                                <span>Documents accepted with niqab exception.</span>
                            }
                            else
                            {
                                <span>ID and photo verified successfully.</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<StepFooter ShowBack="true" OnNext="OnNext" OnBack="OnBack" />