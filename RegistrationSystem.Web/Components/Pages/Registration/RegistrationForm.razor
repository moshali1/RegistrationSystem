    // ═══════════════════════════════════════════════════════════════════════════
    // STEP 5: REVIEW & SUBMIT
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStep5_Review() => __builder =>
    {
        var division = GetSelectedDivision();
        var category = GetSelectedCategory();

        <div class="p-6">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-700 flex items-center justify-center shadow-lg">
                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-slate-800">Review & Submit</h2>
                    <p class="text-sm text-slate-500">Verify all information is correct</p>
                </div>
            </div>

            <div class="space-y-4">
                <!-- Personal Info Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">Personal Information</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(1)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div>
                                <span class="text-slate-500">Full Name:</span>
                                <span class="font-medium text-slate-800 ml-1">@GetFormattedFullName()</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(formData.PreferredName))
                            {
                                <div>
                                    <span class="text-slate-500">Preferred Name:</span>
                                    <span class="font-medium text-slate-800 ml-1">@formData.PreferredName</span>
                                </div>
                            }
                            <div>
                                <span class="text-slate-500">Gender:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.Gender</span>
                            </div>
                            <div>
                                <span class="text-slate-500">Date of Birth:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.DateOfBirth.ToString("MMMM d, yyyy")</span>
                            </div>
                            @if (settings != null)
                            {
                                <div>
                                    <span class="text-slate-500">Age (as of @settings.AgeCutoffDate.ToString("MMM d, yyyy")):</span>
                                    <span class="font-medium text-slate-800 ml-1">@CalculateAge() years</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(formData.CompetitorPhone))
                            {
                                <div>
                                    <span class="text-slate-500">Phone:</span>
                                    <span class="font-medium text-slate-800 ml-1">@formData.CompetitorPhone</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ID & Photo Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">ID & Photo Verification</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(2)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div class="flex items-center gap-2">
                                <span class="text-slate-500">ID Document:</span>
                                @if (formData.IdValidated)
                                {
                                    <span class="inline-flex items-center gap-1 text-emerald-700">
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="text-amber-600">Not uploaded</span>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-slate-500">Photo:</span>
                                @if (formData.PhotoValidated)
                                {
                                    <span class="inline-flex items-center gap-1 text-emerald-700">
                                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                        </svg>
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="text-amber-600">Not uploaded</span>
                                }
                            </div>
                            @if (formData.NiqabBypassApproved)
                            {
                                <div class="sm:col-span-2">
                                    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-full text-xs font-medium bg-violet-100 text-violet-700">
                                        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                        Niqab exception approved
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Competition Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">Competition Selection</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(3)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div>
                                <span class="text-slate-500">Division:</span>
                                <span class="font-medium text-slate-800 ml-1">@(division?.Name ?? "—")</span>
                            </div>
                            <div>
                                <span class="text-slate-500">Category:</span>
                                <span class="font-medium text-slate-800 ml-1">@(category?.Name ?? "—")</span>
                            </div>
                            @if (category?.MaxAgeYears.HasValue == true)
                            {
                                <div>
                                    <span class="text-slate-500">Max Age:</span>
                                    <span class="font-medium text-slate-800 ml-1">@category.MaxAgeYears years</span>
                                </div>
                            }
                            @if (formData.PortionChoice.HasValue)
                            {
                                <div>
                                    <span class="text-slate-500">Portion:</span>
                                    <span class="font-medium text-slate-800 ml-1">@formData.PortionChoice Half</span>
                                </div>
                            }
                            @if (category?.RequiresVideo == true)
                            {
                                <div class="sm:col-span-2 flex items-center gap-2">
                                    <span class="text-slate-500">Video:</span>
                                    @if (formData.VideoUploaded && !string.IsNullOrEmpty(formData.VideoFileName))
                                    {
                                        <span class="inline-flex items-center gap-1.5 text-emerald-700">
                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                            Uploaded (@FormatFileSize(formData.VideoSize))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-red-100 text-red-700 text-xs font-medium">
                                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                            </svg>
                                            Required - Not uploaded
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Address Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">Address</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(4)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div>
                                <span class="text-slate-500">City:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.City</span>
                            </div>
                            <div>
                                <span class="text-slate-500">@(selectedCountry?.StateLabel ?? "State/Province"):</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.StateProvince</span>
                            </div>
                            <div>
                                <span class="text-slate-500">Country:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.Country</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Parent/Guardian Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">Parent/Guardian</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(4)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div>
                                <span class="text-slate-500">Name:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.ParentFirstName @formData.ParentLastName</span>
                            </div>
                            <div>
                                <span class="text-slate-500">Phone:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.ParentPhone</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Teacher/Institution Card -->
                <div class="rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-700">Teacher/Institution</span>
                        <button type="button" class="cursor-pointer text-xs text-cyan-700 hover:text-cyan-800 font-medium" @onclick="() => GoToStep(4)">Edit</button>
                    </div>
                    <div class="p-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
                            <div>
                                <span class="text-slate-500">Name:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.TeacherFirstName @formData.TeacherLastName</span>
                            </div>
                            <div>
                                <span class="text-slate-500">Phone:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.TeacherPhone</span>
                            </div>
                            <div class="sm:col-span-2">
                                <span class="text-slate-500">Institution:</span>
                                <span class="font-medium text-slate-800 ml-1">@formData.TeacherInstitution</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms Card -->
                <div class="rounded-xl border-2 @(formData.TermsAccepted ? "border-emerald-300 bg-emerald-50" : "border-cyan-200 bg-cyan-50") p-4 transition-colors">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox"
                               @bind="formData.TermsAccepted"
                               class="mt-0.5 h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
                        <div>
                            <span class="text-sm text-slate-800 font-medium">I confirm all information is accurate</span>
                            <p class="text-xs text-slate-600 mt-1">
                                By submitting, I agree to the <a href="@(settings?.CompetitionInfo?.RulesUrl ?? "#")" target="_blank" class="text-cyan-700 hover:underline">competition rules</a> and <a href="@(settings?.CompetitionInfo?.TermsOfServiceUrl ?? "#")" target="_blank" class="text-cyan-700 hover:underline">terms of service</a>.
                            </p>
                        </div>
                    </label>
                </div>
            </div>
        </div>

        <!-- Submit Footer -->
        <div class="px-6 py-4 border-t border-slate-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between gap-3">
            <button type="button"
                    class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-all shadow-sm flex items-center gap-2"
                    @onclick="PreviousStep"
                    disabled="@isSubmitting">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Back
            </button>
            <button type="button"
                    class="cursor-pointer rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 text-white px-6 py-2.5 text-sm font-semibold hover:from-emerald-700 hover:to-emerald-800 disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98] transition-all shadow-lg flex items-center gap-2"
                    @onclick="SubmitRegistration"
                    disabled="@(isSubmitting || !formData.TermsAccepted)">
                @if (isSubmitting)
                {
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                    </svg>
                    <span>Submitting...</span>
                }
                else
                {
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Submit Registration</span>
                }
            </button>
        </div>
    };

    // ═══════════════════════════════════════════════════════════════════════════
    // STEP FOOTER (Shared)
    // ═══════════════════════════════════════════════════════════════════════════

    private RenderFragment RenderStepFooter(bool showBack) => __builder =>
    {
        <div class="px-6 py-4 border-t border-slate-200 bg-gradient-to-r from-slate-50 to-white flex items-center justify-between gap-3">
            @if (showBack)
            {
                <button type="button"
                        class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-400 transition-all shadow-sm flex items-center gap-2"
                        @onclick="PreviousStep">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                    </svg>
                    Back
                </button>
            }
            else
            {
                <div></div>
            }
            <button type="button"
                    class="cursor-pointer rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-6 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 active:scale-[0.98] transition-all shadow-lg flex items-center gap-2"
                    @onclick="NextStep">
                <span>Continue</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
            </button>
        </div>
    };
}
