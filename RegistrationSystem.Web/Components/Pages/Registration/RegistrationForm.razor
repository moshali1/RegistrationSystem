@page "/register/new"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Azure
@using RegistrationSystem.Core.Application.NiqabBypasses
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject FileValidationService FileValidationService
@inject BlobStorageService BlobStorageService
@inject NiqabBypassService NiqabBypassService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider

<PageTitle>New Registration</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center py-16">
        <div class="flex flex-col items-center gap-3">
            <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
            <span class="text-sm text-slate-500">Loading...</span>
        </div>
    </div>
}
else if (settings?.RegistrationEnabled != true)
{
    <div class="max-w-lg mx-auto">
        <div class="rounded-xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-8 text-center shadow-sm">
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center mx-auto mb-4 shadow">
                <svg class="h-7 w-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <h2 class="text-lg font-semibold text-slate-800 mb-2">Registration Closed</h2>
            <p class="text-sm text-slate-600 mb-6">Registration is not currently open. Please check back later.</p>
            <a href="/registrations" class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-slate-600 to-slate-700 text-white px-5 py-2.5 text-sm font-medium hover:from-slate-700 hover:to-slate-800 transition-all shadow-sm">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                Back to Registrations
            </a>
        </div>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-6">
            <a href="/registrations" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition-colors">
                <svg class="h-5 w-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
            </a>
            <div>
                <h1 class="text-xl font-bold text-slate-800">New Registration</h1>
                <p class="text-sm text-slate-500">@settings?.CompetitionInfo?.CompetitionName — @competitionYear</p>
            </div>
        </div>

        <!-- Main Layout: Form + Side Panel -->
        <div class="flex gap-6">
            <!-- Form Area (3/4 width) -->
            <div class="flex-1 min-w-0">
                <!-- Progress Bar -->
                <div class="rounded-xl border border-slate-200 bg-gradient-to-r from-slate-700 to-slate-800 shadow-lg mb-4 overflow-hidden">
                    <div class="px-5 py-4">
                        <div class="flex items-center gap-1">
                            @for (var i = 1; i <= totalSteps; i++)
                            {
                                var step = i;
                                var isActive = currentStep == step;
                                var isCompleted = currentStep > step;

                                <div class="flex-1 flex items-center gap-1">
                                    <button type="button"
                                            class="cursor-pointer w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-all @(isActive ? "bg-cyan-500 text-white ring-2 ring-cyan-400 ring-offset-2 ring-offset-slate-700" : isCompleted ? "bg-cyan-600 text-white" : "bg-slate-600 text-slate-400")"
                                            @onclick="() => GoToStep(step)"
                                            disabled="@(!isCompleted && !isActive)">
                                        @if (isCompleted)
                                        {
                                            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                            </svg>
                                        }
                                        else
                                        {
                                            @step
                                        }
                                    </button>
                                    @if (step < totalSteps)
                                    {
                                        <div class="flex-1 h-1 rounded-full @(isCompleted ? "bg-cyan-600" : "bg-slate-600")"></div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="mt-2 flex text-xs">
                            <span class="flex-1 text-center @(currentStep == 1 ? "text-cyan-400 font-medium" : "text-slate-400")">Personal</span>
                            <span class="flex-1 text-center @(currentStep == 2 ? "text-cyan-400 font-medium" : "text-slate-400")">ID & Photo</span>
                            <span class="flex-1 text-center @(currentStep == 3 ? "text-cyan-400 font-medium" : "text-slate-400")">Competition</span>
                            <span class="flex-1 text-center @(currentStep == 4 ? "text-cyan-400 font-medium" : "text-slate-400")">Contact</span>
                            <span class="flex-1 text-center @(currentStep == 5 ? "text-cyan-400 font-medium" : "text-slate-400")">Review</span>
                        </div>
                    </div>
                </div>

                <!-- Error Message -->
                @if (validationErrors.Any())
                {
                    <div class="mb-4 rounded-xl border border-red-200 bg-gradient-to-r from-red-50 to-white px-4 py-3 shadow-sm">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0">
                                <svg class="h-4 w-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="text-sm">
                                <p class="font-medium text-red-800">Please fix the following:</p>
                                <ul class="mt-1.5 space-y-1 text-red-700">
                                    @foreach (var error in validationErrors)
                                    {
                                        <li class="flex items-start gap-1.5">
                                            <span class="text-red-400 mt-1">•</span>
                                            @error
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <!-- Form Card -->
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    @switch (currentStep)
                    {
                        case 1:
                            @RenderStep1()
                            break;
                        case 2:
                            @RenderStep2_FileUpload()
                            break;
                        case 3:
                            @RenderStep3_Competition()
                            break;
                        case 4:
                            @RenderStep4_Contact()
                            break;
                        case 5:
                            @RenderStep5_Review()
                            break;
                    }
                </div>
            </div>

            <!-- Side Panel (1/4 width) - Desktop only -->
            <div class="hidden lg:block w-80 flex-shrink-0">
                <div class="sticky top-6">
                    @RenderInfoPanel()
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isSubmitting;
    private int currentStep = 1;
    private const int totalSteps = 5;

    private CompetitionSettings? settings;
    private int competitionYear;
    private string currentUserId = string.Empty;
    private string currentUserType = string.Empty;
    private List<string> validationErrors = new();

    // Form data (in-memory only until submit)
    private RegistrationFormData formData = new();

    // Cached division/category lists
    private IReadOnlyList<Division> availableDivisions = Array.Empty<Division>();
    private IReadOnlyList<Category> availableCategories = Array.Empty<Category>();

    // Location selection
    private Country? selectedCountry;
    private IReadOnlyList<StateProvince> availableStates = Array.Empty<StateProvince>();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null)
            {
                NavigationManager.NavigateTo("/registrations");
                return;
            }

            currentUserId = user.ObjectIdentifier;
            currentUserType = user.UserType;
            settings = await SettingsService.GetSettingsAsync();
            competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

            // Load available divisions
            availableDivisions = await RegistrationService.GetAvailableDivisionsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCategoriesAsync()
    {
        if (string.IsNullOrEmpty(formData.DivisionId))
        {
            availableCategories = Array.Empty<Category>();
            return;
        }

        availableCategories = await RegistrationService.GetAvailableCategoriesAsync(
            formData.DivisionId,
            formData.DateOfBirth != default ? formData.DateOfBirth : null);
    }

    private void GoToStep(int step)
    {
        if (step >= 1 && step <= totalSteps)
        {
            validationErrors.Clear();
            currentStep = step;
        }
    }

    private async Task NextStep()
    {
        validationErrors.Clear();

        if (!ValidateCurrentStep())
            return;

        // Check for niqab bypass when moving from step 1 to step 2
        if (currentStep == 1)
        {
            await CheckNiqabBypass();
        }

        // Format data before showing review page (step 4 → step 5)
        if (currentStep == 4)
        {
            FormatFormData();
        }

        if (currentStep < totalSteps)
        {
            currentStep++;
        }
    }

    private void FormatFormData()
    {
        // Format names - capitalize first letter of each word, trim
        formData.FirstName = FormatName(formData.FirstName);
        formData.MiddleName = FormatName(formData.MiddleName);
        formData.LastName = FormatName(formData.LastName);
        formData.PreferredName = FormatName(formData.PreferredName);

        formData.ParentFirstName = FormatName(formData.ParentFirstName);
        formData.ParentLastName = FormatName(formData.ParentLastName);

        formData.TeacherFirstName = FormatName(formData.TeacherFirstName);
        formData.TeacherLastName = FormatName(formData.TeacherLastName);
        formData.TeacherInstitution = formData.TeacherInstitution?.Trim();

        // Format city
        formData.City = FormatName(formData.City);

        // Format phone numbers
        formData.CompetitorPhone = FormatPhoneNumber(formData.CompetitorPhone);
        formData.ParentPhone = FormatPhoneNumber(formData.ParentPhone);
        formData.TeacherPhone = FormatPhoneNumber(formData.TeacherPhone);
    }

    private static string FormatName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return string.Empty;

        name = name.Trim();

        // Handle hyphenated names and multiple words
        var words = name.Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        var formatted = words.Select(w =>
            char.ToUpperInvariant(w[0]) + (w.Length > 1 ? w[1..].ToLowerInvariant() : ""));

        // Preserve original separators
        var result = name;
        var index = 0;
        foreach (var word in formatted)
        {
            var originalWord = words[index];
            result = result.Replace(originalWord, word);
            index++;
        }

        return string.Join(" ", formatted);
    }

    private static string FormatPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        // Remove all non-digits
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        // Remove leading 1 if 11 digits
        if (digits.Length == 11 && digits.StartsWith("1"))
            digits = digits[1..];

        // Format as (XXX) XXX-XXXX
        if (digits.Length == 10)
            return $"({digits[..3]}) {digits[3..6]}-{digits[6..]}";

        return phone.Trim();
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            validationErrors.Clear();
            currentStep--;
        }
    }

    private bool ValidateCurrentStep()
    {
        validationErrors.Clear();

        switch (currentStep)
        {
            case 1: // Personal Info
                ValidateName(formData.FirstName, "First name", minLength: 2, required: true);
                ValidateName(formData.MiddleName, "Middle name", minLength: 1, required: false);
                ValidateName(formData.LastName, "Last name", minLength: 2, required: true);
                ValidateName(formData.PreferredName, "Preferred name", minLength: 1, required: false);

                if (formData.DateOfBirth == default)
                    validationErrors.Add("Date of birth is required.");
                if (!string.IsNullOrWhiteSpace(formData.CompetitorPhone) && !RegistrationService.IsValidPhoneNumber(formData.CompetitorPhone))
                    validationErrors.Add("Please enter a valid 10-digit phone number.");
                break;

            case 2: // ID & Photo Upload
                if (!formData.IdValidated)
                    validationErrors.Add("Please upload and validate your ID document.");
                if (!formData.PhotoValidated)
                    validationErrors.Add("Please upload and validate your photo.");
                break;

            case 3: // Competition Selection
                if (string.IsNullOrWhiteSpace(formData.DivisionId))
                    validationErrors.Add("Please select a division.");
                if (string.IsNullOrWhiteSpace(formData.CategoryId))
                    validationErrors.Add("Please select a category.");

                // Check portion choice if needed
                var category = GetSelectedCategory();
                if (category?.PortionOption == PortionOption.TopOrBottom && formData.PortionChoice == null)
                    validationErrors.Add("Please select a portion (Top or Bottom).");

                // Check video upload if required
                if (category?.RequiresVideo == true)
                {
                    if (isUploadingVideo)
                        validationErrors.Add("Please wait for the video upload to complete.");
                    else if (!formData.VideoUploaded)
                        validationErrors.Add("Please upload a video for this category.");
                }
                break;

            case 4: // Contact Information
                if (string.IsNullOrWhiteSpace(formData.Country))
                    validationErrors.Add("Country is required.");
                if (string.IsNullOrWhiteSpace(formData.StateProvince))
                    validationErrors.Add("State/Province is required.");
                if (string.IsNullOrWhiteSpace(formData.City))
                    validationErrors.Add("City is required.");

                // Parent validation
                ValidateName(formData.ParentFirstName, "Parent/Guardian first name", minLength: 2, required: true);
                ValidateName(formData.ParentLastName, "Parent/Guardian last name", minLength: 2, required: true);
                if (string.IsNullOrWhiteSpace(formData.ParentPhone))
                    validationErrors.Add("Parent/Guardian phone number is required.");
                else if (!RegistrationService.IsValidPhoneNumber(formData.ParentPhone))
                    validationErrors.Add("Please enter a valid 10-digit phone number for Parent/Guardian.");

                // Teacher validation
                ValidateName(formData.TeacherFirstName, "Teacher first name", minLength: 2, required: true);
                ValidateName(formData.TeacherLastName, "Teacher last name", minLength: 2, required: true);
                if (string.IsNullOrWhiteSpace(formData.TeacherPhone))
                    validationErrors.Add("Teacher phone number is required.");
                else if (!RegistrationService.IsValidPhoneNumber(formData.TeacherPhone))
                    validationErrors.Add("Please enter a valid 10-digit phone number for Teacher.");

                if (string.IsNullOrWhiteSpace(formData.TeacherInstitution))
                    validationErrors.Add("Institution name is required.");
                else if (formData.TeacherInstitution.Trim().Length < 2)
                    validationErrors.Add("Institution name must be at least 2 characters.");
                break;
        }

        return validationErrors.Count == 0;
    }

    /// <summary>
    /// Validates a name field: checks required, minimum length, and no digits.
    /// </summary>
    private void ValidateName(string? value, string fieldName, int minLength, bool required)
    {
        var trimmed = value?.Trim() ?? string.Empty;

        if (required && string.IsNullOrWhiteSpace(trimmed))
        {
            validationErrors.Add($"{fieldName} is required.");
            return;
        }

        // Only validate further if there's a value
        if (!string.IsNullOrWhiteSpace(trimmed))
        {
            if (trimmed.Length < minLength)
            {
                validationErrors.Add($"{fieldName} must be at least {minLength} character{(minLength > 1 ? "s" : "")}.");
            }

            if (trimmed.Any(char.IsDigit))
            {
                validationErrors.Add($"{fieldName} cannot contain numbers.");
            }
        }
    }

    private async Task SubmitRegistration()
    {
        if (isSubmitting) return;

        validationErrors.Clear();

        if (!formData.TermsAccepted)
        {
            validationErrors.Add("You must accept the terms and conditions.");
            return;
        }

        // Verify files are validated (unless niqab bypass)
        if (!formData.NiqabBypassApproved)
        {
            if (!formData.IdValidated || !formData.HasIdDocument)
            {
                validationErrors.Add("Please upload and validate your ID document.");
                return;
            }
            if (!formData.PhotoValidated || !formData.HasPhoto)
            {
                validationErrors.Add("Please upload and validate your photo.");
                return;
            }
        }

        // Verify video is uploaded if required by category
        var selectedCategory = GetSelectedCategory();
        if (selectedCategory?.RequiresVideo == true)
        {
            if (isUploadingVideo)
            {
                validationErrors.Add("Please wait for the video upload to complete.");
                return;
            }
            if (!formData.VideoUploaded || string.IsNullOrEmpty(formData.VideoBlobUri))
            {
                validationErrors.Add("Please upload a video for this category.");
                return;
            }
        }

        // Student identity validation - students can only register for themselves
        if (currentUserType.Equals("Student", StringComparison.OrdinalIgnoreCase))
        {
            var (isValid, error) = await RegistrationService.ValidateStudentIdentityAsync(
                currentUserId,
                formData.FirstName,
                formData.LastName,
                formData.DateOfBirth);

            if (!isValid)
            {
                validationErrors.Add(error!);
                return;
            }
        }

        isSubmitting = true;
        try
        {
            // Get division name for file naming
            var division = GetSelectedDivision();
            var divisionName = division?.Name ?? "Unknown";

            FileUploadInfo? fileUploadInfo = null;

            // Upload files to Azure Blob Storage
            if (formData.HasIdDocument && formData.HasPhoto)
            {
                var idContainerName = BlobStorageService.GenerateContainerName(
                    competitionYear, divisionName, FileType.Id);
                var photoContainerName = BlobStorageService.GenerateContainerName(
                    competitionYear, divisionName, FileType.Photo);

                var idBlobName = BlobStorageService.GenerateBlobName(
                    FileType.Id,
                    divisionName,
                    formData.FirstName,
                    formData.LastName,
                    formData.DateOfBirth,
                    Path.GetExtension(formData.IdDocumentFileName ?? ".jpg"));

                var photoBlobName = BlobStorageService.GenerateBlobName(
                    FileType.Photo,
                    divisionName,
                    formData.FirstName,
                    formData.LastName,
                    formData.DateOfBirth,
                    Path.GetExtension(formData.PhotoFileName ?? ".jpg"));

                // Upload ID
                using var idStream = new MemoryStream(formData.IdDocumentBytes!);
                await BlobStorageService.UploadAsync(
                    idStream, idContainerName, idBlobName, formData.IdDocumentContentType ?? "image/jpeg");

                // Upload Photo
                using var photoStream = new MemoryStream(formData.PhotoBytes!);
                await BlobStorageService.UploadAsync(
                    photoStream, photoContainerName, photoBlobName, formData.PhotoContentType ?? "image/jpeg");

                fileUploadInfo = new FileUploadInfo
                {
                    IdDocument = new FileMetadata
                    {
                        FileName = formData.IdDocumentFileName ?? "id-document",
                        StorageReference = idBlobName,
                        FileSizeBytes = formData.IdDocumentSize,
                        Extension = Path.GetExtension(formData.IdDocumentFileName ?? ".jpg"),
                        ContentType = formData.IdDocumentContentType ?? "image/jpeg",
                        UploadedAt = DateTimeOffset.UtcNow,
                        ValidationResult = FileValidationService.CreateFileValidationResult(
                            true,
                            formData.NiqabBypassApproved ? "NiqabBypass" : "OcrValidation",
                            formData.NiqabBypassApproved
                                ? "ID document accepted (niqab bypass)"
                                : "ID document validated")
                    },
                    Photo = new FileMetadata
                    {
                        FileName = formData.PhotoFileName ?? "photo",
                        StorageReference = photoBlobName,
                        FileSizeBytes = formData.PhotoSize,
                        Extension = Path.GetExtension(formData.PhotoFileName ?? ".jpg"),
                        ContentType = formData.PhotoContentType ?? "image/jpeg",
                        UploadedAt = DateTimeOffset.UtcNow,
                        ValidationResult = FileValidationService.CreateFileValidationResult(
                            true,
                            formData.NiqabBypassApproved ? "NiqabBypass" : "PersonDetected",
                            formData.NiqabBypassApproved
                                ? "Photo accepted (niqab bypass)"
                                : "Photo validated - person detected")
                    },
                    // Include video if uploaded (already in Azure from Step 3)
                    Video = formData.VideoUploaded && !string.IsNullOrEmpty(formData.VideoBlobName)
                        ? new FileMetadata
                        {
                            FileName = formData.VideoFileName ?? "video",
                            StorageReference = formData.VideoBlobName,
                            FileSizeBytes = formData.VideoSize,
                            Extension = Path.GetExtension(formData.VideoFileName ?? ".mp4"),
                            ContentType = formData.VideoContentType ?? "video/mp4",
                            UploadedAt = DateTimeOffset.UtcNow,
                            ValidationResult = FileValidationService.CreateFileValidationResult(
                                true,
                                "ExtensionValidation",
                                $"Video uploaded ({FormatFileSize(formData.VideoSize)})")
                        }
                        : null,
                    NiqabBypassApproved = formData.NiqabBypassApproved,
                    NiqabBypassCode = formData.NiqabBypassCode
                };
            }

            // Create the registration entity from form data
            var registration = new Registration
            {
                CreatorUserId = currentUserId,
                CompetitionYear = competitionYear,
                Status = RegistrationStatus.AwaitingReview,
                SubmittedAt = DateTimeOffset.UtcNow,
                TermsAccepted = true,
                TermsAcceptedAt = DateTimeOffset.UtcNow,
                PersonalInfo = new PersonalInfo
                {
                    FirstName = formData.FirstName,
                    MiddleName = formData.MiddleName,
                    LastName = formData.LastName,
                    PreferredName = formData.PreferredName,
                    Gender = formData.Gender,
                    DateOfBirth = formData.DateOfBirth,
                    PhoneNumber = formData.CompetitorPhone
                },
                AddressInfo = new AddressInfo
                {
                    Country = formData.Country,
                    StateProvince = formData.StateProvince,
                    City = formData.City
                },
                CompetitionSelection = new CompetitionSelection
                {
                    DivisionId = formData.DivisionId,
                    CategoryId = formData.CategoryId,
                    PortionChoice = formData.PortionChoice
                },
                ParentInfo = new ParentInfo
                {
                    FirstName = formData.ParentFirstName,
                    LastName = formData.ParentLastName,
                    PhoneNumber = formData.ParentPhone
                },
                TeacherInfo = new TeacherInfo
                {
                    FirstName = formData.TeacherFirstName,
                    LastName = formData.TeacherLastName,
                    PhoneNumber = formData.TeacherPhone,
                    Institution = formData.TeacherInstitution
                },
                FileUploadInfo = fileUploadInfo
            };

            // Submit directly (creates and validates in one step)
            var result = await RegistrationService.CreateAndSubmitAsync(registration);

            if (result.IsValid)
            {
                // Log the submission to audit trail
                try
                {
                    await AuditContextProvider.SetCurrentUserContextAsync();
                    var categoryName = selectedCategory?.Name ?? "Unknown Category";

                    await AuditService.LogAsync(
                        AuditAction.Submitted,
                        "Registration",
                        registration.Id, // ID is set by repository after save
                        summary: "New registration submitted",
                        entityDescription: $"{formData.FirstName} {formData.LastName} - {divisionName} / {categoryName}");
                }
                catch
                {
                    // Don't fail the submission if audit logging fails
                }

                NavigationManager.NavigateTo("/registrations");
            }
            else
            {
                validationErrors.AddRange(result.Errors);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private Division? GetSelectedDivision()
    {
        if (string.IsNullOrEmpty(formData.DivisionId))
            return null;
        return availableDivisions.FirstOrDefault(d => d.Id == formData.DivisionId)
            ?? settings?.FindDivision(formData.DivisionId);
    }

    private Category? GetSelectedCategory()
    {
        var division = GetSelectedDivision();
        if (division == null || string.IsNullOrEmpty(formData.CategoryId))
            return null;
        return division.FindCategory(formData.CategoryId);
    }

    private async Task OnDivisionChanged(ChangeEventArgs e)
    {
        formData.DivisionId = e.Value?.ToString() ?? string.Empty;
        formData.CategoryId = string.Empty;
        formData.PortionChoice = null;

        // Clear video when division changes (category will change)
        ClearVideoFile();

        await LoadCategoriesAsync();
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        formData.CategoryId = e.Value?.ToString() ?? string.Empty;
        formData.PortionChoice = null;

        // Clear video when category changes (requirement may change)
        ClearVideoFile();
    }

    private void OnCountryChanged(ChangeEventArgs e)
    {
        var countryName = e.Value?.ToString();
        formData.Country = countryName ?? string.Empty;
        formData.StateProvince = string.Empty;

        selectedCountry = !string.IsNullOrEmpty(countryName)
            ? LocationData.GetCountryByName(countryName)
            : null;

        availableStates = selectedCountry?.StatesProvinces ?? Array.Empty<StateProvince>();
    }

    private void OnStateChanged(ChangeEventArgs e)
    {
        formData.StateProvince = e.Value?.ToString() ?? string.Empty;
    }

    private void OnDateOfBirthChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var date))
        {
            formData.DateOfBirth = date;
            // Refresh categories when DOB changes (age eligibility)
            _ = LoadCategoriesAsync();
        }
    }

    private int CalculateAge()
    {
        if (formData.DateOfBirth == default || settings == null) return 0;

        var cutoff = settings.AgeCutoffDate;
        var age = cutoff.Year - formData.DateOfBirth.Year;
        if (cutoff < formData.DateOfBirth.AddYears(age))
            age--;
        return age;
    }

