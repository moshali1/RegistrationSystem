                                @foreach (var category in availableCategories)
                                {
                                    var ageText = category.MaxAgeYears.HasValue ? $" (Max: {category.MaxAgeYears} yrs)" : "";
                                    <option value="@category.Id" selected="@(formData.CategoryId == category.Id)">
                                        @category.Name@ageText
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                                <span class="font-medium">No eligible categories.</span> Based on the competitor's age, there are no categories available in this division.
                            </div>
                        }
                    </div>
                }

                <!-- Category Details Card -->
                @if (selectedCategory != null)
                {
                    <div class="rounded-xl border border-cyan-200 bg-gradient-to-br from-cyan-50 to-white p-5 shadow-sm">
                        <h3 class="text-sm font-semibold text-slate-800 mb-4 flex items-center gap-2">
                            <svg class="h-4 w-4 text-cyan-600" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            Category Details
                        </h3>
                        <div class="grid grid-cols-2 gap-4">
                            @if (selectedCategory.MaxAgeYears.HasValue)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                                    <span class="text-sm text-slate-600">Max Age: <span class="font-medium text-slate-800">@selectedCategory.MaxAgeYears years</span></span>
                                </div>
                            }
                            @if (selectedCategory.PortionOption != PortionOption.NotApplicable)
                            {
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                                    <span class="text-sm text-slate-600">Portion: <span class="font-medium text-slate-800">@GetPortionLabel(selectedCategory.PortionOption)</span></span>
                                </div>
                            }
                            @if (selectedCategory.RequiresVideo)
                            {
                                <div class="col-span-2 flex items-center gap-2 text-cyan-700 bg-cyan-50 rounded-lg px-3 py-2">
                                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                    <span class="text-sm font-medium">Video upload required</span>
                                </div>
                            }
                        </div>

                        <!-- Age Eligibility Check -->
                        @if (formData.DateOfBirth != default && selectedCategory.MaxAgeYears.HasValue && settings != null)
                        {
                            var age = CalculateAge();
                            var isEligible = age <= selectedCategory.MaxAgeYears.Value;

                            <div class="mt-4 rounded-lg @(isEligible ? "bg-emerald-100 border-emerald-200" : "bg-red-100 border-red-200") border px-4 py-3">
                                <div class="flex items-center gap-2">
                                    @if (isEligible)
                                    {
                                        <svg class="h-5 w-5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm font-medium text-emerald-800">Age eligible: @age years (max: @selectedCategory.MaxAgeYears)</span>
                                    }
                                    else
                                    {
                                        <svg class="h-5 w-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm font-medium text-red-800">Not eligible: @age years exceeds max of @selectedCategory.MaxAgeYears</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Portion Choice -->
                    @if (selectedCategory.PortionOption == PortionOption.TopOrBottom)
                    {
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-slate-700">Portion Choice <span class="text-red-500">*</span></label>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="relative cursor-pointer">
                                    <input type="radio" name="portion" class="peer sr-only"
                                           checked="@(formData.PortionChoice == PortionChoice.Top)"
                                           @onchange="@(() => formData.PortionChoice = PortionChoice.Top)" />
                                    <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                                        Top Half
                                    </div>
                                </label>
                                <label class="relative cursor-pointer">
                                    <input type="radio" name="portion" class="peer sr-only"
                                           checked="@(formData.PortionChoice == PortionChoice.Bottom)"
                                           @onchange="@(() => formData.PortionChoice = PortionChoice.Bottom)" />
                                    <div class="rounded-xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-sm font-medium text-slate-600 transition-all peer-checked:border-cyan-500 peer-checked:bg-cyan-50 peer-checked:text-cyan-700 hover:border-slate-300">
                                        Bottom Half
                                    </div>
                                </label>
                            </div>
                        </div>
                    }

                    <!-- Video Upload Section -->
                    @if (selectedCategory.RequiresVideo)
                    {
                        <div class="mt-6 rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-5">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center shadow">
                                    <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-sm font-semibold text-slate-800">Video Upload Required</h3>
                                    <p class="text-xs text-slate-500">This category requires a recitation video</p>
                                </div>
                            </div>

                            <!-- Video Instructions -->
                            @if (!string.IsNullOrWhiteSpace(selectedCategory.VideoInstructions))
                            {
                                <div class="rounded-lg bg-white border border-slate-200 p-4 mb-4">
                                    <div class="flex items-start gap-2">
                                        <svg class="h-5 w-5 text-cyan-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                                        </svg>
                                        <div>
                                            <p class="text-sm font-medium text-slate-700 mb-1">Instructions</p>
                                            <p class="text-sm text-slate-600">@selectedCategory.VideoInstructions</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- File Upload Area -->
                            @if (!formData.VideoUploaded && !isUploadingVideo)
                            {
                                <div class="space-y-3">
                                    <label class="block">
                                        <div class="rounded-xl border-2 border-dashed border-slate-300 bg-white p-6 text-center cursor-pointer hover:border-cyan-400 hover:bg-cyan-50/50 transition-all">
                                            <InputFile OnChange="OnVideoFileSelected"
                                                       accept="@FileValidationService.AllowedVideoExtensionsString"
                                                       class="hidden" />
                                            <svg class="h-10 w-10 text-slate-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                            </svg>
                                            <p class="text-sm font-medium text-slate-700">Click to upload video</p>
                                            <p class="text-xs text-slate-500 mt-1">MP4, MOV, WebM, AVI, MKV up to 500 MB</p>
                                        </div>
                                    </label>
                                </div>
                            }

                            <!-- Upload Progress -->
                            @if (isUploadingVideo)
                            {
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between text-sm">
                                        <span class="text-slate-600 truncate max-w-[200px]">@formData.VideoFileName</span>
                                        <span class="text-cyan-600 font-medium">@videoUploadProgress%</span>
                                    </div>
                                    <div class="h-3 bg-slate-200 rounded-full overflow-hidden">
                                        <div class="h-full bg-gradient-to-r from-cyan-500 to-cyan-600 transition-all duration-300 ease-out"
                                             style="width: @(videoUploadProgress)%"></div>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <p class="text-xs text-slate-500">Uploading @FormatFileSize(formData.VideoSize)...</p>
                                        <button type="button" @onclick="CancelVideoUpload"
                                                class="text-xs text-red-600 hover:text-red-700 font-medium">
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Upload Complete -->
                            @if (formData.VideoUploaded && !isUploadingVideo)
                            {
                                <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                                    <div class="flex items-start gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center flex-shrink-0">
                                            <svg class="h-6 w-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-semibold text-emerald-800">Video Uploaded</p>
                                            <p class="text-sm text-emerald-700 truncate">@formData.VideoFileName</p>
                                            <p class="text-xs text-emerald-600 mt-1">@FormatFileSize(formData.VideoSize)</p>
                                        </div>
                                        <button type="button" @onclick="() => ClearVideoFile()"
                                                class="text-slate-400 hover:text-red-500 transition-colors p-1"
                                                title="Remove video">
                                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Validation Error -->
                            @if (!string.IsNullOrEmpty(videoValidationError))
                            {
                                <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mt-3">
                                    <div class="flex items-center gap-2 text-red-700">
                                        <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm">@videoValidationError</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @RenderStepFooter(showBack: true)
    };

    private static string GetPortionLabel(PortionOption option) => option switch
    {
        PortionOption.TopOnly => "Top Half Only",
        PortionOption.BottomOnly => "Bottom Half Only",
        PortionOption.TopOrBottom => "Choose Top or Bottom",
        _ => "Not Applicable"
    };

