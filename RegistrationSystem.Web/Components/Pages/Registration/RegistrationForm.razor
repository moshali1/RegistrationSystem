    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetFormattedFullName()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(formData.FirstName))
            parts.Add(formData.FirstName.Trim());

        if (!string.IsNullOrWhiteSpace(formData.MiddleName))
            parts.Add(formData.MiddleName.Trim());

        if (!string.IsNullOrWhiteSpace(formData.LastName))
            parts.Add(formData.LastName.Trim());

        return string.Join(" ", parts);
    }

