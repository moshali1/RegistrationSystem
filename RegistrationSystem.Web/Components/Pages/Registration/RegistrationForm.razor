                    </div>
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-slate-700">Date of Birth <span class="text-red-500">*</span></label>
                        <input type="date"
                               value="@(formData.DateOfBirth == default ? "" : formData.DateOfBirth.ToString("yyyy-MM-dd"))"
