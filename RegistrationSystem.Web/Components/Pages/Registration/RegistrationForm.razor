    // File upload state
    private bool isValidatingId = false;
    private bool isValidatingPhoto = false;
    private string? idValidationError;
    private string? photoValidationError;
    private string? idValidationSuccess;
    private string? photoValidationSuccess;

    // Video upload state
    private bool isUploadingVideo = false;
    private string? videoValidationError;
    private string? videoUploadSuccess;
    private int videoUploadProgress = 0; // 0-100 percent
    private CancellationTokenSource? videoUploadCts;

    // ═══════════════════════════════════════════════════════════════════════════
    // FILE UPLOAD METHODS
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task OnIdFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Reset state
        idValidationError = null;
        idValidationSuccess = null;
        formData.IdValidated = false;
        formData.IdDocumentBytes = null;
        formData.IdDocumentFileName = file.Name;
        formData.IdDocumentContentType = file.ContentType;
        formData.IdDocumentSize = file.Size;

        // Read file bytes immediately (before any StateHasChanged)
        byte[] fileBytes;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            fileBytes = memoryStream.ToArray();
            formData.IdDocumentBytes = fileBytes;
        }
        catch (Exception)
        {
            idValidationError = "Error reading file. Please try again or contact administrator.";
            return;
        }

        // If niqab bypass is approved, skip validation
        if (formData.NiqabBypassApproved)
        {
            formData.IdValidated = true;
            idValidationSuccess = "ID document accepted (niqab bypass approved).";
            StateHasChanged();
            return;
        }

        isValidatingId = true;
        StateHasChanged();

        try
        {
            using var validationStream = new MemoryStream(fileBytes);
            var result = await FileValidationService.ValidateIdDocumentAsync(
                validationStream,
                file.Name,
                file.Size,
                bypassFaceDetection: formData.NiqabBypassApproved);

            if (result.IsValid)
            {
                formData.IdValidated = true;
                idValidationSuccess = result.Details ?? "ID document validated successfully.";
            }
            else
            {
                formData.IdDocumentBytes = null;
                formData.IdDocumentFileName = null;
                idValidationError = result.ErrorSummary;
            }
        }
        catch (Exception)
        {
            formData.IdDocumentBytes = null;
            formData.IdDocumentFileName = null;
            idValidationError = "Error detected. Please try again or contact administrator.";
        }
        finally
        {
            isValidatingId = false;
            StateHasChanged();
        }
    }

    private async Task OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Reset state
        photoValidationError = null;
        photoValidationSuccess = null;
        formData.PhotoValidated = false;
        formData.PhotoBytes = null;
        formData.PhotoFileName = file.Name;
        formData.PhotoContentType = file.ContentType;
        formData.PhotoSize = file.Size;

        // Need ID validated first (unless bypassed)
        if (!formData.IdValidated && !formData.NiqabBypassApproved)
        {
            photoValidationError = "Please upload and validate your ID document first.";
            formData.PhotoFileName = null;
            StateHasChanged();
            return;
        }

        // Read file bytes immediately (before any StateHasChanged)
        byte[] fileBytes;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            fileBytes = memoryStream.ToArray();
            formData.PhotoBytes = fileBytes;
        }
        catch (Exception)
        {
            photoValidationError = "Error reading file. Please try again or contact administrator.";
            return;
        }

        // If niqab bypass is approved, skip validation
        if (formData.NiqabBypassApproved)
        {
            formData.PhotoValidated = true;
            photoValidationSuccess = "Photo accepted (niqab bypass approved).";
            StateHasChanged();
            return;
        }

        isValidatingPhoto = true;
        StateHasChanged();

        try
        {
            using var validationStream = new MemoryStream(fileBytes);
            var result = await FileValidationService.ValidatePhotoAsync(
                validationStream,
                file.Name,
                file.Size,
                bypassFaceDetection: formData.NiqabBypassApproved);

            if (result.IsValid)
            {
                formData.PhotoValidated = true;
                photoValidationSuccess = result.Details ?? "Photo validated successfully.";
            }
            else
            {
                formData.PhotoBytes = null;
                formData.PhotoFileName = null;
                photoValidationError = result.ErrorSummary;
            }
        }
        catch (Exception)
        {
            formData.PhotoBytes = null;
            formData.PhotoFileName = null;
            photoValidationError = "Error detected. Please try again or contact administrator.";
        }
        finally
        {
            isValidatingPhoto = false;
            StateHasChanged();
        }
    }

    private void ClearIdFile()
    {
        formData.IdDocumentBytes = null;
        formData.IdDocumentFileName = null;
        formData.IdDocumentContentType = null;
        formData.IdDocumentSize = 0;
