    // VIDEO UPLOAD METHODS
    // ═══════════════════════════════════════════════════════════════════════════

    private async Task OnVideoFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        // Reset state
        videoValidationError = null;
        videoUploadSuccess = null;
        videoUploadProgress = 0;
        formData.VideoValidated = false;
        formData.VideoUploaded = false;
        formData.VideoFileName = file.Name;
        formData.VideoContentType = file.ContentType;
        formData.VideoSize = file.Size;
        formData.VideoBlobUri = null;
        formData.VideoBlobName = null;

        // Validate file before upload
        var validationResult = FileValidationService.ValidateVideo(file.Name, file.Size, file.ContentType);
        if (!validationResult.IsValid)
        {
            videoValidationError = validationResult.ErrorSummary;
            formData.VideoFileName = null;
            StateHasChanged();
            return;
        }

        formData.VideoValidated = true;

        // Cancel any previous upload
        videoUploadCts?.Cancel();
        videoUploadCts = new CancellationTokenSource();

        // CRITICAL: Open the stream BEFORE any StateHasChanged() call
        // IBrowserFile references become stale after StateHasChanged in Blazor Server
        Stream? stream = null;
        try
        {
            stream = file.OpenReadStream(maxAllowedSize: FileValidationService.MaxVideoSize);
        }
        catch (Exception)
        {
            videoValidationError = "Error reading file. Please try again or contact administrator.";
            formData.VideoFileName = null;
            StateHasChanged();
            return;
        }

        // NOW we can update UI
        isUploadingVideo = true;
        StateHasChanged();

        try
        {
            // Get division name for container
            var selectedDivision = availableDivisions.FirstOrDefault(d => d.Id == formData.DivisionId);
            var divisionName = selectedDivision?.Name ?? "unknown";

            // Generate container and blob names
            var containerName = BlobStorageService.GenerateContainerName(competitionYear, divisionName, FileType.Video);
            var blobName = BlobStorageService.GenerateVideoBlobName(divisionName, Path.GetExtension(file.Name));

            formData.VideoBlobName = blobName;

            // Create progress handler
            var progress = new Progress<long>(bytesUploaded =>
            {
                if (file.Size > 0)
                {
                    videoUploadProgress = (int)((bytesUploaded * 100) / file.Size);
                    InvokeAsync(StateHasChanged);
                }
            });

            // Stream upload directly to Azure
            var blobUri = await BlobStorageService.UploadWithProgressAsync(
                stream,
                file.Size,
                containerName,
                blobName,
                file.ContentType,
                progress,
                videoUploadCts.Token);

            formData.VideoBlobUri = blobUri;
            formData.VideoUploaded = true;
            videoUploadProgress = 100;
            videoUploadSuccess = $"Video uploaded successfully ({FormatFileSize(file.Size)}).";
        }
        catch (OperationCanceledException)
        {
            ClearVideoFile(clearError: false);
            videoValidationError = "Upload was cancelled.";
        }
        catch (Exception)
        {
            ClearVideoFile(clearError: false);
            videoValidationError = "Error detected. Please try again or contact administrator.";
        }
        finally
        {
            // Always dispose the stream
            if (stream != null)
            {
                await stream.DisposeAsync();
            }
            isUploadingVideo = false;
            StateHasChanged();
        }
    }

    private void CancelVideoUpload()
    {
        videoUploadCts?.Cancel();
    }

    private void ClearVideoFile(bool clearError = true)
    {
        // Cancel any in-progress upload
        videoUploadCts?.Cancel();

        formData.VideoFileName = null;
        formData.VideoContentType = null;
        formData.VideoSize = 0;
        formData.VideoBlobUri = null;
        formData.VideoBlobName = null;
        formData.VideoValidated = false;
        formData.VideoUploaded = false;
        videoUploadSuccess = null;
        videoUploadProgress = 0;

        if (clearError)
        {
            videoValidationError = null;
        }
    }

    private bool IsVideoRequiredForSelectedCategory()
    {
        if (string.IsNullOrEmpty(formData.CategoryId)) return false;

        var selectedDivision = availableDivisions.FirstOrDefault(d => d.Id == formData.DivisionId);
        var selectedCategory = selectedDivision?.FindCategory(formData.CategoryId);

        return selectedCategory?.RequiresVideo ?? false;
    }

    private string? GetVideoInstructions()
    {
        if (string.IsNullOrEmpty(formData.CategoryId)) return null;

        var selectedDivision = availableDivisions.FirstOrDefault(d => d.Id == formData.DivisionId);
        var selectedCategory = selectedDivision?.FindCategory(formData.CategoryId);

        return selectedCategory?.VideoInstructions;
    }

    private async Task CheckNiqabBypass()
    {
        // Only check for females
        if (formData.Gender != Gender.Female) return;
        if (string.IsNullOrWhiteSpace(formData.FirstName) ||
            string.IsNullOrWhiteSpace(formData.LastName) ||
            formData.DateOfBirth == default) return;

        try
        {
            var bypass = await NiqabBypassService.FindValidBypassAsync(
                formData.FirstName,
                formData.LastName,
                formData.DateOfBirth,
                competitionYear);

            if (bypass != null)
            {
                formData.NiqabBypassApproved = true;
                formData.NiqabBypassCode = bypass.Code;
            }
        }
        catch
        {
            // Silently ignore errors - bypass is optional
        }
    }

