@* MessageEditor.razor - Component for editing round messages with HTML support *@

<div class="space-y-2">
    <div class="flex items-center justify-between">
        <div>
            <label class="text-sm font-semibold text-slate-700">@Label</label>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="text-xs text-slate-500 mt-0.5">@Description</p>
            }
        </div>
        <div class="flex items-center gap-2">
            <button type="button"
                    @onclick="() => showPreview = !showPreview"
                    class="cursor-pointer text-xs text-slate-600 hover:text-cyan-700 flex items-center gap-1">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                @(showPreview ? "Hide" : "Show") Preview
            </button>
            @if (!string.IsNullOrEmpty(Value))
            {
                <button type="button"
                        @onclick="ClearMessage"
                        class="cursor-pointer text-xs text-red-600 hover:text-red-700 flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Clear
                </button>
            }
        </div>
    </div>

    <textarea @bind="Value"
              @bind:event="oninput"
              @onchange="HandleChange"
              rows="@(showPreview ? 8 : 12)"
              placeholder="Enter message here... HTML tags are supported (e.g., <strong>, <ul>, <li>)"
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 font-mono text-slate-700"></textarea>

    @if (showPreview && !string.IsNullOrEmpty(Value))
    {
        <div class="rounded-lg border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-4">
            <div class="text-xs font-semibold text-slate-600 uppercase tracking-wide mb-2">Preview</div>
            <div class="prose prose-sm max-w-none prose-slate">
                @((MarkupString)Value)
            </div>
        </div>
    }

    <!-- HTML Formatting Help -->
    @if (showHelp)
    {
        <div class="rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800">
            <div class="font-semibold mb-1">Supported HTML Tags:</div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1">
                <div><code class="bg-blue-100 px-1 rounded">&lt;strong&gt;</code> Bold text</div>
                <div><code class="bg-blue-100 px-1 rounded">&lt;em&gt;</code> Italic text</div>
                <div><code class="bg-blue-100 px-1 rounded">&lt;ul&gt;&lt;li&gt;</code> Bullet list</div>
                <div><code class="bg-blue-100 px-1 rounded">&lt;br&gt;</code> Line break</div>
                <div><code class="bg-blue-100 px-1 rounded">&lt;p&gt;</code> Paragraph</div>
                <div><code class="bg-blue-100 px-1 rounded">&lt;h4&gt;</code> Heading</div>
            </div>
        </div>
    }

    <div class="flex items-center justify-between">
        <button type="button"
                @onclick="() => showHelp = !showHelp"
                class="cursor-pointer text-xs text-slate-500 hover:text-slate-700 flex items-center gap-1">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            @(showHelp ? "Hide" : "Show") HTML Help
        </button>
        @if (!string.IsNullOrEmpty(Value))
        {
            <span class="text-xs text-slate-500">@Value.Length characters</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback OnChange { get; set; }

    private bool showPreview;
    private bool showHelp;

    private async Task HandleChange()
    {
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync();
    }

    private async Task ClearMessage()
    {
        Value = null;
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync();
    }
}
