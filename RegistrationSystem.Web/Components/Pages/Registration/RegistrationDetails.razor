@page "/registration/{Id}"
@page "/admin/registration/{Id}"

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Auditing
@using RegistrationSystem.Core.Application.Azure
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject BlobSasService BlobSasService
@inject IAuditService AuditService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Registration Details</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center py-16">
        <div class="flex flex-col items-center gap-2">
            <div class="animate-spin rounded-full h-7 w-7 border-2 border-cyan-600 border-t-transparent"></div>
            <span class="text-sm text-slate-500">Loading...</span>
        </div>
    </div>
}
else if (registration == null)
{
    <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
        <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center mx-auto mb-3">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h3 class="text-base font-semibold text-slate-800 mb-1">Registration Not Found</h3>
        <p class="text-sm text-slate-500 mb-4">This registration doesn't exist or you don't have permission to view it.</p>
        <a href="@(isAdmin ? "/admin/registrations" : "/registrations")"
           class="inline-flex items-center gap-1.5 text-sm text-cyan-600 hover:text-cyan-700 font-medium">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Registrations
        </a>
    </div>
}
else
{
    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
        <a href="@(isAdmin ? "/admin/registrations" : "/registrations")"
           class="w-9 h-9 rounded-lg bg-white border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 flex items-center justify-center transition-all">
            <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
        </a>
        <div class="flex-1">
            <div class="flex items-center gap-2">
                <h1 class="text-xl font-bold text-slate-800">@registration.PersonalInfo.FullName</h1>
                @if (!string.IsNullOrEmpty(registration.Cid))
                {
                    <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-mono">@registration.Cid</span>
                }
                <span class="@GetStatusStyles(registration.Status) px-2 py-0.5 rounded text-xs font-medium">@registration.Status</span>
            </div>
            <p class="text-sm text-slate-500">@(division?.Name ?? "Unknown") / @(category?.Name ?? "Unknown")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-4">

            <!-- Competitor Info + Photo Preview -->
            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                <div class="px-4 py-3 border-b border-slate-100 flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center">
                        <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <h2 class="text-sm font-semibold text-slate-800">Competitor Information</h2>
                </div>
                <div class="p-4">
                    <div class="flex gap-4">
                        <!-- Photo Preview -->
                        @if (!string.IsNullOrEmpty(photoDownloadUrl))
                        {
                            <div class="flex-shrink-0">
                                <button type="button" @onclick="() => OpenImageDialog(photoDownloadUrl)" class="block cursor-pointer">
                                    <img src="@photoDownloadUrl"
                                         alt="Competitor photo"
                                         class="w-20 h-24 object-cover rounded-lg border border-slate-200 hover:border-cyan-300 hover:shadow-md transition-all" />
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="w-20 h-24 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                        }

                        <!-- Info Grid -->
                        <div class="flex-1 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
                            <div>
                                <span class="text-slate-500">Name</span>
                                <p class="font-medium text-slate-800">@registration.PersonalInfo.FullName</p>
                            </div>
                            <div>
                                <span class="text-slate-500">Date of Birth</span>
                                <p class="font-medium text-slate-800">@registration.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy") (@(registration.CalculateAgeAsOf(DateOnly.FromDateTime(DateTime.Today)))y)</p>
                            </div>
                            <div>
                                <span class="text-slate-500">Gender</span>
                                <p class="font-medium text-slate-800">@registration.PersonalInfo.Gender</p>
                            </div>
                            <div>
                                <span class="text-slate-500">Location</span>
                                <p class="font-medium text-slate-800">@registration.AddressInfo.FormattedLocation</p>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PhoneNumber))
                            {
                                <div>
                                    <span class="text-slate-500">Phone</span>
                                    <p class="font-medium text-slate-800">@FormatPhone(registration.PersonalInfo.PhoneNumber)</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PreferredName))
                            {
                                <div>
                                    <span class="text-slate-500">Preferred Name</span>
                                    <p class="font-medium text-slate-800">@registration.PersonalInfo.PreferredName</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Competition + Contact (Combined Row) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Competition Details -->
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-100 flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center">
                            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h2 class="text-sm font-semibold text-slate-800">Competition</h2>
                    </div>
                    <div class="p-4 space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Year</span>
                            <span class="font-medium text-slate-800">@registration.CompetitionYear</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Division</span>
                            <span class="font-medium text-slate-800">@(division?.Name ?? "—")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Category</span>
                            <span class="font-medium text-slate-800">@(category?.Name ?? "—")</span>
                        </div>
                        @if (registration.CompetitionSelection.PortionChoice.HasValue)
                        {
                            <div class="flex justify-between">
                                <span class="text-slate-500">Portion</span>
                                <span class="font-medium text-slate-800">@registration.CompetitionSelection.PortionChoice.Value</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-100 flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-slate-500 to-slate-600 flex items-center justify-center">
                            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <h2 class="text-sm font-semibold text-slate-800">Contacts</h2>
                    </div>
                    <div class="p-4 space-y-3 text-sm">
                        <div>
                            <span class="text-xs text-slate-400 uppercase tracking-wide">Parent/Guardian</span>
                            <p class="font-medium text-slate-800">@registration.ParentInfo.FullName</p>
                            <p class="text-slate-500">@FormatPhone(registration.ParentInfo.PhoneNumber)</p>
                        </div>
                        @if (registration.TeacherInfo != null)
                        {
                            <div class="pt-2 border-t border-slate-100">
                                <span class="text-xs text-slate-400 uppercase tracking-wide">Teacher</span>
                                <p class="font-medium text-slate-800">@registration.TeacherInfo.FullName</p>
                                <p class="text-slate-500">@FormatPhone(registration.TeacherInfo.PhoneNumber)</p>
                                @if (!string.IsNullOrWhiteSpace(registration.TeacherInfo.Institution))
                                {
                                    <p class="text-slate-500">@registration.TeacherInfo.Institution</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Uploaded Files -->
            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-cyan-600 to-cyan-700 flex items-center justify-center">
                            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <h2 class="text-sm font-semibold text-slate-800">Files</h2>
                    </div>
                    @if (registration.FileUploadInfo.NiqabBypassApproved)
                    {
                        <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-xs">Niqab Exception</span>
                    }
                </div>
                <div class="p-4">
                    <div class="flex flex-wrap gap-3">
                        <!-- ID Document -->
                        @if (registration.FileUploadInfo.IdDocument != null && !string.IsNullOrEmpty(idDownloadUrl))
                        {
                            @if (IsImageExtension(registration.FileUploadInfo.IdDocument.Extension))
                            {
                                <button type="button" @onclick="() => OpenImageDialog(idDownloadUrl)"
                                        class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 transition-all text-sm cursor-pointer">
                                    <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0" />
                                    </svg>
                                    <span class="font-medium text-slate-700">ID Document</span>
                                    <span class="text-slate-400 text-xs">@registration.FileUploadInfo.IdDocument.Extension.ToUpperInvariant()</span>
                                    <svg class="h-4 w-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                </button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => DownloadFile(idDownloadUrl)"
                                        class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 transition-all text-sm cursor-pointer">
                                    <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0" />
                                    </svg>
                                    <span class="font-medium text-slate-700">ID Document</span>
                                    <span class="text-slate-400 text-xs">@registration.FileUploadInfo.IdDocument.Extension.ToUpperInvariant()</span>
                                    <svg class="h-4 w-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                    </svg>
                                </button>
                            }
                        }
                        else if (registration.FileUploadInfo.IdDocument != null)
                        {
                            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-sm">
                                <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0" />
                                </svg>
                                <span class="text-slate-500">ID Document</span>
                            </div>
                        }

                        <!-- Photo -->
                        @if (registration.FileUploadInfo.Photo != null && !string.IsNullOrEmpty(photoDownloadUrl))
                        {
                            <button type="button" @onclick="() => OpenImageDialog(photoDownloadUrl)"
                                    class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 transition-all text-sm cursor-pointer">
                                <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="font-medium text-slate-700">Photo</span>
                                <span class="text-slate-400 text-xs">@registration.FileUploadInfo.Photo.Extension.ToUpperInvariant()</span>
                                <svg class="h-4 w-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            </button>
                        }
                        else if (registration.FileUploadInfo.Photo != null)
                        {
                            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-sm">
                                <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="text-slate-500">Photo</span>
                            </div>
                        }

                        <!-- Video (admin only for download, always show if exists) -->
                        @if (registration.FileUploadInfo.Video != null)
                        {
                            @if (isAdmin && !string.IsNullOrEmpty(videoDownloadUrl))
                            {
                                <button type="button" @onclick="() => DownloadFile(videoDownloadUrl)"
                                        class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 transition-all text-sm cursor-pointer">
                                    <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                    <span class="font-medium text-slate-700">Video</span>
                                    <span class="text-slate-400 text-xs">@FormatFileSize(registration.FileUploadInfo.Video.FileSizeBytes)</span>
                                    <svg class="h-4 w-4 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                    </svg>
                                </button>
                            }
                            else
                            {
                                <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 text-sm">
                                    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                    <span class="text-slate-500">Video</span>
                                    <span class="text-slate-400 text-xs">@FormatFileSize(registration.FileUploadInfo.Video.FileSizeBytes)</span>
                                </div>
                            }
                        }
                        else if (category?.RequiresVideo == true)
                        {
                            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-dashed border-amber-300 bg-amber-50/50 text-sm">
                                <svg class="h-4 w-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                </svg>
                                <span class="text-amber-700">Video required</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Audit History (admin only) -->
            @if (isAdmin && auditEntries.Count > 0)
            {
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center">
                                <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h2 class="text-sm font-semibold text-slate-800">Activity</h2>
                        </div>
                        <a href="/admin/audit/Registration/@registration.Id" class="text-xs text-cyan-600 hover:text-cyan-700 font-medium">
                            View all →
                        </a>
                    </div>
                    <div class="divide-y divide-slate-100">
                        @foreach (var entry in auditEntries.Take(4))
                        {
                            <div class="px-4 py-3 flex items-start gap-3">
                                <div class="w-6 h-6 rounded @GetAuditActionStyle(entry.Action) flex items-center justify-center flex-shrink-0 mt-0.5">
                                    @GetAuditActionIcon(entry.Action)
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm text-slate-700">
                                        <span class="font-medium">@entry.Action.GetDisplayName()</span>
                                        @if (!string.IsNullOrEmpty(entry.Summary))
                                        {
                                            <span class="text-slate-500"> — @entry.Summary</span>
                                        }
                                    </p>
                                    <p class="text-xs text-slate-400">@entry.GetFormattedTimestamp("MMM d, h:mm tt") • @entry.GetActorDescription()</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="space-y-4">
            <!-- Status & Info -->
            <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                <div class="p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-slate-500">Status</span>
                        <span class="@GetStatusStyles(registration.Status) px-2 py-0.5 rounded text-xs font-medium">
                            @registration.Status
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(registration.StatusComment))
                    {
                        <div class="pt-2 border-t border-slate-100">
                            <span class="text-xs text-slate-400">Admin Comment</span>
                            <p class="text-sm text-slate-700 mt-0.5">@registration.StatusComment</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(registration.WithdrawComment))
                    {
                        <div class="pt-2 border-t border-slate-100">
                            <span class="text-xs text-slate-400">Withdrawal Reason</span>
                            <p class="text-sm text-slate-700 mt-0.5">@registration.WithdrawComment</p>
                        </div>
                    }

                    <div class="pt-2 border-t border-slate-100 space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Submitted</span>
                            <span class="text-slate-700">@(registration.SubmittedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "—")</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Updated</span>
                            <span class="text-slate-700">@registration.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            @if (CanShowActions())
            {
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
                    <div class="p-4 space-y-2">
                        @if (registration.CanEdit && !isAdmin)
                        {
                            <a href="/registrations/@registration.Id/edit"
                               class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit Registration
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a href="/admin/registrations/@registration.Id/edit"
                               class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                                Edit Registration
                            </a>
                        }

                        @if (registration.CanWithdraw && !isAdmin)
                        {
                            <button type="button"
                                    @onclick="ShowWithdrawModal"
                                    class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-sm font-medium transition-colors">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                </svg>
                                Withdraw
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Image Dialog/Lightbox -->
    @if (!string.IsNullOrEmpty(dialogImageUrl))
    {
        <div @onclick="CloseDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70">
            <div class="relative max-w-4xl max-h-[90vh] p-4">
                <img src="@dialogImageUrl" alt="Preview" class="max-w-full max-h-[80vh] @rotationClass @scaleClass rounded-lg" />

                <!-- Control Buttons -->
                <div class="absolute top-2 right-2 flex items-center gap-2">
                    <!-- Rotate Button -->
                    <button class="p-2 bg-black/70 rounded-full text-white hover:bg-black/90 transition-colors" @onclick="RotateImage" @onclick:stopPropagation>
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z" />
                            <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" />
                        </svg>
                    </button>

                    <!-- Scale Button -->
                    <button class="p-2 bg-black/70 rounded-full text-white hover:bg-black/90 transition-colors" @onclick="ToggleScale" @onclick:stopPropagation>
                        @if (isScaled)
                        {
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707m4.344-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M.172 15.828a.5.5 0 0 0 .707 0l4.096-4.096V14.5a.5.5 0 1 0 1 0v-3.975a.5.5 0 0 0-.5-.5H1.5a.5.5 0 0 0 0 1h2.768L.172 15.121a.5.5 0 0 0 0 .707M15.828.172a.5.5 0 0 0-.707 0l-4.096 4.096V1.5a.5.5 0 1 0-1 0v3.975a.5.5 0 0 0 .5.5H14.5a.5.5 0 0 0 0-1h-2.768L15.828.879a.5.5 0 0 0 0-.707" />
                            </svg>
                        }
                    </button>

                    <!-- Close Button -->
                    <button class="p-2 bg-black/70 rounded-full text-white hover:bg-black/90 transition-colors" @onclick="CloseDialog">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Registration? registration;
    private Division? division;
    private Category? category;
    private CompetitionSettings? settings;
    private List<AuditEntry> auditEntries = new();

    private bool isLoading = true;
    private bool isAdmin;

    private string? idDownloadUrl;
    private string? photoDownloadUrl;
    private string? videoDownloadUrl;

    // Image dialog state
    private string? dialogImageUrl;
    private string rotationClass = "";
    private string scaleClass = "";
    private bool isScaled = false;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = NavigationManager.Uri.Contains("/admin/");
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var currentUser = await CurrentUserService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            isAdmin = isAdmin && currentUser.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase);

            registration = await RegistrationService.GetByIdAsync(Id);

            if (registration == null)
            {
                isLoading = false;
                return;
            }

            if (!isAdmin && registration.CreatorUserId != currentUser.ObjectIdentifier)
            {
                registration = null;
                isLoading = false;
                return;
            }

            settings = await SettingsService.GetSettingsAsync();
            division = settings?.Divisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
            category = division?.Categories.FirstOrDefault(c => c.Id == registration.CompetitionSelection.CategoryId);

            GenerateDownloadUrls();

            if (isAdmin)
            {
                auditEntries = (await AuditService.GetEntityHistoryAsync("Registration", registration.Id)).ToList();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GenerateDownloadUrls()
    {
        if (registration == null) return;

        var year = registration.CompetitionYear;

        // ID and Photo available to everyone
        if (registration.FileUploadInfo.IdDocument != null)
        {
            idDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.IdDocument.StorageReference, year);
        }

        if (registration.FileUploadInfo.Photo != null)
        {
            photoDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.Photo.StorageReference, year);
        }

        // Video only for admin
        if (registration.FileUploadInfo.Video != null && isAdmin)
        {
            videoDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.Video.StorageReference, year);
        }
    }

    private bool CanShowActions()
    {
        if (registration == null) return false;
        return registration.CanEdit || registration.CanWithdraw || isAdmin;
    }

    private void ShowWithdrawModal()
    {
        // TODO: Implement withdrawal modal
    }

    private void OpenImageDialog(string? imageUrl)
    {
        if (!string.IsNullOrEmpty(imageUrl))
        {
            dialogImageUrl = imageUrl;
            rotationClass = "";
            scaleClass = "";
            isScaled = false;
        }
    }

    private void CloseDialog()
    {
        dialogImageUrl = null;
        rotationClass = "";
        scaleClass = "";
        isScaled = false;
    }

    private void RotateImage()
    {
        var rotations = new[] { "", "rotate-90", "rotate-180", "-rotate-90" };
        var currentIndex = Array.IndexOf(rotations, rotationClass);
        rotationClass = rotations[(currentIndex + 1) % rotations.Length];
    }

    private void ToggleScale()
    {
        isScaled = !isScaled;
        scaleClass = isScaled ? "scale-75" : "";
    }

    private void DownloadFile(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            NavigationManager.NavigateTo(url, forceLoad: true);
        }
    }

    private bool IsImageExtension(string extension)
    {
        var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" };
        return imageExtensions.Contains(extension.ToLowerInvariant());
    }

    private string FormatPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone) || phone.Length != 10)
            return phone;
        return $"({phone[..3]}) {phone[3..6]}-{phone[6..]}";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetStatusStyles(RegistrationStatus status) => status switch
    {
        RegistrationStatus.AwaitingReview => "bg-cyan-100 text-cyan-700",
        RegistrationStatus.Pending => "bg-amber-100 text-amber-700",
        RegistrationStatus.Reviewed => "bg-cyan-100 text-cyan-700",
        RegistrationStatus.Verified => "bg-cyan-100 text-cyan-700",
        RegistrationStatus.Withdrawn => "bg-slate-100 text-slate-600",
        RegistrationStatus.Disqualified => "bg-slate-100 text-slate-600",
        _ => "bg-slate-100 text-slate-600"
    };

    private string GetAuditActionStyle(AuditAction action) => action switch
    {
        AuditAction.Created or AuditAction.Submitted => "bg-cyan-100 text-cyan-600",
        AuditAction.Updated => "bg-slate-100 text-slate-600",
        AuditAction.Approved or AuditAction.Verified => "bg-cyan-100 text-cyan-600",
        AuditAction.Rejected or AuditAction.Deleted => "bg-slate-200 text-slate-600",
        AuditAction.StatusChanged => "bg-amber-100 text-amber-600",
        AuditAction.Withdrawn or AuditAction.WithdrawalRequested => "bg-slate-100 text-slate-600",
        _ => "bg-slate-100 text-slate-600"
    };

    private RenderFragment GetAuditActionIcon(AuditAction action) => __builder =>
    {
        @switch (action)
        {
            case AuditAction.Created:
            case AuditAction.Submitted:
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                break;
            case AuditAction.Updated:
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                break;
            case AuditAction.Approved:
            case AuditAction.Verified:
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                break;
            case AuditAction.StatusChanged:
            case AuditAction.Withdrawn:
            case AuditAction.WithdrawalRequested:
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                </svg>
                break;
            default:
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                break;
        }
    };
}
