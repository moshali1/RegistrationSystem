@page "/registration/{Id}"
@page "/admin/registration/{Id}"

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject BlobSasService BlobSasService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Registration Details</PageTitle>

<div class="max-w-7xl mx-auto">
    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
                <span class="text-sm text-slate-500">Loading registration...</span>
            </div>
        </div>
    }
    else if (registration == null)
    {
        <div class="max-w-2xl mx-auto">
            <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-5">
                    <svg class="h-8 w-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-slate-800 mb-2">Registration Not Found</h3>
                <p class="text-slate-600 mb-6">This registration doesn't exist or you don't have permission to view it.</p>
                <a href="@(isAdmin ? "/admin/registrations" : "/registrations")"
                   class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-6 py-3 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Registrations
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <!-- LEFT COLUMN (2/3 width) - ALL INFORMATION -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <!-- Header -->
                    <div class="px-6 pt-6 pb-2">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
                            <div>
                                <h1 class="text-2xl font-bold text-slate-800">@registration.PersonalInfo.FullName</h1>
                                <p class="text-sm text-slate-500 mt-1">@(division?.Name ?? "Unknown") · @(category?.Name ?? "Unknown")</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <StatusBadge Status="registration.Status" Size="StatusBadge.StatusBadgeSize.Large" />
                                @if (!string.IsNullOrEmpty(registration.Cid))
                                {
                                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold bg-slate-700 text-white shadow-sm">
                                        @registration.Cid
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="p-6">
                        <!-- Status Comments -->
                        @if (!string.IsNullOrEmpty(registration.StatusComment))
                        {
                            <div class="mb-5 rounded-lg bg-slate-50 border border-slate-200 p-4">
                                <div class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">Admin Comment</div>
                                <p class="text-sm text-slate-700">@registration.StatusComment</p>
                            </div>
                        }
                        @if (registration.Status == RegistrationStatus.Withdrawn && !string.IsNullOrEmpty(registration.WithdrawComment))
                        {
                            <div class="mb-5 rounded-lg bg-amber-50 border border-amber-200 p-4">
                                <div class="text-xs font-medium text-amber-700 uppercase tracking-wide mb-1">Withdrawal Reason</div>
                                <p class="text-sm text-amber-900">@registration.WithdrawComment</p>
                            </div>
                        }

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- COMPETITOR SECTION                                       -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-6 h-6 rounded-md bg-gradient-to-br from-cyan-500 to-cyan-600 flex items-center justify-center">
                                <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-slate-800">Competitor Information</h3>
                        </div>

                        <dl class="divide-y divide-slate-100">
                            <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                <dt class="text-sm font-medium text-slate-900">Full Name</dt>
                                <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">@registration.PersonalInfo.FullName</dd>
                            </div>
                            <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                <dt class="text-sm font-medium text-slate-900">Gender</dt>
                                <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">@registration.PersonalInfo.Gender</dd>
                            </div>
                            <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                <dt class="text-sm font-medium text-slate-900">Date of Birth</dt>
                                <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">
                                    @registration.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")
                                    @if (settings != null)
                                    {
                                        <span class="text-cyan-600 ml-2">(@registration.CalculateAgeAsOf(settings.AgeCutoffDate) yrs)</span>
                                    }
                                </dd>
                            </div>
                            <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                <dt class="text-sm font-medium text-slate-900">Location</dt>
                                <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">@registration.AddressInfo.FormattedLocation</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PhoneNumber))
                            {
                                <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                    <dt class="text-sm font-medium text-slate-900">Phone</dt>
                                    <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">@FormatPhone(registration.PersonalInfo.PhoneNumber)</dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PreferredName))
                            {
                                <div class="py-2.5 sm:grid sm:grid-cols-3 sm:gap-4">
                                    <dt class="text-sm font-medium text-slate-900">Preferred Name</dt>
                                    <dd class="mt-1 text-sm text-slate-600 sm:col-span-2 sm:mt-0">@registration.PersonalInfo.PreferredName</dd>
                                </div>
                            }
                        </dl>

                        <div class="border-t border-slate-100 my-4"></div>

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- COMPETITION SECTION                                      -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-6 h-6 rounded-md bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center">
                                <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-slate-800">Competition Information</h3>
                            <span class="text-xs text-slate-400">| @registration.CompetitionYear</span>
                        </div>

                        <p class="text-sm pl-8">
                            <span class="font-medium text-slate-900">@(division?.Name ?? "—")</span>
                            <span class="text-slate-300 mx-1.5">|</span>
                            <span class="text-slate-600">@(category?.Name ?? "—")</span>
                            @if (registration.CompetitionSelection.PortionChoice.HasValue)
                            {
                                <span class="text-slate-300 mx-1.5">|</span>
                                <span class="text-slate-600">@registration.CompetitionSelection.PortionChoice.Value</span>
                            }
                        </p>

                        <div class="border-t border-slate-100 my-3"></div>

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- PARENT / GUARDIAN SECTION                                -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        <div class="flex items-center gap-2 mb-1.5">
                            <div class="w-6 h-6 rounded-md bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center">
                                <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <h3 class="text-sm font-semibold text-slate-800">Parent / Guardian Information</h3>
                        </div>
                        <p class="text-sm pl-8">
                            <span class="font-medium text-slate-900">@registration.ParentInfo.FullName</span>
                            <span class="text-slate-300 mx-2">|</span>
                            <span class="text-slate-600">@FormatPhone(registration.ParentInfo.PhoneNumber)</span>
                        </p>

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- TEACHER SECTION                                          -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        @if (registration.TeacherInfo != null)
                        {
                            <div class="border-t border-slate-100 my-3"></div>

                            <div class="flex items-center gap-2 mb-1.5">
                                <div class="w-6 h-6 rounded-md bg-gradient-to-br from-violet-500 to-violet-600 flex items-center justify-center">
                                    <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-semibold text-slate-800">Teacher Information</h3>
                            </div>
                            <p class="text-sm pl-8">
                                <span class="font-medium text-slate-900">@registration.TeacherInfo.FullName</span>
                                <span class="text-slate-300 mx-2">|</span>
                                <span class="text-slate-600">@FormatPhone(registration.TeacherInfo.PhoneNumber)</span>
                                @if (!string.IsNullOrWhiteSpace(registration.TeacherInfo.Institution))
                                {
                                    <span class="text-slate-300 mx-2">|</span>
                                    <span class="text-slate-600">@registration.TeacherInfo.Institution</span>
                                }
                            </p>
                        }

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!-- FILE INFORMATION                                         -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        @if (registration.FileUploadInfo.Photo != null || registration.FileUploadInfo.IdDocument != null || registration.FileUploadInfo.Video != null)
                        {
                            <div class="border-t border-slate-100 my-3"></div>

                            <div class="flex items-center gap-2 mb-2">
                                <div class="w-6 h-6 rounded-md bg-gradient-to-br from-slate-500 to-slate-600 flex items-center justify-center">
                                    <svg class="h-3.5 w-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-semibold text-slate-800">File Information</h3>
                            </div>

                            <ul class="divide-y divide-slate-100 rounded-lg border border-slate-200 overflow-hidden">
                                @if (registration.FileUploadInfo.Photo != null && !string.IsNullOrEmpty(photoDownloadUrl))
                                {
                                    <li class="flex items-center justify-between px-4 py-3">
                                        <div class="flex flex-1 items-center gap-3 min-w-0">
                                            <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-slate-400">
                                                <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                                            </svg>
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="text-sm font-medium text-slate-900 truncate">Competitor Photo</span>
                                                    @if (registration.FileUploadInfo.NiqabBypassApproved)
                                                    {
                                                        <span class="shrink-0 text-xs font-medium text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">Niqab</span>
                                                    }
                                                </div>
                                                <p class="text-xs text-slate-500">Photo · Uploaded</p>
                                            </div>
                                        </div>
                                        <button type="button" @onclick="() => DownloadFile(photoDownloadUrl)"
                                                class="ml-4 shrink-0 text-sm font-medium text-cyan-600 hover:text-cyan-700 transition-colors">
                                            Download
                                        </button>
                                    </li>
                                }
                                @if (registration.FileUploadInfo.IdDocument != null && !string.IsNullOrEmpty(idDownloadUrl))
                                {
                                    <li class="flex items-center justify-between px-4 py-3">
                                        <div class="flex flex-1 items-center gap-3 min-w-0">
                                            <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-slate-400">
                                                <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                                            </svg>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-medium text-slate-900 truncate">ID Document</p>
                                                <p class="text-xs text-slate-500">@registration.FileUploadInfo.IdDocument.Extension.ToUpperInvariant().TrimStart('.') · Uploaded</p>
                                            </div>
                                        </div>
                                        <button type="button" @onclick="() => DownloadFile(idDownloadUrl)"
                                                class="ml-4 shrink-0 text-sm font-medium text-cyan-600 hover:text-cyan-700 transition-colors">
                                            Download
                                        </button>
                                    </li>
                                }
                                @if (registration.FileUploadInfo.Video != null)
                                {
                                    <li class="flex items-center justify-between px-4 py-3">
                                        <div class="flex flex-1 items-center gap-3 min-w-0">
                                            <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-slate-400">
                                                <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                                            </svg>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-medium text-slate-900 truncate">Recitation Video</p>
                                                <p class="text-xs text-slate-500">Video · @FormatFileSize(registration.FileUploadInfo.Video.FileSizeBytes)</p>
                                            </div>
                                        </div>
                                        @if (isAdmin && !string.IsNullOrEmpty(videoDownloadUrl))
                                        {
                                            <button type="button" @onclick="() => DownloadFile(videoDownloadUrl)"
                                                    class="ml-4 shrink-0 text-sm font-medium text-cyan-600 hover:text-cyan-700 transition-colors">
                                                Download
                                            </button>
                                        }
                                        else if (!isAdmin)
                                        {
                                            <span class="ml-4 shrink-0 text-xs text-slate-400">Admin only</span>
                                        }
                                    </li>
                                }
                                else if (category?.RequiresVideo == true)
                                {
                                    <li class="flex items-center px-4 py-3 bg-amber-50">
                                        <div class="flex flex-1 items-center gap-3 min-w-0">
                                            <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 shrink-0 text-amber-500">
                                                <path d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd" fill-rule="evenodd" />
                                            </svg>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-medium text-amber-800">Recitation Video</p>
                                                <p class="text-xs text-amber-600">Required · Not uploaded</p>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <!-- Footer with timestamps and actions -->
                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-5 text-xs text-slate-500">
                                @if (submittedAt.HasValue)
                                {
                                    <div class="flex items-center gap-1.5">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span>Submitted <span class="font-medium text-slate-600">@submittedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</span></span>
                                    </div>
                                }
                                @if (lastUpdatedAt.HasValue)
                                {
                                    <div class="flex items-center gap-1.5">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                        </svg>
                                        <span>Updated <span class="font-medium text-slate-600">@lastUpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</span></span>
                                    </div>
                                }
                            </div>
                            <div class="flex items-center gap-2">
                                @if (canWithdraw && !isAdmin)
                                {
                                    <button type="button"
                                            @onclick="ShowWithdrawModal"
                                            class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 transition-all">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                        </svg>
                                        Withdraw
                                    </button>
                                }
                                @if (canEdit)
                                {
                                    <a href="@(isAdmin ? $"/admin/registration/{registration.Id}/edit" : $"/registration/{registration.Id}/edit")"
                                       class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-3 py-1.5 text-xs font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                        Edit Registration
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════════════════════════════════════════════════════ -->
                <!-- ACTIVITY (ADMIN ONLY)                                            -->
                <!-- ═══════════════════════════════════════════════════════════════ -->
                @if (isAdmin && auditEntries.Count > 0)
                {
                    <div class="mt-5 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <h3 class="text-sm font-semibold text-slate-800">Recent Activity</h3>
                            </div>
                            <a href="/admin/audit/Registration/@registration.Id" class="text-xs text-cyan-600 hover:text-cyan-700 font-medium">
                                View all →
                            </a>
                        </div>
                        <div class="divide-y divide-slate-100">
                            @foreach (var entry in auditEntries.Take(5))
                            {
                                <div class="px-6 py-3.5 flex items-start gap-3 hover:bg-slate-50 transition-colors">
                                    <div class="w-7 h-7 rounded-lg @GetAuditActionStyle(entry.Action) flex items-center justify-center flex-shrink-0">
                                        @GetAuditActionIcon(entry.Action)
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-slate-700">
                                            <span class="font-semibold">@entry.Action.GetDisplayName()</span>
                                            @if (!string.IsNullOrEmpty(entry.Summary))
                                            {
                                                <span class="text-slate-500"> — @entry.Summary</span>
                                            }
                                        </p>
                                        <p class="text-xs text-slate-400 mt-0.5">
                                            @entry.GetFormattedTimestamp("MMM d, yyyy 'at' h:mm tt") · @entry.GetActorDescription()
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT COLUMN (1/3 width) - PHOTOS & DOCUMENTS -->
            <div class="lg:col-span-1">
                <div class="sticky top-5 space-y-5">

                    <!-- Photo -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="px-4 py-3 border-b border-slate-200">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-lg bg-cyan-600 flex items-center justify-center">
                                        <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                    <span class="text-sm font-semibold text-slate-800">Competitor Photo</span>
                                </div>
                                @if (registration.FileUploadInfo.NiqabBypassApproved)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 text-xs font-medium">
                                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                        Niqab
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="p-4">
                            @if (!string.IsNullOrEmpty(photoDownloadUrl))
                            {
                                <button type="button" @onclick="() => OpenImageDialog(photoDownloadUrl)" class="relative block w-full cursor-pointer group rounded-lg overflow-hidden">
