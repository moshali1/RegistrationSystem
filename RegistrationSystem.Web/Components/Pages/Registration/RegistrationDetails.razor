            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- IMAGE LIGHTBOX                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            @if (!string.IsNullOrEmpty(dialogImageUrl))
            {
                <div @onclick="CloseDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
                    <div class="relative max-w-6xl max-h-[90vh] p-4">
                        <img src="@dialogImageUrl"
                             alt="Preview"
                             class="max-w-full max-h-[85vh] rounded-lg shadow-2xl @rotationClass @scaleClass transition-transform duration-200" />

                        <div class="absolute top-6 right-6 flex items-center gap-2">
                            <button type="button"
                                    class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                                    @onclick="RotateImage"
                                    @onclick:stopPropagation
                                    title="Rotate">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z" />
                                    <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" />
                                </svg>
                            </button>

                            <button type="button"
                                    class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                                    @onclick="ToggleScale"
                                    @onclick:stopPropagation
                                    title="@(isScaled ? "Zoom in" : "Zoom out")">
                                @if (isScaled)
                                {
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M5.828 10.172a.5.5 0 0 0-.707 0l-4.096 4.096V11.5a.5.5 0 0 0-1 0v3.975a.5.5 0 0 0 .5.5H4.5a.5.5 0 0 0 0-1H1.732l4.096-4.096a.5.5 0 0 0 0-.707m4.344-4.344a.5.5 0 0 0 .707 0l4.096-4.096V4.5a.5.5 0 1 0 1 0V.525a.5.5 0 0 0-.5-.5H11.5a.5.5 0 0 0 0 1h2.768l-4.096 4.096a.5.5 0 0 0 0 .707" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M.172 15.828a.5.5 0 0 0 .707 0l4.096-4.096V14.5a.5.5 0 1 0 1 0v-3.975a.5.5 0 0 0-.5-.5H1.5a.5.5 0 0 0 0 1h2.768L.172 15.121a.5.5 0 0 0 0 .707M15.828.172a.5.5 0 0 0-.707 0l-4.096 4.096V1.5a.5.5 0 1 0-1 0v3.975a.5.5 0 0 0 .5.5H14.5a.5.5 0 0 0 0-1h-2.768L15.828.879a.5.5 0 0 0 0-.707" />
                                    </svg>
                                }
                            </button>

                            <button type="button"
                                    class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                                    @onclick="CloseDialog"
                                    title="Close">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- ═══════════════════════════════════════════════════════════════════ -->
            <!-- WITHDRAW MODAL                                                       -->
            <!-- ═══════════════════════════════════════════════════════════════════ -->
            @if (showWithdrawModal)
            {
                <div class="fixed inset-0 z-50 overflow-y-auto">
                    <div class="flex min-h-full items-center justify-center p-4">
                        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" @onclick="CloseWithdrawModal"></div>

                        <div class="relative w-full max-w-md rounded-2xl bg-white shadow-2xl">
                            <div class="px-6 py-5 border-b border-slate-200">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow">
                                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                        </svg>
                                    </div>
                                    <div>
                                        <h3 class="text-lg font-semibold text-slate-800">Withdraw Registration</h3>
                                        <p class="text-sm text-slate-500">This action cannot be undone</p>
                                    </div>
                                </div>
                            </div>

                            <div class="px-6 py-5">
                                <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 mb-4">
                                    <div class="text-sm">
                                        <div class="font-medium text-slate-800">@registration!.PersonalInfo.FullName</div>
                                        <div class="text-slate-500 mt-1">@(division?.Name ?? "—") / @(category?.Name ?? "—")</div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(withdrawError))
                                {
                                    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mb-4">
                                        <p class="text-sm text-red-700">@withdrawError</p>
                                    </div>
                                }

                                <div class="space-y-1.5 mb-4">
                                    <label class="text-sm font-medium text-slate-700">Reason for withdrawal <span class="text-red-500">*</span></label>
                                    <select @bind="withdrawReasonType"
                                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 cursor-pointer">
                                        <option value="">Select a reason...</option>
                                        <option value="ScheduleConflict">Schedule conflict</option>
                                        <option value="HealthRelated">Health-related reason</option>
                                        <option value="InsufficientPreparation">Insufficient preparation</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>

                                @if (withdrawReasonType == "Other")
                                {
                                    <div class="space-y-1.5">
                                        <label class="text-sm font-medium text-slate-700">Please explain <span class="text-red-500">*</span></label>
                                        <textarea @bind="withdrawOtherReason"
                                                  rows="3"
                                                  placeholder="Please explain why you are withdrawing this registration..."
                                                  class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 resize-none"></textarea>
                                    </div>
                                }
                            </div>

                            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-2xl">
                                <button type="button"
                                        class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                                        @onclick="CloseWithdrawModal"
                                        disabled="@isWithdrawing">
                                    Cancel
                                </button>
                                <button type="button"
                                        class="cursor-pointer rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-red-700 hover:to-red-800 disabled:opacity-50 transition-all flex items-center gap-2"
                                        @onclick="ConfirmWithdraw"
                                        disabled="@isWithdrawing">
                                    @if (isWithdrawing)
                                    {
                                        <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                                        </svg>
                                    }
                                    Withdraw Registration
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Registration? registration;
    private Division? division;
    private Category? category;
    private CompetitionSettings? settings;
    private List<AuditEntry> auditEntries = new();

    private bool isLoading = true;
    private bool isAdmin;

    private bool canEdit;
    private bool canWithdraw;

    private string? idDownloadUrl;
    private string? photoDownloadUrl;
    private string? videoDownloadUrl;

    // Timestamps derived from audit entries
    private DateTimeOffset? submittedAt;
    private DateTimeOffset? lastUpdatedAt;

    // Image dialog state
    private string? dialogImageUrl;
    private string rotationClass = "";
    private string scaleClass = "";
    private bool isScaled = false;

    // Withdrawal modal state
    private bool showWithdrawModal;
    private string withdrawReasonType = string.Empty;
    private string withdrawOtherReason = string.Empty;
    private bool isWithdrawing;
    private string? withdrawError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var currentUser = await CurrentUserService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            isAdmin = currentUser.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase);

            registration = await RegistrationService.GetByIdAsync(Id);

            if (registration == null)
            {
                isLoading = false;
                return;
            }

            if (!isAdmin && registration.CreatorUserId != currentUser.ObjectIdentifier)
            {
                registration = null;
                isLoading = false;
                return;
            }

            settings = await SettingsService.GetSettingsAsync();
            division = settings?.Divisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
            category = division?.Categories.FirstOrDefault(c => c.Id == registration.CompetitionSelection.CategoryId);

            canEdit = CanEdit(registration) || isAdmin;
            canWithdraw = CanWithdraw(registration);

            GenerateDownloadUrls();

            // Load audit entries for all users — needed for timestamps
            // Full activity section is shown for admin only
            auditEntries = (await AuditService.GetEntityHistoryAsync("Registration", registration.Id)).ToList();

            submittedAt = auditEntries
                .Where(e => e.Action == AuditAction.Submitted || e.Action == AuditAction.Created)
                .OrderBy(e => e.Timestamp)
                .FirstOrDefault()?.Timestamp;

            lastUpdatedAt = auditEntries
                .OrderByDescending(e => e.Timestamp)
                .FirstOrDefault()?.Timestamp;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // PERMISSIONS
    // ═══════════════════════════════════════════════════════════════════════════

    private bool CanEdit(Registration reg)
    {
        if (reg.Status != RegistrationStatus.AwaitingReview &&
            reg.Status != RegistrationStatus.Pending)
            return false;

        var cat = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);

        return cat?.AllowEdit ?? true;
    }

    private bool CanWithdraw(Registration reg)
    {
        if (reg.Status == RegistrationStatus.Withdrawn ||
            reg.Status == RegistrationStatus.Disqualified)
            return false;

        var cat = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);

        return cat?.AllowWithdraw ?? true;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // DOWNLOAD URLS
    // ═══════════════════════════════════════════════════════════════════════════

    private void GenerateDownloadUrls()
    {
        if (registration == null) return;

        var year = registration.CompetitionYear;

        if (registration.FileUploadInfo.IdDocument != null)
        {
            idDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.IdDocument.StorageReference, year);
        }

        if (registration.FileUploadInfo.Photo != null)
        {
            photoDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.Photo.StorageReference, year);
        }

        if (registration.FileUploadInfo.Video != null && isAdmin)
        {
            videoDownloadUrl = BlobSasService.GenerateSasUriFromReference(
                registration.FileUploadInfo.Video.StorageReference, year);
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // WITHDRAWAL MODAL
    // ═══════════════════════════════════════════════════════════════════════════

    private void ShowWithdrawModal()
    {
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
        showWithdrawModal = true;
    }

    private void CloseWithdrawModal()
    {
        showWithdrawModal = false;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
    }

    private string GetWithdrawReasonText() => withdrawReasonType switch
    {
        "ScheduleConflict" => "Schedule conflict",
        "HealthRelated" => "Health-related reason",
        "InsufficientPreparation" => "Insufficient preparation",
        "Other" => $"Other - {withdrawOtherReason.Trim()}",
        _ => withdrawReasonType
    };

    private async Task ConfirmWithdraw()
    {
        if (registration == null) return;

        if (string.IsNullOrWhiteSpace(withdrawReasonType))
        {
            withdrawError = "Please select a reason for withdrawal.";
            return;
        }

        if (withdrawReasonType == "Other" && string.IsNullOrWhiteSpace(withdrawOtherReason))
        {
            withdrawError = "Please explain your reason for withdrawal.";
            return;
        }

        isWithdrawing = true;
        withdrawError = null;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null) return;

            var reasonText = GetWithdrawReasonText();
            var previousStatus = registration.Status.ToString();

            await AuditContextProvider.SetCurrentUserContextAsync();

            await RegistrationService.WithdrawAsync(
                registration.Id,
                user.ObjectIdentifier,
                reasonText);

            await AuditService.LogFieldChangesAsync(
                "Registration",
                registration.Id,
                new List<FieldChange>
                {
                    new FieldChange
                    {
                        FieldName = "Status",
                        DisplayName = "Status",
                        OldValue = previousStatus,
                        NewValue = RegistrationStatus.Withdrawn.ToString()
                    },
                    new FieldChange
                    {
                        FieldName = "WithdrawComment",
                        DisplayName = "Withdrawal Reason",
                        OldValue = null,
                        NewValue = reasonText
                    }
                },
                action: AuditAction.Withdrawn,
                summary: $"Registration withdrawn. Reason: {reasonText}",
                entityDescription: $"{registration.PersonalInfo.FullName} - {division?.Name ?? "Unknown"} / {category?.Name ?? "Unknown"}");

            CloseWithdrawModal();
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            withdrawError = ex.Message;
        }
        catch (Exception)
        {
            withdrawError = "An error occurred while withdrawing the registration.";
        }
        finally
        {
            isWithdrawing = false;
        }
    }

