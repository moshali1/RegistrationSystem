@page "/registration/{Id}"
@page "/admin/registration/{Id}"

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject BlobSasService BlobSasService
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Registration Details</PageTitle>

@if (isLoading)
{
    <div class="flex items-center justify-center py-16">
        <div class="flex flex-col items-center gap-3">
            @Icons.Spinner("h-8 w-8 text-cyan-700 animate-spin")
            <span class="text-sm text-slate-500">Loading registration...</span>
        </div>
    </div>
}
else if (registration == null)
{
    <div class="max-w-lg mx-auto mt-12">
        <div class="rounded-xl border border-slate-200 bg-white p-10 text-center shadow-sm">
            @Icons.Warning("h-10 w-10 text-slate-300 mx-auto mb-4")
            <h3 class="text-lg font-semibold text-slate-800 mb-2">Registration Not Found</h3>
            <p class="text-sm text-slate-500 mb-6">This registration doesn't exist or you don't have permission to view it.</p>
            <a href="@(isAdmin ? "/admin/registrations" : "/registrations")"
               class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-sm">
                Back to Registrations
            </a>
        </div>
    </div>
}
else
{
    <!-- HEADER BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex items-center gap-3">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">@registration.PersonalInfo.FullName</h1>
                <p class="text-sm text-slate-500 mt-0.5">
                    @(division?.Name ?? "Unknown") · @(category?.Name ?? "Unknown")
                    @if (registration.CompetitionSelection.PortionChoice.HasValue)
                    {
                        <span> · @registration.CompetitionSelection.PortionChoice.Value</span>
                    }
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <StatusBadge Status="registration.Status" Size="StatusBadge.StatusBadgeSize.Large" />
            @if (!string.IsNullOrEmpty(registration.Cid))
            {
                <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold bg-slate-700 text-white shadow-sm">
                    @registration.Cid
                </span>
            }
        </div>
    </div>

    <!-- STATUS COMMENTS (conditional banners) -->
    @if (!string.IsNullOrEmpty(registration.StatusComment))
    {
        <div class="mb-3 rounded-lg bg-amber-50 border border-amber-200 px-4 py-2.5 flex items-start gap-2">
            @Icons.Info("h-4 w-4 text-amber-500 mt-0.5 flex-shrink-0")
            <div>
                <span class="text-xs font-semibold text-amber-700 uppercase tracking-wide">Admin Comment</span>
                <p class="text-sm text-amber-800">@registration.StatusComment</p>
            </div>
        </div>
    }
    @if (registration.Status == RegistrationStatus.Withdrawn && !string.IsNullOrEmpty(registration.WithdrawComment))
    {
        <div class="mb-3 rounded-lg bg-red-50 border border-red-200 px-4 py-2.5 flex items-start gap-2">
            @Icons.Warning("h-4 w-4 text-red-500 mt-0.5 flex-shrink-0")
            <div>
                <span class="text-xs font-semibold text-red-700 uppercase tracking-wide">Withdrawal Reason</span>
                <p class="text-sm text-red-800">@registration.WithdrawComment</p>
            </div>
        </div>
    }

    <!-- MAIN 3-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LEFT: DATA SECTIONS (5 cols)                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div class="lg:col-span-5 space-y-3">
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">

                <!-- Competitor -->
                <div class="px-4 py-2.5 border-b border-slate-100 bg-gradient-to-r from-cyan-600 to-cyan-700 rounded-t-xl">
                    <div class="flex items-center gap-2">
                        @Icons.User("h-3.5 w-3.5 text-cyan-200")
                        <span class="text-xs font-semibold text-white uppercase tracking-wide">Competitor</span>
                    </div>
                </div>
                <div class="px-4 py-2.5 space-y-1.5 text-xs">
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Name</span>
                        <span class="text-slate-800 font-medium">@registration.PersonalInfo.FullName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PreferredName))
                    {
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">Preferred</span>
                            <span class="text-slate-800">@registration.PersonalInfo.PreferredName</span>
                        </div>
                    }
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Gender</span>
                        <span class="text-slate-800">@registration.PersonalInfo.Gender</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">DOB / Age</span>
                        <span class="text-slate-800">
                            @registration.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")
                            @if (settings != null)
                            {
                                <span class="text-cyan-600 font-medium ml-1">(@registration.CalculateAgeAsOf(settings.AgeCutoffDate) yrs)</span>
                            }
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Location</span>
                        <span class="text-slate-800">@registration.AddressInfo.FormattedLocation</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(registration.PersonalInfo.PhoneNumber))
                    {
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">Phone</span>
                            <span class="text-slate-800">@FormatPhone(registration.PersonalInfo.PhoneNumber)</span>
                        </div>
                    }
                </div>

                <!-- Competition -->
                <div class="px-4 py-2.5 border-t border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700">
                    <div class="flex items-center gap-2">
                        @Icons.Trophy("h-3.5 w-3.5 text-amber-300")
                        <span class="text-xs font-semibold text-white uppercase tracking-wide">Competition</span>
                        <span class="text-xs text-slate-300 ml-auto">@registration.CompetitionYear</span>
                    </div>
                </div>
                <div class="px-4 py-2.5 space-y-1.5 text-xs">
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Division</span>
                        <span class="text-slate-800 font-medium">@(division?.Name ?? "—")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Category</span>
                        <span class="text-slate-800">@(category?.Name ?? "—")</span>
                    </div>
                    @if (registration.CompetitionSelection.PortionChoice.HasValue)
                    {
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">Portion</span>
                            <span class="text-slate-800">@registration.CompetitionSelection.PortionChoice.Value</span>
                        </div>
                    }
                </div>

                <!-- Parent / Guardian -->
                <div class="px-4 py-2.5 border-t border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700">
                    <div class="flex items-center gap-2">
                        @Icons.Users("h-3.5 w-3.5 text-emerald-300")
                        <span class="text-xs font-semibold text-white uppercase tracking-wide">Parent / Guardian</span>
                    </div>
                </div>
                <div class="px-4 py-2.5 space-y-1.5 text-xs">
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Name</span>
                        <span class="text-slate-800 font-medium">@registration.ParentInfo.FullName</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-medium text-slate-500">Phone</span>
                        <span class="text-slate-800">@FormatPhone(registration.ParentInfo.PhoneNumber)</span>
                    </div>
                </div>

                <!-- Teacher (if present) -->
                @if (registration.TeacherInfo != null)
                {
                    <div class="px-4 py-2.5 border-t border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700">
                        <div class="flex items-center gap-2">
                            @Icons.Building("h-3.5 w-3.5 text-violet-300")
                            <span class="text-xs font-semibold text-white uppercase tracking-wide">Teacher</span>
                        </div>
                    </div>
                    <div class="px-4 py-2.5 space-y-1.5 text-xs">
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">Name</span>
                            <span class="text-slate-800 font-medium">@registration.TeacherInfo.FullName</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="font-medium text-slate-500">Phone</span>
                            <span class="text-slate-800">@FormatPhone(registration.TeacherInfo.PhoneNumber)</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(registration.TeacherInfo.Institution))
                        {
                            <div class="flex justify-between">
                                <span class="font-medium text-slate-500">Institution</span>
                                <span class="text-slate-800">@registration.TeacherInfo.Institution</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- FOOTER: Timestamps + Actions -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4 text-xs text-slate-400">
                        @if (submittedAt.HasValue)
                        {
                            <span>Submitted <span class="text-slate-600 font-medium">@submittedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</span></span>
                        }
                        @if (lastUpdatedAt.HasValue)
                        {
                            <span>Updated <span class="text-slate-600 font-medium">@lastUpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</span></span>
                        }
                    </div>
                    <div class="flex items-center gap-2">
                        @if (canWithdraw && !isAdmin)
                        {
                            <button type="button" @onclick="ShowWithdrawModal"
                                    class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 transition-all">
                                @Icons.Ban("h-3.5 w-3.5")
                                Withdraw
                            </button>
                        }
                        @if (canEdit)
                        {
                            <a href="@(isAdmin ? $"/admin/registration/{registration.Id}/edit" : $"/registration/{registration.Id}/edit")"
                               class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-3 py-1.5 text-xs font-medium hover:from-cyan-700 hover:to-cyan-800 transition-all">
                                @Icons.Edit("h-3.5 w-3.5")
                                Edit
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CENTER: PHOTO & ID (3 cols)                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div class="lg:col-span-3 space-y-3">
            <!-- Photo Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-4 py-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700 rounded-t-xl flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        @Icons.Photo("h-3.5 w-3.5 text-cyan-300")
                        <span class="text-xs font-semibold text-white uppercase tracking-wide">Photo</span>
                    </div>
                    @if (registration.FileUploadInfo.NiqabBypassApproved)
                    {
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-emerald-500/30 text-emerald-200 text-xs font-medium">
                            @Icons.Shield("h-3 w-3")
                            Niqab
                        </span>
                    }
                </div>
                <div class="p-3">
                    @if (!string.IsNullOrEmpty(photoDownloadUrl))
                    {
                        <button type="button" @onclick="() => OpenImageDialog(photoDownloadUrl)"
                                class="relative block w-full cursor-pointer group rounded-lg overflow-hidden">
                            <img src="@photoDownloadUrl" alt="Photo"
                                 class="w-full h-52 object-cover blur-md scale-105" />
                            <div class="absolute inset-0 bg-slate-900/40 flex items-center justify-center group-hover:bg-slate-900/50 transition-colors">
                                <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center group-hover:bg-white/30 transition-colors">
                                    @Icons.Eye("h-5 w-5 text-white")
                                </div>
                            </div>
                        </button>
                        <button type="button" @onclick="() => DownloadFile(photoDownloadUrl)"
                                class="mt-2 w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 text-xs font-medium text-slate-600 hover:text-cyan-700 transition-all cursor-pointer">
                            @Icons.Download("h-3.5 w-3.5")
                            Download Photo
                        </button>
                    }
                    else
                    {
                        <div class="w-full h-52 rounded-lg bg-slate-100 flex items-center justify-center border border-slate-200">
                            @Icons.Photo("h-12 w-12 text-slate-300")
                        </div>
                        <p class="mt-2 text-center text-xs text-slate-400">No photo uploaded</p>
                    }
                </div>
            </div>

            <!-- ID Document Card -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-4 py-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700 rounded-t-xl">
                    <div class="flex items-center gap-2">
                        @Icons.IdCard("h-3.5 w-3.5 text-amber-300")
                        <span class="text-xs font-semibold text-white uppercase tracking-wide">ID Document</span>
                    </div>
                </div>
                <div class="p-3">
                    @if (registration.FileUploadInfo.IdDocument != null && !string.IsNullOrEmpty(idDownloadUrl))
                    {
                        @if (IsImageExtension(registration.FileUploadInfo.IdDocument.Extension))
                        {
                            <button type="button" @onclick="() => OpenImageDialog(idDownloadUrl, viewingId: true)"
                                    class="relative block w-full cursor-pointer group rounded-lg overflow-hidden">
                                <img src="@idDownloadUrl" alt="ID Document"
                                     class="w-full h-36 object-cover blur-md scale-105" />
                                <div class="absolute inset-0 bg-slate-900/40 flex items-center justify-center group-hover:bg-slate-900/50 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center group-hover:bg-white/30 transition-colors">
                                        @Icons.Eye("h-5 w-5 text-white")
                                    </div>
                                </div>
                            </button>
                        }
                        else
                        {
                            <div class="w-full h-24 rounded-lg bg-slate-50 border border-slate-200 flex flex-col items-center justify-center gap-1">
                                @Icons.Document("h-8 w-8 text-slate-400")
                                <span class="text-xs text-slate-500">@registration.FileUploadInfo.IdDocument.Extension.ToUpperInvariant().TrimStart('.') file</span>
                            </div>
                        }
                        <button type="button" @onclick="() => DownloadFile(idDownloadUrl)"
                                class="mt-2 w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 hover:border-cyan-300 hover:bg-cyan-50 text-xs font-medium text-slate-600 hover:text-cyan-700 transition-all cursor-pointer">
                            @Icons.Download("h-3.5 w-3.5")
                            Download ID
                        </button>
                    }
                    else
                    {
                        <div class="w-full h-24 rounded-lg bg-slate-100 flex items-center justify-center border border-slate-200">
                            @Icons.IdCard("h-8 w-8 text-slate-300")
                        </div>
                        <p class="mt-2 text-center text-xs text-slate-400">No ID uploaded</p>
                    }
                </div>
            </div>

            <!-- Video (if present) -->
            @if (registration.FileUploadInfo.Video != null)
            {
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        @Icons.Video("h-4 w-4 text-violet-600")
                        <div>
                            <span class="text-xs font-medium text-slate-800">Recitation Video</span>
                            <span class="text-xs text-slate-400 ml-1">@FormatFileSize(registration.FileUploadInfo.Video.FileSizeBytes)</span>
                        </div>
                    </div>
                    @if (isAdmin && !string.IsNullOrEmpty(videoDownloadUrl))
                    {
                        <button type="button" @onclick="() => DownloadFile(videoDownloadUrl)"
                                class="text-xs font-medium text-cyan-600 hover:text-cyan-700 transition-colors cursor-pointer">
                            Download
                        </button>
                    }
                    else if (!isAdmin)
                    {
                        <span class="text-xs text-slate-400">Admin only</span>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- RIGHT: ACTIVITY TIMELINE (4 cols, admin only)           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <div class="lg:col-span-4">
            @if (isAdmin && auditEntries.Count > 0)
            {
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden h-full flex flex-col">
                    <div class="px-4 py-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700 rounded-t-xl flex items-center justify-between flex-shrink-0">
                        <div class="flex items-center gap-2.5">
                            @Icons.Clock("h-3.5 w-3.5 text-slate-300")
                            <span class="text-xs font-semibold text-white uppercase tracking-wide">Activity</span>
                            <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-white/20 text-xs font-semibold text-white">@auditEntries.Count</span>
                        </div>
                        <a href="/admin/audit/Registration/@registration.Id" class="text-xs text-cyan-300 hover:text-cyan-200 font-medium">
                            View all →
                        </a>
                    </div>
                    <div class="divide-y divide-slate-50 overflow-y-auto flex-1" style="max-height: calc(100vh - 260px)">
                        @foreach (var entry in auditEntries.Take(15))
                        {
                            <div class="px-4 py-2.5 hover:bg-slate-50/50 transition-colors">
                                <div class="flex items-start gap-2.5">
                                    <div class="w-6 h-6 rounded-md @GetAuditActionStyle(entry.Action) flex items-center justify-center flex-shrink-0 mt-0.5">
                                        @GetAuditActionIcon(entry.Action)
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs text-slate-700 leading-relaxed">
                                            <span class="font-semibold">@entry.Action.GetDisplayName()</span>
                                            @if (!string.IsNullOrEmpty(entry.Summary))
                                            {
                                                <span class="text-slate-500"> — @entry.Summary</span>
                                            }
                                        </p>
                                        <p class="text-xs text-slate-400 mt-0.5">
                                            @entry.GetFormattedTimestamp("MMM d 'at' h:mm tt") · @entry.GetActorDescription()
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (!isAdmin)
            {
                <!-- Non-admin users see file info summary instead -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="px-4 py-2.5 border-b border-slate-100 bg-gradient-to-r from-slate-600 to-slate-700 rounded-t-xl">
                        <div class="flex items-center gap-2">
                            @Icons.Document("h-3.5 w-3.5 text-slate-300")
                            <span class="text-xs font-semibold text-white uppercase tracking-wide">Files</span>
                        </div>
                    </div>
                    <div class="p-4 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @Icons.Photo("h-4 w-4 text-slate-400")
                                <span class="text-slate-700">Competitor Photo</span>
                            </div>
                            @if (registration.FileUploadInfo.Photo != null)
                            {
                                @Icons.CheckCircle("h-4 w-4 text-emerald-500")
                            }
                            else
                            {
                                <span class="text-slate-400">Not uploaded</span>
                            }
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @Icons.IdCard("h-4 w-4 text-slate-400")
                                <span class="text-slate-700">ID Document</span>
                            </div>
                            @if (registration.FileUploadInfo.IdDocument != null)
                            {
                                @Icons.CheckCircle("h-4 w-4 text-emerald-500")
                            }
                            else
                            {
                                <span class="text-slate-400">Not uploaded</span>
                            }
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                @Icons.Video("h-4 w-4 text-slate-400")
                                <span class="text-slate-700">Recitation Video</span>
                            </div>
                            @if (registration.FileUploadInfo.Video != null)
                            {
                                @Icons.CheckCircle("h-4 w-4 text-emerald-500")
                            }
                            else
                            {
                                <span class="text-slate-400">Not uploaded</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- IMAGE LIGHTBOX                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    @if (!string.IsNullOrEmpty(dialogImageUrl))
    {
        <div @onclick="CloseDialog" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
            <div class="relative max-w-6xl max-h-[90vh] p-4">
                <img src="@dialogImageUrl" alt="Preview"
                     class="max-w-full max-h-[85vh] rounded-lg shadow-2xl @rotationClass @scaleClass transition-transform duration-200" />

                @if (isViewingId)
                {
                    <div class="absolute bottom-6 left-6 px-4 py-2.5 bg-black/60 backdrop-blur-md rounded-xl shadow-lg" @onclick:stopPropagation>
                        <div class="flex items-center gap-3">
                            @Icons.User("h-4 w-4 text-cyan-400")
                            <div>
                                <p class="text-sm font-semibold text-white leading-tight">@registration!.PersonalInfo.FullName</p>
                                <p class="text-xs text-slate-300 mt-0.5">
                                    DOB: @registration.PersonalInfo.DateOfBirth.ToString("MMMM d, yyyy")
                                    @if (settings != null)
                                    {
                                        <span class="text-cyan-400 ml-1">(@registration.CalculateAgeAsOf(settings.AgeCutoffDate) yrs)</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <div class="absolute top-6 right-6 flex items-center gap-2">
                    <button type="button"
                            class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                            @onclick="RotateImage" @onclick:stopPropagation title="Rotate">
                        @Icons.Refresh("h-5 w-5")
                    </button>
                    <button type="button"
                            class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                            @onclick="ToggleScale" @onclick:stopPropagation title="@(isScaled ? "Zoom in" : "Zoom out")">
                        @Icons.ZoomIn("h-5 w-5")
                    </button>
                    <button type="button"
                            class="cursor-pointer p-3 bg-black/60 hover:bg-black/80 rounded-xl text-white transition-all shadow-lg backdrop-blur-sm"
                            @onclick="CloseDialog" title="Close">
                        @Icons.XMark("h-5 w-5")
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WITHDRAW MODAL                                                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    @if (showWithdrawModal)
    {
        <div class="fixed inset-0 z-50 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4">
                <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm" @onclick="CloseWithdrawModal"></div>
                <div class="relative w-full max-w-md rounded-xl bg-white shadow-2xl">
                    <div class="px-6 py-5 border-b border-slate-200">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow">
                                @Icons.Warning("h-5 w-5 text-white")
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-slate-800">Withdraw Registration</h3>
                                <p class="text-sm text-slate-500">This action cannot be undone</p>
                            </div>
                        </div>
                    </div>
                    <div class="px-6 py-5">
                        <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 mb-4">
                            <div class="text-sm font-medium text-slate-800">@registration.PersonalInfo.FullName</div>
                            <div class="text-sm text-slate-500 mt-0.5">@(division?.Name ?? "—") / @(category?.Name ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(withdrawError))
                        {
                            <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mb-4">
                                <p class="text-sm text-red-700">@withdrawError</p>
                            </div>
                        }
                        <div class="space-y-1.5 mb-4">
                            <label class="text-sm font-medium text-slate-700">Reason for withdrawal <span class="text-red-500">*</span></label>
                            <select @bind="withdrawReasonType"
                                    class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 cursor-pointer">
                                <option value="">Select a reason...</option>
                                <option value="ScheduleConflict">Schedule conflict</option>
                                <option value="HealthRelated">Health-related reason</option>
                                <option value="InsufficientPreparation">Insufficient preparation</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        @if (withdrawReasonType == "Other")
                        {
                            <div class="space-y-1.5">
                                <label class="text-sm font-medium text-slate-700">Please explain <span class="text-red-500">*</span></label>
                                <textarea @bind="withdrawOtherReason" rows="3"
                                          placeholder="Please explain why you are withdrawing..."
                                          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 resize-none"></textarea>
                            </div>
                        }
                    </div>
                    <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-xl">
                        <button type="button" @onclick="CloseWithdrawModal" disabled="@isWithdrawing"
                                class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                            Cancel
                        </button>
                        <button type="button" @onclick="ConfirmWithdraw" disabled="@isWithdrawing"
                                class="cursor-pointer rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-red-700 hover:to-red-800 disabled:opacity-50 transition-all flex items-center gap-2">
                            @if (isWithdrawing)
                            {
                                @Icons.Spinner("h-4 w-4")
                            }
                            Withdraw Registration
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private Registration? registration;
    private Division? division;
    private Category? category;
    private CompetitionSettings? settings;
    private List<AuditEntry> auditEntries = new();

    private bool isLoading = true;
    private bool isAdmin;
    private bool canEdit;
    private bool canWithdraw;

    private string? idDownloadUrl;
    private string? photoDownloadUrl;
    private string? videoDownloadUrl;

    private DateTimeOffset? submittedAt;
    private DateTimeOffset? lastUpdatedAt;

    // Image dialog
    private string? dialogImageUrl;
    private bool isViewingId;
    private string rotationClass = "";
    private string scaleClass = "";
    private bool isScaled = false;
    private int rotationDegrees = 0;

    // Withdraw modal
    private bool showWithdrawModal;
    private string withdrawReasonType = string.Empty;
    private string withdrawOtherReason = string.Empty;
    private bool isWithdrawing;
    private string? withdrawError;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var currentUser = await CurrentUserService.GetCurrentUserAsync();
            if (currentUser == null)
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            isAdmin = currentUser.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            registration = await RegistrationService.GetByIdAsync(Id);

            if (registration == null)
            {
                isLoading = false;
                return;
            }

            if (!isAdmin && registration.CreatorUserId != currentUser.ObjectIdentifier)
            {
                registration = null;
                isLoading = false;
                return;
            }

            settings = await SettingsService.GetSettingsAsync();
            division = settings?.Divisions.FirstOrDefault(d => d.Id == registration.CompetitionSelection.DivisionId);
            category = division?.Categories.FirstOrDefault(c => c.Id == registration.CompetitionSelection.CategoryId);

            canEdit = CanEditRegistration(registration) || isAdmin;
            canWithdraw = CanWithdrawRegistration(registration);

            GenerateDownloadUrls();

            auditEntries = (await AuditService.GetEntityHistoryAsync("Registration", registration.Id)).ToList();

            submittedAt = auditEntries
                .Where(e => e.Action == AuditAction.Submitted || e.Action == AuditAction.Created)
                .OrderBy(e => e.Timestamp)
                .FirstOrDefault()?.Timestamp;

            lastUpdatedAt = auditEntries
                .OrderByDescending(e => e.Timestamp)
                .FirstOrDefault()?.Timestamp;
        }
        finally
        {
            isLoading = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // PERMISSIONS
    // ═══════════════════════════════════════════════════════════════════════════

    private bool CanEditRegistration(Registration reg)
    {
        if (reg.Status != RegistrationStatus.AwaitingReview &&
            reg.Status != RegistrationStatus.Pending)
            return false;

        var cat = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);
        return cat?.AllowEdit ?? true;
    }

    private bool CanWithdrawRegistration(Registration reg)
    {
        if (reg.Status == RegistrationStatus.Withdrawn ||
            reg.Status == RegistrationStatus.Disqualified)
            return false;

        var cat = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);
        return cat?.AllowWithdraw ?? true;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // DOWNLOAD URLS
    // ═══════════════════════════════════════════════════════════════════════════

    private void GenerateDownloadUrls()
    {
        if (registration == null) return;
        var year = registration.CompetitionYear;

        if (registration.FileUploadInfo.IdDocument != null)
            idDownloadUrl = BlobSasService.GenerateSasUriFromReference(registration.FileUploadInfo.IdDocument.StorageReference, year);

        if (registration.FileUploadInfo.Photo != null)
            photoDownloadUrl = BlobSasService.GenerateSasUriFromReference(registration.FileUploadInfo.Photo.StorageReference, year);

        if (registration.FileUploadInfo.Video != null && isAdmin)
            videoDownloadUrl = BlobSasService.GenerateSasUriFromReference(registration.FileUploadInfo.Video.StorageReference, year);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // WITHDRAWAL
    // ═══════════════════════════════════════════════════════════════════════════

    private void ShowWithdrawModal()
    {
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
        showWithdrawModal = true;
    }

    private void CloseWithdrawModal()
    {
        showWithdrawModal = false;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
    }

    private string GetWithdrawReasonText() => withdrawReasonType switch
    {
        "ScheduleConflict" => "Schedule conflict",
        "HealthRelated" => "Health-related reason",
        "InsufficientPreparation" => "Insufficient preparation",
        "Other" => $"Other - {withdrawOtherReason.Trim()}",
        _ => withdrawReasonType
    };

    private async Task ConfirmWithdraw()
    {
        if (registration == null) return;

        if (string.IsNullOrWhiteSpace(withdrawReasonType))
        {
            withdrawError = "Please select a reason for withdrawal.";
            return;
        }

        if (withdrawReasonType == "Other" && string.IsNullOrWhiteSpace(withdrawOtherReason))
        {
            withdrawError = "Please explain your reason for withdrawal.";
            return;
        }

        isWithdrawing = true;
        withdrawError = null;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null) return;

            var reasonText = GetWithdrawReasonText();
            var previousStatus = registration.Status.ToString();

            await AuditContextProvider.SetCurrentUserContextAsync();

            await RegistrationService.WithdrawAsync(registration.Id, user.ObjectIdentifier, reasonText);

            await AuditService.LogFieldChangesAsync(
                "Registration", registration.Id,
                new List<FieldChange>
                {
                    new() { FieldName = "Status", DisplayName = "Status", OldValue = previousStatus, NewValue = RegistrationStatus.Withdrawn.ToString() },
                    new() { FieldName = "WithdrawComment", DisplayName = "Withdrawal Reason", OldValue = null, NewValue = reasonText }
                },
                action: AuditAction.Withdrawn,
                summary: $"Registration withdrawn. Reason: {reasonText}",
                entityDescription: $"{registration.PersonalInfo.FullName} - {division?.Name ?? "Unknown"} / {category?.Name ?? "Unknown"}");

            CloseWithdrawModal();
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            withdrawError = ex.Message;
        }
        catch (Exception)
        {
            withdrawError = "An error occurred while withdrawing the registration.";
        }
        finally
        {
            isWithdrawing = false;
        }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // IMAGE DIALOG
    // ═══════════════════════════════════════════════════════════════════════════

    private void OpenImageDialog(string? imageUrl, bool viewingId = false)
    {
        if (!string.IsNullOrEmpty(imageUrl))
        {
            dialogImageUrl = imageUrl;
            isViewingId = viewingId;
            rotationClass = "";
            scaleClass = "";
            isScaled = false;
            rotationDegrees = 0;
        }
    }

    private void CloseDialog()
    {
        dialogImageUrl = null;
        isViewingId = false;
        rotationClass = "";
        scaleClass = "";
        isScaled = false;
        rotationDegrees = 0;
    }

    private void RotateImage()
    {
        rotationDegrees = (rotationDegrees + 90) % 360;
        rotationClass = rotationDegrees switch
        {
            0 => "",
            90 => "rotate-90",
            180 => "rotate-180",
            270 => "[transform:rotate(270deg)]",
            _ => ""
        };
    }

    private void ToggleScale()
    {
        isScaled = !isScaled;
        scaleClass = isScaled ? "scale-150" : "";
    }

    private void DownloadFile(string? url)
    {
        if (!string.IsNullOrEmpty(url))
            NavigationManager.NavigateTo(url, forceLoad: true);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════════════════════

    private bool IsImageExtension(string extension)
    {
        var exts = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" };
        return exts.Contains(extension.ToLowerInvariant());
    }

    private string FormatPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone) || phone.Length != 10) return phone;
        return $"({phone[..3]}) {phone[3..6]}-{phone[6..]}";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetAuditActionStyle(AuditAction action) => action switch
    {
        AuditAction.Created or AuditAction.Submitted => "bg-cyan-100 text-cyan-700",
        AuditAction.Updated => "bg-slate-100 text-slate-600",
        AuditAction.Approved or AuditAction.Verified => "bg-emerald-100 text-emerald-700",
        AuditAction.Rejected or AuditAction.Deleted => "bg-red-100 text-red-600",
        AuditAction.StatusChanged => "bg-amber-100 text-amber-700",
        AuditAction.EmailSent => "bg-blue-100 text-blue-700",
        _ => "bg-slate-100 text-slate-600"
    };

    private RenderFragment GetAuditActionIcon(AuditAction action) => __builder =>
    {
        @switch (action)
        {
            case AuditAction.Created:
            case AuditAction.Submitted:
                @Icons.Plus("h-3.5 w-3.5")
                break;
            case AuditAction.Updated:
                @Icons.EditSquare("h-3.5 w-3.5")
                break;
            case AuditAction.Approved:
            case AuditAction.Verified:
                @Icons.Check("h-3.5 w-3.5")
                break;
            case AuditAction.Rejected:
            case AuditAction.Deleted:
                @Icons.XMark("h-3.5 w-3.5")
                break;
            case AuditAction.EmailSent:
                @Icons.Envelope("h-3.5 w-3.5")
                break;
            default:
                @Icons.ArrowsRightLeft("h-3.5 w-3.5")
                break;
        }
    };
}
