    private void OpenImageDialog(string? imageUrl)
    {
        if (!string.IsNullOrEmpty(imageUrl))
        {
            dialogImageUrl = imageUrl;
            rotationClass = "";
            scaleClass = "";
            isScaled = false;
        }
    }

    private void CloseDialog()
    {
        dialogImageUrl = null;
        rotationClass = "";
        scaleClass = "";
        isScaled = false;
    }

    private void RotateImage()
    {
        var rotations = new[] { "", "rotate-90", "rotate-180", "-rotate-90" };
        var currentIndex = Array.IndexOf(rotations, rotationClass);
        rotationClass = rotations[(currentIndex + 1) % rotations.Length];
    }

    private void ToggleScale()
    {
        isScaled = !isScaled;
        scaleClass = isScaled ? "scale-75" : "";
    }

    private void DownloadFile(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            NavigationManager.NavigateTo(url, forceLoad: true);
        }
    }

