    private bool IsImageExtension(string extension)
    {
        var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp" };
        return imageExtensions.Contains(extension.ToLowerInvariant());
    }

    private string FormatPhone(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone) || phone.Length != 10)
            return phone;
        return $"({phone[..3]}) {phone[3..6]}-{phone[6..]}";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private string GetAuditActionStyle(AuditAction action) => action switch
    {
        AuditAction.Created or AuditAction.Submitted => "bg-cyan-100 text-cyan-700",
        AuditAction.Updated => "bg-slate-100 text-slate-600",
        AuditAction.Approved or AuditAction.Verified => "bg-emerald-100 text-emerald-700",
        AuditAction.Rejected or AuditAction.Deleted => "bg-red-100 text-red-600",
        AuditAction.StatusChanged => "bg-amber-100 text-amber-700",
        AuditAction.Withdrawn or AuditAction.WithdrawalRequested => "bg-slate-100 text-slate-600",
        _ => "bg-slate-100 text-slate-600"
    };

