@page "/registrations"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using RegistrationSystem.Core.Application.Registrations
@using RegistrationSystem.Core.Application.Settings
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Web.Services

@inject RegistrationService RegistrationService
@inject SettingsService SettingsService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>My Registrations</PageTitle>

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">My Registrations</h1>
            <p class="text-sm text-slate-500 mt-1">@settings?.CompetitionInfo?.CompetitionName — @competitionYear</p>
        </div>
        @if (settings?.RegistrationEnabled == true)
        {
            <a href="/register/new" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg active:scale-[0.98]">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Registration
            </a>
        }
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-cyan-700 border-t-transparent"></div>
                <span class="text-sm text-slate-500">Loading registrations...</span>
            </div>
        </div>
    }
    else if (!registrations.Any())
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center mx-auto mb-5 shadow-lg">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <h2 class="text-xl font-semibold text-slate-800 mb-2">No Registrations Yet</h2>
            <p class="text-slate-600 mb-6 max-w-md mx-auto">You haven't registered any competitors for this year's competition. Start by creating a new registration.</p>
            @if (settings?.RegistrationEnabled == true)
            {
                <a href="/register/new" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-6 py-3 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg active:scale-[0.98]">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Start Registration
                </a>
            }
            else
            {
                <div class="inline-flex items-center gap-2 rounded-xl bg-amber-100 text-amber-800 px-5 py-2.5 text-sm font-medium">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    Registration is currently closed
                </div>
            }
        </div>
    }
    else
    {
        <!-- Filters & Search Bar -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-4 overflow-hidden">
            <div class="p-4">
                <div class="flex flex-col lg:flex-row gap-4">
                    <!-- Search -->
                    <div class="flex-1">
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   placeholder="Search by competitor name..."
                                   class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="flex flex-wrap gap-3">
                        <!-- Division Filter -->
                        <select @bind="filterDivision" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Divisions</option>
                            @foreach (var div in GetUniqueDivisions())
                            {
                                <option value="@div.Id">@div.Name</option>
                            }
                        </select>

                        <!-- Status Filter -->
                        <select @bind="filterStatus" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Statuses</option>
                            @foreach (RegistrationStatus status in Enum.GetValues<RegistrationStatus>())
                            {
                                <option value="@status">@GetStatusDisplayName(status)</option>
                            }
                        </select>

                        <!-- Gender Filter -->
                        <select @bind="filterGender" class="rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Genders</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>

                        @if (HasActiveFilters)
                        {
                            <button type="button" class="cursor-pointer text-sm text-slate-500 hover:text-slate-700 px-3 py-2.5 flex items-center gap-1" @onclick="ClearFilters">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                Clear
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Results Count -->
            <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-sm">
                <span class="text-slate-600">
                    Showing <span class="font-semibold text-slate-800">@FilteredRegistrations.Count()</span> of <span class="font-semibold text-slate-800">@registrations.Count</span> registrations
                </span>
            </div>
        </div>

        <!-- Registrations Table -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
                            <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Competitor</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Competition</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Location</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Message</th>
                            <th class="text-right px-4 py-3 text-xs font-semibold text-slate-600 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var reg in FilteredRegistrations)
                        {
                            var division = settings?.FindDivision(reg.CompetitionSelection.DivisionId);
                            var category = division?.FindCategory(reg.CompetitionSelection.CategoryId);

                            <tr class="hover:bg-slate-50 transition-colors">
                                <!-- Competitor -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-1.5 h-10 rounded-full @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-500" : "bg-pink-500")"></div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-slate-800">@reg.PersonalInfo.FullName</span>
                                                @if (!string.IsNullOrEmpty(reg.Cid))
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-mono">@reg.Cid</span>
                                                }
                                            </div>
                                            <div class="text-xs text-slate-500 flex items-center gap-2">
                                                <span>@reg.PersonalInfo.Gender</span>
                                                <span class="text-slate-300">•</span>
                                                <span>@reg.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")</span>
                                                @if (settings != null)
                                                {
                                                    <span class="text-slate-300">•</span>
                                                    <span class="text-cyan-600 font-medium">@reg.CalculateAgeAsOf(settings.AgeCutoffDate) yrs</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Competition -->
                                <td class="px-4 py-4">
                                    <div class="text-sm">
                                        <div class="font-medium text-slate-800">@(division?.Name ?? "—")</div>
                                        <div class="text-xs text-slate-500 flex items-center gap-1">
                                            <span>@(category?.Name ?? "—")</span>
                                            @if (reg.CompetitionSelection.PortionChoice.HasValue)
                                            {
                                                <span class="text-slate-300">•</span>
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs">
                                                    @(reg.CompetitionSelection.PortionChoice == PortionChoice.Top ? "▲" : "▼") @reg.CompetitionSelection.PortionChoice
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Location -->
                                <td class="px-4 py-4">
                                    <div class="text-sm">
                                        @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                                        {
                                            <div class="text-slate-700">@reg.AddressInfo.City, @reg.AddressInfo.StateProvince</div>
                                            <div class="text-xs text-slate-500">@reg.AddressInfo.Country</div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">—</span>
                                        }
                                    </div>
                                </td>

                                <!-- Status -->
                                <td class="px-4 py-4">
                                    @RenderStatusBadge(reg.Status)
                                </td>

                                <!-- Message -->
                                <td class="px-4 py-4">
                                    <div class="text-sm text-slate-500 max-w-[200px] truncate">
                                        @if (!string.IsNullOrEmpty(reg.StatusComment))
                                        {
                                            @reg.StatusComment
                                        }
                                        else if (!string.IsNullOrEmpty(reg.WithdrawComment))
                                        {
                                            @reg.WithdrawComment
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">—</span>
                                        }
                                    </div>
                                </td>

                                <!-- Actions -->
                                <td class="px-4 py-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <!-- Details - Always visible -->
                                        <a href="/registration/@reg.Id" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-800 hover:bg-slate-100 transition-colors">
                                            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            Details
                                        </a>

                                        @{
                                            var canEditStatus = reg.CanEdit;
                                            var canWithdrawStatus = reg.CanWithdraw;
                                            var categoryAllowsEdit = category?.AllowEdit ?? true;
                                            var categoryAllowsWithdraw = category?.AllowWithdraw ?? true;
                                        }

                                        <!-- Edit - Visible when status allows AND category allows -->
                                        @if (canEditStatus && categoryAllowsEdit)
                                        {
                                            <a href="/registration/@reg.Id/edit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-cyan-700 hover:text-cyan-800 hover:bg-cyan-50 transition-colors">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Edit
                                            </a>
                                        }

                                        <!-- Withdraw - Visible when status allows AND category allows -->
                                        @if (canWithdrawStatus && categoryAllowsWithdraw)
                                        {
                                            <button type="button"
                                                    class="cursor-pointer inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium text-red-600 hover:text-red-700 hover:bg-red-50 transition-colors"
                                                    @onclick="() => ShowWithdrawModal(reg)">
                                                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                </svg>
                                                Withdraw
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!FilteredRegistrations.Any())
            {
                <div class="px-4 py-12 text-center">
                    <svg class="h-12 w-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <p class="text-slate-500">No registrations match your filters.</p>
                    <button type="button" class="cursor-pointer mt-2 text-sm text-cyan-700 hover:text-cyan-800 font-medium" @onclick="ClearFilters">Clear filters</button>
                </div>
            }
        </div>
    }
</div>

<!-- Withdraw Confirmation Modal -->
@if (showWithdrawModal && withdrawingRegistration != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <!-- Backdrop -->
            <div class="fixed inset-0 bg-slate-900/50 transition-opacity" @onclick="CloseWithdrawModal"></div>

            <!-- Modal -->
            <div class="relative w-full max-w-md rounded-2xl bg-white shadow-2xl">
                <div class="px-6 py-5 border-b border-slate-200">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow">
                            <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-slate-800">Withdraw Registration</h3>
                            <p class="text-sm text-slate-500">This action cannot be undone</p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-5">
                    <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 mb-4">
                        <div class="text-sm">
                            <div class="font-medium text-slate-800">@withdrawingRegistration.PersonalInfo.FullName</div>
                            <div class="text-slate-500 mt-1">
                                @{
                                    var div = settings?.FindDivision(withdrawingRegistration.CompetitionSelection.DivisionId);
                                    var cat = div?.FindCategory(withdrawingRegistration.CompetitionSelection.CategoryId);
                                }
                                @(div?.Name ?? "—") / @(cat?.Name ?? "—")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(withdrawError))
                    {
                        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mb-4">
                            <p class="text-sm text-red-700">@withdrawError</p>
                        </div>
                    }

                    <!-- Reason Dropdown -->
                    <div class="space-y-1.5 mb-4">
                        <label class="text-sm font-medium text-slate-700">Reason for withdrawal <span class="text-red-500">*</span></label>
                        <select @bind="withdrawReasonType"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 cursor-pointer">
                            <option value="">Select a reason...</option>
                            <option value="NotReady">Not ready to compete this year</option>
                            <option value="MaybeInFuture">Maybe in the future</option>
                            <option value="Duplicate">Duplicate registration</option>
                            <option value="WantToRestart">Want to restart registration</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Alert for "Want to restart" -->
                    @if (withdrawReasonType == "WantToRestart")
                    {
                        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 mb-4">
                            <div class="flex gap-3">
                                <svg class="h-5 w-5 text-amber-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                <div class="text-sm">
                                    <p class="font-medium text-amber-800">Consider editing instead</p>
                                    <p class="text-amber-700 mt-1">
                                        @if (withdrawingRegistration.CanEdit)
                                        {
                                            <span>You can <a href="/registration/@withdrawingRegistration.Id/edit" class="underline font-medium hover:text-amber-900">edit this registration</a> to make changes without withdrawing.</span>
                                        }
                                        else
                                        {
                                            <span>Please contact us to request changes to your registration instead of creating a duplicate.</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Other reason text field -->
                    @if (withdrawReasonType == "Other")
                    {
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-slate-700">Please explain <span class="text-red-500">*</span></label>
                            <textarea @bind="withdrawOtherReason"
                                      rows="3"
                                      placeholder="Please explain why you are withdrawing this registration..."
                                      class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 resize-none"></textarea>
                        </div>
                    }
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-2xl">
                    <button type="button"
                            class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                            @onclick="CloseWithdrawModal"
                            disabled="@isWithdrawing">
                        Cancel
                    </button>
                    <button type="button"
                            class="cursor-pointer rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-red-700 hover:to-red-800 disabled:opacity-50 transition-all flex items-center gap-2"
                            @onclick="ConfirmWithdraw"
                            disabled="@isWithdrawing">
                        @if (isWithdrawing)
                        {
                            <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" />
                            </svg>
                        }
                        Withdraw Registration
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private CompetitionSettings? settings;
    private int competitionYear;
    private IReadOnlyList<Registration> registrations = Array.Empty<Registration>();

    // Filters
    private string searchQuery = string.Empty;
    private string filterDivision = string.Empty;
    private string filterStatus = string.Empty;
    private string filterGender = string.Empty;

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchQuery) ||
                                      !string.IsNullOrEmpty(filterDivision) ||
                                      !string.IsNullOrEmpty(filterStatus) ||
                                      !string.IsNullOrEmpty(filterGender);

    private IEnumerable<Registration> FilteredRegistrations
    {
        get
        {
            var result = registrations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim().ToLowerInvariant();
                result = result.Where(r =>
                    r.PersonalInfo.FullName.ToLowerInvariant().Contains(query) ||
                    (r.PersonalInfo.PreferredName?.ToLowerInvariant().Contains(query) ?? false));
            }

            if (!string.IsNullOrEmpty(filterDivision))
            {
                result = result.Where(r => r.CompetitionSelection.DivisionId == filterDivision);
            }

            if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<RegistrationStatus>(filterStatus, out var status))
            {
                result = result.Where(r => r.Status == status);
            }

            if (!string.IsNullOrEmpty(filterGender) && Enum.TryParse<Gender>(filterGender, out var gender))
            {
                result = result.Where(r => r.PersonalInfo.Gender == gender);
            }

            return result.OrderByDescending(r => r.CreatedAt);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null) return;

            settings = await SettingsService.GetSettingsAsync();
            competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

            registrations = await RegistrationService.GetUserRegistrationsAsync(user.ObjectIdentifier, competitionYear);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<Division> GetUniqueDivisions()
    {
        var divisionIds = registrations
            .Select(r => r.CompetitionSelection.DivisionId)
            .Where(id => !string.IsNullOrEmpty(id))
            .Distinct();

        return divisionIds
            .Select(id => settings?.FindDivision(id))
            .Where(d => d != null)!;
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        filterDivision = string.Empty;
        filterStatus = string.Empty;
        filterGender = string.Empty;
    }

    private static string GetStatusDisplayName(RegistrationStatus status) => status switch
    {
        RegistrationStatus.AwaitingReview => "Awaiting Review",
        RegistrationStatus.Pending => "Pending",
        RegistrationStatus.Reviewed => "Reviewed",
        RegistrationStatus.Verified => "Verified",
        RegistrationStatus.Withdrawn => "Withdrawn",
        RegistrationStatus.Disqualified => "Disqualified",
        _ => status.ToString()
    };

    // Withdraw modal state
    private bool showWithdrawModal;
    private Registration? withdrawingRegistration;
    private string withdrawReasonType = string.Empty;
    private string withdrawOtherReason = string.Empty;
    private bool isWithdrawing;
    private string? withdrawError;

    private void ShowWithdrawModal(Registration registration)
    {
        withdrawingRegistration = registration;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
        showWithdrawModal = true;
    }

    private void CloseWithdrawModal()
    {
        showWithdrawModal = false;
        withdrawingRegistration = null;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
    }

    private string GetWithdrawReasonText() => withdrawReasonType switch
    {
        "NotReady" => "Not ready to compete this year",
        "MaybeInFuture" => "Maybe in the future",
        "Duplicate" => "Duplicate registration",
        "WantToRestart" => "Want to restart registration",
        "Other" => $"Other - {withdrawOtherReason.Trim()}",
        _ => string.Empty
    };

    private async Task ConfirmWithdraw()
    {
        if (withdrawingRegistration == null) return;

        // Validate selection
        if (string.IsNullOrWhiteSpace(withdrawReasonType))
        {
            withdrawError = "Please select a reason for withdrawal.";
            return;
        }

        // Validate "Other" has explanation
        if (withdrawReasonType == "Other" && string.IsNullOrWhiteSpace(withdrawOtherReason))
        {
            withdrawError = "Please explain your reason for withdrawal.";
            return;
        }

        isWithdrawing = true;
        withdrawError = null;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null) return;

            var reasonText = GetWithdrawReasonText();

            await RegistrationService.WithdrawAsync(
                withdrawingRegistration.Id,
                user.ObjectIdentifier,
                reasonText);

            CloseWithdrawModal();
            await LoadDataAsync();
        }
        catch (InvalidOperationException ex)
        {
            withdrawError = ex.Message;
        }
        catch (Exception)
        {
            withdrawError = "An error occurred while withdrawing the registration.";
        }
        finally
        {
            isWithdrawing = false;
        }
    }

    private RenderFragment RenderStatusBadge(RegistrationStatus status) => __builder =>
    {
        var (bgClass, textClass, icon) = status switch
        {
            RegistrationStatus.AwaitingReview => ("bg-amber-100", "text-amber-700", "clock"),
            RegistrationStatus.Pending => ("bg-orange-100", "text-orange-700", "warning"),
            RegistrationStatus.Reviewed => ("bg-cyan-100", "text-cyan-700", "check"),
            RegistrationStatus.Verified => ("bg-emerald-100", "text-emerald-700", "shield"),
            RegistrationStatus.Withdrawn => ("bg-slate-100", "text-slate-500", "ban"),
            RegistrationStatus.Disqualified => ("bg-red-100", "text-red-700", "x"),
            _ => ("bg-slate-100", "text-slate-600", "circle")
        };

        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium @bgClass @textClass">
            @switch (icon)
            {
                case "clock":
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    break;
                case "warning":
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                    break;
                case "check":
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                    break;
                case "shield":
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                    break;
                case "ban":
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                    break;
                case "x":
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                    break;
            }
            @GetStatusDisplayName(status)
        </span>
    };
}
