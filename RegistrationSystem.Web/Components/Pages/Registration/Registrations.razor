@page "/registrations"
@attribute [Authorize]

@inject RegistrationService RegistrationService
@inject CompetitionProgressService CompetitionProgressService
@inject SettingsService SettingsService
@inject CurrentUserService CurrentUserService
@inject NavigationManager NavigationManager
@inject IAuditService AuditService
@inject BlazorAuditContextProvider AuditContextProvider
@implements IDisposable

<PageTitle>My Registrations</PageTitle>

<div>
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">@(showAllRegistrations && isAdmin ? "All Registrations" : "My Registrations")</h1>
            <p class="text-sm text-slate-500 mt-1">@settings?.CompetitionInfo?.CompetitionName — @competitionYear</p>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <!-- Admin Toggle -->
            @if (isAdmin)
            {
                <div class="flex items-center rounded-xl border border-slate-200 bg-white p-1 shadow-sm">
                    <button type="button"
                            class="cursor-pointer flex-1 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-all @(showAllRegistrations ? "bg-cyan-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-50")"
                            @onclick="() => SetViewMode(true)">
                        @Icons.Users("h-4 w-4")
                        All
                    </button>
                    <button type="button"
                            class="cursor-pointer flex-1 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-all @(!showAllRegistrations ? "bg-cyan-600 text-white shadow-sm" : "text-slate-600 hover:bg-slate-50")"
                            @onclick="() => SetViewMode(false)">
                        @Icons.User("h-4 w-4")
                        Mine
                    </button>
                </div>
            }

            @if (settings?.RegistrationEnabled == true)
            {
                <a href="/register/new" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg active:scale-[0.98]">
                    @Icons.Plus("h-4 w-4")
                    New Registration
                </a>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-16">
            <div class="flex flex-col items-center gap-3">
                @Icons.Spinner("h-8 w-8 text-cyan-700 animate-spin")
                <span class="text-sm text-slate-500">Loading registrations...</span>
            </div>
        </div>
    }
    else if (!registrations.Any())
    {
        <!-- Empty State -->
        <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-12 text-center shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-500 to-cyan-700 flex items-center justify-center mx-auto mb-5 shadow-lg">
                @Icons.Document("h-8 w-8 text-white")
            </div>
            <h2 class="text-xl font-semibold text-slate-800 mb-2">No Registrations Yet</h2>
            <p class="text-slate-600 mb-6 max-w-md mx-auto">
                @if (showAllRegistrations && isAdmin)
                {
                    <span>No registrations have been submitted for this year's competition yet.</span>
                }
                else
                {
                    <span>You haven't registered any competitors for this year's competition. Start by creating a new registration.</span>
                }
            </p>
            @if (settings?.RegistrationEnabled == true)
            {
                <a href="/register/new" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-6 py-3 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg active:scale-[0.98]">
                    @Icons.Plus("h-5 w-5")
                    Start Registration
                </a>
            }
            else
            {
                <div class="inline-flex items-center gap-2 rounded-xl bg-amber-100 text-amber-800 px-5 py-2.5 text-sm font-medium">
                    @Icons.Warning("h-4 w-4")
                    Registration is currently closed
                </div>
            }
        </div>
    }
    else
    {
        <!-- Filters & Search Bar -->
        <div class="rounded-xl border border-slate-200 bg-white shadow-sm mb-4">
            <div class="p-4">
                <div class="flex flex-col lg:flex-row gap-3">
                    <!-- Search -->
                    <div class="flex-1">
                        <div class="relative">
                            @Icons.Search("absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400")
                            <input type="text"
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   placeholder="Search by competitor name..."
                                   class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" />
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="flex flex-col sm:flex-row gap-2.5">
                        <select @bind="filterDivision" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Divisions</option>
                            @foreach (var div in GetUniqueDivisions())
                            {
                                <option value="@div.Id">@div.Name</option>
                            }
                        </select>

                        <select @bind="filterStatus" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Statuses</option>
                            @foreach (var status in GetUniqueStatuses())
                            {
                                <option value="@status">@StatusBadge.GetDisplayName(status)</option>
                            }
                        </select>

                        <select @bind="filterGender" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500">
                            <option value="">All Genders</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>

                        @if (HasActiveFilters)
                        {
                            <button type="button" class="cursor-pointer text-sm text-slate-500 hover:text-slate-700 px-3 py-2.5 flex items-center gap-1 self-center" @onclick="ClearFilters">
                                @Icons.XMark("h-4 w-4")
                                Clear
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Results Count -->
            <div class="px-4 py-2.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-sm rounded-b-xl">
                <span class="text-slate-600">
                    Showing <span class="font-semibold text-slate-800">@FilteredRegistrations.Count()</span> of <span class="font-semibold text-slate-800">@registrations.Count</span> registrations
                    @if (showAllRegistrations && isAdmin)
                    {
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-cyan-100 text-cyan-800">All Users</span>
                    }
                </span>
            </div>
        </div>

        <!-- Mobile Card List -->
        <div class="md:hidden space-y-3">
            @foreach (var reg in FilteredRegistrations)
            {
                var division = settings?.FindDivision(reg.CompetitionSelection.DivisionId);
                var category = division?.FindCategory(reg.CompetitionSelection.CategoryId);
                var hasNotification = HasRoundNotification(reg.Id);
                var hasUnacknowledged = HasUnacknowledgedRound(reg.Id);

                <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                    <!-- Tappable main area → details -->
                    <a href="/registration/@reg.Id" class="block">
                        <!-- Card Header -->
                        <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-4 py-3">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="w-1.5 h-8 rounded-full flex-shrink-0 @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-400" : "bg-pink-400")"></div>
                                <div class="min-w-0 flex-1">
                                    <span class="font-semibold text-white truncate block">@reg.PersonalInfo.FullName</span>
                                    <div class="flex items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(reg.Cid))
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-600 text-slate-300 text-xs font-mono">
                                                @reg.Cid
                                            </span>
                                        }
                                        <StatusBadge Status="reg.Status" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="px-4 py-3 space-y-2">
                            <!-- Division / Category -->
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <div class="text-sm font-medium text-slate-800">@(division?.Name ?? "—")</div>
                                    <div class="text-xs text-slate-500 flex items-center gap-1 flex-wrap mt-0.5">
                                        <span>@(category?.Name ?? "—")</span>
                                        @if (reg.CompetitionSelection.PortionChoice.HasValue)
                                        {
                                            <span class="text-slate-300">•</span>
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs">
                                                @(reg.CompetitionSelection.PortionChoice == PortionChoice.Top ? "▲" : "▼") @reg.CompetitionSelection.PortionChoice
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="text-right flex-shrink-0 text-xs text-slate-500">
                                    <span>@reg.PersonalInfo.Gender</span>
                                    @if (settings != null)
                                    {
                                        <span class="text-slate-300 mx-1">•</span>
                                        <span class="text-cyan-600 font-medium">@reg.CalculateAgeAsOf(settings.AgeCutoffDate) yrs</span>
                                    }
                                </div>
                            </div>

                            <!-- Location -->
                            @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                            {
                                <div class="flex items-center gap-1.5 text-xs text-slate-500">
                                    @Icons.MapPin("h-3.5 w-3.5 flex-shrink-0 text-slate-400")
                                    <span>@reg.AddressInfo.City, @reg.AddressInfo.StateProvince</span>
                                </div>
                            }
                        </div>
                    </a>

                    <!-- Action footer (not part of the tap target) -->
                    <div class="px-4 py-2.5 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            @if (CanEdit(reg))
                            {
                                <a href="/registration/@reg.Id/edit"
                                   class="inline-flex items-center gap-1.5 text-sm text-slate-600 font-medium">
                                    @Icons.EditSquare("h-4 w-4")
                                    Edit
                                </a>
                            }

                            @if (hasNotification)
                            {
                                <a href="/registrations/@reg.Id/messages" class="relative inline-flex items-center gap-1.5 text-sm text-slate-600 font-medium">
                                    @Icons.Envelope("h-4 w-4")
                                    Messages
                                    @if (hasUnacknowledged)
                                    {
                                        <span class="inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                                    }
                                </a>
                            }
                        </div>

                        @if (CanWithdraw(reg))
                        {
                            <button type="button"
                                    @onclick="() => ShowWithdrawModal(reg)"
                                    class="cursor-pointer inline-flex items-center gap-1.5 text-sm text-red-500 font-medium">
                                @Icons.Ban("h-4 w-4")
                                Withdraw
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!FilteredRegistrations.Any())
            {
                <div class="rounded-xl border border-slate-200 bg-white shadow-sm px-4 py-12 text-center">
                    @Icons.Search("h-12 w-12 text-slate-300 mx-auto mb-3")
                    <p class="text-slate-500">No registrations match your filters.</p>
                    <button type="button" class="cursor-pointer mt-2 text-sm text-cyan-700 hover:text-cyan-800 font-medium" @onclick="ClearFilters">Clear filters</button>
                </div>
            }
        </div>

        <!-- Desktop Table -->
        <div class="hidden md:block rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="bg-gradient-to-r from-slate-700 to-slate-800">
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Competitor</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Competition</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Location</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Status</th>
                            <th class="text-left px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider">Message</th>
                            <th class="text-center px-4 py-3.5 text-xs font-semibold text-slate-300 uppercase tracking-wider w-32">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var reg in FilteredRegistrations)
                        {
                            var division = settings?.FindDivision(reg.CompetitionSelection.DivisionId);
                            var category = division?.FindCategory(reg.CompetitionSelection.CategoryId);

                            <tr class="hover:bg-slate-50 transition-colors">
                                <!-- Competitor -->
                                <td class="px-4 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-1.5 h-10 rounded-full flex-shrink-0 @(reg.PersonalInfo.Gender == Gender.Male ? "bg-cyan-500" : "bg-pink-500")"></div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2">
                                                <span class="font-medium text-slate-800 truncate max-w-[200px]"
                                                      title="@reg.PersonalInfo.FullName">
                                                    @reg.PersonalInfo.FullName
                                                </span>
                                                @if (!string.IsNullOrEmpty(reg.Cid))
                                                {
                                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-mono whitespace-nowrap flex-shrink-0">
                                                        @reg.Cid
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-xs text-slate-500 flex items-center gap-2">
                                                <span>@reg.PersonalInfo.Gender</span>
                                                <span class="text-slate-300">•</span>
                                                <span class="whitespace-nowrap">@reg.PersonalInfo.DateOfBirth.ToString("MMM d, yyyy")</span>
                                                @if (settings != null)
                                                {
                                                    <span class="text-slate-300">•</span>
                                                    <span class="text-cyan-600 font-medium whitespace-nowrap">@reg.CalculateAgeAsOf(settings.AgeCutoffDate) yrs</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Competition -->
                                <td class="px-4 py-4">
                                    <div class="text-sm">
                                        <div class="font-medium text-slate-800">@(division?.Name ?? "—")</div>
                                        <div class="text-xs text-slate-500 flex items-center gap-1 flex-wrap">
                                            <span>@(category?.Name ?? "—")</span>
                                            @if (reg.CompetitionSelection.PortionChoice.HasValue)
                                            {
                                                <span class="text-slate-300">•</span>
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs whitespace-nowrap">
                                                    @(reg.CompetitionSelection.PortionChoice == PortionChoice.Top ? "▲" : "▼") @reg.CompetitionSelection.PortionChoice
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Location -->
                                <td class="px-4 py-4">
                                    <div class="text-sm">
                                        @if (!string.IsNullOrEmpty(reg.AddressInfo.City))
                                        {
                                            <div class="text-slate-700">@reg.AddressInfo.City, @reg.AddressInfo.StateProvince</div>
                                            <div class="text-xs text-slate-500">@reg.AddressInfo.Country</div>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">—</span>
                                        }
                                    </div>
                                </td>

                                <!-- Status -->
                                <td class="px-4 py-4">
                                    <StatusBadge Status="reg.Status" />
                                </td>

                                <!-- Message -->
                                <td class="px-4 py-4">
                                    @{
                                        var hasNotification = HasRoundNotification(reg.Id);
                                        var hasUnacknowledged = HasUnacknowledgedRound(reg.Id);
                                    }
                                    @if (hasNotification)
                                    {
                                        <a href="/registrations/@reg.Id/messages" class="inline-flex items-center gap-2 group">
                                            <div class="relative">
                                                @Icons.Inbox("h-5 w-5 text-slate-400 group-hover:text-cyan-600 transition-colors")
                                                @if (hasUnacknowledged)
                                                {
                                                    <span class="absolute -top-1 -right-1 flex h-3 w-3">
                                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                                        <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500 ring-2 ring-white"></span>
                                                    </span>
                                                }
                                            </div>
                                            <span class="text-sm text-slate-600 group-hover:text-cyan-700 transition-colors whitespace-nowrap">Messages</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 text-sm">—</span>
                                    }
                                </td>

                                <!-- Actions - Icon Buttons -->
                                <td class="px-4 py-4 whitespace-nowrap text-right">
                                    <div class="inline-flex items-center gap-1 justify-end">
                                        <a href="/registration/@reg.Id"
                                           class="p-2 text-slate-400 hover:text-teal-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200"
                                           title="View Details">
                                            @Icons.Eye("h-4.5 w-4.5")
                                        </a>

                                        @if (CanEdit(reg))
                                        {
                                            <a href="/registration/@reg.Id/edit"
                                               class="p-2 text-slate-400 hover:text-teal-600 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200"
                                               title="Edit Registration">
                                                @Icons.EditSquare("h-4.5 w-4.5")
                                            </a>
                                        }

                                        @if (CanWithdraw(reg))
                                        {
                                            <button type="button"
                                                    @onclick="() => ShowWithdrawModal(reg)"
                                                    class="p-2 text-slate-400 hover:text-red-500 hover:bg-white hover:shadow-sm hover:ring-1 hover:ring-slate-200 rounded-full transition-all duration-200 cursor-pointer"
                                                    title="Withdraw Registration">
                                                @Icons.Ban("h-4.5 w-4.5")
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!FilteredRegistrations.Any())
            {
                <div class="px-4 py-12 text-center">
                    @Icons.Search("h-12 w-12 text-slate-300 mx-auto mb-3")
                    <p class="text-slate-500">No registrations match your filters.</p>
                    <button type="button" class="cursor-pointer mt-2 text-sm text-cyan-700 hover:text-cyan-800 font-medium" @onclick="ClearFilters">Clear filters</button>
                </div>
            }
        </div>
    }
</div>

<!-- Admin Toast Notification -->
<Toast Visible="@showAdminToast" DurationMs="3000" OnDismissed="() => showAdminToast = false">
    <a href="/admin/registrations"
       class="flex items-center gap-3 rounded-xl bg-slate-800 text-white pl-4 pr-5 py-3 shadow-xl hover:bg-slate-700 transition-colors">
        @Icons.InfoCircleOutline("h-5 w-5 text-cyan-400 flex-shrink-0")
        <span class="text-sm font-medium">Check out <strong>Admin Registration List</strong> for more functionality</span>
        @Icons.Chevron("h-4 w-4 text-slate-400 flex-shrink-0")
    </a>
</Toast>

<!-- Withdraw Confirmation Modal -->
@if (showWithdrawModal && withdrawingRegistration != null)
{
    <div class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <!-- Backdrop -->
            <div class="fixed inset-0 bg-slate-900/50 transition-opacity" @onclick="CloseWithdrawModal"></div>

            <!-- Modal -->
            <div class="relative w-full max-w-md rounded-xl bg-white shadow-2xl">
                <div class="px-6 py-5 border-b border-slate-200">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center shadow">
                            @Icons.Warning("h-5 w-5 text-white")
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-slate-800">Withdraw Registration</h3>
                            <p class="text-sm text-slate-500">This action cannot be undone</p>
                        </div>
                    </div>
                </div>

                <div class="px-6 py-5">
                    <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 mb-4">
                        <div class="text-sm">
                            <div class="font-medium text-slate-800">@withdrawingRegistration.PersonalInfo.FullName</div>
                            <div class="text-slate-500 mt-1">
                                @{
                                    var div = settings?.FindDivision(withdrawingRegistration.CompetitionSelection.DivisionId);
                                    var cat = div?.FindCategory(withdrawingRegistration.CompetitionSelection.CategoryId);
                                }
                                @(div?.Name ?? "—") / @(cat?.Name ?? "—")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(withdrawError))
                    {
                        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 mb-4">
                            <p class="text-sm text-red-700">@withdrawError</p>
                        </div>
                    }

                    <!-- Reason Dropdown -->
                    <div class="space-y-1.5 mb-4">
                        <label class="text-sm font-medium text-slate-700">Reason for withdrawal <span class="text-red-500">*</span></label>
                        <select @bind="withdrawReasonType"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 cursor-pointer">
                            <option value="">Select a reason...</option>
                            <option value="ScheduleConflict">Schedule conflict</option>
                            <option value="HealthRelated">Health-related reason</option>
                            <option value="InsufficientPreparation">Insufficient preparation</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Other reason text field -->
                    @if (withdrawReasonType == "Other")
                    {
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-slate-700">Please explain <span class="text-red-500">*</span></label>
                            <textarea @bind="withdrawOtherReason"
                                      rows="3"
                                      placeholder="Please explain why you are withdrawing this registration..."
                                      class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 resize-none"></textarea>
                        </div>
                    }
                </div>

                <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end gap-3 rounded-b-xl">
                    <button type="button"
                            class="cursor-pointer rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors"
                            @onclick="CloseWithdrawModal"
                            disabled="@isWithdrawing">
                        Cancel
                    </button>
                    <button type="button"
                            class="cursor-pointer rounded-xl bg-gradient-to-r from-red-600 to-red-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-red-700 hover:to-red-800 disabled:opacity-50 transition-all flex items-center gap-2"
                            @onclick="ConfirmWithdraw"
                            disabled="@isWithdrawing">
                        @if (isWithdrawing)
                        {
                            @Icons.Spinner("animate-spin h-4 w-4")
                        }
                        Withdraw Registration
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private CompetitionSettings? settings;
    private int competitionYear;
    private IReadOnlyList<Registration> registrations = Array.Empty<Registration>();
    private IReadOnlyDictionary<string, CompetitionProgress> competitionProgress = new Dictionary<string, CompetitionProgress>();
    private bool isAdmin;
    private bool showAllRegistrations = false;
    private string? currentUserId;

    // Admin toast
    private bool showAdminToast;

    // Filters
    private string searchQuery = string.Empty;
    private string filterDivision = string.Empty;
    private string filterStatus = string.Empty;
    private string filterGender = string.Empty;

    private bool HasActiveFilters => !string.IsNullOrEmpty(searchQuery) ||
                                      !string.IsNullOrEmpty(filterDivision) ||
                                      !string.IsNullOrEmpty(filterStatus) ||
                                      !string.IsNullOrEmpty(filterGender);

    private IEnumerable<Registration> FilteredRegistrations
    {
        get
        {
            var result = registrations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var query = searchQuery.Trim().ToLowerInvariant();
                var queryParts = query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                result = result.Where(r =>
                {
                    var fullName = r.PersonalInfo.FullName.ToLowerInvariant();
                    var firstName = r.PersonalInfo.FirstName.ToLowerInvariant();
                    var lastName = r.PersonalInfo.LastName.ToLowerInvariant();
                    var preferredName = r.PersonalInfo.PreferredName?.ToLowerInvariant() ?? "";

                    // Direct match against full name or preferred name
                    if (fullName.Contains(query) || preferredName.Contains(query))
                        return true;

                    // Multi-word search: each query part must match first, middle, last, or preferred name
                    // This allows "John Smith" to match "John Michael Smith"
                    if (queryParts.Length > 1)
                    {
                        var middleName = r.PersonalInfo.MiddleName?.ToLowerInvariant() ?? "";
                        return queryParts.All(part =>
                            firstName.Contains(part) ||
                            middleName.Contains(part) ||
                            lastName.Contains(part) ||
                            preferredName.Contains(part));
                    }

                    return false;
                });
            }

            if (!string.IsNullOrEmpty(filterDivision))
            {
                result = result.Where(r => r.CompetitionSelection.DivisionId == filterDivision);
            }

            if (!string.IsNullOrEmpty(filterStatus) && Enum.TryParse<RegistrationStatus>(filterStatus, out var status))
            {
                result = result.Where(r => r.Status == status);
            }

            if (!string.IsNullOrEmpty(filterGender) && Enum.TryParse<Gender>(filterGender, out var gender))
            {
                result = result.Where(r => r.PersonalInfo.Gender == gender);
            }

            return result.OrderByDescending(r => r.Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            var user = await CurrentUserService.GetCurrentUserAsync();
            if (user == null) return;

            currentUserId = user.ObjectIdentifier;
            isAdmin = user.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase);

            settings = await SettingsService.GetSettingsAsync();
            competitionYear = settings?.CompetitionInfo?.CompetitionYear ?? DateTime.UtcNow.Year;

            // Load registrations
            if (showAllRegistrations && isAdmin)
            {
                registrations = await RegistrationService.GetAllByYearAsync(competitionYear);
            }
            else
            {
                registrations = await RegistrationService.GetUserRegistrationsAsync(currentUserId, competitionYear);
            }

            // BATCH load competition progress - single query instead of N queries
            var registrationIds = registrations.Select(r => r.Id).ToList();
            competitionProgress = await CompetitionProgressService.GetByRegistrationIdsAsync(registrationIds);
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
    }

    // Client-side permission checks - no async calls needed
    private bool CanEdit(Registration reg)
    {
        if (reg.Status != RegistrationStatus.AwaitingReview &&
            reg.Status != RegistrationStatus.Pending)
            return false;

        var category = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);

        return category?.AllowEdit ?? true;
    }

    private bool CanWithdraw(Registration reg)
    {
        if (reg.Status == RegistrationStatus.Withdrawn ||
            reg.Status == RegistrationStatus.Disqualified)
            return false;

        var category = settings?.FindDivision(reg.CompetitionSelection.DivisionId)
            ?.FindCategory(reg.CompetitionSelection.CategoryId);

        return category?.AllowWithdraw ?? true;
    }

    private async Task SetViewMode(bool viewAll)
    {
        if (showAllRegistrations != viewAll)
        {
            showAllRegistrations = viewAll;

            // Show toast when admin switches to "All" view
            if (viewAll && isAdmin)
            {
                showAdminToast = true;
            }

            await LoadDataAsync();
        }
    }

    private IEnumerable<Division> GetUniqueDivisions()
    {
        var divisionIds = registrations
            .Select(r => r.CompetitionSelection.DivisionId)
            .Where(id => !string.IsNullOrEmpty(id))
            .Distinct();

        return divisionIds
            .Select(id => settings?.FindDivision(id))
            .Where(d => d != null)!;
    }

    private IEnumerable<RegistrationStatus> GetUniqueStatuses()
    {
        return registrations
            .Select(r => r.Status)
            .Distinct()
            .OrderBy(s => s);
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        filterDivision = string.Empty;
        filterStatus = string.Empty;
        filterGender = string.Empty;
    }

    // Withdraw modal state
    private bool showWithdrawModal;
    private Registration? withdrawingRegistration;
    private string withdrawReasonType = string.Empty;
    private string withdrawOtherReason = string.Empty;
    private bool isWithdrawing;
    private string? withdrawError;

    private void ShowWithdrawModal(Registration registration)
    {
        withdrawingRegistration = registration;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
        showWithdrawModal = true;
    }

    private void CloseWithdrawModal()
    {
        showWithdrawModal = false;
        withdrawingRegistration = null;
        withdrawReasonType = string.Empty;
        withdrawOtherReason = string.Empty;
        withdrawError = null;
    }

    private string GetWithdrawReasonText() => withdrawReasonType switch
    {
        "ScheduleConflict" => "Schedule conflict",
        "HealthRelated" => "Health-related reason",
        "InsufficientPreparation" => "Insufficient preparation",
        "Other" => $"Other - {withdrawOtherReason.Trim()}",
        _ => string.Empty
    };

    private async Task ConfirmWithdraw()
    {
        if (withdrawingRegistration == null || string.IsNullOrEmpty(currentUserId)) return;

        // Validate selection
        if (string.IsNullOrWhiteSpace(withdrawReasonType))
        {
            withdrawError = "Please select a reason for withdrawal.";
            return;
        }

        // Validate "Other" has explanation
        if (withdrawReasonType == "Other" && string.IsNullOrWhiteSpace(withdrawOtherReason))
        {
            withdrawError = "Please explain your reason for withdrawal.";
            return;
        }

        isWithdrawing = true;
        withdrawError = null;

        try
        {
            var reasonText = GetWithdrawReasonText();
            var previousStatus = withdrawingRegistration.Status.ToString();

            // Get division/category names for audit
            var division = settings?.FindDivision(withdrawingRegistration.CompetitionSelection.DivisionId);
            var category = division?.FindCategory(withdrawingRegistration.CompetitionSelection.CategoryId);

            // Set audit context
            await AuditContextProvider.SetCurrentUserContextAsync();

            await RegistrationService.WithdrawAsync(
                withdrawingRegistration.Id,
                currentUserId,
                reasonText);

            // Log audit entry for withdrawal
            await AuditService.LogFieldChangesAsync(
                "Registration",
                withdrawingRegistration.Id,
                new List<FieldChange>
                {
                    new FieldChange
                    {
                        FieldName = "Status",
                        DisplayName = "Status",
                        OldValue = previousStatus,
                        NewValue = RegistrationStatus.Withdrawn.ToString()
                    },
                    new FieldChange
                    {
                        FieldName = "WithdrawComment",
                        DisplayName = "Withdrawal Reason",
                        OldValue = null,
                        NewValue = reasonText
                    }
                },
                action: AuditAction.Withdrawn,
                summary: $"{previousStatus} → Withdrawn (Reason: {reasonText})",
                entityDescription: $"{withdrawingRegistration.PersonalInfo.FullName} - {division?.Name ?? "Unknown"} / {category?.Name ?? "Unknown"}");

            CloseWithdrawModal();
            await LoadDataAsync();
        }
        catch (InvalidOperationException ex)
        {
            withdrawError = ex.Message;
        }
        catch (Exception)
        {
            withdrawError = "An error occurred while withdrawing the registration.";
        }
        finally
        {
            isWithdrawing = false;
        }
    }

    private bool HasRoundNotification(string registrationId)
    {
        // Show Messages link if CompetitionProgress exists (means there's info to view)
        return competitionProgress.ContainsKey(registrationId);
    }

    private bool HasUnacknowledgedRound(string registrationId)
    {
        if (!competitionProgress.TryGetValue(registrationId, out var progress))
            return false;

        // Result or bypass notifications (Acknowledged = false on completed/eliminated/bypassed round)
        if (progress.HasPendingAcknowledgment) return true;

        // Scheduling reminder: participant has an Active round and there is an open session for it
        // Red dot fires when admin opens scheduling; clears automatically once they book (status → Scheduled)
        // HasPlacement rounds (final round) are excluded — results are announced in person, not via scheduling
        var activeRound = progress.Rounds.FirstOrDefault(r => r.Status == RoundEntryStatus.Active);
        if (activeRound != null)
        {
            var activeRoundDef = settings?.Divisions
                .SelectMany(d => d.Categories)
                .SelectMany(c => c.Rounds)
                .FirstOrDefault(r => r.Id == activeRound.RoundDefinitionId);
            if (activeRoundDef?.HasPlacement != true &&
                settings?.SchedulingSessions.Any(s =>
                    s.IsOpen &&
                    string.Equals(s.LinkedRoundName, activeRound.Name, StringComparison.OrdinalIgnoreCase)) == true)
                return true;
        }

        return false;
    }
}
