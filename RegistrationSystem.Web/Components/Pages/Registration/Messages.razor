@page "/registrations/{RegistrationId}/messages"
@using Microsoft.AspNetCore.Components.Authorization
@using RegistrationSystem.Core.Domain.Registrations
@using RegistrationSystem.Core.Domain.CompetitionRounds
@using RegistrationSystem.Core.Domain.Settings
@using RegistrationSystem.Core.Domain.Auditing
@using RegistrationSystem.Core.Application.Auditing
@using System.Security.Claims

@inject RegistrationService RegistrationService
@inject CompetitionProgressService CompetitionProgressService
@inject SettingsService SettingsService
@inject IAuditService AuditService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(registration != null ? $"Messages — {registration.PersonalInfo.FullName}" : "Messages")</PageTitle>

<div class="min-h-screen">

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center h-96 gap-4">
            @Icons.Spinner("h-10 w-10 text-cyan-700 animate-spin")
            <p class="text-slate-400 text-sm font-medium animate-pulse">Loading messages...</p>
        </div>
    }
    else if (registration == null)
    {
        <div class="max-w-2xl mx-auto mt-20 text-center bg-white p-12 rounded-xl border border-slate-200 shadow-sm">
            <div class="h-16 w-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                @Icons.FaceSmile("h-8 w-8 text-slate-300")
            </div>
            <h3 class="text-lg font-semibold text-slate-900">Registration Not Found</h3>
            <button @onclick="GoBack" class="mt-6 inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                Return to Registrations
            </button>
        </div>
    }
    else
    {
        <!-- ═══════════════════════════════════════════════════════════════
             PAGE HEADER
             ═══════════════════════════════════════════════════════════════ -->
        <div class="max-w-7xl mx-auto px-6 pt-6 pb-2">
            <button @onclick="GoBack" class="group flex items-center text-sm text-slate-500 hover:text-cyan-700 transition-colors mb-4">
                @Icons.ArrowLeft("mr-2 h-4 w-4 text-slate-400 group-hover:text-cyan-700 transition-colors")
                Back to Registrations
            </button>

            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">@registration.PersonalInfo.FullName</h1>
                    <div class="flex items-center gap-3 mt-2 text-sm text-slate-500">
                        <span>@divisionName</span>
                        <span class="text-slate-300">·</span>
                        <span>@category?.Name</span>
                        @if (!string.IsNullOrEmpty(registration.Cid))
                        {
                            <span class="text-slate-300">·</span>
                            <span class="font-mono bg-slate-100 px-2 py-0.5 rounded text-xs text-slate-600 border border-slate-200">@registration.Cid</span>
                        }
                    </div>
                </div>
                <span class="self-start @GetStatusBadgeClass(registration.Status) px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide border shadow-sm">
                    @GetStatusDisplayName(registration.Status)
                </span>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             MAIN CONTENT
             ═══════════════════════════════════════════════════════════════ -->
        <div class="max-w-7xl mx-auto px-6 py-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- ─── Left: Competition Progress ─────────────────────── -->
                <div class="lg:col-span-8">
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

                        <div class="px-6 py-4 bg-gradient-to-r from-slate-800 to-slate-700 flex items-center gap-3">
                            <div class="w-7 h-7 rounded-md bg-gradient-to-br from-cyan-500 to-teal-600 flex items-center justify-center shadow-sm">
                                @Icons.Calendar("h-3.5 w-3.5 text-white")
                            </div>
                            <h2 class="font-semibold text-white">Competition Progress</h2>
                        </div>

                        <div class="p-6 md:p-8">
                            @if (timelineSteps.Count == 0)
                            {
                                <div class="text-center py-10 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                                    @Icons.Clock("h-10 w-10 text-slate-300 mx-auto mb-3")
                                    <p class="text-sm font-medium text-slate-600">Schedule Pending</p>
                                    <p class="text-xs text-slate-400 mt-1">Round assignments will appear here after review.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var (step, index) in timelineSteps.Select((s, i) => (s, i)))
                                {
                                    var isLast = index == timelineSteps.Count - 1;
                                    var stepIndex = index;

                                    <div class="flex">
                                        <!-- Dot + Connector -->
                                        <div class="flex flex-col items-center">
                                            <div class="h-10 w-10 rounded-full bg-white border-2 @(step.ShowAcknowledge ? "border-cyan-500 ring-4 ring-cyan-50" : "border-slate-200") flex items-center justify-center shrink-0 shadow-sm">
                                                <div class="h-3 w-3 rounded-full @step.DotClass"></div>
                                            </div>
                                            @if (!isLast)
                                            {
                                                <div class="w-0.5 bg-slate-200 flex-1 min-h-6"></div>
                                            }
                                        </div>

                                        <!-- Step Content -->
                                        <div class="ml-5 flex-1 @(isLast ? "" : "pb-8")">
                                            <div class="flex flex-wrap items-center gap-2 pt-0.5">
                                                <h3 class="text-base font-semibold text-slate-900">@step.Title</h3>
                                                @if (!string.IsNullOrEmpty(step.BadgeLabel))
                                                {
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @step.BadgeClass">
                                                        @step.BadgeLabel
                                                    </span>
                                                }
                                            </div>

                                            <div class="mt-1.5 text-sm text-slate-600 message-content">
                                                @((MarkupString)step.Description)
                                            </div>

                                            @* Expandable Instructions *@
                                            @if (!string.IsNullOrEmpty(step.ExpandableDetails))
                                            {
                                                <button @onclick="() => ToggleExpanded(stepIndex)"
                                                        class="mt-2 flex items-center gap-1.5 text-xs font-medium text-cyan-600 hover:text-cyan-700 transition-colors cursor-pointer">
                                                    @Icons.Chevron($"h-3 w-3 transition-transform duration-200 {(expandedSteps.Contains(stepIndex) ? "rotate-90" : "")}")
                                                    Instructions
                                                </button>
                                                @if (expandedSteps.Contains(stepIndex))
                                                {
                                                    <div class="mt-2 text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 message-content">
                                                        @((MarkupString)step.ExpandableDetails)
                                                    </div>
                                                }
                                            }

                                            @if (!string.IsNullOrEmpty(step.AcknowledgedDetail))
                                            {
                                                <div class="mt-1.5 flex items-center gap-1.5 text-[11px] text-slate-400">
                                                    @Icons.CheckCircle("h-3 w-3")
                                                    @step.AcknowledgedDetail
                                                </div>
                                            }

                                            @if (step.ShowAcknowledge)
                                            {
                                                <button @onclick="AcknowledgeAsync"
                                                        disabled="@isAcknowledging"
                                                        class="mt-3 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-cyan-600 to-teal-600 rounded-lg shadow-sm hover:from-cyan-700 hover:to-teal-700 disabled:opacity-60 disabled:cursor-not-allowed transition-all">
                                                    @if (isAcknowledging)
                                                    {
                                                        @Icons.Spinner("animate-spin h-4 w-4")
                                                        <p>Processing...</p>
                                                    }
                                                    else
                                                    {
                                                        @Icons.Check("h-4 w-4")
                                                        <p>Confirm &amp; Acknowledge</p>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- ─── Right: Status + Communications ─────────────────── -->
                <div class="lg:col-span-4 space-y-6">

                    <!-- Status History -->
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="px-5 py-3.5 bg-gradient-to-r from-slate-800 to-slate-700 flex items-center gap-3">
                            <div class="w-7 h-7 rounded-md bg-gradient-to-br from-violet-500 to-violet-600 flex items-center justify-center shadow-sm">
                                @Icons.CheckCircle("h-3.5 w-3.5 text-white")
                            </div>
                            <h3 class="text-sm font-semibold text-white">Status History</h3>
                        </div>
                        <div>
                            @if (statusEntries.Count == 0)
                            {
                                <p class="p-6 text-sm text-slate-500 text-center">No history available.</p>
                            }
                            else
                            {
                                <ul class="divide-y divide-slate-50 max-h-[350px] overflow-y-auto">
                                    @foreach (var entry in statusEntries)
                                    {
                                        <li class="px-4 py-3 hover:bg-slate-50 transition-colors">
                                            <div class="flex items-start gap-3">
                                                <div class="shrink-0 mt-1.5">
                                                    <div class="h-2 w-2 rounded-full @GetActionDotClass(entry.Action)"></div>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-medium text-slate-900">@entry.Summary</p>
                                                    <div class="flex items-center justify-between mt-1 gap-2">
                                                        <p class="text-xs text-slate-400">@entry.GetFormattedTimestamp()</p>
                                                        @if (entry.GetActorDescription() != "Anonymous")
                                                        {
                                                            <span class="text-[10px] text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200 shrink-0">
                                                                @entry.GetActorDescription()
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <!-- Communications -->
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="px-5 py-3.5 bg-gradient-to-r from-slate-800 to-slate-700 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-7 h-7 rounded-md bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-sm">
                                @Icons.Envelope("h-3.5 w-3.5 text-white")
                                </div>
                                <h3 class="text-sm font-semibold text-white">Communications</h3>
                            </div>
                            <span class="text-xs text-slate-400 bg-slate-800 border border-slate-600 px-2 py-0.5 rounded-full">@communicationEntries.Count</span>
                        </div>
                        <div>
                            @if (communicationEntries.Count == 0)
                            {
                                <div class="p-8 text-center">
                                    <p class="text-xs text-slate-400">No emails or SMS sent yet.</p>
                                </div>
                            }
                            else
                            {
                                <ul class="divide-y divide-slate-50 max-h-[350px] overflow-y-auto">
                                    @foreach (var entry in communicationEntries)
                                    {
                                        <li class="px-4 py-3 flex items-start gap-3 hover:bg-slate-50 transition-colors">
                                            <div class="shrink-0">
                                                @if (entry.Action == AuditAction.SmsSent)
                                                {
                                                    <div class="w-8 h-8 rounded-md bg-gradient-to-br from-violet-500 to-violet-600 flex items-center justify-center shadow-sm">
                                                        @Icons.ChatBubble("h-4 w-4 text-white")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-8 h-8 rounded-md bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-sm">
                                                        @Icons.Envelope("h-4 w-4 text-white")
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs font-semibold text-slate-800">@entry.Summary</p>
                                                <p class="text-[11px] text-slate-400 mt-0.5">@entry.GetFormattedTimestamp()</p>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }

</div>

@code {
    [Parameter]
    public string RegistrationId { get; set; } = string.Empty;

    private Registration? registration;
    private CompetitionProgress? competitionProgress;
    private Category? category;
    private string? divisionName;
    private List<RoundDefinition> roundDefinitions = new();

    private List<AuditEntry> statusEntries = new();
    private List<AuditEntry> communicationEntries = new();
    private List<TimelineStep> timelineSteps = new();
    private HashSet<int> expandedSteps = new();

    private string? currentUserId;
    private bool isLoading = true;
    private bool isAcknowledging;

    // ─── Model ────────────────────────────────────────────────────────

    private record TimelineStep(
        string Title,
        string DotClass,
        string? BadgeLabel,
        string? BadgeClass,
        string Description,
        string? ExpandableDetails = null,
        string? AcknowledgedDetail = null,
        bool ShowAcknowledge = false
    );

    private static readonly HashSet<AuditAction> StatusActions = new()
    {
        AuditAction.Created,
        AuditAction.Submitted,
        AuditAction.StatusChanged,
        AuditAction.Approved,
        AuditAction.Rejected,
        AuditAction.Withdrawn,
        AuditAction.WithdrawalRequested,
        AuditAction.Verified,
        AuditAction.Disqualified
    };

    private static readonly HashSet<AuditAction> CommunicationActions = new()
    {
        AuditAction.EmailSent,
        AuditAction.SmsSent
    };

    // ─── Lifecycle ────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        registration = await RegistrationService.GetByIdAsync(RegistrationId);
        if (registration == null)
        {
            isLoading = false;
            return;
        }

        var progressTask = CompetitionProgressService.GetByRegistrationIdAsync(RegistrationId);
        var settingsTask = SettingsService.GetSettingsAsync();
        var auditTask = AuditService.GetEntityHistoryAsync("Registration", RegistrationId);

        await Task.WhenAll(progressTask, settingsTask, auditTask);

        competitionProgress = await progressTask;
        var settings = await settingsTask;
        var auditEntries = await auditTask;

        var division = settings.FindDivision(registration.CompetitionSelection.DivisionId);
        divisionName = division?.Name;
        category = division?.FindCategory(registration.CompetitionSelection.CategoryId);
        roundDefinitions = category?.Rounds ?? new();

        statusEntries = auditEntries.Where(e => StatusActions.Contains(e.Action)).ToList();
        communicationEntries = auditEntries.Where(e => CommunicationActions.Contains(e.Action)).ToList();

        BuildTimeline();
        isLoading = false;
    }

    // ─── Timeline Builder ─────────────────────────────────────────────

    private void BuildTimeline()
    {
        timelineSteps = new();
        if (competitionProgress == null) return;

        var steps = new List<TimelineStep>();

        foreach (var roundDef in roundDefinitions.OrderBy(r => r.Order))
        {
            var entry = competitionProgress.GetRound(roundDef.Id);
            if (entry == null) continue;

            // Pending — haven't reached this round yet
            if (entry.Status == RoundEntryStatus.Pending) break;

            // Bypassed
            if (entry.Status == RoundEntryStatus.Bypassed)
            {
                steps.AddRange(BuildBypassedSteps(roundDef, entry));
                continue;
            }

            // Active — show schedule or "awaiting results"
            if (entry.Status == RoundEntryStatus.Active)
            {
                steps.AddRange(BuildActiveSteps(roundDef, entry));
                break; // Stop at current active round
            }

            // Completed or Eliminated — show result
            steps.AddRange(BuildResultSteps(roundDef, entry));

            // If eliminated, stop the timeline
            if (entry.Status == RoundEntryStatus.Eliminated) break;
        }

        timelineSteps = steps;
    }

    private List<TimelineStep> BuildBypassedSteps(RoundDefinition roundDef, RoundEntry entry)
    {
        var description = !string.IsNullOrEmpty(entry.BypassReason)
            ? $"You are exempt from this round. <em>({entry.BypassReason})</em>"
            : "As a previous year finalist, you are exempt from this round.";

        return [new TimelineStep(
            Title: roundDef.Name,
            DotClass: "bg-emerald-500",
            BadgeLabel: "Exempt",
            BadgeClass: "text-emerald-700 bg-emerald-50",
            Description: description
        )];
    }

    private List<TimelineStep> BuildActiveSteps(RoundDefinition roundDef, RoundEntry entry)
    {
        var steps = new List<TimelineStep>();

        if (roundDef.HasSchedule && entry.ScheduledDateTime.HasValue)
        {
            // Has schedule assigned — show formatted date prominently + expandable instructions + ack button
            var description = FormatScheduleDescription(entry.ScheduledDateTime.Value);
            var details = !string.IsNullOrEmpty(roundDef.ScheduleDetails) ? roundDef.ScheduleDetails : null;

            steps.Add(new TimelineStep(
                Title: roundDef.Name,
                DotClass: entry.Acknowledged ? "bg-emerald-500" : "bg-cyan-500",
                BadgeLabel: entry.Acknowledged ? "Acknowledged" : "Scheduled",
                BadgeClass: entry.Acknowledged ? "text-emerald-700 bg-emerald-50" : "text-cyan-700 bg-cyan-50",
                Description: description,
                ExpandableDetails: details,
                AcknowledgedDetail: entry.Acknowledged && entry.AcknowledgedAt.HasValue
                    ? $"Confirmed {FormatCentralTime(entry.AcknowledgedAt.Value)}"
                    : null,
                ShowAcknowledge: !entry.Acknowledged
            ));

            // If the scheduled date hasn't passed yet, stop here — result will show after
            if (entry.ScheduledDateTime.Value > DateTimeOffset.UtcNow) return steps;

            // Date passed but still Active (no result entered yet) — show pending result
            steps.Add(new TimelineStep(
                Title: $"{roundDef.Name} Result",
                DotClass: "bg-amber-500",
                BadgeLabel: "Pending",
                BadgeClass: "text-amber-700 bg-amber-50",
                Description: "Results are being processed. Please check back soon."
            ));
        }
        else if (roundDef.HasSchedule)
        {
            // HasSchedule but not yet assigned
            steps.Add(new TimelineStep(
                Title: roundDef.Name,
                DotClass: "bg-slate-300",
                BadgeLabel: null,
                BadgeClass: null,
                Description: "Not yet scheduled."
            ));
        }
        else
        {
            // No schedule (async review round like video qualification)
            steps.Add(new TimelineStep(
                Title: roundDef.Name,
                DotClass: "bg-amber-500",
                BadgeLabel: "Under review",
                BadgeClass: "text-amber-700 bg-amber-50",
                Description: "An admin is currently reviewing your submission."
            ));
        }

        return steps;
    }

    private List<TimelineStep> BuildResultSteps(RoundDefinition roundDef, RoundEntry entry)
    {
        var steps = new List<TimelineStep>();

        // First, show the schedule step if this is a HasSchedule round
        if (roundDef.HasSchedule && entry.ScheduledDateTime.HasValue)
        {
            var scheduleDesc = FormatScheduleDescription(entry.ScheduledDateTime.Value);
            var details = !string.IsNullOrEmpty(roundDef.ScheduleDetails) ? roundDef.ScheduleDetails : null;

            steps.Add(new TimelineStep(
                Title: roundDef.Name,
                DotClass: "bg-emerald-500",
                BadgeLabel: "Completed",
                BadgeClass: "text-emerald-700 bg-emerald-50",
                Description: scheduleDesc,
                ExpandableDetails: details,
                AcknowledgedDetail: entry.AcknowledgedAt.HasValue
                    ? $"Confirmed {FormatCentralTime(entry.AcknowledgedAt.Value)}"
                    : null
            ));
        }

        // Then show the result
        var (dotClass, badgeLabel, badgeClass, description) = entry.Result switch
        {
            RoundResult.Pass => (
                "bg-emerald-500", "Passed", "text-emerald-700 bg-emerald-50",
                entry.Comment ?? roundDef.PassMessage ?? GetDefaultPassMessage(roundDef.Name)
            ),
            RoundResult.Qualified => (
                "bg-emerald-500", "Qualified", "text-emerald-700 bg-emerald-50",
                entry.Comment ?? roundDef.PassMessage ?? GetDefaultPassMessage(roundDef.Name)
            ),
            RoundResult.Fail => (
                "bg-red-500", "Did not pass", "text-red-700 bg-red-50",
                entry.Comment ?? roundDef.FailMessage ?? GetDefaultFailMessage(roundDef.Name)
            ),
            RoundResult.NotQualified => (
                "bg-red-500", "Not Qualified", "text-red-700 bg-red-50",
                entry.Comment ?? roundDef.FailMessage ?? GetDefaultFailMessage(roundDef.Name)
            ),
            RoundResult.NoShow => (
                "bg-amber-500", "Did not attend", "text-amber-700 bg-amber-50",
                entry.Comment ?? roundDef.FailMessage ?? $"You did not attend the {roundDef.Name}."
            ),
            RoundResult.Placed => (
                "bg-emerald-500", GetPlacementBadge(entry.Placement), "text-emerald-700 bg-emerald-50",
                entry.Comment ?? roundDef.PassMessage ?? GetDefaultFinalMessage(entry.Placement)
            ),
            RoundResult.Participated => (
                "bg-cyan-500", "Participated", "text-cyan-700 bg-cyan-50",
                entry.Comment ?? roundDef.PassMessage ?? GetDefaultFinalMessage(null)
            ),
            _ => (
                "bg-amber-500", "Pending", "text-amber-700 bg-amber-50",
                "Results are being processed. Please check back soon."
            )
        };

        steps.Add(new TimelineStep(
            Title: $"{roundDef.Name} Result",
            DotClass: dotClass,
            BadgeLabel: badgeLabel,
            BadgeClass: badgeClass,
            Description: description
        ));

        return steps;
    }

    // ─── Event Handlers ───────────────────────────────────────────────

    private void ToggleExpanded(int stepIndex)
    {
        if (!expandedSteps.Remove(stepIndex))
            expandedSteps.Add(stepIndex);
    }

    private async Task AcknowledgeAsync()
    {
        isAcknowledging = true;
        try
        {
            await CompetitionProgressService.AcknowledgeAsync(RegistrationId, currentUserId!);
            competitionProgress = await CompetitionProgressService.GetByRegistrationIdAsync(RegistrationId);
            BuildTimeline();
        }
        finally
        {
            isAcknowledging = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/registrations");
    }

    // ─── Helpers ──────────────────────────────────────────────────────

    private static string FormatCentralTime(DateTimeOffset dto)
    {
        var centralZone = TimeZoneInfo.FindSystemTimeZoneById("Central Standard Time");
        var ct = TimeZoneInfo.ConvertTimeFromUtc(dto.UtcDateTime, centralZone);
        return ct.ToString("MMM d, yyyy 'at' h:mm tt") + " CT";
    }

    private static string FormatScheduleDescription(DateTimeOffset dto)
    {
        var centralZone = TimeZoneInfo.FindSystemTimeZoneById("Central Standard Time");
        var ct = TimeZoneInfo.ConvertTimeFromUtc(dto.UtcDateTime, centralZone);
        var dayOfWeek = ct.ToString("dddd");
        var date = ct.ToString("MMMM d, yyyy");
        var time = ct.ToString("h:mm tt");
        return $"<strong class=\"text-slate-900\">{dayOfWeek}, {date}</strong><br><span class=\"text-lg font-semibold text-cyan-700\">{time} CT</span>";
    }

    private static string GetStatusBadgeClass(RegistrationStatus status) => status switch
    {
        RegistrationStatus.Pending => "bg-emerald-100 text-emerald-800",
        RegistrationStatus.AwaitingReview => "bg-amber-100 text-amber-800",
        RegistrationStatus.Reviewed => "bg-cyan-100 text-cyan-800",
        RegistrationStatus.Verified => "bg-indigo-100 text-indigo-800",
        RegistrationStatus.Withdrawn => "bg-slate-200 text-slate-700",
        RegistrationStatus.Disqualified => "bg-red-100 text-red-800",
        _ => "bg-slate-200 text-slate-700"
    };

    private static string GetStatusDisplayName(RegistrationStatus status) => status switch
    {
        RegistrationStatus.AwaitingReview => "Awaiting Review",
        RegistrationStatus.Pending => "Pending",
        RegistrationStatus.Reviewed => "Reviewed",
        RegistrationStatus.Verified => "Verified",
        RegistrationStatus.Withdrawn => "Withdrawn",
        RegistrationStatus.Disqualified => "Disqualified",
        _ => status.ToString()
    };

    private static string GetActionDotClass(AuditAction action) => action.GetColorClass() switch
    {
        "emerald" => "bg-emerald-500",
        "cyan" => "bg-cyan-500",
        "red" => "bg-red-500",
        "amber" => "bg-amber-500",
        "violet" => "bg-violet-500",
        "blue" => "bg-blue-500",
        _ => "bg-slate-400"
    };

    private static string GetPlacementBadge(int? placement) => placement switch
    {
        1 => "\U0001f947 Placed 1st",
        2 => "\U0001f948 Placed 2nd",
        3 => "\U0001f949 Placed 3rd",
        _ => "Placed"
    };

    private static string GetDefaultPassMessage(string roundName) =>
        $"Congratulations! You have successfully passed the <strong>{roundName}</strong>.";

    private static string GetDefaultFailMessage(string roundName) =>
        $"Thank you for participating in the <strong>{roundName}</strong> of the competition. While you did not advance to the next round, we sincerely appreciate your dedication to the Qur'an and commend your efforts.<br><br>We encourage you to continue your memorization journey and look forward to your participation in future competitions, in sh\u0101' All\u0101h.<br><br><em>Jazak All\u0101hu Khayran.</em>";

    private static string GetDefaultFinalMessage(int? placement)
    {
        if (placement.HasValue && placement.Value <= 3)
        {
            var medal = placement.Value switch { 1 => "\U0001f947 First Place", 2 => "\U0001f948 Second Place", 3 => "\U0001f949 Third Place", _ => "" };
            return $"<strong>Masha'All\u0101h! {medal}</strong><br><br>Congratulations on your outstanding performance. May All\u0101h bless you, your teachers, and your family.<br><br>Details about the award ceremony will be shared with you soon, in sh\u0101' All\u0101h.<br><br><em>Jazak All\u0101hu Khayran.</em>";
        }

        return "Thank you for participating in the competition. May All\u0101h accept your efforts and make the Qur'\u0101n a light in your life.<br><br>Details about the award ceremony will be shared with you soon, in sh\u0101' All\u0101h.<br><br><em>Jazak All\u0101hu Khayran.</em>";
    }
}
