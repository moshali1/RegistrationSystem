@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center max-w-md">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-red-500 to-red-600 flex items-center justify-center mx-auto mb-6 shadow-lg">
            @Icons.Warning("h-8 w-8 text-white")
        </div>
        <h1 class="text-2xl font-bold text-slate-800 mb-2">Something went wrong</h1>
        <p class="text-slate-500 mb-6">An unexpected error occurred while processing your request. Please try again.</p>
        @if (ShowRequestId)
        {
            <p class="text-xs text-slate-400 mb-6">
                Request ID: <code class="bg-slate-100 px-2 py-1 rounded text-slate-600">@RequestId</code>
            </p>
        }
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg">
            @Icons.Home("h-4 w-4")
            Go Home
        </a>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
