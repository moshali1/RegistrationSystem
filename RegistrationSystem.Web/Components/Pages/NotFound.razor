@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found</PageTitle>

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="text-center max-w-md">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-slate-500 to-slate-700 flex items-center justify-center mx-auto mb-6 shadow-lg">
            @Icons.Search("h-8 w-8 text-white")
        </div>
        <h1 class="text-2xl font-bold text-slate-800 mb-2">Page not found</h1>
        <p class="text-slate-500 mb-6">Sorry, the page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-600 to-cyan-700 text-white px-5 py-2.5 text-sm font-semibold hover:from-cyan-700 hover:to-cyan-800 transition-all shadow-lg">
            @Icons.Home("h-4 w-4")
            Go Home
        </a>
    </div>
</div>
