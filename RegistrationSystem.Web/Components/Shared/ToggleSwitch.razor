<label class="group relative inline-flex w-11 shrink-0 cursor-pointer rounded-full bg-slate-200 p-0.5
              outline-offset-2 outline-cyan-600 ring-1 ring-inset ring-slate-900/5
              transition-colors duration-200 ease-in-out
              has-[:checked]:bg-cyan-700
              has-[:focus-visible]:outline has-[:focus-visible]:outline-2">
    <span class="size-5 rounded-full bg-white shadow-sm ring-1 ring-slate-900/5
                 transition-transform duration-200 ease-in-out
                 group-has-[:checked]:translate-x-5"></span>
    <input type="checkbox"
           checked="@Value"
           @onchange="HandleChanged"
           class="absolute inset-0 appearance-none cursor-pointer focus:outline-none" />
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public EventCallback OnToggled { get; set; }

    private async Task HandleChanged()
    {
        var newValue = !Value;
        await ValueChanged.InvokeAsync(newValue);

        if (OnToggled.HasDelegate)
            await OnToggled.InvokeAsync();
    }
}
