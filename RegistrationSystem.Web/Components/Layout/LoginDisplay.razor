@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <!-- Backdrop to close dropdown -->
        @if (isDropdownOpen)
        {
            <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>
        }

        <div class="relative z-50">
            <button type="button"
                    class="cursor-pointer flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-100 transition-colors"
                    @onclick="ToggleDropdown">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-600 to-cyan-700 flex items-center justify-center text-white text-xs font-semibold shadow-sm">
                    @GetInitials(context)
                </div>
                <div class="hidden sm:block text-left">
                    <div class="text-sm font-medium text-slate-800 truncate max-w-[120px]">
                        @GetDisplayName(context)
                    </div>
                    <div class="text-xs text-slate-500 truncate max-w-[120px]">
                        @GetEmail(context)
                    </div>
                </div>
                <svg class="h-4 w-4 text-slate-400 hidden sm:block transition-transform @(isDropdownOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            @if (isDropdownOpen)
            {
                <div class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white shadow-xl overflow-hidden">
                    <!-- User Info -->
                    <div class="px-4 py-3 border-b border-slate-100 bg-slate-50">
                        <p class="text-sm font-medium text-slate-800 truncate">@GetDisplayName(context)</p>
                        <p class="text-xs text-slate-500 truncate">@GetEmail(context)</p>
                    </div>

                    <!-- Menu Items -->
                    <div class="py-1">
                        <a href="/profile" @onclick="CloseDropdown" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Profile
                        </a>
                        <a href="/claims" @onclick="CloseDropdown" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
                            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                            </svg>
                            Claims
                        </a>
                    </div>

                    <!-- Sign Out -->
                    <div class="border-t border-slate-100 py-1">
                        <a href="/MicrosoftIdentity/Account/SignOut" class="flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Sign out
                        </a>
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/MicrosoftIdentity/Account/SignIn"
           class="inline-flex items-center gap-2 rounded-lg bg-cyan-700 px-4 py-2 text-sm font-medium text-white hover:bg-cyan-800 transition-colors shadow-sm">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            Sign in
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isDropdownOpen;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void CloseDropdown()
    {
        isDropdownOpen = false;
    }

    private static string GetDisplayName(AuthenticationState context)
    {
        return context.User.FindFirst("name")?.Value
            ?? context.User.Identity?.Name
            ?? "User";
    }

    private static string GetEmail(AuthenticationState context)
    {
        return context.User.FindFirst("preferred_username")?.Value
            ?? context.User.FindFirst("emails")?.Value
            ?? context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? "";
    }

    private static string GetInitials(AuthenticationState context)
    {
        var name = GetDisplayName(context);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }

        return name.Length > 0 ? name[0].ToString().ToUpper() : "?";
    }
}
