@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<div class="p-4 text-slate-200 text-sm space-y-4">
    <!-- Main navigation -->
    <nav class="space-y-1">
        <NavLink href=""
                 Match="NavLinkMatch.All"
                 class="group nav-link"
                 ActiveClass="nav-link-active">
            @Icons.Home("w-5 h-5 opacity-80 group-hover:opacity-100")
            <span>Home</span>
        </NavLink>

        <NavLink href="register/new"
                 class="group nav-link"
                 ActiveClass="nav-link-active">
            @Icons.Plus("w-5 h-5 opacity-80 group-hover:opacity-100")
            <span>New Registration</span>
        </NavLink>

        <NavLink href="registrations"
                 class="group nav-link"
                 ActiveClass="nav-link-active">
            @Icons.ListBullet("w-5 h-5 opacity-80 group-hover:opacity-100")
            <span>My Registrations</span>
        </NavLink>
    </nav>

    <!-- Account section -->
    <AuthorizeView>
        <Authorized>
            <div class="pt-4 mt-2 border-t border-white/10">
                <p class="px-4 text-xs font-semibold tracking-wide uppercase text-slate-400 mb-2">
                    Account
                </p>
                <NavLink href="profile"
                         class="group nav-link"
                         ActiveClass="nav-link-active">
                    @Icons.User("w-5 h-5 opacity-80 group-hover:opacity-100")
                    <span>Profile</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

    <!-- Admin section - Only visible to Admins -->
    <AuthorizeView Roles="Admin">
        <Authorized>
            <div class="pt-4 mt-2 border-t border-white/10 space-y-4">
                <!-- Registrations -->
                <div>
                    <p class="px-4 text-xs font-semibold tracking-wide uppercase text-slate-400 mb-2">
                        Registrations
                    </p>
                    <nav class="space-y-1">
                        <NavLink href="admin/dashboard"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.ChartBar("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Dashboard</span>
                        </NavLink>

                        <NavLink href="admin/registrations"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.ListBullet("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Registration List</span>
                        </NavLink>

                        <NavLink href="admin/registration-review"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.ClipboardCheck("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Registration Review</span>
                        </NavLink>

                        <NavLink href="admin/id-verification"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.ShieldCheckFilled("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>ID Verification</span>
                        </NavLink>

                        <NavLink href="admin/competition-tracking"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.Eye("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Competition Tracking</span>
                        </NavLink>
                    </nav>
                </div>

                <!-- System -->
                <div>
                    <p class="px-4 text-xs font-semibold tracking-wide uppercase text-slate-400 mb-2">
                        System
                    </p>
                    <nav class="space-y-1">
                        <NavLink href="admin/niqab-bypasses"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.Shield("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Niqab Bypasses</span>
                        </NavLink>

                        <NavLink href="admin/audit"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.Clock("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Audit Trail</span>
                        </NavLink>

                        <NavLink href="admin/tools"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.Lightning("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Admin Tools</span>
                        </NavLink>
                    </nav>
                </div>

                <!-- Settings -->
                <div>
                    <p class="px-4 text-xs font-semibold tracking-wide uppercase text-slate-400 mb-2">
                        Settings
                    </p>
                    <nav class="space-y-1">
                        <NavLink href="admin/competition-settings"
                                 class="group nav-link"
                                 ActiveClass="nav-link-active">
                            @Icons.Cog("w-5 h-5 opacity-80 group-hover:opacity-100")
                            <span>Competition Settings</span>
                        </NavLink>
                    </nav>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
